# modules/config/shell-environment.nix — the login environment. Generates
# /etc/profile.d/solnix-env.sh (the illumos /etc/profile ALREADY sources
# /etc/profile.d/*.sh) so every login shell gets the system profile on PATH,
# NIX_PROFILES, and the declared session variables + aliases. The solnix analog
# of NixOS's config/shells-environment.nix (design \u00a7B).
#
# POSIX sh-safe: the generated file runs under /sbin/sh AND ksh93 (the two login
# shells solnix uses). No bashisms; a re-source guard makes it idempotent.
# Deliberately NOT set (design \u00a7B): LOCALE_ARCHIVE (illumos is not glibc). We do
# NOT touch /bin/sh.

{ config, lib, pkgs, ... }:

let
  inherit (lib) mkOption types concatStringsSep mapAttrsToList mapAttrs;

  cfg = config.environment;

  # exportedEnvVars: absolute sessionVariables + profile-relative vars expanded
  # across environment.profiles. Copied from NixOS config/shells-environment.nix
  # (pure-string form). listSuffixes for each profileRelative var are joined onto
  # every profile, then concatenated with the absolute values under one name.
  #
  # DIFF from NixOS: the profile-relative vars (PATH/MANPATH/INFOPATH) APPEND any
  # pre-existing value (''${NAME:+:''${NAME}}) so the illumos base PATH set by
  # /etc/profile (/usr/bin, /sbin, ...) survives — our sw dirs go FIRST (sw wins,
  # design risk #5), the base tools stay reachable after. A bare `export PATH=...`
  # would clobber the base PATH and lose svcs/uname/etc.
  profileRelNames = builtins.attrNames cfg.profileRelativeSessionVariables;
  exportedEnvVars =
    let
      absoluteVariables = mapAttrs (_n: lib.toList) cfg.sessionVariables;
      suffixedVariables = lib.flip mapAttrs cfg.profileRelativeSessionVariables (
        _envVar: listSuffixes:
        lib.concatMap (profile: map (suffix: "${profile}${suffix}") listSuffixes) cfg.profiles
      );
      allVariables = lib.zipAttrsWith (_n: lib.concatLists) [
        absoluteVariables
        suffixedVariables
      ];
      exportVariables = mapAttrsToList (
        n: v:
        let joined = concatStringsSep ":" v;
        in if builtins.elem n profileRelNames
           then ''export ${n}="${joined}''${${n}:+:''${${n}}}"''
           else ''export ${n}="${joined}"''
      ) allVariables;
    in
    concatStringsSep "\n" exportVariables;

  # NIX_PROFILES ordering matches NixOS (least-specific first): default, then the
  # user profile, then current-system sw.
  nixProfiles = "/nix/var/nix/profiles/default $HOME/.nix-profile /run/current-system/sw";

  # Guaranteed base PATH tail (maintainer directive 2026-08-04): after the
  # profile-relative sw/bin dirs, ALWAYS append the Nix tooling + the illumos base
  # OS dirs, so BOTH the Nix profile (htop, ...) AND native tools (ping, getent,
  # format, ...) resolve in EVERY login shell (bash AND ksh93) regardless of what
  # /etc/profile pre-set. Explicit so a bare image can never leave ksh without a PATH.
  basePathTail = "/nix-tools/bin:/usr/gnu/bin:/usr/bin:/usr/sbin:/sbin:/usr/ccs/bin";

  # aliases only make sense in an interactive shell; guard them on $PS1.
  aliasLines = concatStringsSep "\n" (
    mapAttrsToList (name: value: "  alias ${name}=${lib.escapeShellArg value}") cfg.shellAliases
  );

  # the /etc/profile.d snippet. Re-source guard (__SOLNIX_ENV_SOURCED) keeps a
  # nested login shell from re-exporting. Interactive-only aliases behind $PS1.
  setEnvironmentText = ''
    # solnix login environment. Generated by modules/config/shell-environment.nix.
    # POSIX sh-safe (runs under /sbin/sh + ksh93). Do not edit; edit the module.
    if [ -n "''${__SOLNIX_ENV_SOURCED:-}" ]; then
      :
    else
      __SOLNIX_ENV_SOURCED=1
      export __SOLNIX_ENV_SOURCED

      ${exportedEnvVars}

      # Guaranteed base PATH tail: Nix tooling + illumos base OS dirs ALWAYS present
      # (append only dirs not already in PATH, so both nix-profile tools and native
      # ping/getent/format resolve in bash + ksh93). Maintainer directive 2026-08-04.
      for __d in ${basePathTail}; do
        case ":''${PATH}:" in *":''${__d}:"*) : ;; *) PATH="''${PATH:-}:''${__d}" ;; esac
      done
      PATH="''${PATH#:}"; export PATH
      unset __d

      export NIX_PROFILES="${nixProfiles}"

      ${cfg.shellInit}
    fi

    # login-shell init (re-run on each login shell, not guarded).
    ${cfg.loginShellInit}

    # interactive-only aliases.
    if [ -n "''${PS1:-}" ]; then
${aliasLines}
      ${cfg.extraInit}
    fi
  '';

  setEnvironment = pkgs.writeText "solnix-env.sh" setEnvironmentText;
in
{
  options.environment = {
    sessionVariables = mkOption {
      type = types.attrsOf (types.either types.str (types.listOf types.str));
      default = { };
      example = { EDITOR = "vim"; };
      description = ''
        Absolute environment variables set for every login shell. A list value is
        joined with ":". environment.variables is merged in.
      '';
    };

    variables = mkOption {
      type = types.attrsOf (types.either types.str (types.listOf types.str));
      default = { };
      description = "Alias of sessionVariables (merged in). NixOS-compat name.";
    };

    profiles = mkOption {
      type = types.listOf types.str;
      default = [
        "/run/current-system/sw"
        "$HOME/.nix-profile"
        "/nix/var/nix/profiles/default"
      ];
      description = ''
        Profiles used to build the profile-relative session variables (PATH,
        MANPATH, INFOPATH). Order = PATH search order.
      '';
    };

    profileRelativeSessionVariables = mkOption {
      type = types.attrsOf (types.listOf types.str);
      default = {
        PATH = [ "/bin" "/sbin" ];
        MANPATH = [ "/share/man" ];
        INFOPATH = [ "/share/info" ];
      };
      description = ''
        Variables built by suffixing each entry onto every environment.profiles
        entry (e.g. PATH = /run/current-system/sw/bin:.../sw/sbin:...).
      '';
    };

    shellInit = mkOption {
      type = types.lines;
      default = "";
      description = "Shell commands run once per login (inside the re-source guard).";
    };
    loginShellInit = mkOption {
      type = types.lines;
      default = "";
      description = "Shell commands run for every login shell (outside the guard).";
    };
    extraInit = mkOption {
      type = types.lines;
      default = "";
      description = "Extra interactive-shell init (run behind the $PS1 guard).";
    };

    shellAliases = mkOption {
      type = types.attrsOf types.str;
      default = { };
      example = { ll = "ls -l"; };
      description = "Interactive shell aliases (emitted behind a $PS1 guard).";
    };
  };

  # internal: the generated /etc/profile.d carrier the activation module folds in.
  options.environment.generatedEtc = mkOption {
    type = types.attrsOf types.str;
    internal = true;
    default = { };
    description = "shell-env-derived /etc files (profile.d/solnix-env.sh). Read by activation.";
  };

  options.system.build.setEnvironment = mkOption {
    type = types.package;
    internal = true;
    description = "The /etc/profile.d/solnix-env.sh derivation (NixOS setEnvironment analog).";
  };

  config = {
    # environment.variables merges into sessionVariables (NixOS-compat).
    environment.sessionVariables = cfg.variables;

    system.build.setEnvironment = setEnvironment;
    environment.generatedEtc."profile.d/solnix-env.sh" = setEnvironmentText;
  };
}
