# modules/config/pgfarm.nix — the PostgreSQL build-farm animal + PG dev host role,
# declaratively.
#
# WHAT THIS REPLACES: scripts/bene-provision-dixi.sh steps 4/5 (the pgbf user,
# the buildfarm client checkout, build-farm.conf, and the PATH ordering fix).
# Those steps hand-built a running animal; this module makes an INSTALLED system
# get the same thing from its configuration. The script's steps 1/2/3/6 (build
# pool, IPS `pkg update`, IPS toolchain, the Nix bootstrap) are NOT covered here
# and remain imperative — see the DOCUMENTED GAPS block at the bottom of this
# file and docs/build-farm-animal-provisioning.md.
#
# THE LOAD-BEARING DETAIL: illumos /usr/bin/diff prints "No differences
# encountered" for identical files. PostgreSQL's src/test/modules/test_json_parser
# TAP test asserts diff prints NOTHING, so with the illumos diff on PATH four
# subtests and the whole module-test_json_parserCheck stage FAIL — silently, in
# the sense that the build itself is fine and only one stage goes red. The fix is
# text/gnu-diffutils installed (imperative, IPS) AND /usr/gnu/bin FIRST in PATH
# (declarative, here). This module puts /usr/gnu/bin first in three places that
# all matter, from one option (solnix.pgfarm.gnuBinFirst):
#   1. build-farm.conf's build_env.PATH  — every configure/make/test child;
#   2. the SMF method environment        — the scheduled animal run;
#   3. environment.shellInit             — an operator's interactive run.
# Miss any one of them and the corresponding path silently fails that stage.

{ config, lib, pkgs, ... }:

let
  inherit (lib) mkOption mkEnableOption types mkIf concatStringsSep optionalString;

  cfg = config.solnix.pgfarm;

  # The PATH every build/test child process must see. /usr/gnu/bin FIRST (see the
  # header): GNU diff must beat /usr/bin/diff. This is the exact value proven
  # green on the reference animal. With gnuBinFirst = false it becomes the plain
  # illumos PATH, which is what makes the negative control meaningful (the
  # test_json_parser stage must then FAIL) rather than merely unset.
  buildPath =
    if cfg.gnuBinFirst
    then "/usr/gnu/bin:/usr/bin:/usr/sbin"
    else "/usr/bin:/usr/sbin";

  # git refuses to operate in a tree owned by another uid ("dubious ownership"),
  # which breaks run_build.pl's git calls. A store-path global gitconfig scoped
  # to exactly the two trees the animal touches — declarative, and narrower than
  # `safe.directory = *`.
  gitConfig = pkgs.writeText "pgfarm-gitconfig" ''
    [safe]
    	directory = ${cfg.clientDir}
    	directory = ${cfg.buildRoot}
  '';

  # Perl-quote a string for a single-quoted perl literal.
  pq = s: "'" + (builtins.replaceStrings [ "\\" "'" ] [ "\\\\" "\\'" ] s) + "'";

  # build-farm.conf, rendered from options. The upstream sample is ~500 lines of
  # commented-out alternatives; this emits only the keys run_build.pl reads,
  # with the values the reference animal runs green with.
  buildFarmConf = pkgs.writeText "build-farm.conf" ''
    # -*-perl-*-
    # build-farm.conf GENERATED by modules/config/pgfarm.nix. Do not edit on the
    # target: edit solnix.pgfarm.* and rebuild.
    package PGBuild;
    use strict;
    use warnings;
    our (%conf);

    %conf = (
    	# identity. animal/secret come from buildfarm.postgresql.org (a human
    	# registration step); until they are set, run with --test, which builds and
    	# tests locally and reports nothing upstream.
    	animal => ${pq cfg.animal},
    	secret => ${pq cfg.secret},

    	# source
    	scm => 'git',
    	git_keep_mirror => 1,
    	git_ignore_mirror_failure => 1,
    	git_gc_hours => ${toString cfg.gitGcHours},
    	git_use_workdirs => 1,
    	rm_worktrees => 1,

    	# external commands. illumos `make` is not GNU make; PostgreSQL needs gmake.
    	make => ${pq cfg.makeProgram},
    	make_jobs => ${if cfg.jobs == null then "undef" else toString cfg.jobs},

    	# where to build. Must be on the big pool, never /tmp (tmpfs, volatile).
    	build_root => ${pq cfg.buildRoot},
    	use_vpath => undef,
    	use_valgrind => undef,
    	use_discard_caches => undef,
    	keep_error_builds => 0,
    	core_file_glob => "*core*",

    	# where to report
    	target => ${pq cfg.target},
    	upgrade_target => ${pq cfg.upgradeTarget},
    	using_msvc => undef,
    	using_meson => undef,

    	force_every => { },
    	alerts => { },
    	trigger_exclude => qr[^doc/|/README$|\.po$],
    	trigger_include => undef,
    	mail_events => { all => [], fail => [], change => [], green => [] },

    	ccache_failure_remove => undef,
    	use_default_ccache_dir => ${if cfg.ccache then "1" else "undef"},
    	use_accache => 1,

    	# env seen by EVERY build/report child process. PATH puts /usr/gnu/bin
    	# first: PG's test_json_parser TAP test asserts diff prints NOTHING for
    	# identical files, and the illumos /usr/bin/diff prints "No differences
    	# encountered" with -u, failing that stage.
    	build_env => {
    ${concatStringsSep "\n" (
      lib.mapAttrsToList (k: v: "\t\t${k} => ${pq v},") buildEnvAttrs
    )}
    	},

    	# env seen only by configure.
    	config_env => {
    ${concatStringsSep "\n" (
      lib.mapAttrsToList (k: v: "\t\t${k} => ${pq v},") configEnvAttrs
    )}
    	},

    	# configure options (do NOT put --prefix/--with-pgport here; run_build sets them)
    	config_opts => [
    		qw(
    ${concatStringsSep "\n" (map (o: "\t\t  ${o}") cfg.configOpts)}
    		  ),
    	],

    	extra_config => {
    		DEFAULT => [
    			q(log_line_prefix = '%m [%p:%l] %q%a '),
    			"log_connections = 'true'",
    			"log_disconnections = 'true'",
    			"log_statement = 'all'",
    			"fsync = off"
    		],
    		HEAD => ['debug_parallel_query = regress'],
    	},

    	optional_steps => { },
    	extra_doc_targets => undef,
    	locales => [qw( ${concatStringsSep " " cfg.locales} )],
    	base_port => ${toString cfg.basePort},
    	modules => [qw( ${concatStringsSep " " cfg.modules} )],

    	global => {
    		branches_to_build => ${pq cfg.branchesToBuild},
    		global_lock_dir => undef,
    		parallel_lockdir => undef,
    		parallel_stagger => undef,
    		max_parallel => undef,
    	},
    );
    1;
  '';

  # build_env / config_env as attrsets so the option surface can extend them.
  # PATH is ALWAYS set (see buildPath): leaving it unset would let an inherited
  # PATH decide which diff wins, which is precisely the failure mode being fixed.
  buildEnvAttrs =
    { PATH = buildPath; GIT_CONFIG_GLOBAL = "${gitConfig}"; }
    // cfg.extraBuildEnv;

  configEnvAttrs =
    (lib.optionalAttrs cfg.ccache { CC = "ccache gcc"; })
    // cfg.extraConfigEnv;

  # The one-shot setup the animal needs before its first run: the directories on
  # the big pool with the right ownership, and the buildfarm client checkout.
  #
  # GAP (honest): the client checkout is a `git clone` at RUNTIME, not a pinned
  # store path. The host eval path (lib/host-pkgs.nix) has no fetchers, and the
  # buildfarm client is a moving HEAD the animal is expected to keep current, so
  # pinning it in the store would need a re-pin per client release. Declared
  # intent is here; the fetch is imperative. See DOCUMENTED GAPS below.
  setupScript = pkgs.writeScript "pgfarm-setup" ''
    #!/sbin/sh
    # solnix pgfarm setup (generated by modules/config/pgfarm.nix). Idempotent.
    set -u
    PATH=${buildPath}:/sbin; export PATH

    for d in ${cfg.stateDir} ${cfg.home} ${cfg.buildRoot}; do
      [ -d "$d" ] || mkdir -p "$d" || { echo "FATAL: cannot mkdir $d" >&2; exit 1; }
      chown ${cfg.user}:${cfg.group} "$d" || exit 1
    done
    chown -R ${cfg.user}:${cfg.group} ${cfg.home} ${cfg.buildRoot}

    if [ ! -d ${cfg.clientDir}/.git ]; then
      mkdir -p "$(dirname ${cfg.clientDir})"
      git clone --depth 1 ${cfg.clientRepo} ${cfg.clientDir} \
        || { echo "FATAL: clone ${cfg.clientRepo} failed" >&2; exit 1; }
    fi
    chown -R ${cfg.user}:${cfg.group} ${cfg.clientDir}

    # run_build.pl refuses a config it cannot read; the generated one is a store
    # path, so nothing is copied — the wrapper passes --config=<store path>.
    [ -r ${buildFarmConf} ] || { echo "FATAL: generated build-farm.conf unreadable" >&2; exit 1; }

    # The load-bearing check, as a build-time-declared runtime GATE: if GNU diff
    # is not first on the build PATH, test_json_parserCheck will fail later with a
    # confusing TAP diff. Fail loudly HERE instead.
    ${optionalString cfg.gnuBinFirst ''
      if diff /etc/hosts /etc/hosts 2>/dev/null | grep -q 'No differences'; then
        echo "FATAL: illumos /usr/bin/diff is winning on PATH ($PATH)." >&2
        echo "       Install text/gnu-diffutils (IPS) so /usr/gnu/bin/diff exists." >&2
        exit 1
      fi
    ''}
    echo "pgfarm setup complete (user ${cfg.user}, buildroot ${cfg.buildRoot})"
  '';

  # run_build.pl invocation, as a store-path script. Used BOTH by the SMF service
  # and by an operator (`pgfarm-run HEAD`), so both go through the identical env +
  # config. An operator running run_build.pl by hand with a different PATH is
  # exactly how the illumos-diff bug reappears, so there is one entry point.
  runBuild = pkgs.writeScript "pgfarm-run" ''
    #!/sbin/sh
    # solnix pgfarm run_build.pl driver (generated by modules/config/pgfarm.nix).
    #   pgfarm-run [branch] [extra run_build.pl args...]
    # --test is added automatically while the animal is unregistered, so an
    # unregistered animal never posts to buildfarm.postgresql.org.
    set -u
    PATH=${buildPath}; export PATH
    GIT_CONFIG_GLOBAL=${gitConfig}; export GIT_CONFIG_GLOBAL
    HOME=${cfg.home}; export HOME
    branch="''${1:-${cfg.branch}}"
    [ $# -gt 0 ] && shift
    cd ${cfg.clientDir} || exit 1
    exec perl ./run_build.pl ${
      optionalString (cfg.animal == "CHANGEME" || cfg.secret == "CHANGEME") "--test "
    }--verbose --config=${buildFarmConf} "$@" "$branch"
  '';

  # The scheduled animal. SMF has no periodic-service model (svc.startd runs
  # contract/transient/wait), so a build farm animal — which upstream drives from
  # cron every N minutes — is expressed here as a contract daemon that sleeps and
  # re-runs. That keeps the schedule inside smf.services.* (the declared
  # mechanism) instead of adding a crontab the config does not own.
  #
  # NOTE: fixed interval, not a cron expression. If the animal ever needs
  # calendar scheduling (only build at night, skip weekends), add an SMF
  # scheduled-service manifest or a generated crontab then.
  runLoop = pkgs.writeScript "pgfarm-loop" ''
    #!/sbin/sh
    set -u
    PATH=${buildPath}; export PATH
    while :; do
      ${runBuild} ${cfg.branch} || echo "pgfarm: run_build.pl exited non-zero" >&2
      sleep ${toString cfg.intervalSeconds}
    done
  '';
in
{
  options.solnix.pgfarm = {
    enable = mkEnableOption ''
      the PostgreSQL build-farm animal + PG development host role: a non-root
      build user, a generated build-farm.conf, the GNU-diff PATH fix, and
      run_build.pl wired as an SMF service
    '';

    user = mkOption {
      type = types.str;
      default = "pgbf";
      description = ''
        Unprivileged build user. PostgreSQL's initdb and run_build.pl both REFUSE
        to run as root, so the animal cannot use root.
      '';
    };
    uid = mkOption { type = types.int; default = 1100; description = "uid of the build user."; };
    group = mkOption { type = types.str; default = "pgbf"; description = "Primary group of the build user."; };
    gid = mkOption { type = types.int; default = 1100; description = "gid of the build group."; };

    stateDir = mkOption {
      type = types.str;
      default = "/pgbf";
      description = ''
        Root of the animal's persistent state. MUST be on a large pool, not the
        root pool: the root pool on the solnix base image is a small slice, and a
        near-full root pool has separately wedged a node's loader. The pool
        itself is created imperatively (see the gaps note in this module).
      '';
    };
    home = mkOption {
      type = types.str;
      default = "${cfg.stateDir}/home/${cfg.user}";
      defaultText = "\${stateDir}/home/\${user}";
      description = "Build user's home, on the big pool so a reboot cannot lose it.";
    };
    buildRoot = mkOption {
      type = types.str;
      default = "${cfg.stateDir}/buildroot";
      defaultText = "\${stateDir}/buildroot";
      description = "buildfarm build_root. Never /tmp (tmpfs, volatile).";
    };
    clientDir = mkOption {
      type = types.str;
      default = "/opt/pgbf/client-code";
      description = "Where the PGBuildFarm client checkout lives.";
    };
    clientRepo = mkOption {
      type = types.str;
      default = "https://github.com/PGBuildFarm/client-code.git";
      description = "Upstream buildfarm client repository.";
    };

    animal = mkOption {
      type = types.str;
      default = "CHANGEME";
      description = ''
        Animal name from buildfarm.postgresql.org. Registration is a HUMAN step;
        while this is "CHANGEME" the run wrapper forces --test, so nothing is
        reported upstream.
      '';
    };
    secret = mkOption {
      type = types.str;
      default = "CHANGEME";
      description = ''
        Animal secret from buildfarm.postgresql.org. A secret in the Nix store is
        world-readable — set this from a sops-managed file rather than inline once
        the animal is registered.
      '';
    };

    branch = mkOption { type = types.str; default = "HEAD"; description = "PostgreSQL branch to build."; };
    branchesToBuild = mkOption { type = types.str; default = "ALL"; description = "run_branches.pl branch selection."; };
    makeProgram = mkOption {
      type = types.str;
      default = "gmake";
      description = "illumos /usr/bin/make is not GNU make; PostgreSQL needs gmake.";
    };
    jobs = mkOption {
      type = types.nullOr types.int;
      default = null;
      description = "make_jobs (parallel make/check). null = serial (upstream default).";
    };
    ccache = mkOption { type = types.bool; default = true; description = "Build through ccache (CC = 'ccache gcc')."; };

    configOpts = mkOption {
      type = types.listOf types.str;
      default = [
        "--enable-cassert"
        "--enable-debug"
        "--enable-tap-tests"
        "--without-icu"
      ];
      description = ''
        configure options. --without-icu because the IPS ICU is v4.6 and modern
        PostgreSQL needs >= 55; --enable-tap-tests is why IPC::Run is required.
      '';
    };
    locales = mkOption { type = types.listOf types.str; default = [ "C" ]; description = "Locales to test."; };
    basePort = mkOption { type = types.int; default = 5678; description = "Base port (branch offset applied by run_build)."; };
    modules = mkOption { type = types.listOf types.str; default = [ "TestUpgrade" ]; description = "Buildfarm client modules to load."; };
    gitGcHours = mkOption { type = types.int; default = 168; description = "Hours between git gc of the mirror."; };
    target = mkOption {
      type = types.str;
      default = "https://buildfarm.postgresql.org/cgi-bin/pgstatus.pl";
      description = "Where results are reported.";
    };
    upgradeTarget = mkOption {
      type = types.str;
      default = "https://buildfarm.postgresql.org/cgi-bin/upgrade.pl";
      description = "Where OS/compiler version changes are reported.";
    };

    gnuBinFirst = mkOption {
      type = types.bool;
      default = true;
      description = ''
        Put /usr/gnu/bin FIRST on the build PATH. LOAD-BEARING: the illumos
        /usr/bin/diff prints "No differences encountered" for identical files, so
        PostgreSQL's test_json_parser TAP test (which asserts an EMPTY diff) fails
        4 subtests and the module-test_json_parserCheck stage. Only turn this off
        if you have replaced /usr/bin/diff itself.
      '';
    };

    extraBuildEnv = mkOption {
      type = types.attrsOf types.str;
      default = { };
      description = "Extra build_env entries (seen by every build/test child).";
    };
    extraConfigEnv = mkOption {
      type = types.attrsOf types.str;
      default = { };
      description = "Extra config_env entries (seen only by configure).";
    };

    scheduled = mkOption {
      type = types.bool;
      default = false;
      description = ''
        Run the animal on a schedule via SMF. Off by default: a fresh install
        should not start hammering PostgreSQL HEAD until the operator has
        registered the animal and sized the pool.
      '';
    };
    intervalSeconds = mkOption {
      type = types.int;
      default = 3600;
      description = "Seconds between scheduled runs (SMF has no cron expression).";
    };

    # --- computed (read-only): what the acceptance test and the operator use ---
    buildFarmConf = mkOption {
      type = types.package;
      readOnly = true;
      description = "The generated build-farm.conf, as a store path.";
    };
    runBuild = mkOption {
      type = types.package;
      readOnly = true;
      description = "The run_build.pl driver script (identical env for SMF and operator).";
    };
    setup = mkOption {
      type = types.package;
      readOnly = true;
      description = "The idempotent setup script (dirs, ownership, client checkout).";
    };
  };

  config = mkIf cfg.enable {
    solnix.pgfarm.buildFarmConf = buildFarmConf;
    solnix.pgfarm.runBuild = runBuild;
    solnix.pgfarm.setup = setupScript;

    # This system's role, recorded in /etc/solnix-release so a running animal is
    # self-describing (edition = release channel; role = what it is FOR).
    solnix.roles = [ "pgfarm" ];

    users.groups.${cfg.group}.gid = cfg.gid;
    users.users.${cfg.user} = {
      inherit (cfg) uid group home;
      description = "PostgreSQL build farm animal";
      # bash, not ksh93: the buildfarm client and PG's own test scripts assume a
      # bourne-compatible interactive shell and the IPS toolchain ships bash.
      shell = "/usr/bin/bash";
      # No password: this is a service account reached with `su - <user>` from
      # root. null = "NP" (not locked, so key login would work if a key is added).
      hashedPassword = null;
    };

    # An operator's INTERACTIVE run must see the same PATH the build does, or a
    # hand-run `run_build.pl` fails test_json_parserCheck while the scheduled one
    # passes. shellInit runs after shell-environment.nix has composed PATH, so
    # prepending here wins over the base /usr/bin from /etc/profile.
    environment.shellInit = optionalString cfg.gnuBinFirst ''
      # GNU diffutils must beat illumos /usr/bin/diff (PG test_json_parser).
      case ":$PATH:" in
        ":/usr/gnu/bin:"*) : ;;
        *) PATH="/usr/gnu/bin:$PATH"; export PATH ;;
      esac
    '';

    # Setup oneshot: directories + ownership + the client checkout. Transient =
    # run-once, reaching online when the method returns 0.
    smf.services.pgfarm-setup = {
      enable = true;
      category = "site";
      description = "PostgreSQL build-farm animal setup (dirs, owner, client checkout)";
      model = "transient";
      requires = [ "svc:/system/filesystem/local:default" "svc:/milestone/network:default" ];
      dependencies = [ config.smf.networkOnline ];   # the DHCP lease and resolv.conf (solnix-net), not only network/physical
      start.exec = "${setupScript}";
      start.timeoutSeconds = 600;
      stop.exec = ":true";
      environment.PATH = buildPath;
    };

    # The animal itself. A contract daemon running the sleep/run loop (see the
    # runLoop comment: SMF has no periodic model). Disabled unless
    # solnix.pgfarm.scheduled, but the manifest is still GENERATED and
    # DTD-validated at build time, so enabling it is a config flip, not a port.
    smf.services.pgfarm = {
      enable = cfg.scheduled;
      category = "site";
      description = "PostgreSQL build-farm animal (run_build.pl, every ${toString cfg.intervalSeconds}s)";
      model = "contract";
      requires = [ "svc:/site/pgfarm-setup:default" ];
      user = cfg.user;
      group = cfg.group;
      workingDirectory = cfg.clientDir;
      start.exec = "${runLoop}";
      start.timeoutSeconds = 0; # 0 = infinite: a PG build+check run takes ~15 min
      stop.exec = ":kill";
      environment = {
        PATH = buildPath;
        HOME = cfg.home;
        GIT_CONFIG_GLOBAL = "${gitConfig}";
      };
    };
  };

  # ---------------------------------------------------------------------------
  # DOCUMENTED GAPS — things this module does NOT make declarative. Stated here
  # rather than implied, because a known gap beats a false claim.
  #
  # 1. THE IPS TOOLCHAIN IS IMPERATIVE. gcc-14, gnu-make, bison, flex, git,
  #    ccache, library/perl-5/ipc-run-542 and — critically — text/gnu-diffutils
  #    come from the OpenIndiana publisher via `pkg install`. solnix has no
  #    declarative IPS mechanism (no `ips.packages = [...]` option), and the
  #    published solnix real-derivations do not yet cover a PG-capable toolchain
  #    (gcc/perl rows exist but the animal needs the IPS perl 5.42 that
  #    ipc-run-542 was built against). The module DECLARES the PATH ordering that
  #    makes gnu-diffutils win; it cannot yet declare its installation.
  #    -> Upgrade path: an `ips.packages` option that renders a first-boot
  #       `pkg install` oneshot, or PG-toolchain real derivations in the cache.
  #
  # 2. THE BUILD POOL IS IMPERATIVE. `zpool create bfpool <disk>` +
  #    `zfs create -o mountpoint=/pgbf` + the /nix dataset. solnix has no
  #    filesystems/zpool module yet, and creating pools from a config is a
  #    destructive operation that needs a disk-selection policy first.
  #    -> Upgrade path: a `solnix.storage.pools.*` module.
  #
  # 3. THE CLIENT CHECKOUT IS FETCHED AT RUNTIME, not pinned in the store (see
  #    the setupScript comment). It is a moving upstream HEAD.
  #
  # 4. NO CALENDAR SCHEDULE. Fixed interval only (see runLoop).
  #
  # 5. animal/secret IN THE STORE ARE WORLD-READABLE. Registered animals should
  #    take the secret from a sops-managed file, not from this option.
  # ---------------------------------------------------------------------------
}
