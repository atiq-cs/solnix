{ config, lib, ... }:
# modules/config/dumpadm.nix -- the kernel crash-dump device (illumos dumpadm(8)).
#
# illumos writes a kernel crash dump to a dedicated device on panic, and
# svc:/system/dumpadm reads /etc/dumpadm.conf at boot to configure it; savecore
# copies the dump into the savecore directory on the next boot. Without a dump
# device a panic leaves no evidence. NixOS's nearest analog is boot.crashDump
# (kdump, opt-in); on illumos a dump zvol is what an installer creates by default,
# so this is the illumos default made declarative.
#
# The zvol itself (e.g. rpool/dump) lives in the pool, outside every boot
# environment, so it survives generations; create it once:
#   pfexec zfs create -V <size> <pool>/dump
# This module only makes each generation's /etc/dumpadm.conf name it, so the
# setting is part of the configuration rather than state a new BE would drop.
let
  cfg = config.solnix.dumpadm;
in
{
  options.solnix.dumpadm = {
    enable = lib.mkEnableOption "a declarative kernel crash-dump device (dumpadm)";
    device = lib.mkOption {
      type = lib.types.str;
      example = "/dev/zvol/dsk/rpool/dump";
      description = "The dump device: a dedicated zvol, e.g. /dev/zvol/dsk/rpool/dump.";
    };
    savecoreDir = lib.mkOption {
      type = lib.types.str;
      default = "/var/crash/${config.networking.hostName}";
      defaultText = lib.literalExpression ''"/var/crash/''${config.networking.hostName}"'';
      description = ''
        Where savecore writes a dump on the boot after a panic. Under /var/crash,
        which is a shared dataset on systems with the <pool>/var layout, so a dump
        survives a generation switch or rollback.
      '';
    };
    content = lib.mkOption {
      type = lib.types.enum [ "kernel" "all" "curproc" ];
      default = "kernel";
      description = "What a dump holds: kernel pages (the default), all of memory, or kernel + the panicking process.";
    };
    compress = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Save dumps compressed (vmdump.N, expanded with savecore -f).";
    };
  };

  config = lib.mkIf cfg.enable {
    # dumpadm(8) rewrites this file, so install-be keeps it a real copy
    # (etc_copy), not a link into the store.
    environment.generatedEtc."dumpadm.conf" = ''
      #
      # dumpadm.conf -- generated by solnix (modules/config/dumpadm.nix).
      # Change it in the configuration, not with dumpadm(8): a new generation
      # replaces this file.
      #
      DUMPADM_DEVICE=${cfg.device}
      DUMPADM_SAVDIR=${cfg.savecoreDir}
      DUMPADM_CONTENT=${cfg.content}
      DUMPADM_ENABLE=yes
      DUMPADM_CSAVE=${if cfg.compress then "on" else "off"}
    '';
  };
}
