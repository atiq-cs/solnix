# modules/config/nix.nix — /etc/nix/nix.conf, driven by nix.settings. The solnix
# analog of NixOS's config/nix.nix (design \u00a7B). This OWNS nix.settings (the real
# declaration moved here from the accept-and-ignore stub in nixos-compat.nix).
#
# Stage-A defaults (design \u00a7C): the cache.solnix.io substituter + key,
# sandbox=false (illumos has no Linux namespaces), single-user
# (build-users-group=""), max-jobs=auto. Also puts nix.package in
# environment.systemPackages so nix ships on the image.

{ config, lib, pkgs, ... }:

let
  inherit (lib) mkOption types mkIf concatStringsSep mapAttrsToList;

  cfg = config.nix;

  # render one nix.conf value: a list -> space-separated (nix.conf list syntax),
  # a bool -> true/false, anything else -> toString. Copied from the nix.conf
  # key = value semantics NixOS's pkgs.formats.nixConf produces (space-joined
  # lists, lowercase bools), minus the formats machinery (unavailable on the host).
  mkValueString =
    v:
    if v == true then "true"
    else if v == false then "false"
    else if lib.isList v then concatStringsSep " " (map toString v)
    else toString v;

  # extra-<key> lines go after every plain key: nix applies nix.conf top to bottom, so a plain `substituters`
  # line after `extra-substituters` (mapAttrsToList sorts by name) silently drops the extras (measured with
  # nix 2.24 on dixi, 2026-10-29). NixOS's nixConf renders the extra- keys last for the same reason.
  mkKeyValuePairs =
    attrs:
    let isExtra = k: lib.hasPrefix "extra-" k; line = k: "${k} = ${mkValueString attrs.${k}}";
        ks = lib.attrNames attrs; in
    concatStringsSep "\n" (map line (lib.filter (k: !isExtra k) ks ++ lib.filter isExtra ks));

  nixConfText = ''
    # /etc/nix/nix.conf \u2014 generated by modules/config/nix.nix. Do not edit.
    ${mkKeyValuePairs cfg.settings}
    ${cfg.extraOptions}
  '';
in
{
  options.nix = {
    enable = mkOption {
      type = types.bool;
      default = true;
      description = "Whether to enable Nix on the image (ship nix.package + /etc/nix/nix.conf).";
    };

    package = mkOption {
      type = types.package;
      default = pkgs.solnix.nixSrc;
      defaultText = lib.literalExpression "pkgs.solnix.nixSrc";
      description = "The Nix that ships on the image: 2.24.15 built from source with its whole dependency chain (pkgs/illumos/nix-src.nix).";
    };

    # nix.settings: the freeform /etc/nix/nix.conf attrs. Real declaration lives
    # HERE now (removed from the nixos-compat.nix stub). attrsOf a config-atom so
    # each value goes through option resolution — mkDefault on a value (below) is
    # unwrapped, and base.nix's plain assignments merge/override cleanly (a bare
    # `types.attrs` freeform would leave mkDefault wrappers unresolved).
    settings = mkOption {
      type = types.attrsOf (types.oneOf [
        types.bool
        types.int
        types.str
        (types.listOf (types.oneOf [ types.bool types.int types.str ]))
      ]);
      default = { };
      description = "Freeform /etc/nix/nix.conf settings (substituters, keys, sandbox, ...).";
    };

    extraOptions = mkOption {
      type = types.lines;
      default = "";
      description = "Extra text appended verbatim to /etc/nix/nix.conf.";
    };
  };

  # internal: the generated /etc/nix/nix.conf carrier the activation module folds in.
  options.nix.generatedEtc = mkOption {
    type = types.attrsOf types.str;
    internal = true;
    default = { };
    description = "nix-derived /etc files (nix/nix.conf). Read by activation.";
  };

  config = mkIf cfg.enable {
    # Stage-A defaults (design \u00a7C). A config's own nix.settings.* merge over these
    # (freeform attrset merge); base.nix already sets substituters + keys.
    nix.settings = {
      substituters = lib.mkDefault [ "https://cache.solnix.io" "https://cache.nixos.org" ];
      # ONLY the cache.solnix.io-1 signing key (plus nixos.org's). The earlier
      # 5HAV key is retired: nothing this system needs is signed by it.
      trusted-public-keys = lib.mkDefault [
        "cache.solnix.io-1:8UNrVAOSOrI9PGHc8/pD2Yqp265ZeYb3OId+gv4+wm8="
        "cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY="
      ];
      # illumos ships per-CA PEMs and no bundle; nix gets the Mozilla bundle.
      ssl-cert-file = lib.mkDefault "${pkgs.solnix.nixChain.cacert}/etc/ssl/certs/ca-bundle.crt";
      sandbox = lib.mkDefault false;         # illumos has no Linux namespaces.
      # NixOS default: multi-user, builds run as nixbld* through nix-daemon.
      build-users-group = lib.mkDefault "nixbld";
      builders = lib.mkDefault "";
      max-jobs = lib.mkDefault "auto";
      cores = lib.mkDefault 0;               # use all cores per build (NixOS default).
      # flakes + the new CLI on by default (Nix 2.24). Matches the maintainer's floki.
      # fetch-closure is REQUIRED: starter.nix / pkgs/illumos/default.nix wire the
      # starter set via builtins.fetchClosure, which is gated behind it;
      # without it a --flake eval FATALs "attribute 'fetchClosure' missing".
      experimental-features = lib.mkDefault "nix-command flakes";
      require-sigs = lib.mkDefault true;     # verify cache signatures (5HAV).
      # keep build inputs/outputs so `nix develop`/gc-roots behave like NixOS.
      keep-outputs = lib.mkDefault true;
      keep-derivations = lib.mkDefault true;
      warn-dirty = lib.mkDefault false;
      download-buffer-size = lib.mkDefault 524288000;
      # allow all users to use the daemon-less store; trust root (the admin user
      # gets trust via its RBAC Primary Administrator profile / group, not a
      # hardcoded name here — the default image must not bake a specific username).
      allowed-users = lib.mkDefault "*";
      trusted-users = lib.mkDefault [ "root" ];
    };

    nix.generatedEtc."nix/nix.conf" = nixConfText;

    # ship nix on the image.
    environment.systemPackages = [ cfg.package ];

    # NixOS: nixbld group (gid 30000) + nixbld1..32 (uid 30001..), and
    # nix-daemon as a system service. trusted-users=root, allowed-users=*.
    users.groups.nixbld.gid = 30000;
    users.users = lib.listToAttrs (map (n: {
      name = "nixbld${toString n}";
      value = {
        uid = 30000 + n; group = "nixbld"; extraGroups = [ "nixbld" ];
        description = "Nix build user ${toString n}"; home = "/var/empty";
        shell = "/bin/false"; hashedPassword = null;
      };
    }) (lib.range 1 32));
    smf.services.nix-daemon = {
      enable = true;
      category = "system";
      description = "Nix daemon";
      model = "contract";
      requires = [ "svc:/system/filesystem/local:default" ];
      start.exec = "${cfg.package}/bin/nix-daemon --daemon &";
      stop.exec = ":kill";
      # A build that dumps core or dies on a signal is in the daemon's process contract; without this, svc.startd treats it as
      # the service failing and kills the whole contract, every in-flight build with it (dixi 2026-11-02: one nodejs build's
      # ld core restarted the daemon and killed 8 builds). NixOS's nix-daemon.service has KillMode=process for the same reason.
      ignoreError = [ "core" "signal" ];
    };
  };
}
