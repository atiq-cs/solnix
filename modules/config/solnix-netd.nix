# networking.solnix-netd -- the analog of NixOS's default dhcpcd (+ wpa_supplicant re-association on a laptop):
# one long-running SMF service (contract model; svc.startd respawns it) that follows links as they come and go.
# What it does, and why each piece is needed on illumos, is in ./solnix-netd.sh. In short:
#   - DHCP on every managed link that is up (networking.useDHCP: every Ethernet link the config does not name;
#     networking.interfaces.<n>.dhcp: that link), so a USB NIC that re-enumerates as usbecmN on another port works;
#   - wired preferred: dhcpagent ignores the router option on wireless leases (PARAM_IGNORE_LIST=3 below) and the
#     daemon installs the wireless default only while no wired default exists. dhcpcd uses metrics for this; illumos
#     has none and round-robins equal default routes (ire_round_robin), which is what lost 68% on lixi;
#   - wifi kept associated: the wifi modules' join script (mkWifiJoinScript), retried with backoff;
#   - a wired link whose gateway stops answering loses its default route until the gateway answers again;
#   - IPv4 hostmodel strong, so a reply leaves by the link that owns its source address.
# It replaces solnix-net's DHCP part (static addresses stay there) and the one-shot solnix-wifi-join services.
# It does not do the EC2 ena ifconfig fallback (gotcha #15), so it is off by default where neither useDHCP nor wifi
# networks are set (EC2 names ena0).
{ config, lib, pkgs, ... }:

let
  cfg = config.networking.solnix-netd;
  net = config.networking;
  named = b: lib.attrNames (lib.filterAttrs (_: i: i.dhcp == b) net.interfaces);
  wifiLinks = lib.attrNames cfg.wifiJoin;
in
{
  options.networking.solnix-netd = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = net.useDHCP || cfg.wifiJoin != { };
      defaultText = lib.literalExpression "networking.useDHCP || <wifi networks configured>";
      description = ''
        Run solnix-netd: DHCP on links as they appear, wired preferred over wifi, wifi kept associated, and a
        gateway probe that demotes a wired default route whose gateway stops answering (NixOS: dhcpcd).
      '';
    };
    holdDir = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = null;
      internal = true;
      description = "A dir where <link>.down tells the daemon to leave that wifi link disconnected (set by services.solnix-nm).";
    };
    wifiJoin = lib.mkOption {
      type = lib.types.attrsOf lib.types.path;
      default = { };
      internal = true;
      description = "Wifi link -> its join script (set by hardware.wirelessIwx/Iwm.networks).";
    };
  };

  config = lib.mkIf cfg.enable {
    smf.services.solnix-netd = {
      enable = true;
      category = "site";
      description = "solnix network daemon (DHCP on hotplugged links, wired preferred, wifi kept up)";
      model = "contract";
      requires = [ "svc:/network/physical:default" ];
      environment = {
        NETD_WIFI = lib.concatStringsSep " " (lib.mapAttrsToList (l: s: "${l}=${s}") cfg.wifiJoin);
        NETD_DHCP_ALL = if net.useDHCP then "1" else "0";
        NETD_DHCP_LINKS = lib.concatStringsSep " " (named true);
        # named without dhcp: off, or static (solnix-net's)
        NETD_SKIP_LINKS = lib.concatStringsSep " " (named false);
        NETD_RESOLV = if net.nameservers == [ ] then "1" else "0";
        NETD_ONLINE = "/var/run/solnix-netd.online";   # tmpfs: gone at boot
      } // lib.optionalAttrs (cfg.holdDir != null) { NETD_HOLD_DIR = cfg.holdDir; };
      # The method returns once the daemon has the network (an address and the default route) or after 60 s; the daemon
      # stays in the service's contract, its output in the SMF log. So the service goes online with the network, which
      # is what smf.networkOnline waits for: NixOS's dhcpcd, wait = "any" (fork after an address, or on its timeout).
      # 60 s, not dhcpcd's 30: netd associates wifi in the same window; lixi took 12, 17, 12 and 31 s (2026-11-10/11).
      start.exec = ''
        rm -f "$NETD_ONLINE"
        /usr/bin/ksh93 ${./solnix-netd.sh} &
        p=$! i=0
        while [ ! -e "$NETD_ONLINE" ] && [ $i -lt 60 ] && kill -0 $p 2>/dev/null; do sleep 1; i=$((i + 1)); done
        [ -e "$NETD_ONLINE" ] || echo "solnix-netd: not online after $i s; the service goes online without it"
      '';
      start.timeoutSeconds = 90;
      stop.exec = ":kill";
    };

    # dhcpagent(8) reads this per link: no router option from a wireless lease (the daemon owns that route).
    # Replaces the stock file, whose only settings are the four lines kept here.
    environment.generatedEtc."default/dhcpagent" = lib.mkIf (wifiLinks != [ ]) ''
      # generated by modules/config/solnix-netd.nix; see dhcpagent(8) for the parameters
      PARAM_REQUEST_LIST=1,3,6,12,15,26,28,43
      .v6.PARAM_REQUEST_LIST=7,12,23,24,27,29
      PARAM_IGNORE_LIST=
      .v6.PARAM_IGNORE_LIST=
      ${lib.concatMapStrings (l: "${l}.PARAM_IGNORE_LIST=3\n") wifiLinks}'';
  };
}
