# lib/make-be.nix — nixify the proven oi-make-be.sh image recipe.
#
# T2.6. Consumes a T2.8 system.build.toplevel and produces a store-resident
# ASSEMBLY SCRIPT (a derivation) that, run as root on the illumos host, lays the
# toplevel closure into a bootable ZFS-root BE + ESP + loader + boot_archive.
#
# WHY a script-emitting derivation, not a pure image derivation (the boundary,
# documented per the task): the image build needs root + live ZFS (zpool/zfs
# create, mkfs pcfs, bootadm, installboot, mount) — none of which run inside a
# Nix build sandbox. So the REPRODUCIBLE part (which toplevel/proto/manifests to
# lay down, encoded from the config) is a store path; the PRIVILEGED part (touch
# real disks) runs on the host from that script. This mirrors how NixOS's
# make-disk-image ultimately shells out to privileged tooling, and keeps the
# 16 boot gotchas + the pit_is_broken fix (all proven in oi-make-be.sh) intact.
#
# What make-be adds to the proto root (add-not-replace, design-smf-init §5):
#   - the toplevel's generated SMF manifests -> /lib/svc/manifest/solnix
#   - the toplevel's site profile           -> /etc/svc/profile/site/solnix.xml
#   - the toplevel's activate script (available at /lib/svc/method for switch)
#   - the toplevel closure copied into the store ON the BE (self-contained /nix)
#   - every gotcha fix from oi-make-be.sh (driver files, /dev symlinks, dir perms,
#     external libs, OpenSSH, cryptosvc race, ttya console, ...)
#     Networking (DHCP/static) + users/authorized_keys are NOW config-generated
#     (T2.9): the toplevel ships site/solnix-net + /etc/{passwd,shadow,group,
#     resolv.conf} + seed-authorized-keys, so make-be stages those instead of
#     hand-writing a netcfg method / copying ROOT_AUTHKEY.
#   - the NON-DEBUG kernel with pit_is_broken=1 (NDPROTO), for 100% boot.

{ pkgs
, toplevel                 # the T2.8 system.build.toplevel store path
, disk ? "c1t1d0"          # scratch whole-disk (NOT the rpool)
, pool ? "spool"
, be ? "solnix-1"
, protoGlob ? "/nix/store/*illumos-gate-proto"  # BE root = the gate proto
, ndProto ? "/code/illumos-gate/proto/root_i386" # non-DEBUG kernel (pit fix)
}:

let
  # The toplevel provides the solnix-owned overlay. Read them at build time so
  # the emitted script references them by store path (immutable, closure-tracked).
  siteProfile = "${toplevel}/site-profile.xml";
  manifestsDir = "${toplevel}/manifest/solnix";
  activate = "${toplevel}/activate";
  systemPath = "${toplevel}/systemPath";
  seedAuthKeys = "${toplevel}/seed-authorized-keys";

  # The assembly script: oi-make-be.sh's proven flow, with the hand-written site
  # profile + solnix manifests REPLACED by the toplevel's config-generated ones,
  # and the toplevel closure copied onto the BE so /nix/store is self-contained.
  makeBe = pkgs.writeScript "solnix-make-be" ''
    #!/usr/bin/env bash
    # solnix-make-be — assemble a bootable ZFS-root solnix BE from a T2.8 toplevel.
    # RUN AS ROOT on the illumos build host, after attaching a scratch disk.
    # Generated by lib/make-be.nix; encodes docs/design-make-be.md (16 gotchas).
    set -euo pipefail
    export PATH=/usr/sbin:/usr/bin:/usr/gnu/bin:/sbin:/nix-tools/bin

    DISK="''${DISK:-${disk}}"
    POOL="''${POOL:-${pool}}"
    BE="''${BE:-${be}}"
    BEDS="$POOL/ROOT/$BE"
    ALTROOT="''${ALTROOT:-/a}"
    PROTO="''${PROTO:-$(ls -d ${protoGlob} | head -1)}"
    NDPROTO="''${NDPROTO:-${ndProto}}"
    GCP=/usr/gnu/bin/cp

    # solnix toplevel-provided artifacts (store paths, closure-tracked):
    TOPLEVEL="${toplevel}"
    SITE_PROFILE="${siteProfile}"
    SMF_MANIFESTS="${manifestsDir}"
    ACTIVATE="${activate}"
    SYSTEMPATH="${systemPath}"
    SEED_AUTHKEYS="${seedAuthKeys}"  # T2.9: users.users.*.openssh.authorizedKeys seed

    die()  { echo "FATAL: $*" >&2; exit 1; }
    log()  { printf '\n=== %s ===\n' "$*" >&2; }

    [ "$(id -u)" = 0 ] || die "run as root"
    [ -n "$PROTO" ] && [ -d "$PROTO" ] || die "gate proto not found ($PROTO)"
    [ "$DISK" != "c2t1d0" ] || die "refusing to use the rpool disk c2t1d0"
    [ -e "/dev/rdsk/''${DISK}s0" ] || die "scratch disk $DISK not present (attach EBS + reboot)"
    log "toplevel = $TOPLEVEL"
    log "proto    = $PROTO ($(du -sh "$PROTO" | awk '{print $1}'))"

    # 0. tear down any prior attempt
    log "cleaning prior $POOL / $ALTROOT"
    umount "$ALTROOT/esp" 2>/dev/null || true
    zfs unmount "$BEDS" 2>/dev/null || true
    zpool destroy "$POOL" 2>/dev/null || true
    zpool export "$POOL" 2>/dev/null || true
    rm -rf "$ALTROOT" 2>/dev/null || true
    mkdir -p "$ALTROOT"

    # 1. GPT label (throwaway pool -> clean EFI label -> fmthard 3-part spec)
    log "GPT-labelling $DISK"
    zpool create -f solnixtmp "/dev/dsk/''${DISK}" >/dev/null 2>&1 || die "clean EFI label failed"
    zpool destroy solnixtmp 2>/dev/null || true
    ACCESS="$(prtvtoc "/dev/rdsk/''${DISK}" 2>/dev/null | awk '/accessible sectors/{print $2}')"
    RESV_START="$(prtvtoc -h "/dev/rdsk/''${DISK}" 2>/dev/null | awk '$1==8{print $4}')"
    RESV_SIZE="$(prtvtoc -h "/dev/rdsk/''${DISK}" 2>/dev/null | awk '$1==8{print $5}')"
    ESP_START=256; ESP_SIZE=524288
    POOL_START=$((ESP_START + ESP_SIZE)); POOL_SIZE=$((RESV_START - POOL_START))
    [ "$POOL_SIZE" -gt 0 ] || die "computed pool size <= 0"
    cat > /tmp/solnix.vtoc <<EOF
    0 12 00 ''${ESP_START} ''${ESP_SIZE}
    1 4 00 ''${POOL_START} ''${POOL_SIZE}
    8 11 00 ''${RESV_START} ''${RESV_SIZE}
    EOF
    fmthard -s /tmp/solnix.vtoc "/dev/rdsk/''${DISK}" 2>&1 || die "fmthard failed"

    # 2. ESP FAT32
    log "mkfs pcfs ESP on ''${DISK}s0"
    yes | mkfs -F pcfs -o fat=32,b=ESP "/dev/rdsk/''${DISK}s0" >/dev/null 2>&1 || true

    # 3. pool + BE dataset
    log "creating pool $POOL on ''${DISK}s1"
    zpool create -f -o altroot="$ALTROOT" -o cachefile=none \
      -O compression=on -O atime=off -m none "$POOL" "/dev/dsk/''${DISK}s1"
    zfs create -o canmount=off -o mountpoint=legacy "$POOL/ROOT"
    zfs create -o canmount=noauto -o mountpoint=/ "$BEDS"
    zfs mount "$BEDS"
    BEROOT="$ALTROOT"
    [ -d "$BEROOT/." ] || die "BE root not mounted at $BEROOT"

    # 4. lay down the gate proto as the BE root (the internally-consistent world)
    log "copying proto -> BE root"
    ( cd "$PROTO" && tar -cf - . ) | ( cd "$BEROOT" && tar -xf - )
    for d in proc dev devices system/contract system/object system/volatile \
             etc/svc/volatile var/run var/tmp mnt export export/home root nix; do
      mkdir -p "$BEROOT/$d"
    done

    # 4a. swap in the NON-DEBUG kernel (pit_is_broken=1 -> 100% boot; gotcha #4/#5/#10)
    if [ -n "$NDPROTO" ] && [ -d "$NDPROTO" ] && \
       ! strings "$NDPROTO/platform/i86pc/kernel/amd64/unix" 2>/dev/null | grep -qi 'DEBUG enabled'; then
      log "swapping NON-DEBUG kernel trees from $NDPROTO"
      for tree in platform/i86pc/kernel platform/i86hvm/kernel platform/i86xpv/kernel kernel usr/kernel; do
        [ -d "$NDPROTO/$tree" ] && ( cd "$NDPROTO" && tar -cf - "$tree" ) | ( cd "$BEROOT" && tar -xf - )
      done
    fi

    # 4b. dir perms (gotcha #7): proto ships 0555 dirs
    log "restoring directory write permissions"
    find "$BEROOT" -type d -exec chmod u+w {} + 2>/dev/null || true
    chmod 1777 "$BEROOT/tmp" "$BEROOT/var/tmp" "$BEROOT/system/volatile" 2>/dev/null || true

    # 4c. /dev symlinks (gotcha #6)
    log "seeding essential /dev symlinks"
    for n in console msglog null zero tty syscon systty sysmsg random urandom poll; do
      [ -L "/dev/$n" ] && ln -sf "$(/usr/bin/readlink /dev/$n)" "$BEROOT/dev/$n" 2>/dev/null || true
    done

    # 4d. SMF profile symlinks (gotcha #8)
    log "creating SMF profile symlinks"
    ( cd "$BEROOT/etc/svc/profile" && \
      ln -sf generic_limited_net.xml generic.xml && \
      ln -sf platform_none.xml platform.xml && \
      ln -sf ns_dns.xml name_service.xml ) 2>/dev/null || true

    # 4e. users/groups: preserve the stock proto accounts (gotcha #9 — the SMF
    #     stack + sshd privsep need them), then MERGE the config-generated
    #     declared users/groups from the toplevel's /etc overlay (T2.9: users
    #     module). Proto accounts stay; module-declared users (greg, ...) are
    #     appended if not already present. This makes accounts declarative
    #     (users.users.<name>) instead of "copy the host's whole passwd".
    log "merging stock proto accounts + config-generated users (T2.9)"
    # stock accounts the proto lacks but the host has (privsep etc.) — unchanged.
    for u in $(comm -23 <(cut -d: -f1 /etc/passwd | sort) <(cut -d: -f1 "$BEROOT/etc/passwd" | sort) 2>/dev/null); do
      grep "^$u:" /etc/passwd >> "$BEROOT/etc/passwd" 2>/dev/null || true
      grep "^$u:" /etc/shadow >> "$BEROOT/etc/shadow" 2>/dev/null || true
    done
    for g in $(comm -23 <(cut -d: -f1 /etc/group | sort) <(cut -d: -f1 "$BEROOT/etc/group" | sort) 2>/dev/null); do
      grep "^$g:" /etc/group >> "$BEROOT/etc/group" 2>/dev/null || true
    done
    # config-generated declared users from the users module (T2.9). Append any
    # not already in the proto/host set; module lines take precedence for the
    # accounts it owns (e.g. root's shell) via the passwd rewrite in step 9.
    if [ -f "$TOPLEVEL/etc/passwd" ]; then
      while IFS=: read -r un rest; do
        [ -n "$un" ] || continue
        grep -q "^$un:" "$BEROOT/etc/passwd" 2>/dev/null || echo "$un:$rest" >> "$BEROOT/etc/passwd"
      done < "$TOPLEVEL/etc/passwd"
    fi
    if [ -f "$TOPLEVEL/etc/shadow" ]; then
      while IFS=: read -r un rest; do
        [ -n "$un" ] || continue
        grep -q "^$un:" "$BEROOT/etc/shadow" 2>/dev/null || echo "$un:$rest" >> "$BEROOT/etc/shadow"
      done < "$TOPLEVEL/etc/shadow"
    fi
    if [ -f "$TOPLEVEL/etc/group" ]; then
      while IFS=: read -r gn rest; do
        [ -n "$gn" ] || continue
        grep -q "^$gn:" "$BEROOT/etc/group" 2>/dev/null || echo "$gn:$rest" >> "$BEROOT/etc/group"
      done < "$TOPLEVEL/etc/group"
    fi
    chmod 1777 "$BEROOT/tmp"

    # 5. /etc essentials + driver files (gotcha #3) + ttya console
    log "/etc essentials + ttya console + driver-config files"
    for f in name_to_major driver_aliases driver_classes minor_perm; do
      $GCP "/etc/$f" "$BEROOT/etc/$f" 2>/dev/null || true
    done
    $GCP /etc/security/device_policy "$BEROOT/etc/security/device_policy" 2>/dev/null || true
    cat > "$BEROOT/etc/vfstab" <<'EOF'
    /devices	-	/devices	devfs	-	no	-
    /proc	-	/proc	proc	-	no	-
    ctfs	-	/system/contract ctfs	-	no	-
    objfs	-	/system/object	objfs	-	no	-
    sharefs	-	/etc/dfs/sharetab	sharefs	-	no	-
    fd	-	/dev/fd		fd	-	no	-
    swap	-	/tmp		tmpfs	-	yes	-
    EOF
    [ -f "$BEROOT/etc/hostid" ] || printf '0x1b0b57ec\n' > "$BEROOT/etc/hostid"
    # hostname + resolv.conf + defaultrouter from the toplevel's /etc overlay
    # (T2.9: generated from networking.hostName / .nameservers / .defaultGateway).
    [ -f "$TOPLEVEL/etc/nodename" ] && $GCP "$TOPLEVEL/etc/nodename" "$BEROOT/etc/nodename" 2>/dev/null || true
    [ -f "$TOPLEVEL/etc/resolv.conf" ] && $GCP "$TOPLEVEL/etc/resolv.conf" "$BEROOT/etc/resolv.conf" 2>/dev/null || true
    [ -f "$TOPLEVEL/etc/defaultrouter" ] && $GCP "$TOPLEVEL/etc/defaultrouter" "$BEROOT/etc/defaultrouter" 2>/dev/null || true
    mkdir -p "$BEROOT/boot/solaris"
    cat > "$BEROOT/boot/solaris/bootenv.rc" <<'EOF'
    setprop console ttya
    setprop os_console ttya
    setprop ttya-mode 115200,8,n,1,-
    setprop ttya-ignore-cd true
    setprop ttya-rts-dtr-off false
    EOF
    cat > "$BEROOT/boot/loader.conf" <<'EOF'
    console="ttya"
    os_console="ttya"
    boot-args="-v"
    loader_logo="illumos"
    EOF

    # 6. external libs the SMF stack needs (gotcha: not in proto)
    log "adding external libs (libxml2/icu/zlib/libstdc++/libgcc_s)"
    add_extlibs() { local sd=$1 dd=$2
      for l in "$sd/libxml2.so.16" "$sd/libz.so.1" "$sd/libicuuc.so.78" "$sd/libicudata.so.78"; do
        [ -e "$l" ] && $GCP -L "$l" "$dd/$(basename "$l")"
      done; }
    add_extlibs /usr/lib       "$BEROOT/usr/lib"
    add_extlibs /usr/lib/amd64 "$BEROOT/usr/lib/amd64"
    $GCP -L /usr/gcc/14/lib/libstdc++.so.6        "$BEROOT/usr/lib/libstdc++.so.6"
    $GCP -L /usr/gcc/14/lib/libgcc_s.so.1         "$BEROOT/usr/lib/libgcc_s.so.1"
    $GCP -L /usr/gcc/14/lib/amd64/libstdc++.so.6  "$BEROOT/usr/lib/amd64/libstdc++.so.6"
    $GCP -L /usr/gcc/14/lib/amd64/libgcc_s.so.1   "$BEROOT/usr/lib/amd64/libgcc_s.so.1"

    # 6b. modern OpenSSH for login (gotchas #12-#15)
    log "adding modern OpenSSH (manifest+method+binaries+libs)"
    $GCP /usr/sbin/sshd "$BEROOT/usr/sbin/sshd" 2>/dev/null || true
    $GCP /usr/bin/ssh-keygen "$BEROOT/usr/bin/ssh-keygen" 2>/dev/null || true
    $GCP /usr/bin/ssh "$BEROOT/usr/bin/ssh" 2>/dev/null || true
    mkdir -p "$BEROOT/usr/libexec"
    for h in sshd-session sshd-auth sftp-server ssh-keysign ssh-pkcs11-helper ssh-sk-helper; do
      [ -e "/usr/libexec/$h" ] && $GCP /usr/libexec/$h "$BEROOT/usr/libexec/$h" 2>/dev/null || true
    done
    $GCP /lib/svc/manifest/network/ssh.xml "$BEROOT/lib/svc/manifest/network/ssh.xml" 2>/dev/null || true
    $GCP /lib/svc/method/sshd "$BEROOT/lib/svc/method/sshd" 2>/dev/null || true
    chmod 0444 "$BEROOT/lib/svc/manifest/network/ssh.xml" 2>/dev/null || true
    chmod 0555 "$BEROOT/lib/svc/method/sshd" 2>/dev/null || true
    for l in libcrypto.so.3 libssl.so.3; do
      s=$(ls /usr/lib/amd64/$l 2>/dev/null || ls /lib/amd64/$l 2>/dev/null)
      [ -n "$s" ] && $GCP -L "$s" "$BEROOT/usr/lib/amd64/$l" 2>/dev/null || true
    done
    if [ -f /etc/ssh/sshd_config ]; then
      mkdir -p "$BEROOT/etc/ssh"
      $GCP /etc/ssh/sshd_config "$BEROOT/etc/ssh/sshd_config"
      sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/; s/^#*PubkeyAuthentication.*/PubkeyAuthentication yes/' "$BEROOT/etc/ssh/sshd_config" 2>/dev/null || true
      for t in rsa ecdsa ed25519; do
        [ -f "$BEROOT/etc/ssh/ssh_host_''${t}_key" ] || /usr/bin/ssh-keygen -q -t $t -f "$BEROOT/etc/ssh/ssh_host_''${t}_key" -N "" 2>/dev/null || true
      done
    fi
    mkdir -p "$BEROOT/var/empty"; chown root:sys "$BEROOT/var/empty" 2>/dev/null || true; chmod 0755 "$BEROOT/var/empty"
    # authorized_keys: DECLARATIVE via the users module (T2.9). Run the toplevel's
    # generated seed script against the BE root; it writes each declared user's
    # ~/.ssh/authorized_keys from users.users.<name>.openssh.authorizedKeys.keys.
    # (Replaces the ad-hoc ROOT_AUTHKEY copy; ROOT_AUTHKEY still honoured as a
    # fallback for a config that declares no keys.)
    if [ -f "$SEED_AUTHKEYS" ]; then
      log "seeding authorized_keys from users module (T2.9)"
      ROOT="$BEROOT" /usr/bin/bash "$SEED_AUTHKEYS" || echo "NOTE: authorized_keys seed had non-fatal errors"
    elif [ -n "''${ROOT_AUTHKEY:-}" ] && [ -f "''${ROOT_AUTHKEY}" ]; then
      mkdir -p "$BEROOT/root/.ssh"; chmod 700 "$BEROOT/root/.ssh"
      $GCP "$ROOT_AUTHKEY" "$BEROOT/root/.ssh/authorized_keys"; chmod 600 "$BEROOT/root/.ssh/authorized_keys"
    fi

    # 7. seed SMF repository
    log "seeding SMF repository from seed/global.db"
    mkdir -p "$BEROOT/etc/svc"
    $GCP "$BEROOT/lib/svc/seed/global.db" "$BEROOT/etc/svc/repository.db"
    chmod 0600 "$BEROOT/etc/svc/repository.db"

    # 8. THE NIXIFICATION: copy the toplevel closure into the BE's /nix/store,
    #    install the config-generated SMF manifests + site profile + activate.
    log "copying toplevel closure into BE /nix/store"
    mkdir -p "$BEROOT/nix/store"
    for p in $(nix-store -qR "$TOPLEVEL"); do
      [ -e "$BEROOT$p" ] || $GCP -a "$p" "$BEROOT$(dirname "$p")/" 2>/dev/null || \
        ( mkdir -p "$BEROOT$(dirname "$p")" && $GCP -a "$p" "$BEROOT$(dirname "$p")/" )
    done
    rm -f "$BEROOT/run-current-system" 2>/dev/null || true
    ln -s "$TOPLEVEL" "$BEROOT/run-current-system" 2>/dev/null || true

    # 8a. generation registry + switch tools on PATH (T2.5). Register this
    #     toplevel as generation 1, and symlink the switch-to-configuration +
    #     solnix-rebuild tools into /usr/bin so an admin can `solnix-rebuild ...`.
    log "registering generation 1 + installing switch tools"
    mkdir -p "$BEROOT/nix/var/nix/profiles"
    # illumos `ln -sfn` follows an existing symlink-to-dir; rm -f first to be safe.
    rm -f "$BEROOT/nix/var/nix/profiles/system-1-link" "$BEROOT/nix/var/nix/profiles/system"
    ln -s "$TOPLEVEL" "$BEROOT/nix/var/nix/profiles/system-1-link"
    ln -s system-1-link "$BEROOT/nix/var/nix/profiles/system"
    printf '1\n' > "$BEROOT/nix/var/nix/profiles/system.gen"
    if [ -e "$TOPLEVEL/bin/switch-to-configuration" ]; then
      rm -f "$BEROOT/usr/bin/switch-to-configuration" "$BEROOT/usr/bin/solnix-rebuild" "$BEROOT/usr/bin/solnix-install"
      ln -s "$TOPLEVEL/bin/switch-to-configuration" "$BEROOT/usr/bin/switch-to-configuration"
      ln -s "$TOPLEVEL/bin/solnix-rebuild"          "$BEROOT/usr/bin/solnix-rebuild"
      [ -e "$TOPLEVEL/bin/solnix-install" ] && ln -s "$TOPLEVEL/bin/solnix-install" "$BEROOT/usr/bin/solnix-install"
    fi

    log "installing solnix-generated SMF manifests + site profile (add-not-replace)"
    mkdir -p "$BEROOT/lib/svc/manifest/solnix" "$BEROOT/lib/svc/method" "$BEROOT/etc/svc/profile/site"
    if [ -d "$SMF_MANIFESTS" ]; then
      cp "$SMF_MANIFESTS"/*.xml "$BEROOT/lib/svc/manifest/solnix/" 2>/dev/null || true
    fi
    [ -e "$SITE_PROFILE" ] && $GCP -L "$SITE_PROFILE" "$BEROOT/etc/svc/profile/site/solnix.xml"
    [ -e "$ACTIVATE" ] && { $GCP -L "$ACTIVATE" "$BEROOT/lib/svc/method/solnix-activate"; chmod 0555 "$BEROOT/lib/svc/method/solnix-activate"; }

    # 8b. the solnix-hello oneshot (boot evidence). Kept verbatim: pure
    #     boot-plumbing, not config. The DHCP/networking oneshot is NO LONGER
    #     hand-written here — it is the config-generated `site/solnix-net`
    #     service (T2.9, from networking.interfaces.*), staged above via
    #     `cp "$SMF_MANIFESTS"/*.xml`, whose method script is an absolute
    #     /nix/store path copied into the BE with the toplevel closure.
    cat > "$BEROOT/lib/svc/manifest/solnix/solnix-hello.xml" <<'EOF'
    <?xml version="1.0"?>
    <!DOCTYPE service_bundle SYSTEM "/usr/share/lib/xml/dtd/service_bundle.dtd.1">
    <service_bundle type="manifest" name="solnix:hello">
      <service name="site/solnix-hello" type="service" version="1">
        <single_instance/>
        <dependency name="fs" grouping="require_all" restart_on="none" type="service">
          <service_fmri value="svc:/system/filesystem/local:default"/>
        </dependency>
        <exec_method type="method" name="start" exec="/lib/svc/method/solnix-hello" timeout_seconds="120">
          <method_context><method_credential user="root"/></method_context>
        </exec_method>
        <exec_method type="method" name="stop" exec=":true" timeout_seconds="60">
          <method_context><method_credential user="root"/></method_context>
        </exec_method>
        <property_group name="startd" type="framework">
          <propval name="duration" type="astring" value="transient"/>
        </property_group>
        <instance name="default" enabled="true"/>
        <template><common_name><loctext xml:lang="C">solnix gate marker</loctext></common_name></template>
      </service>
    </service_bundle>
    EOF
    cat > "$BEROOT/lib/svc/method/solnix-hello" <<'EOF'
    #!/sbin/sh
    . /lib/svc/share/smf_include.sh
    ( sleep 45
      {
        echo ""; echo "########## SOLNIX GATE EVIDENCE ##########"
        echo "## uname -a:"; /usr/bin/uname -a
        echo "## solnix-release:"; cat /etc/solnix-release 2>/dev/null
        echo "## milestone:"; /usr/bin/svcs -H milestone/multi-user-server 2>&1
        echo "## svcs -x:"; /usr/bin/svcs -x 2>&1
        echo "## online count:"; /usr/bin/svcs -a 2>/dev/null | grep -c online
        echo "## crypto/ssh:"; /usr/bin/svcs -H system/cryptosvc network/ssh 2>&1
        echo "## ip:"; /usr/sbin/ipadm show-addr 2>&1; /usr/bin/netstat -rn 2>&1 | grep -E 'default|172|10\.' | head -3
        echo "## solnix toplevel:"; ls -l /run-current-system 2>&1
        echo "########## END SOLNIX GATE EVIDENCE ##########"; echo ""
      } > /dev/console 2>&1
    ) &
    exit $SMF_EXIT_OK
    EOF
    chmod 0755 "$BEROOT/lib/svc/method/solnix-hello"

    # 8c. cryptosvc race fix (gotcha #11): inject milestone/devices dependency
    CRYPTOMF="$BEROOT/lib/svc/manifest/system/cryptosvc.xml"
    if [ -f "$CRYPTOMF" ] && ! grep -q 'milestone/devices' "$CRYPTOMF"; then
      log "injecting milestone/devices dependency into cryptosvc"
      awk '/<single_instance/ && !done {
          print;
          print "\t<dependency name=\x27solnix-devices\x27 grouping=\x27require_all\x27 restart_on=\x27none\x27 type=\x27service\x27>";
          print "\t\t<service_fmri value=\x27svc:/milestone/devices\x27/>";
          print "\t</dependency>"; done=1; next } { print }' \
        "$CRYPTOMF" > "$CRYPTOMF.new" && mv "$CRYPTOMF.new" "$CRYPTOMF"
    fi
    # DTD-validate everything we wrote (build-time-equivalent gate, design §2.6)
    for m in "$BEROOT/lib/svc/manifest/solnix/"*.xml "$BEROOT/etc/svc/profile/site/solnix.xml" "$CRYPTOMF"; do
      [ -f "$m" ] && { xmllint --noout --dtdvalid "$BEROOT/usr/share/lib/xml/dtd/service_bundle.dtd.1" "$m" 2>&1 && echo "DTD-valid: $(basename "$m")" || die "invalid manifest: $m"; }
    done

    # 9. root console login (gotcha: proto root shell absent)
    log "root console login"
    if [ -e "$BEROOT/usr/bin/ksh93" ]; then RSH=/usr/bin/ksh93; else RSH=/sbin/sh; fi
    awk -F: -v sh="$RSH" 'BEGIN{OFS=":"} $1=="root"{$7=sh} {print}' \
      "$BEROOT/etc/passwd" > "$BEROOT/etc/passwd.new" && mv "$BEROOT/etc/passwd.new" "$BEROOT/etc/passwd"
    awk -F: 'BEGIN{OFS=":"} $1=="root"{$2=""} {print}' \
      "$BEROOT/etc/shadow" > "$BEROOT/etc/shadow.new" && mv "$BEROOT/etc/shadow.new" "$BEROOT/etc/shadow"
    chmod 0400 "$BEROOT/etc/shadow"
    [ -f "$BEROOT/etc/default/login" ] && sed -i 's/^CONSOLE=/#CONSOLE=/; s/^PASSREQ=YES/PASSREQ=NO/' "$BEROOT/etc/default/login" || true

    # 10. boot_archive
    log "building boot_archive"
    [ -f "$BEROOT/etc/path_to_inst" ] || : > "$BEROOT/etc/path_to_inst"
    bootadm update-archive -f -R "$BEROOT" 2>&1 | grep -vE '^gzip:|cannot find' | tail -6 || true
    [ -f "$BEROOT/platform/i86pc/amd64/boot_archive" ] || die "boot_archive not built"

    # 11. loader on ESP + bootfs + menu.lst
    log "installing loader on ESP + setting bootfs"
    mkdir -p "$BEROOT/esp"; mount -F pcfs "/dev/dsk/''${DISK}s0" "$BEROOT/esp"
    mkdir -p "$BEROOT/esp/EFI/Boot"; cp "$BEROOT/boot/loader64.efi" "$BEROOT/esp/EFI/Boot/bootx64.efi"
    umount "$BEROOT/esp"
    installboot -fm "$BEROOT/boot/pmbr" "$BEROOT/boot/gptzfsboot" "/dev/rdsk/''${DISK}s0" 2>&1 || \
      echo "NOTE: installboot -m warning expected on EFI-labelled disks"
    zpool set bootfs="$BEDS" "$POOL"
    # T2.5: beadm needs the pool mounted + a menu.lst present (libbe "Invalid
    # path for menu.lst" otherwise). Give the pool a mountpoint under the altroot
    # and seed the grub-legacy menu.lst libbe rewrites on beadm create/activate.
    zfs set mountpoint="/$POOL" "$POOL" 2>/dev/null || true
    mkdir -p "$ALTROOT/$POOL/boot" 2>/dev/null || true
    printf 'title %s\nbootfs %s\n' "$BE" "$BEDS" > "$ALTROOT/$POOL/boot/menu.lst"
    cat > "$BEROOT/boot/menu.lst" <<EOF
    title solnix-1
    bootfs $BEDS
    EOF

    # 12. finalize
    log "finalizing"
    cat > "$BEROOT/etc/solnix-release" <<EOF
    solnix image (nixified make-be)
    built:    $(date -u +%FT%TZ)
    toplevel: $TOPLEVEL
    proto:    $PROTO
    host:     $(uname -a)
    EOF
    sync
    zfs set canmount=noauto "$BEDS"
    umount "$BEROOT/esp" 2>/dev/null || true
    zfs unmount "$BEDS" 2>/dev/null || zfs unmount -f "$BEDS" 2>/dev/null || true
    zpool export "$POOL" || die "zpool export failed"
    log "DONE: bootable solnix image on $DISK (pool $POOL, BE $BEDS)"
    echo "Next: scripts/oi-be-to-ami.sh. DISK=$DISK POOL=$POOL BE=$BEDS TOPLEVEL=$TOPLEVEL"
  '';
in
{
  # the assembly script (run as root on the host)
  script = makeBe;
  # convenience: the toplevel it consumes (closure root)
  inherit toplevel;
}
