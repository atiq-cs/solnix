#!/sbin/sh
# solnix-install — lay a solnix toplevel onto a BLANK target disk's ZFS root,
# from a running solnix system (the "installer environment"). T2.7.
#
# The illumos analog of nixos-install. Unlike make-be (which runs on the OI
# BUILD host and lays the gate PROTO down onto a scratch disk), solnix-install
# runs INSIDE a booted solnix proto-root world and installs onto a SECOND
# (target) disk — the real "install to a fresh disk" flow, not a re-dd of a
# prebaked image.
#
#   solnix-install <target-disk> [toplevel]
#     <target-disk>  e.g. c1t1d0  (the BLANK disk; NOT the running rpool disk)
#     [toplevel]     store path of the system to install (default: the running
#                    /run-current-system). Its closure must exist in the local
#                    /nix/store (the installer env is self-contained).
#
# What it does (mirrors make-be steps, but base = the RUNNING root, which is a
# proven-booting proto-derived world with all 16 boot gotchas already applied):
#   1. GPT-label the target (ESP + ZFS + reserved), like the OI rpool layout
#   2. mkfs pcfs on the ESP; zpool create <POOL> on the ZFS slice
#   3. rpool/ROOT/<be> = the boot environment (canmount=noauto mountpoint=/)
#   4. copy the running root FS onto the target BE (tar | tar, minus pseudo fs +
#      /nix, which is copied by closure below) — carries every gotcha fix
#   5. copy the toplevel closure into the target's /nix/store (self-contained)
#   6. seed the SMF repository + stage the toplevel's manifests/site/activate
#   7. register generation 1 + switch tools on the target's PATH
#   8. loader on ESP + bootfs + menu.lst (beadm-ready) + boot_archive
#
# Pure /sbin/sh + illumos tools (no nix, no GNU cp) — runs in the minimal proto.
# Reuses the illumos gotchas learned in switch-to-configuration: ln -sfn follows
# (use rm+ln), no readlink(1) (use ls -l|sed), cp dir tree = `cp -R -P` no slash.
set -u
# Deliberately minimal PATH: this runs in a bare proto world and must not pick up
# whatever a build host happens to have.
PATH=/usr/sbin:/usr/bin:/sbin
# ...but --flake and --git need `nix` and `git`, and on real install media those are
# NOT in /usr/bin. The bootstrap Nix installs relocatably to /nix-tools224 (and the
# older classic one to /nix-tools), and the installed system's own nix lives in the
# system profile. Append those, so `command -v nix` finds it instead of dying with
# "nix is not on this media" on a machine that plainly has nix. APPEND, not prepend:
# a store-resident nix on the installed system should still win over a bootstrap one.
for _extra in /nix-tools224/bin /nix-tools/bin /nix/var/nix/profiles/default/bin \
              /run/current-system/sw/bin /usr/gnu/bin; do
  [ -d "$_extra" ] && PATH="$PATH:$_extra"
done
export PATH
# The bootstrap Nix tarball needs its own runtime libs and cert bundle; without
# these `nix` execs and then dies on a missing libstdc++ or an unverifiable TLS
# cert, which reads as a network failure rather than a setup one.
[ -d /nix-tools224/runtime-lib ] && \
  LD_LIBRARY_PATH_64="/nix-tools224/runtime-lib${LD_LIBRARY_PATH_64:+:$LD_LIBRARY_PATH_64}" && \
  export LD_LIBRARY_PATH_64
[ -f /nix-tools224/ca-bundle.crt ] && [ -z "${NIX_SSL_CERT_FILE:-}" ] && \
  NIX_SSL_CERT_FILE=/nix-tools224/ca-bundle.crt && export NIX_SSL_CERT_FILE
[ -d /nix-tools224/etc/nix ] && [ -z "${NIX_CONF_DIR:-}" ] && \
  NIX_CONF_DIR=/nix-tools224/etc/nix && export NIX_CONF_DIR

# ---------------------------------------------------------------------------
# ARGUMENT PARSING. Flags are additive: the historical positional form
# `solnix-install <disk> [toplevel]` still works, so every existing caller and
# every doc that predates this keeps functioning.
#
# The flake form the maintainer asked for:
#   solnix-install --git https://github.com/USER/REPO.git --flake .#HOST
#
# ⚠️ HTTPS ON PURPOSE. A git@ URL needs an ssh key the live media does not have --
# verified that his repo is anonymously clonable over https (info/refs returns 200),
# so the installer never needs credentials. A git@ URL is accepted but warned about.
GIT_URL=""; GIT_REF=""; FLAKE_REF=""; HOME_FLAKE=""; DO_HOME=1
DO_NET_ONLY=0; DO_SELF_UPDATE=0; DO_SSHD=0
TARGET=""; TOPLEVEL=""
while [ $# -gt 0 ]; do
  case "$1" in
    --git)        GIT_URL="${2:-}"; shift 2 ;;
    --ref)        GIT_REF="${2:-}"; shift 2 ;;
    --flake)      FLAKE_REF="${2:-}"; shift 2 ;;
    # --home-manager is the spelling in the maintainer's own invocation; --home is
    # the historical one. Both mean the same thing, and an unrecognised option here
    # exits 2, so accepting only one of them would fail the documented command line.
    --home|--home-manager) HOME_FLAKE="${2:-}"; shift 2 ;;
    --home-base)  SOLNIX_HOME_STYLE=$(case "${2:-}" in /export/home|export) echo export;; *) echo home;; esac)
                  export SOLNIX_HOME_STYLE; shift 2 ;;
    --no-home)    DO_HOME=0; shift ;;
    --disk)       TARGET="${2:-}"; shift 2 ;;
    --net)        DO_NET_ONLY=1; shift ;;
    --ssh)        DO_SSHD=1; shift ;;
    --self-update) DO_SELF_UPDATE=1; shift ;;
    -h|--help)
      cat <<'USAGE'
usage: solnix-install [--disk <target>] [--flake <ref>#<attr>]
                      [--git <https-url> [--ref <rev>]]
                      [--home <ref>#<attr>] [--home-base /home|/export/home]
                      [--no-home]
       solnix-install <target-disk> [toplevel]      (legacy positional form)

  --git    clone a config repo first, then resolve --flake inside it.
           Use an https:// URL: the live media has no ssh key.
  --flake  the system configuration to build, e.g. .#HOST
  --home | --home-manager
           a home-manager configuration, e.g. .#USER@HOST
           (auto-detected from the same flake when omitted)
  --net    bring the network up (if not already up) and report; do nothing else.
           A quick "is my network working" action -- no disk is touched. It also
           OFFERS to start sshd for a remote install.
  --ssh    bring the network up and start sshd so a remote operator can ssh in and
           run this installer. Live media only; no disk is touched. A root
           credential is set automatically (empty passwords do NOT work over ssh
           on illumos): supply SOLNIX_SSH_PUBKEY='ssh-ed25519 AAAA...' for key
           auth, or SOLNIX_ROOT_PW=... for a chosen password; otherwise a random
           password is generated and PRINTED. SOLNIX_SSHD=1 starts it without
           prompting.
  --self-update
           bring the network up, re-fetch THIS installer from the release URL, and
           re-exec it with the same args (minus --self-update). Use to pull the
           latest installer without a reflash. No disk is touched by this step.
USAGE
      exit 0 ;;
    --*) echo "unknown option: $1" >&2; exit 2 ;;
    *)   if [ -z "$TARGET" ]; then TARGET="$1"; else TOPLEVEL="$1"; fi; shift ;;
  esac
done
POOL="${SOLNIX_POOL:-rpool}"       # target pool name; rpool for a real install
BE="${SOLNIX_BE:-solnix-1}"
BEDS="$POOL/ROOT/$BE"
ALTROOT="${SOLNIX_ALTROOT:-/a}"
SRCROOT="${SOLNIX_SRCROOT:-/}"     # the running root we copy as the base world

# CONSOLE OF THE *INSTALLED* SYSTEM. Not the same question as the console of the
# live media, and getting it wrong is unrecoverable without a keyboard.
#
# Default "ttya" (serial), because every automated install test in this repo
# captures the installed system's first boot over the serial line -- changing the
# default would blind them all.
#
# ⚠️ BUT a laptop has NO ttya. illumos derives BOTH stdin and stdout from this
# value, so an installed system configured for a serial port that does not exist
# boots to a black screen AND takes no input -- with the target disk already
# erased. The unattended (keyboard-free) install path therefore passes "text",
# the framebuffer console, which is the value the media itself ships and the only
# one with real-hardware evidence behind it on the X1 Carbon.
# ⚠️ DEFAULT IS "text", NOT "ttya". This defaulted to ttya so that headless EC2
# serial captures kept working, but the consequence on real hardware is severe:
# the maintainer installed interactively on an X1 Carbon -- which has NO serial
# port -- rebooted, and got a dead keyboard, because the loader falls back for
# OUTPUT while the kernel console INPUT stays on a nonexistent ttya. A laptop is
# the common case for an interactive install; a headless server sets the variable.
# Set SOLNIX_TARGET_CONSOLE=ttya explicitly for serial-console work.
TARGET_CONSOLE="${SOLNIX_TARGET_CONSOLE:-text}"

# _upload_logs -- on failure, bundle the install + build logs + key diagnostics and
# OFFER to upload them to a paste service so they can be debugged off-host. No creds
# needed (public paste). curl is on the media; if it cannot reach the paste service
# it says so and leaves the bundle on disk. Skips the prompt if SOLNIX_DIAG_AUTO=1.
_upload_logs() {
  _il="${SOLNIX_INSTALL_LOG:-/tmp/solnix-install.log}"
  _bl=$(ls -t "$ALTROOT"/var/tmp/solnix-build-*.log 2>/dev/null | head -1)
  _bundle=/tmp/solnix-fail-$$.txt
  {
    echo "===== solnix install failure bundle $(date -u '+%Y-%m-%dT%H:%M:%SZ') ====="
    echo "--- uname / version ---"; uname -a 2>/dev/null; nix --version 2>/dev/null
    echo "--- disks ---"; echo | format 2>/dev/null | grep -E '^ *[0-9]\.' || true
    echo "--- pools ---"; zpool list 2>/dev/null; zpool status 2>/dev/null | head -30
    echo "--- network ---"; ipadm show-addr 2>/dev/null; cat /etc/resolv.conf 2>/dev/null
    echo "===== INSTALL LOG (${_il}) ====="; tail -200 "$_il" 2>/dev/null
    if [ -n "$_bl" ]; then echo "===== BUILD LOG (${_bl}) ====="; tail -300 "$_bl" 2>/dev/null; fi
  } > "$_bundle" 2>/dev/null
  echo "" >&2
  echo "  A failure bundle (install log + build log + disks/pools/network) is at:" >&2
  echo "    $_bundle" >&2
  if [ "${SOLNIX_DIAG_AUTO:-0}" != 1 ]; then
    printf '  Upload it to paste.rs for off-host debugging? [Y/n]: ' >&2
    read _ans 2>/dev/null || _ans=y
    case "$_ans" in n|N|no|NO) echo "  not uploaded; the bundle is on disk above." >&2; return 0 ;; esac
  fi
  if command -v curl >/dev/null 2>&1; then
    _url=$(curl -fsS --max-time 60 --data-binary @"$_bundle" https://paste.rs 2>/dev/null)
    case "$_url" in
      https://paste.rs/*)
        echo "" >&2
        echo "  #####################################################################" >&2
        echo "  ##  UPLOADED. Send this URL to the maintainer:  $_url" >&2
        echo "  #####################################################################" >&2
        return 0 ;;
    esac
  fi
  echo "  upload failed (no curl or no network). Read the bundle above, or by hand:" >&2
  echo "    curl --data-binary @$_bundle https://paste.rs" >&2
}

die() {
  echo "FATAL: $*" >&2
  # Offer to ship the logs off-host for debugging (best-effort; never blocks the exit).
  _upload_logs 2>/dev/null || true
  exit 1
}
log() { printf '\n=== %s ===\n' "$*" >&2; printf '\n=== %s ===\n' "$*" >> "${SOLNIX_INSTALL_LOG:-/tmp/solnix-install.log}" 2>/dev/null || true; }

# ---------------------------------------------------------------------------
# PROGRESS UX. The operator watches a framebuffer console (no serial, no smart
# terminal), so this stays deliberately dumb: a step counter for orientation
# and, for the LONG steps (flake eval, nix build, closure copy, bootadm), a
# background spinner that prints \r[-\|/] + elapsed seconds. No cursor
# addressing, no color, no width math -- only \r and plain ASCII, which the
# illumos wscons framebuffer honors. All output goes to stderr (stdout may be
# captured), and every helper is a no-op-safe pair so a killed spinner can never
# wedge a step.
#
# STEP_TOTAL is the count the operator sees as [N/STEP_TOTAL]; it is a fixed
# orientation number, not a promise every step runs (SELF_INSTALL skips some).
STEP_TOTAL=9
STEP_N=0
step() {  # step "<human description>"
  STEP_N=$((STEP_N + 1))
  printf '\n=== [%d/%d] %s ===\n' "$STEP_N" "$STEP_TOTAL" "$*" >&2
}

# spin_start "<label>" -- start a background spinner on stderr. Returns
# immediately; the PID is stashed in _SPIN_PID. spin_stop ends it and prints the
# elapsed time. Safe if stderr is not a tty (it just prints a growing line);
# safe if called without a matching stop (cleanup() kills it). Only ONE spinner
# at a time -- a second spin_start stops the first.
_SPIN_PID=""
spin_start() {
  spin_stop >/dev/null 2>&1
  _spin_label="$1"
  _spin_t0=$(_now_s)
  (
    _i=0
    while : ; do
      case $(( _i % 4 )) in 0) _c='-';; 1) _c='\';; 2) _c='|';; 3) _c='/';; esac
      _el=$(( $(_now_s) - _spin_t0 ))
      # %s prints _c verbatim; _c must be a SINGLE backslash for the spinner frame.
      # In sh single-quotes '\' is TWO literal backslashes (no escaping happens),
      # so it printed \. Use printf's %b-free single char: assign one backslash.
      printf '\r  [%s] %s  (%ds elapsed)   ' "$_c" "$_spin_label" "$_el" >&2
      _i=$((_i + 1))
      sleep 1
    done
  ) &
  _SPIN_PID=$!
}
# spin_stop -- stop the spinner, clear its line, print the final elapsed time.
spin_stop() {
  [ -n "$_SPIN_PID" ] || return 0
  kill "$_SPIN_PID" 2>/dev/null
  wait "$_SPIN_PID" 2>/dev/null
  _el=$(( $(_now_s) - ${_spin_t0:-$(_now_s)} ))
  printf '\r  [done] %s  (%ds)                       \n' "${_spin_label:-step}" "$_el" >&2
  _SPIN_PID=""
}
# _now_s -- seconds since epoch, POSIX (no GNU date -d, no %s guarantee issues on
# illumos date which DOES support +%s). Fallback to 0 so arithmetic never breaks.
_now_s() { date +%s 2>/dev/null || echo 0; }

# have_intel_ax2xx -- is an Intel AX2xx-family wifi card present? illumos exposes
# PCI device+vendor as pci8086,<dev> compatible strings in the device tree. The
# device IDs below are the AX200/AX201/AX210/AX211 family (Cyclone/Quz/So/Ty);
# grep the tree rather than trust a driver bind, since no driver attaches yet.
# Includes the CNVi forms (MAC integrated in the PCH, only the RF companion on
# M.2) -- notably a370 (AX201 on Comet Lake), MEASURED on the dixi X1 as
# pci8086,a370 at _SB_.PCI0.CNVW. a370 was MISSING, so this machine's own wifi
# read as "no card present"; added it (+ 9df0/31dc) so detection is correct.
have_intel_ax2xx() {
  # pci8086,<id> nodes; discrete + CNVi ids.
  { prtconf -pv 2>/dev/null; ls -d /devices/pci* 2>/dev/null; } \
    | grep -iE 'pci(ex)?8086,(2723|2725|02f0|06f0|34f0|3df0|43f0|a0f0|51f0|54f0|7af0|7e40|a370|9df0|31dc)' \
    >/dev/null 2>&1
}

# illumos ln -sfn FOLLOWS an existing symlink-to-dir (rc=0, no-op); always rm+ln.
# _solnix_nixpkgs_src <flake-ref> -- print the store path of solnix-pkgs' patched
# nixpkgs source (the applyPatches output the flake's `import "${nixpkgs}/lib"`
# needs realised). Uses `nix eval builtins.getFlake` to read the config flake's
# solnix-pkgs INPUT directly -- PURE NIX, no python/jq and no human-output parsing
# (both earlier approaches were fragile on the media: python3 is absent, and
# `nix flake metadata` tree-output parsing returned empty). nix is guaranteed here.
# ⚠️ getFlake UNPACKS nixpkgs into the Git tarball cache (XDG_CACHE_HOME) at eval
# time. On the live media HOME=/root sits on the ramdisk root, which is 100% FULL
# by design -- the unpack overflows and corrupts the cache, after which every read
# fails "object not found - failed to find pack entry" and the eval returns EMPTY
# (measured on the X1, tui11: paste.rs/P46jo). So point XDG_CACHE_HOME + TMPDIR at
# the POOL ($ALTROOT/var/tmp, 928G) -- caller must have mounted it already -- and
# clear any cache the ramdisk already corrupted. stderr is NOT swallowed: the
# caller captures it so a failure is visible, never a silent empty.
_solnix_nixpkgs_src() {
  _sns_cache="$ALTROOT/var/tmp/solnix-nixcache"
  rm -rf "$_sns_cache" 2>/dev/null; mkdir -p "$_sns_cache" "$ALTROOT/var/tmp" 2>/dev/null
  run_to 300 env HOME="$ALTROOT/var/tmp" XDG_CACHE_HOME="$_sns_cache" TMPDIR="$ALTROOT/var/tmp" \
    nix eval --impure --raw --expr \
    "(builtins.getFlake \"$1\").inputs.solnix-pkgs.lib.nixpkgsSrc"
}
relink() { rm -f "$2" 2>/dev/null; ln -s "$1" "$2"; }
# minimal proto has no readlink(1); derive symlink target from ls -l.
_readlink() { [ -h "$1" ] || return 1; ls -ld "$1" 2>/dev/null | sed -n 's/.* -> //p'; }
# copy a store path into the target (illumos cp -R -P, parent dir no trailing /).
copy_path() { [ -e "$ALTROOT$1" ] && return 0; d="$ALTROOT$(dirname "$1")"; mkdir -p "$d"; cp -R -P "$1" "$d" 2>/dev/null || true; }

# assert_mounted_on_pool <dataset> <expected-mountpoint> -- prove a dataset is
# ACTUALLY mounted on the target pool, not that its mountpoint DIRECTORY merely
# exists. This is the guard the X1 5/9 failure needed: the old `[ -d "$ALTROOT/." ]`
# check passes whether or not `zfs mount` succeeded, because $ALTROOT was mkdir'd
# up front -- so a silent mount failure (timeout, transient) left $ALTROOT a bare
# dir on the ~9M RAM ramdisk, and the build's `--store $ALTROOT` then overflowed
# it ("No space left on device") while the 928G pool sat unmounted (measured:
# `df /a` = ????????, rpool 928G free). Two independent signals, both illumos-safe
# (no GNU stat/readlink): the ZFS `mounted` property == yes, AND the path's fstype
# per `df -n` is zfs (a ramdisk dir reports ufs/tmpfs, never zfs). Fail LOUD.
assert_mounted_on_pool() {
  _amds="$1"; _ammp="$2"; _amerr="${3:-}"
  _ammnt=$(run_to 15 zfs get -H -o value mounted "$_amds" 2>/dev/null || echo unknown)
  _amfs=$(df -n "$_ammp" 2>/dev/null | sed -n 's/.*: *//p')
  if [ "$_ammnt" != yes ]; then
    echo "" >&2
    echo "FATAL: dataset $_amds is NOT mounted (zfs mounted=$_ammnt)." >&2
    echo "  $_ammp exists as a directory but the pool is not mounted on it, so the" >&2
    echo "  toplevel build would write into the RAM ramdisk (~9M free) and fail with" >&2
    echo "  'No space left on device' while the target pool sits unused. This is the" >&2
    echo "  X1 5/9 failure. \`zfs mount $_amds\` likely timed out or raced -- retry, and" >&2
    echo "  if it persists check \`zpool status $POOL\` and \`zfs get mounted $_amds\`." >&2
    if [ -n "$_amerr" ] && [ -s "$_amerr" ]; then
      echo "  The mount attempt reported:" >&2
      sed 's/^/    /' "$_amerr" >&2 2>/dev/null || true
    fi
    die "target pool not mounted at $_ammp -- refusing to build into the ramdisk"
  fi
  case "$_amfs" in
    *zfs*) : ;;
    '' ) log "note: df -n $_ammp gave no fstype (df quirk); trusting zfs mounted=yes" ;;
    *)  echo "" >&2
        echo "FATAL: $_ammp reports fstype '$_amfs', not zfs -- the target pool is not" >&2
        echo "  the filesystem at $_ammp (a stale ramdisk dir shadows the mount)." >&2
        die "$_ammp is $_amfs, not the zfs pool -- refusing to build into it" ;;
  esac
}

# run a command with a hard wall-clock timeout so no privileged step (a busy
# zpool import, a wedged bootadm, a mkfs) hangs the install forever (the T2.7
# hang was a re-run wedged on a target pool left imported). Uses a background
# watchdog since the minimal illumos installer env has no timeout(1).
run_to() {  # run_to <seconds> <cmd...>
  _to=$1; shift
  "$@" &
  _pid=$!
  ( sleep "$_to"; kill -TERM "$_pid" 2>/dev/null; sleep 3; kill -KILL "$_pid" 2>/dev/null ) &
  _watch=$!
  wait "$_pid" 2>/dev/null; _rc=$?
  kill "$_watch" 2>/dev/null; wait "$_watch" 2>/dev/null
  return $_rc
}

# ALWAYS leave the host clean: on ANY exit (success, error, ^C) unmount the ESP
# + the BE and EXPORT the target pool so it is not left imported (the exact
# state that wedged the prior re-run). Idempotent + best-effort.
# ROOTPOOL is the RUNNING root pool (never touch it). Detect it NOW, before the
# trap, so an early die() cleanup can still protect it (empty -> protect rpool +
# every currently-imported pool, since nothing of ours is imported yet).
ROOTDS=$(zfs list -H -o name,mountpoint 2>/dev/null | awk '$2=="/"{print $1; exit}')
ROOTPOOL="${ROOTDS%%/*}"
# LIVE-INSTALLER case: the running root is a UFS ramdisk, so there is NO ZFS
# pool mounted at / to protect. Leave ROOTPOOL empty (not the literal 'rpool')
# so a real root install onto a fresh rpool is not falsely rejected as
# "target == running root pool". Only default to rpool when a ZFS / exists.
if [ -z "$ROOTPOOL" ]; then
  case "$(df -n / 2>/dev/null)" in *zfs*) ROOTPOOL=rpool;; *) ROOTPOOL="";; esac
fi
# snapshot the pools imported at start; cleanup only exports pools NOT in this
# set (i.e. only ones this run imported), so an early failure never touches a
# pre-existing pool (e.g. the running root).
PREEXISTING_POOLS=" $(zpool list -H -o name 2>/dev/null | tr '\n' ' ') "
cleanup() {
  spin_stop 2>/dev/null || true
  # The encryption passphrase is written to a temp keyfile so `zfs create` can read
  # it non-interactively; it must not survive this script under any exit path.
  [ -n "${ENC_KEYFILE:-}" ] && rm -f "$ENC_KEYFILE" 2>/dev/null
  umount "$ALTROOT/esp" 2>/dev/null || true
  zfs unmount "$BEDS" 2>/dev/null || zfs unmount -f "$BEDS" 2>/dev/null || true
  for _p in "$POOL" $(zpool list -H -o name 2>/dev/null); do
    case "$_p" in "$ROOTPOOL"|rpool|"") continue;; esac
    # only export a pool this run created (not one imported before we started).
    case "$PREEXISTING_POOLS" in *" $_p "*) continue;; esac
    zpool export "$_p" 2>/dev/null || true
  done
  # ⚠️ NVMe-scratch on the TARGET must be DESTROYED (not just exported) on ANY exit,
  # including a failed build. It is a WHOLE-DISK pool on the install target; if a run
  # dies at (e.g.) the 5/9 build and only exports it, its ZFS label survives on the
  # whole disk. The NEXT run's rpool detection then sees a leftover fragment whose
  # backing was swallowed by that whole-disk claim and imports rpool FAULTED -- the
  # recurring 'rpool health=FAULTED' loop (measured on the X1; disk itself is clean
  # per iostat). Destroy + labelclear here so a failed run leaves the target clean.
  if [ "${SCRATCH_ON_TARGET:-0}" = 1 ] && [ -n "${TARGET:-}" ]; then
    HOME=/root; TMPDIR=/tmp; XDG_CACHE_HOME=/root/.cache; export HOME TMPDIR XDG_CACHE_HOME
    run_to 20 zfs unmount solnixscratch 2>/dev/null || true
    run_to 20 zpool destroy -f solnixscratch 2>/dev/null || run_to 20 zpool export -f solnixscratch 2>/dev/null || true
    for _tn in "$TARGET" "${TARGET}p0" "${TARGET}s0"; do
      [ -e "/dev/dsk/$_tn" ] && run_to 20 zpool labelclear -f "/dev/dsk/$_tn" 2>/dev/null || true
    done
  fi
}
trap cleanup EXIT INT TERM

[ "$(id -u)" = 0 ] || die "run as root"

# ---------------------------------------------------------------------------
# 0b. FETCH THE CONFIG AND PROVE THE ATTR EXISTS -- before touching any disk.
#
# The maintainer's step 3 is "ensure the .#dixi profile exists". Doing that BEFORE
# anything destructive is the point: a typo'd attr must fail with a list of what IS
# available, not half an install.
# ---------------------------------------------------------------------------
# 0a. INTERNET CHECK -- BEFORE the clone, because the clone is the first thing
#     that needs it and "git clone failed" is a far worse diagnostic than this.
#
# TWO SEPARATE QUESTIONS, REPORTED SEPARATELY, because the fixes differ:
#   does DNS resolve?  -> a resolver / DHCP problem
#   does HTTPS fetch?  -> a routing / proxy / TLS problem
# A check that only pings, or only resolves, PASSES on a box that cannot fetch --
# which is the failure that matters here, since every later step fetches. So this
# does a real HTTPS GET of a known-tiny, known-stable document and then requires
# the BODY to look like that document. That is what makes a captive portal fail:
# a portal answers 200 with an HTML login page, and a bare exit-code check would
# call that success.
#
# WARNING: ON THE X1 THIS IS USB-ETHERNET OR IT IS NOTHING, and the failure text
# below says so deliberately. There is no working wifi on this machine under
# illumos and no prospect of any: the Intel AX2xx has no illumos driver, no
# OpenSolaris-family fork has one (illumos-gate, omnios, joyent and nexenta all
# checked -- the newest Intel support is the iwn/iwp 6000-series era and no fork
# claims 0x2723/0x2725/0x02f0), and the OpenBSD iwx port was abandoned after
# measuring that it needs a BSD network-interface layer illumos never had.
# Telling the operator to "check the network" invites hours on wifi that cannot
# ever work, so the message names the dongle instead.

# bring_up_network -- plumb the first real wired NIC and get a DHCP lease, so the
# operator does not have to run dladm/ipadm/route/resolv.conf by hand. This
# automates exactly the manual sequence a fresh boot needs, and is idempotent:
# re-running it does no harm. It is best-effort -- check_internet is still the
# real gate, so if anything here is wrong the fetch test catches it.
#
# WHY THIS IS NEEDED: the live media has no auto-network service (nwam is not
# staged), so a booted machine has only lo0 until something plumbs a NIC. And
# ena0, if present, is the EC2 BUILD HOST's virtual NIC baked into the image --
# it will never get a link on real hardware, so it is skipped explicitly.
bring_up_network() {
  command -v dladm >/dev/null 2>&1 || return 0   # nothing to do without the tools
  command -v ipadm >/dev/null 2>&1 || return 0

  # 1. Pick the first physical link that is NOT ena0 (cloud NIC) or lo0. dladm
  #    show-phys lists real, attached datalinks -- a USB-ethernet dongle shows
  #    here as e1000g0/axf0/usbecm0 once its driver bound.
  _nic=$(dladm show-phys -p -o link 2>/dev/null \
         | grep -v -E '^(ena[0-9]|lo[0-9])' | head -1)
  if [ -z "$_nic" ]; then
    log "no wired NIC found to auto-configure (dladm show-phys lists only cloud/loopback)"
    return 0
  fi
  log "auto-configuring network on $_nic"

  # 2. Plumb it and request DHCP. create-if/create-addr are no-ops-with-error if
  #    already done, so swallow those; ipadm show-addr below is the real check.
  pfexec ipadm create-if "$_nic" 2>/dev/null || true
  # -t: temporary (this boot). A persistent addrobj fails on the live media's
  # ramdisk persistent DB ("Operation failed"); the temporary form gets the lease.
  pfexec ipadm create-addr -t -T dhcp "$_nic/v4" 2>/dev/null || true

  # 3. Wait up to ~20s for a lease -- a slow dongle/switch can take a few seconds.
  _got=""
  _i=0
  while [ "$_i" -lt 20 ]; do
    _got=$(ipadm show-addr -p -o addr "$_nic/v4" 2>/dev/null | sed 's,/.*,,')
    case "$_got" in ""|0.0.0.0) : ;; *) break ;; esac
    sleep 1; _i=$((_i+1))
  done
  case "$_got" in
    ""|0.0.0.0) log "no DHCP lease on $_nic after ${_i}s -- check the cable/dongle"; return 0 ;;
    *) log "$_nic got $_got via DHCP" ;;
  esac

  # 4. STALE DEFAULT ROUTES. A baked-in image can carry a bogus default route
  #    (seen: 192.168.1.5 from the build host) that wins over the real gateway,
  #    so internet-bound packets black-hole while the LAN still works. Keep only
  #    the DHCP-provided gateway (the router that answered our lease) and drop any
  #    other default. The DHCP gateway is normally the .1 of our /24, but read it
  #    from the routing table rather than guessing: keep the default whose gateway
  #    is reachable on our NIC, delete the rest.
  _keepgw=$(netstat -rn 2>/dev/null | awk '$1=="default"{print $2}' \
            | while read -r _gw; do
                # a gateway on our own subnet is the plausible real one; ping it
                if ping -sn "$_gw" 56 1 >/dev/null 2>&1; then echo "$_gw"; break; fi
              done)
  if [ -n "$_keepgw" ]; then
    netstat -rn 2>/dev/null | awk '$1=="default"{print $2}' | while read -r _gw; do
      [ "$_gw" = "$_keepgw" ] && continue
      log "removing stale default route via $_gw (keeping $_keepgw)"
      pfexec route delete default "$_gw" >/dev/null 2>&1 || true
    done
  fi

  # 5. RESOLVER. The media now boots with an EMPTY /etc/resolv.conf (the stale EC2
  #    build-host resolver is scrubbed at image build), so the common case is: fill
  #    it from THIS network's DHCP lease. But DO NOT clobber a resolv.conf the
  #    operator (or a prior step) already populated -- if it has a nameserver line,
  #    respect it. Only write when it is empty / has no nameserver.
  if [ -s /etc/resolv.conf ] && grep -q '^[[:space:]]*nameserver' /etc/resolv.conf 2>/dev/null; then
    log "/etc/resolv.conf already has a nameserver -- leaving it as-is (not overwriting)"
    _dns_servers=""
  else
    _dns_servers=$(dhcpinfo -i "$_nic" DNSserv 2>/dev/null | tr ' ' '\n' | grep -E '^[0-9]+\.' )
    if [ -z "$_dns_servers" ]; then
      # empty resolv.conf AND no DNS in the lease -> fall back to the gateway / public.
      _dns_servers="${_keepgw:-1.1.1.1}"
    fi
  fi
  if [ -n "$_dns_servers" ]; then
    log "writing /etc/resolv.conf from DHCP/lease resolvers: $(echo $_dns_servers | tr '\n' ' ')"
    { for _s in $_dns_servers; do printf 'nameserver %s\n' "$_s"; done; } \
      | pfexec tee /etc/resolv.conf >/dev/null 2>&1 || true
  fi
  return 0
}

# _grow_scratch_tail <disk cNtNdN> -- extend the scratch GPT partition (GPT index
# 2, the SCRATCH_MB-sized one make-iso-usb.sh built) into the stick's UNPARTITIONED
# FREE TAIL, so a single dd'd stick's scratch fills the device (NixOS-style
# single-medium install, no second USB). Grows the label to the whole device
# (format -e expand), then rewrites the partition map (fmthard) so part 2 fills
# from its unchanged start to an EFI-reserved slice at the device end. p1(ISO)/
# p2(ESP) are copied VERBATIM -- MEASURED byte-identical after (the grow claims
# only free tail). Returns 0 on grow, non-zero if nothing to claim / tool missing.
_grow_scratch_tail() {
  _gd="$1"
  _graw="/dev/rdsk/${_gd}p0"
  command -v format  >/dev/null 2>&1 || return 1
  command -v fmthard >/dev/null 2>&1 || return 1
  command -v prtvtoc >/dev/null 2>&1 || return 1
  [ -e "$_graw" ] || return 1
  # expand the EFI label to the whole device (claims the free tail into the usable
  # region + moves the backup GPT header to the device end; moves NO partition).
  # Driven non-interactively; "1"=EFI label, "y"=confirm write.
  printf 'partition\nexpand\nlabel\n1\ny\nquit\nquit\n' | format -e "$_graw" >/dev/null 2>&1
  _acc=$(prtvtoc "$_graw" 2>/dev/null | awk '/accessible/{print $2}')
  case "$_acc" in ''|*[!0-9]*) return 1 ;; esac
  _p0=$(prtvtoc -h "$_graw" 2>/dev/null | awk '$1==0{print $4, $5}')
  _p1=$(prtvtoc -h "$_graw" 2>/dev/null | awk '$1==1{print $4, $5}')
  _p2start=$(prtvtoc -h "$_graw" 2>/dev/null | awk '$1==2{print $4}')
  _built=$(prtvtoc -h "$_graw" 2>/dev/null | awk '$1==2{print $5}')
  case "$_p2start$_built" in ''|*[!0-9]*) return 1 ;; esac
  _lastu=$(( _acc - 34 ))              # leave room for the backup GPT header
  _rstart=$(( _lastu - 16384 + 1 ))    # EFI reserved (tag 11) start
  _p2cnt=$(( _rstart - _p2start ))     # scratch fills up to the reserved slice
  # only rewrite if there is a meaningful gain (else keep the built size).
  [ "$_p2cnt" -gt "$_built" ] || return 1
  { echo "0 20 01 $_p0"
    echo "1 12 00 $_p1"
    echo "2 20 00 $_p2start $_p2cnt"
    echo "8 11 00 $_rstart 16384"     # fmthard REQUIRES one reserved (tag 11)
  } > /tmp/solnix-scratch-grow.spec
  fmthard -s /tmp/solnix-scratch-grow.spec "$_graw" >/tmp/solnix-scratch-grow.err 2>&1 || {
    log "USB scratch: fmthard grow failed:"; sed 's/^/    /' /tmp/solnix-scratch-grow.err >&2 2>/dev/null
    return 1
  }
  log "USB scratch: grew scratch partition into free tail ($(( (_p2cnt*512)/1048576 ))MiB, was $(( (_built*512)/1048576 ))MiB)"
  return 0
}

# setup_scratch -- give nix a WRITABLE scratch fs so the flake fetch + eval
# scratch (~/.cache/nix, TMPDIR, HOME) do NOT fill the tiny RAM ramdisk. MEASURED:
# the live root is a ~334MB UFS ramdisk in RAM (~136MB free); a `dd`'d hybrid-ISO
# stick would otherwise leave the rest of the device UNUSED. The build itself
# already goes to the target pool (--store $ALTROOT), but the name gate's flake
# FETCH runs BEFORE the pool exists and lands on the ramdisk -> "file system full".
#
# THE MEDIA NOW CARRIES A WRITABLE PARTITION (make-iso-usb.sh appends GPT
# partition 3, type Solaris, as a blank scratch area). We find the boot stick by
# its SOLNIX_INSTALL label, zpool-create the scratch pool ON THAT PRE-CARVED
# PARTITION 3 (a real GPT slot the image built -- NOT live-repartitioning the
# GPT, which wedges boot devices), grow it into the stick's free tail
# (zpool online -e), and point HOME/TMPDIR/nix caches at it. SOLNIX_SCRATCH_DISK
# still overrides for a spare disk / second stick. All best-effort: any failure
# falls back to the ramdisk and the gate's disk precheck explains a fill.
setup_scratch() {
  [ -n "${SOLNIX_NO_USB_SCRATCH:-}" ] && return 0
  command -v zpool >/dev/null 2>&1 || return 0
  _scr_mp="/var/tmp/solnix-scratch"

  # Already set up (re-run)?
  if zpool list solnixscratch >/dev/null 2>&1 && [ -d "$_scr_mp" ]; then
    log "USB scratch: solnixscratch already present at $_scr_mp"
  else
    _scrpart=""
    # Explicit override wins (whole-disk spare / second stick).
    if [ -n "${SOLNIX_SCRATCH_DISK:-}" ]; then
      _scrpart="${SOLNIX_SCRATCH_DISK}"
      [ -n "${TARGET:-}" ] && [ "$_scrpart" = "$TARGET" ] && { log "USB scratch: SOLNIX_SCRATCH_DISK == target, refusing"; return 0; }
      log "USB scratch: using operator-specified $_scrpart (ERASES it)"
    else
      # Find the boot stick by its SOLNIX_INSTALL ISO label. MEASURED: the isohybrid
      # ISO9660 volume descriptor (carrying volume-id SOLNIX_INSTALL) sits at sector
      # 16 of the WHOLE DISK (p0), NOT inside p1 (p1 starts at LBA 64, past it) --
      # reading p1 finds nothing, p0 matches. On an EFI/GPT disk the scratch is GPT
      # partition 2 = slice s2 (the fdisk node p3 fails "No such device or address").
      _scrdisk=""
      for _d in /dev/rdsk/*p0; do
        [ -e "$_d" ] || continue
        _n=$(basename "$_d"); _n=${_n%p0}
        if dd if="/dev/rdsk/${_n}p0" bs=2048 count=64 2>/dev/null | strings 2>/dev/null | grep -q 'SOLNIX_INSTALL'; then
          # Found the boot stick. Do NOT require the s2 slice node to pre-exist:
          # on a freshly dd'd stick illumos has not necessarily created the GPT
          # slice device nodes, and the EFI label the pool needs is written by the
          # grow step below. Nudge /dev, let _grow_scratch_tail establish the
          # label+slices, then derive the pool device AFTER.
          _scrdisk="$_n"
          break
        fi
      done
      if [ -z "$_scrdisk" ]; then
        # NO USB scratch stick attached. On the X1's specific USB controller
        # scsa2usb may never bind (measured: `devfsadm -i scsa2usb` fails to
        # attach and no /dev/dsk USB node appears), so the boot stick is not a
        # block device and cannot be found here. FALL BACK to a scratch pool on
        # the TARGET NVMe -- the one device the kernel definitely sees -- created
        # ONLY when the operator has already chosen a target (passed it on the
        # command line), since the target is about to be wholly erased for the
        # install anyway. The pool is DESTROYED in step-0 before the real install
        # pool is created (SCRATCH_ON_TARGET below drives that teardown).
        if [ -n "${TARGET:-}" ] && { [ -e "/dev/rdsk/${TARGET}s0" ] || [ -e "/dev/rdsk/${TARGET}p0" ]; }; then
          # never build scratch on the RUNNING root disk.
          _rootdisk=$(zpool status "$ROOTPOOL" 2>/dev/null | awk '/[0-9]d[0-9]/{gsub(/s[0-9]+$/,"",$1); print $1; exit}')
          if [ -n "$_rootdisk" ] && [ "$TARGET" = "$_rootdisk" ]; then
            log "USB scratch: no stick, and TARGET==running root disk -- refusing NVMe-scratch."
            return 0
          fi
          log "USB scratch: no SOLNIX_INSTALL stick found -- falling back to NVMe-scratch on the"
          log "             chosen target $TARGET (whole-disk pool 'solnixscratch', DESTROYED before"
          log "             the install pool is created; the target is erased for the install anyway)."
          # A prior aborted run may have left solnixscratch OR a leftover rpool on
          # this disk -- and a mounted/imported rpool makes the whole-disk
          # `zpool create solnixscratch <disk>` fail ("device is part of a pool").
          # This disk is about to be wholly erased for the install, so clear ANY
          # pool on it now (export first -- works on a suspended/FAULTED pool where
          # destroy would D-state hang), then labelclear the nodes.
          for _p in solnixscratch rpool $(zpool list -H -o name 2>/dev/null); do
            case "$_p" in "$ROOTPOOL"|"") continue;; esac
            zpool status "$_p" 2>/dev/null | grep -q "$TARGET" || [ "$_p" = solnixscratch ] || continue
            run_to 20 zpool destroy -f "$_p" 2>/dev/null || run_to 20 zpool export -f "$_p" 2>/dev/null || true
          done
          pfexec devfsadm -c disk 2>/dev/null || devfsadm -c disk 2>/dev/null || true
          for _tn in "${TARGET}" "${TARGET}p0" "${TARGET}s0" "${TARGET}s1"; do
            [ -e "/dev/dsk/$_tn" ] && run_to 20 zpool labelclear -f "/dev/dsk/$_tn" 2>/dev/null || true
          done
          pfexec devfsadm -c disk 2>/dev/null || devfsadm -c disk 2>/dev/null || true
          # Some virtual controllers refuse a whole-disk EFI label without an
          # fdisk table first (same case the install pool create handles); lay
          # one so the whole-disk `zpool create` can EFI-label the disk.
          run_to 30 fdisk -B "/dev/rdsk/${TARGET}p0" >/dev/null 2>&1 || true
          devfsadm >/dev/null 2>&1 || true; sync; sleep 1
          if run_to 90 zpool create -f -O compression=on -O atime=off -m "$_scr_mp" solnixscratch "/dev/dsk/${TARGET}" 2>/tmp/solnix-scratch.err; then
            SCRATCH_ON_TARGET=1; export SCRATCH_ON_TARGET
            log "USB scratch: NVMe-scratch pool 'solnixscratch' created on $TARGET ($(df -k "$_scr_mp" 2>/dev/null | awk 'NR==2{print $4}')KB)"
            _scrpart=""    # pool already created; skip the shared create below
          else
            # NVMe-scratch was the ONLY scratch option (no USB stick as a disk on
            # this hardware), and it FAILED. Falling back to the ramdisk just makes
            # the name-gate die at 2/9 with an unhelpful "9M free" -- so FAIL HERE
            # with the ACTUAL zpool create error, which names the real problem
            # (e.g. a suspended/leftover rpool on the disk, a label refusal). The
            # operator can then wipe the disk and re-run.
            echo "" >&2
            echo "FATAL: could not create the NVMe-scratch pool on $TARGET, and there is no" >&2
            echo "other writable scratch (the USB stick is not a block device on this hardware)." >&2
            echo "Without scratch, resolving the flake would fill the tiny RAM ramdisk. The" >&2
            echo "zpool create error was:" >&2
            sed 's/^/  /' /tmp/solnix-scratch.err >&2 2>/dev/null || true
            echo "" >&2
            echo "Most likely a prior partial install left a suspended/leftover pool or labels" >&2
            echo "on $TARGET. Clear it, then re-run the installer:" >&2
            echo "  solnix-zap $TARGET     # exports a leftover/faulted pool, clears cache + labels" >&2
            echo "  (if solnix-zap says a reboot is needed, reboot -- labels+cache are already" >&2
            echo "   cleared so it will not re-import -- then re-run the installer)" >&2
            die "NVMe-scratch create failed -- see the zpool error above; run solnix-zap $TARGET and retry"
          fi
        else
          log "USB scratch: no SOLNIX_INSTALL stick found and no target chosen -- leaving TMPDIR on the ramdisk."
          log "             (A non-USB boot, or an older image. Re-run with a target disk argument, or"
          log "             SOLNIX_SCRATCH_DISK=<cNtNdN> pointing at a spare disk/second stick if / fills.)"
          return 0
        fi
      else
      log "USB scratch: boot stick is $_scrdisk"
      # Ensure the disk's partition/slice nodes exist (a fresh dd may not have
      # triggered devfsadm for them yet).
      pfexec devfsadm -c disk 2>/dev/null || devfsadm -c disk 2>/dev/null || true
      # SELF-GROW into the stick's free tail. This ALSO writes the EFI label that
      # creates the s2 slice the pool lives on -- so it must run whether or not s2
      # pre-exists. A dd'd stick bigger than the image leaves UNPARTITIONED FREE
      # SPACE after the scratch partition; claiming it does NOT move p1(ISO)/
      # p2(ESP) -- the class of op NixOS's installer performs, so a SINGLE stick
      # fills the device with no second USB. MEASURED SAFE: p1/p2 byte-identical
      # after, stick still boots. (Growing UNDER a live pool suspends pool I/O, so
      # grow FIRST, create after.)
      _grow_scratch_tail "$_scrdisk" || log "USB scratch: tail grow skipped/failed (using built size)"
      # NOW derive the pool device. Prefer s2 (present after the grow's EFI label);
      # fall back to the fdisk p3 node (older-image compat) so we still get scratch
      # even if the grow was a no-op.
      pfexec devfsadm -c disk 2>/dev/null || devfsadm -c disk 2>/dev/null || true
      if [ -e "/dev/dsk/${_scrdisk}s2" ]; then
        _scrpart="${_scrdisk}s2"
      elif [ -e "/dev/dsk/${_scrdisk}p3" ]; then
        _scrpart="${_scrdisk}p3"
      else
        log "USB scratch: $_scrdisk has no s2/p3 scratch slice even after devfsadm+grow -- leaving TMPDIR on the ramdisk."
        log "             (prtvtoc /dev/rdsk/${_scrdisk}p0 shows the layout; re-run with SOLNIX_SCRATCH_DISK if / fills.)"
        return 0
      fi
      log "USB scratch: boot stick scratch slice is $_scrpart"
      fi   # end: USB stick found (vs NVMe-scratch fallback)
    fi
    # Create the pool on the (pre-carved) partition or the override device --
    # UNLESS the NVMe-scratch fallback above already created solnixscratch (then
    # _scrpart is empty and SCRATCH_ON_TARGET=1).
    if [ -n "$_scrpart" ]; then
    if ! zpool create -f -O compression=on -O atime=off -m "$_scr_mp" solnixscratch "/dev/dsk/${_scrpart}" 2>/tmp/solnix-scratch.err \
         && ! zpool create -f -O compression=on -O atime=off -m "$_scr_mp" solnixscratch "$_scrpart" 2>>/tmp/solnix-scratch.err; then
      log "USB scratch: zpool create on $_scrpart failed:"; sed 's/^/    /' /tmp/solnix-scratch.err >&2 2>/dev/null || true
      log "USB scratch: falling back to the RAM ramdisk"
      return 0
    fi
    # The scratch partition was grown into the stick's free tail BEFORE the pool
    # was created (_grow_scratch_tail above), so the pool already fills the device.
    # autoexpand + online -e remain for the SOLNIX_SCRATCH_DISK whole-disk override
    # path (a raw whole disk grows via online -e).
    zpool set autoexpand=on solnixscratch 2>/dev/null || true
    zpool online -e solnixscratch "/dev/dsk/${_scrpart}" 2>/dev/null \
      || zpool online -e solnixscratch "$_scrpart" 2>/dev/null || true
    fi   # end: shared create (skipped for NVMe-scratch)
  fi
  [ -d "$_scr_mp" ] || { log "USB scratch: pool present but $_scr_mp not mounted -- falling back"; return 0; }

  mkdir -p "$_scr_mp/home" "$_scr_mp/tmp" "$_scr_mp/nix-cache" "$_scr_mp/nix" 2>/dev/null
  HOME="$_scr_mp/home"; export HOME
  TMPDIR="$_scr_mp/tmp"; export TMPDIR
  XDG_CACHE_HOME="$_scr_mp/nix-cache"; export XDG_CACHE_HOME
  # SCRATCH_STORE: a chroot-store on the scratch pool for the NAME GATE's flake
  # eval. `nix eval github:...` COPIES the flake + its (53) inputs into the nix
  # STORE as store paths -- and the default store is the RAM ramdisk /nix, whose
  # inode count is fixed (RD_NBPI). Thousands of small input files exhaust INODES
  # ("/: out of inodes") before bytes, which HOME/TMPDIR redirection does NOT
  # prevent because it does not move the store. Pointing the eval at
  # `--store $SCRATCH_STORE` puts that flake+inputs copy on the scratch pool.
  # (The real toplevel BUILD already uses --store $ALTROOT, the target pool.)
  SCRATCH_STORE="$_scr_mp/nix"; export SCRATCH_STORE
  _scr_kind="USB scratch"; [ "${SCRATCH_ON_TARGET:-0}" = 1 ] && _scr_kind="NVMe-scratch (on target $TARGET)"
  log "$_scr_kind READY: HOME/TMPDIR/XDG_CACHE_HOME/SCRATCH_STORE -> $_scr_mp ($(df -k "$_scr_mp" 2>/dev/null | awk 'NR==2{print $4}')KB free)"
  return 0
}

# setup_media_store -- lofi-mount the READ-ONLY base-closure media store
# (design-two-installer-images.md #2) and wire it as a file:// substituter, so a
# base `nix build` pulls store paths from the MEDIA, not the network.
#
# make-iso-usb.sh packs the base closure + starter set into a standalone ISO9660
# image at /solnix-store.iso INSIDE the boot medium's own ISO9660 filesystem.
# Here we: mount the boot medium ro (same hsfs mount the live method already
# uses to identify it), lofiadm -a the inner /solnix-store.iso, mount THAT ro,
# and export MEDIA_STORE_MNT. build_toplevel adds `--extra-substituters
# file://$MEDIA_STORE_MNT`; the store's paths are signed by cache.solnix.io-1
# (5HAV..., already trusted), so signature trust does the integrity work.
#
# ⚠️ This serves STORE PATHS only. A user's github: flake still fetches its
#    FLAKE INPUTS over the network into the step-#1 scratch partition; only the
#    BASE/default install is made offline by this. All best-effort: any failure
#    leaves MEDIA_STORE_MNT empty and the build falls back to the network cache.
MEDIA_STORE_MNT=""
setup_media_store() {
  [ -n "${SOLNIX_NO_MEDIA_STORE:-}" ] && return 0
  command -v lofiadm >/dev/null 2>&1 || return 0
  _msrc=""
  # Operator override: a path to an already-mounted store dir or a store image.
  if [ -n "${SOLNIX_MEDIA_STORE:-}" ]; then
    if [ -f "${SOLNIX_MEDIA_STORE}/nix-cache-info" ]; then
      MEDIA_STORE_MNT="${SOLNIX_MEDIA_STORE}"
      log "media store: using operator-mounted $MEDIA_STORE_MNT"
      return 0
    fi
    [ -f "$SOLNIX_MEDIA_STORE" ] && _msrc="$SOLNIX_MEDIA_STORE"
  fi
  # Find /solnix-store.iso on the boot medium. Mount each cNtNdNp0 ro as hsfs and
  # look for the store image. Keep the medium mounted (it is read-only; the live
  # method mounts/umounts it transiently, our own ro mount is independent) and
  # lofi-map the inner image IN PLACE -- no 1.3 GB copy into scratch. This is the
  # same content-keyed identification the live method uses, not a device-name guess.
  _medium_mnt=""
  if [ -z "$_msrc" ]; then
    _mm=/var/tmp/solnix-media-root
    mkdir -p "$_mm" 2>/dev/null
    for _p0 in /dev/dsk/c*p0; do
      [ -e "$_p0" ] || continue
      if mount -F hsfs -o ro "$_p0" "$_mm" 2>/dev/null; then
        if [ -f "$_mm/solnix-store.iso" ]; then
          _msrc="$_mm/solnix-store.iso"
          _medium_mnt="$_mm"
          log "media store: found /solnix-store.iso on boot medium $_p0 (mapped in place)"
        else
          umount "$_mm" 2>/dev/null || true
        fi
      fi
      [ -n "$_msrc" ] && break
    done
  fi
  if [ -z "$_msrc" ]; then
    log "media store: no /solnix-store.iso on the boot medium -- base build will use the network cache"
    return 0
  fi
  # lofiadm -a the store image, then mount it ro as hsfs.
  _mdev=$(lofiadm -a "$_msrc" 2>/tmp/solnix-mediastore.err)
  if [ -z "$_mdev" ]; then
    log "media store: lofiadm -a failed:"; sed 's/^/    /' /tmp/solnix-mediastore.err >&2 2>/dev/null || true
    [ -n "$_medium_mnt" ] && umount "$_medium_mnt" 2>/dev/null || true
    return 0
  fi
  _smp=/var/tmp/solnix-media-store
  mkdir -p "$_smp" 2>/dev/null
  # lofiadm prints /dev/lofi/N (block); hsfs mounts off the block device.
  if ! mount -F hsfs -o ro "$_mdev" "$_smp" 2>>/tmp/solnix-mediastore.err; then
    log "media store: mount -F hsfs of $_mdev failed:"; sed 's/^/    /' /tmp/solnix-mediastore.err >&2 2>/dev/null || true
    lofiadm -d "$_mdev" 2>/dev/null || true
    [ -n "$_medium_mnt" ] && umount "$_medium_mnt" 2>/dev/null || true
    return 0
  fi
  if [ ! -f "$_smp/nix-cache-info" ]; then
    log "media store: $_smp mounted but has no nix-cache-info -- not a store image; ignoring"
    umount "$_smp" 2>/dev/null || true; lofiadm -d "$_mdev" 2>/dev/null || true
    return 0
  fi
  MEDIA_STORE_MNT="$_smp"
  log "media store READY: file://$MEDIA_STORE_MNT ($(ls "$_smp"/*.narinfo 2>/dev/null | wc -l | tr -d ' ') narinfo) -> base build is offline-capable"
  return 0
}

# _start_sshd -- OFFER to start sshd after the network is up, so a remote operator
# can ssh in and drive the install. The live media has no baked password by default
# (matching NixOS), so this is opt-in and it enables ROOT login + an empty-password
# login for the live session ONLY (this is throwaway installer media, not an installed
# system). Skips the prompt if SOLNIX_SSHD=1. Best-effort; never fatal.
_start_sshd() {
  command -v sshd >/dev/null 2>&1 || { log "sshd not staged on this media -- cannot offer remote install"; return 0; }
  if [ "${SOLNIX_SSHD:-0}" != 1 ] && [ "${DO_SSHD:-0}" != 1 ]; then
    echo "" >&2
    echo "  Start sshd so you can install REMOTELY (ssh in from another host)?" >&2
    printf '  [y/N]: ' >&2
    read _sa 2>/dev/null || _sa=n
    case "$_sa" in y|Y|yes|YES) ;; *) return 0 ;; esac
  fi
  # host keys: generate if the baked ones are absent (a public image bakes none).
  for _t in rsa ecdsa ed25519; do
    _hk="/etc/ssh/ssh_host_${_t}_key"
    [ -s "$_hk" ] || ssh-keygen -q -t "$_t" -f "$_hk" -N '' 2>/dev/null || true
  done
  # allow root login for the live session. NOTE: an EMPTY root password does NOT work
  # over ssh on illumos -- pam_unix_auth refuses a null password on the network even
  # with PermitEmptyPasswords yes (measured on the X1: sshd prompts, Enter is rejected).
  # So we authenticate one of two real ways, in order of preference:
  #   1. a pubkey the operator supplied (SOLNIX_SSH_PUBKEY) -- zero-friction, no password.
  #   2. a root PASSWORD -- taken from SOLNIX_ROOT_PW if set, else RANDOM and PRINTED here.
  # Either way we set an actual credential BEFORE announcing the service, so the very
  # first ssh attempt succeeds. We do NOT enable PermitEmptyPasswords (it is a footgun
  # that reads as "works" in QEMU and fails on real PAM).
  _sc=/etc/ssh/sshd_config
  if [ -f "$_sc" ]; then
    grep -q '^PermitRootLogin yes' "$_sc" || echo 'PermitRootLogin yes' >> "$_sc"
    # if a pubkey was supplied, ensure pubkey auth is on; always keep password auth on
    # (the random-password path needs it). Remove any PermitEmptyPasswords we may have
    # written on an earlier run -- it does not help and misleads.
    grep -q '^PasswordAuthentication yes' "$_sc" || echo 'PasswordAuthentication yes' >> "$_sc"
    grep -q '^PubkeyAuthentication yes' "$_sc" || echo 'PubkeyAuthentication yes' >> "$_sc"
  fi
  # 1. pubkey path (preferred): install SOLNIX_SSH_PUBKEY into root's authorized_keys.
  _pubkey_done=0
  if [ -n "${SOLNIX_SSH_PUBKEY:-}" ]; then
    mkdir -p /root/.ssh 2>/dev/null; chmod 700 /root/.ssh 2>/dev/null
    if ! grep -qF "$SOLNIX_SSH_PUBKEY" /root/.ssh/authorized_keys 2>/dev/null; then
      printf '%s\n' "$SOLNIX_SSH_PUBKEY" >> /root/.ssh/authorized_keys
    fi
    chmod 600 /root/.ssh/authorized_keys 2>/dev/null
    _pubkey_done=1
    log "installed SOLNIX_SSH_PUBKEY into /root/.ssh/authorized_keys -- key auth enabled"
  fi
  # 2. password path: set a root password so password auth works over ssh. Skip only if
  #    root ALREADY has a real (non-empty, non-locked) password -- the operator set one.
  #    `passwd -s root` prints e.g. "root  PS ..." (PS = password set) / "root  NP" (none)
  #    / "root  LK" (locked). We set one unless it is already PS.
  _rootpw_status=$(passwd -s root 2>/dev/null | awk '{print $2}')
  _shown_pw=""
  if [ "$_rootpw_status" != PS ]; then
    if [ -n "${SOLNIX_ROOT_PW:-}" ]; then
      _newpw="$SOLNIX_ROOT_PW"
    else
      # random 16-char password (no ambiguous chars). od on /dev/urandom is in the proto;
      # fall back to a timestamp-seeded value if od is somehow absent.
      _newpw=$(od -An -N12 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n' | cut -c1-16)
      [ -n "$_newpw" ] || _newpw="solnix$(date +%s | tail -c 7)"
    fi
    # set it non-interactively. illumos passwd reads from a tty; use the SMF-safe
    # route: write the crypted hash via `passwd` stdin is unreliable, so prefer
    # `echo pw | passwd --stdin` when supported, else a here-doc double-entry.
    if passwd root >/dev/null 2>&1 <<EOF2
$_newpw
$_newpw
EOF2
    then :; else
      # some illumos passwd builds want the old pw first (empty) then twice new
      passwd root >/dev/null 2>&1 <<EOF3

$_newpw
$_newpw
EOF3
    fi
    _shown_pw="$_newpw"
    [ -n "${SOLNIX_ROOT_PW:-}" ] && _shown_pw="(the SOLNIX_ROOT_PW you supplied)"
    log "set a root password for the live ssh session"
  fi
  # enable the SMF service if present, else run sshd directly.
  if svcadm enable -s svc:/network/ssh:default 2>/dev/null; then :; 
  else /usr/lib/ssh/sshd 2>/dev/null || /usr/sbin/sshd 2>/dev/null || true; fi
  sleep 1
  _ip=$(ipadm show-addr -p -o addr 2>/dev/null | sed 's,/.*,,' | grep -vE '^(127\.|::1|0\.0\.0\.0)' | head -1)
  if pgrep -x sshd >/dev/null 2>&1 || svcs -H network/ssh 2>/dev/null | grep -q online; then
    echo "" >&2
    echo "  #####################################################################" >&2
    echo "  ##  sshd is up. From another host on this network:" >&2
    if [ "$_pubkey_done" = 1 ] && [ -z "$_shown_pw" ]; then
      echo "  ##      ssh root@${_ip:-<this-machine-ip>}" >&2
      echo "  ##      (authenticate with the private key matching SOLNIX_SSH_PUBKEY)" >&2
    elif [ -n "$_shown_pw" ]; then
      echo "  ##      ssh root@${_ip:-<this-machine-ip>}" >&2
      echo "  ##      root PASSWORD:  $_shown_pw" >&2
      [ "$_pubkey_done" = 1 ] && echo "  ##      (or use the private key matching SOLNIX_SSH_PUBKEY)" >&2
    else
      echo "  ##      ssh root@${_ip:-<this-machine-ip>}" >&2
      echo "  ##      (root already has a password -- use it)" >&2
    fi
    echo "  ##  a flood of agent keys -> 'too many authentication failures'? add:" >&2
    echo "  ##      ssh -o IdentitiesOnly=yes -o IdentityAgent=none root@${_ip:-<ip>}" >&2
    echo "  ##  then run:  solnix-install --flake 'github:USER/REPO#HOST'" >&2
    echo "  #####################################################################" >&2
  else
    log "sshd did not come up -- check: svcs -x network/ssh"
  fi
}

check_internet() {
  _probe_url="${SOLNIX_NET_PROBE:-https://cache.nixos.org/nix-cache-info}"
  _probe_host=$(echo "$_probe_url" | sed -e 's,^[a-z]*://,,' -e 's,/.*,,')
  _dns_ok=0; _fetch_ok=0

  # 1. DNS. getent is in the proto; nslookup is the fallback.
  if command -v getent >/dev/null 2>&1; then
    getent hosts "$_probe_host" >/dev/null 2>&1 && _dns_ok=1
  fi
  if [ "$_dns_ok" = 0 ] && command -v nslookup >/dev/null 2>&1; then
    nslookup "$_probe_host" >/dev/null 2>&1 && _dns_ok=1
  fi

  # 2. A REAL FETCH, with a content assertion. run_to caps it so a black-holed
  #    route cannot hang the installer (curl's own --max-time is belt-and-braces).
  if command -v curl >/dev/null 2>&1; then
    _body=$(run_to 40 curl -fsS --max-time 25 "$_probe_url" 2>/dev/null)
  elif command -v wget >/dev/null 2>&1; then
    _body=$(run_to 40 wget -qO- --timeout=25 "$_probe_url" 2>/dev/null)
  else
    log "neither curl nor wget on this media -- cannot verify internet access"
    return 0   # do not block; the clone will fail with its own message
  fi
  case "$_body" in *StoreDir*|*Priority*) _fetch_ok=1 ;; esac

  if [ "$_fetch_ok" = 1 ]; then
    if [ "$_dns_ok" = 1 ]; then
      log "internet OK: DNS resolved $_probe_host and the HTTPS fetch returned a real cache-info document"
    else
      log "internet OK: HTTPS fetch worked, but DNS lookup of $_probe_host did NOT -- check /etc/hosts or a stale resolver"
    fi
    return 0
  fi

  echo "" >&2
  echo "=== NO INTERNET ACCESS =====================================================" >&2
  if [ "$_dns_ok" = 1 ]; then
    echo "  DNS RESOLVES $_probe_host but the HTTPS FETCH FAILED." >&2
    echo "  Name service works; the route or TLS does not. Check:" >&2
    echo "    netstat -rn                 # is there a default route?" >&2
    echo "    ping -s 1.1.1.1 56 2        # does anything leave the machine?" >&2
  else
    echo "  DNS COULD NOT RESOLVE $_probe_host, and the fetch FAILED." >&2
    echo "    ipadm show-addr             # did any interface get an address?" >&2
    echo "    cat /etc/resolv.conf        # is there a nameserver at all?" >&2
  fi
  echo "" >&2
  echo "  THIS IS ALMOST CERTAINLY THE USB-ETHERNET ADAPTER, NOT WIFI." >&2
  if have_intel_ax2xx; then
    echo "  An Intel AX2xx wifi card IS present in this machine. solnix's native" >&2
    echo "  iwx driver is IN PROGRESS (src/wifi-port): the 802.11 layer compiles" >&2
    echo "  and partial-links, but the module does not yet load/attach -- so wifi" >&2
    echo "  cannot associate TODAY. The firmware blobs are already staged in the" >&2
    echo "  image (hardware.wirelessIwx), so the card is ready the moment the" >&2
    echo "  driver lands. For NOW, install over USB ethernet." >&2
  else
    echo "  No Intel AX2xx wifi card detected; this is the USB-ethernet dongle." >&2
  fi
  echo "  Check the dongle:" >&2
  echo "    dladm show-phys             # is the adapter attached at all?" >&2
  echo "    dladm show-link" >&2
  echo "  illumos ships axf (ASIX AX88172/88178/88772), udmf (Davicom DM9601E)," >&2
  echo "  upf (Prolific) and urf (Realtek RTL8150) -- all Fast Ethernet, and NONE" >&2
  echo "  supports RTL8153, which is what most modern dongles are. If dladm lists" >&2
  echo "  nothing, the adapter is unsupported; an ASIX AX88772 one is the safe buy." >&2
  echo "" >&2
  echo "  SOLNIX_SKIP_NET_CHECK=1 proceeds anyway (later fetches will just fail)." >&2
  return 1
}

detect_target() {
  [ -n "$TARGET" ] && return 0   # explicit --disk / positional wins
  # AUTO-DETECT the target disk so the operator need not type an identifier.
  # Enumerate whole disks by their p0 node (NVMe blkdev disks expose p0, NOT s0 --
  # an *s0 glob MISSES them, which is why the X1's NVMe never listed). Exclude the
  # RUNNING root disk and the boot medium. If EXACTLY ONE eligible disk remains,
  # select it automatically; if several, list them and ask (never guess among
  # multiple real disks -- that risks the wrong one).
  _rootdisk=$(zpool status "$ROOTPOOL" 2>/dev/null | awk '/[0-9]d[0-9]/{gsub(/s[0-9]+$/,"",$1); print $1; exit}')
  _bootfs=$(df -n / 2>/dev/null | awk '{print $NF}')   # e.g. /devices/ramdisk (live) -- usually not a disk
  _cands=""
  for _d in /dev/rdsk/*p0; do
    [ -e "$_d" ] || continue
    _n=$(basename "$_d"); _n=${_n%p0}
    [ -n "$_rootdisk" ] && [ "$_n" = "$_rootdisk" ] && continue   # never the running root
    # skip a disk whose label carries the SOLNIX_INSTALL boot medium (if it even
    # enumerated as a disk -- on the X1 the USB does not, but be safe).
    dd if="/dev/rdsk/${_n}p0" bs=2048 count=64 2>/dev/null | strings 2>/dev/null | grep -q 'SOLNIX_INSTALL' && continue
    _cands="$_cands $_n"
  done
  _cands=$(echo $_cands)   # trim
  _ncand=$(echo $_cands | wc -w | tr -d ' ')
  if [ "$_ncand" = 1 ]; then
    TARGET="$_cands"
    log "auto-selected the only eligible target disk: $TARGET (pass --disk to override)"
  else
    echo "" >&2
    if [ "$_ncand" = 0 ]; then
      echo "No eligible target disk found (illumos enumerated none, or only the boot/root disk)." >&2
      echo "  That is a driver/enumeration problem, not an installer one. Check:" >&2
      echo "    format                          # what disks does illumos see?" >&2
      echo "    prtconf -D | grep -i blkdev     # did the NVMe attach?" >&2
      echo "    devfsadm -C                     # rebuild /dev, then re-run" >&2
    else
      echo "Multiple eligible disks -- choose one with --disk (whole-disk name, no sN/pN suffix):" >&2
      for _n in $_cands; do
        _sz=$(prtvtoc -h "/dev/rdsk/${_n}p0" 2>/dev/null | awk '$1==2{print $5}')
        if [ -n "$_sz" ]; then printf '  %-28s ~%s GiB\n' "$_n" "$(( _sz / 2097152 ))" >&2
        else printf '  %-28s (size unread -- fine, the installer labels it)\n' "$_n" >&2; fi
      done
      echo "" >&2
      echo "  (booted from: ${_bootfs:-unknown}. Do NOT pick a disk you need.)" >&2
      echo "  Re-run: solnix-install --disk <one-of-the-names-above> [other flags]" >&2
    fi
    exit 2
  fi
}

# Only gate on the network when something actually needs it. A purely local
# install (positional toplevel, no --git/--flake) must still work offline.
# --net / --self-update: network-only actions, no disk touched. Placed AFTER
# bring_up_network + check_internet are defined and BEFORE any disk work.
if [ "${DO_NET_ONLY:-0}" = 1 ] || [ "${DO_SELF_UPDATE:-0}" = 1 ] || [ "${DO_SSHD:-0}" = 1 ]; then
  bring_up_network
  if check_internet; then
    log "network is up and reaches the internet."
  else
    die "network is NOT up -- see the guidance above (plug a USB-ethernet dongle if there is no wired link)."
  fi
  # remote-install: offer sshd once the network is up (explicit with --ssh, or offered
  # by --net). --self-update skips the offer (it is about to re-exec).
  if [ "${DO_SSHD:-0}" = 1 ]; then _start_sshd
  elif [ "${DO_NET_ONLY:-0}" = 1 ]; then _start_sshd; fi
  if [ "${DO_SELF_UPDATE:-0}" = 1 ]; then
    _self_url="${SOLNIX_INSTALLER_URL:-https://codeberg.org/gregburd/solnix/raw/branch/main/scripts/solnix-install}"
    _newer="/tmp/solnix-install.updated"
    log "re-fetching the installer from $_self_url"
    if command -v curl >/dev/null 2>&1 && curl -fsSL --max-time 120 "$_self_url" -o "$_newer" 2>/dev/null && [ -s "$_newer" ]; then
      : # fetched with curl
    elif command -v nix >/dev/null 2>&1; then
      _p=$(nix store prefetch-file --name solnix-install-updated "$_self_url" --json 2>/dev/null | sed -n 's/.*"storePath":"\([^"]*\)".*/\1/p')
      [ -n "$_p" ] && cp "$_p" "$_newer" 2>/dev/null || true
    fi
    if [ -s "$_newer" ] && head -1 "$_newer" | grep -q '/sbin/sh'; then
      chmod +x "$_newer"
      log "installer updated -- re-exec'ing $_newer (network already up)."
      # drop --self-update from the re-exec args so we do not loop.
      set -- "$@"   # $@ is already stripped of --self-update by the parser
      exec "$_newer" "$@"
    fi
    die "could not fetch a newer installer from $_self_url -- the current one still works; re-run without --self-update."
  fi
  log "--net: done (no disk was touched)."
  exit 0
fi

if [ -n "$GIT_URL" ] || [ -n "$FLAKE_REF" ]; then
  if [ -n "${SOLNIX_SKIP_NET_CHECK:-}" ]; then
    log "internet check SKIPPED (SOLNIX_SKIP_NET_CHECK set)"
  else
    step "preparing scratch + media store + network"
    # detect_target BEFORE setup_scratch: the NVMe-scratch fallback needs TARGET
    # set (it builds scratch on the chosen target's free space when no USB stick
    # is a disk). detect_target is idempotent + a no-op when --disk was given.
    detect_target
    setup_scratch
    setup_media_store
    bring_up_network
    check_internet || die "no internet access -- see above. NOTHING has been written to any disk."
  fi
fi

if [ -n "$GIT_URL" ]; then
  case "$GIT_URL" in
    git@*|ssh://*)
      echo "WARNING: $GIT_URL needs an ssh key, and the install media has none." >&2
      echo "         Use the https:// form, e.g. https://github.com/<u>/<r>.git" >&2 ;;
  esac
  command -v git >/dev/null 2>&1 || die "git is not on this media; cannot use --git.
  Use nix's own fetcher instead -- pass the repo URL directly to --flake, no git binary needed:
    solnix-install --flake 'github:<user>/<repo>#<attr>'
    solnix-install --flake 'git+https://host/user/repo.git#<attr>'
  (the live media stages nix but not git, whose 150 hardlinks would bloat the ramdisk ~800MB)"
  CFGDIR="${SOLNIX_CFGDIR:-/var/tmp/solnix-config}"
  # Move a previous clone aside rather than deleting it: on a live installer the
  # operator may be retrying after a failure and the old tree can hold clues.
  [ -d "$CFGDIR" ] && mv "$CFGDIR" "$CFGDIR.prev.$$" 2>/dev/null
  log "cloning $GIT_URL"
  if [ -n "$GIT_REF" ]; then
    git clone --quiet "$GIT_URL" "$CFGDIR" || die "git clone failed: $GIT_URL"
    ( cd "$CFGDIR" && git checkout --quiet "$GIT_REF" ) || die "git checkout $GIT_REF failed"
  else
    # --depth 1 keeps a slow USB-ethernet link honest; flakes need no history.
    git clone --quiet --depth 1 "$GIT_URL" "$CFGDIR" || die "git clone failed: $GIT_URL"
  fi
  [ -f "$CFGDIR/flake.nix" ] || die "$GIT_URL has no flake.nix at its root"
  log "cloned to $CFGDIR ($(cd "$CFGDIR" && git rev-parse --short HEAD 2>/dev/null))"
  # A bare `.#attr` is relative to the CLONE, not to $PWD.
  case "$FLAKE_REF" in .#*) FLAKE_REF="$CFGDIR#${FLAKE_REF#.#}" ;; esac
  case "$HOME_FLAKE" in .#*) HOME_FLAKE="$CFGDIR#${HOME_FLAKE#.#}" ;; esac
fi

if [ -n "$FLAKE_REF" ]; then
  command -v nix >/dev/null 2>&1 || die "nix is not on this media; cannot use --flake"
  _fl="${FLAKE_REF%%#*}"; _at="${FLAKE_REF#*#}"
  step "resolving $_at in $_fl"
  # Try the solnix analog first, then the NixOS name, so either repo layout works:
  # solnix owns solnixConfigurations; a nix-config may own nixosConfigurations.
  _drv=""; _found=""
  # RAMDISK-SAFE ATTR GATE. builtins.fetchClosure (starter.nix, default.nix)
  # SUBSTITUTES its paths AT EVAL TIME, so evaluating the toplevel's drvPath
  # realizes the whole starter closure into /nix -- which on the live media is a
  # ~620MB RAM ramdisk, and it fills it ("alloc: /: file system full"). A
  # NAME-only eval (attrNames) is lazy and realizes NOTHING (measured: store
  # delta 0), so it proves the attr EXISTS without touching disk. The real
  # drvPath instantiation + build happen later, with the store on the target
  # pool (see the build block), not the ramdisk.
  # DISK PRECHECK: even this lazy name gate makes nix FETCH the flake into the
  # ramdisk (~/.cache/nix), which fails on a full /. A previous failed --flake
  # attempt (or an old drvPath-gate installer) can leave the ~620MB ramdisk full,
  # and then this eval fails to WRITE, not because the attr is missing -- which
  # used to misreport as "nothing to install". Check free space and say the real
  # thing: reboot the live media (the ramdisk is RAM; a reboot gives a fresh one).
  _freek=$(df -k / 2>/dev/null | awk 'NR==2{print $4}')
  case "$_freek" in ''|*[!0-9]*) : ;; *) if [ "$_freek" -lt 51200 ]; then
    echo "" >&2
    echo "FATAL: only ${_freek}KB free on / -- too little for nix to even fetch the flake." >&2
    echo "The live media's / is a ~620MB RAM ramdisk; a previous failed attempt likely" >&2
    echo "filled it. REBOOT the installer (the ramdisk is RAM -- a reboot gives a fresh" >&2
    echo "one), then re-run. The build itself goes to the target pool, not the ramdisk." >&2
    die "insufficient ramdisk space to resolve the flake -- reboot and retry"
  fi ;; esac

  # The flake fetch + input copy the name gate triggers goes into the nix STORE.
  # Default store = the RAM ramdisk /nix (fixed inode count) -> "/: out of inodes"
  # when a flake's many inputs are copied in (measured: a real flake copies ~100k
  # files into the store). Point the eval at the scratch-pool store when one is
  # prepared. If NO scratch store (setup_scratch fell back to the ramdisk), the
  # eval WILL exhaust the ramdisk -- so refuse rather than fail cryptically.
  _gatestore=""
  if [ -n "${SCRATCH_STORE:-}" ]; then
    _gatestore="--store $SCRATCH_STORE"
    log "name gate: flake eval store on scratch pool ($SCRATCH_STORE)"
  else
    echo "" >&2
    echo "FATAL: no writable scratch store for the flake eval, and the live root is a" >&2
    echo "small RAM ramdisk. Resolving a flake copies ~100k files into the nix store," >&2
    echo "which would exhaust the ramdisk (\"/: out of inodes\"). setup_scratch did not" >&2
    echo "prepare a scratch pool -- no USB scratch stick attached (scsa2usb may not bind on" >&2
    echo "this USB controller) AND the NVMe-scratch-on-target fallback did not run (no target" >&2
    echo "disk was chosen, or its create failed). Re-run PASSING THE TARGET DISK as the first" >&2
    echo "argument (solnix-install <cNtNdN> --flake ...), which enables NVMe-scratch on it, or" >&2
    echo "set SOLNIX_SCRATCH_DISK=<cNtNdN> to a spare disk / SECOND USB stick (whole-disk;" >&2
    echo "ERASED), or use a media image whose scratch partition is large enough (SCRATCH_MB>=4096)." >&2
    die "no scratch store for flake eval -- refusing to fill the ramdisk"
  fi

  for _set in solnixConfigurations nixosConfigurations; do
    # Capture stderr so we can tell "attr genuinely absent" from "eval FAILED"
    # (disk full / no network / bad flake) -- the latter must not masquerade as
    # "nothing to install".
    # LONG STEP: the flake fetch + input copy can take minutes on a slow link.
    spin_start "fetching + evaluating the flake ($_set)"
    _ev=$(nix eval $_gatestore "${_fl}#${_set}" --apply \
         "x: if builtins.hasAttr \"${_at}\" x then \"yes\" else \"no\"" --raw 2>/tmp/solnix-gate.err)
    _rc=$?
    spin_stop
    if [ "$_rc" = 0 ] && [ "$_ev" = yes ]; then
      _found="$_set"; _drv="(name-verified; drvPath deferred to the pool-backed build)"; break
    fi
    # rc!=0 AND the attrset itself did not evaluate (not merely a missing member)
    # means a real failure. If the err mentions space/network, surface THAT.
    if [ "$_rc" != 0 ] && grep -qiE 'no space|file system full|out of inodes|could not resolve|unable to download|connection|SSL' /tmp/solnix-gate.err 2>/dev/null; then
      echo "" >&2
      echo "FATAL: could not evaluate '$_at' -- nix eval failed for a reason that is NOT a" >&2
      echo "missing attribute. The error was:" >&2
      tail -5 /tmp/solnix-gate.err | sed 's/^/  /' >&2
      die "flake resolution failed (disk/network), NOT a missing config -- fix the above and retry"
    fi
  done
  if [ -z "$_drv" ]; then
    echo "" >&2
    echo "FATAL: no system configuration named '$_at' in $_fl" >&2
    echo "" >&2
    for _set in solnixConfigurations nixosConfigurations homeConfigurations; do
      echo "  $_set:" >&2
      nix eval --raw "${_fl}#${_set}" --apply \
        'x: builtins.concatStringsSep "\n" (builtins.attrNames x)' 2>/dev/null \
        | sed 's/^/    /' >&2 || echo "    (none)" >&2
    done
    echo "" >&2
    die "nothing to install -- refusing to touch ${TARGET:-the disk}"
  fi
  log "attr gate OK: ${_found}.\"$_at\" -> $_drv"
fi

# ---------------------------------------------------------------------------
# 0c. BUILD THE TOPLEVEL FROM THE FLAKE (step 7, the build half).
#
# This is what replaces the cpio path lists: instead of enumerating files to copy,
# we realise a store path whose CLOSURE is the system, and later copy that closure.
#
# ⚠️ STORE MUST BE ON REAL DISK, NOT THE RAMDISK. builtins.fetchClosure and the
# build both realise gigabytes into /nix, and the live media's /nix is a ~620MB
# RAM ramdisk ("alloc: /: file system full"). So the build is a FUNCTION invoked
# AFTER the target pool exists, with the nix store + TMPDIR on the pool
# ($ALTROOT/nix on the target disk). The ramdisk-safe NAME gate above already
# proved the attr exists, so a typo still fails before any disk is touched; what
# moves past the disk step is only the heavy realisation, which has nowhere else
# to go. A build failure after this point is handled by build_toplevel's own
# die(), and the pool it half-populated is on the target disk we are installing
# to anyway, so nothing the operator wanted to keep is at risk.
build_toplevel() {
  [ -n "$FLAKE_REF" ] && [ -z "$TOPLEVEL" ] || return 0
  step "building the system toplevel from $FLAKE_REF (the long step)"
  _fl="${FLAKE_REF%%#*}"; _at="${FLAKE_REF#*#}"
  # The attr set was determined by the gate above ($_found); reuse it rather than
  # guessing again, so build and gate cannot disagree about what they resolved.
  _set="${_found:-solnixConfigurations}"
  _outlink="$ALTROOT/var/tmp/solnix-toplevel-$$"
  mkdir -p "$ALTROOT/var/tmp" "$ALTROOT/nix/store" 2>/dev/null || true
  # Store + TMPDIR on the target pool, NOT the ramdisk. The pool's store IS the
  # installed system's store, so paths realised here need no later copy across a
  # store boundary -- they are already where the booted system will find them.
  #
  # Log to a FILE and test nix build's OWN exit, not a pipe's. `if nix build ... |
  # tail` would test tail (always 0), masking a build failure -- the same
  # pipe-hides-exit trap that a 2>/dev/null once hid in the media cpio. /sbin/sh
  # has no PIPESTATUS, so a logfile is the portable fix; tail it for the operator.
  _buildlog="$ALTROOT/var/tmp/solnix-build-$$.log"
  # If the read-only media store is mounted, offer it as an EXTRA substituter so
  # the base closure's store paths come from the media (offline) instead of the
  # network. It is ADDITIVE: the network cache still fills anything the media
  # lacks (e.g. a user flake's own inputs). Its paths are signed by the trusted
  # cache.solnix.io-1 key, so no extra-trusted-public-keys flag is needed.
  _extrasub=""
  [ -n "${MEDIA_STORE_MNT:-}" ] && _extrasub="--extra-substituters file://$MEDIA_STORE_MNT"
  [ -n "$_extrasub" ] && log "base build: using media store substituter file://$MEDIA_STORE_MNT (offline-capable)"
  # ⚠️ REDIRECT EVERY NIX SCRATCH ONTO THE POOL for the build. MEASURED (X1
  # build-inode diag): the live ramdisk / is ~99% full AT BOOT (only ~9M free of
  # 629M -- 613M is the base media). --store $ALTROOT puts the STORE (both the
  # flake+input eval copy AND the build outputs) on the pool, but nix ALSO writes its eval cache, flake registry, and flake
  # source unpack under $HOME/.cache + $TMPDIR -- and if setup_scratch's scratch
  # pool did NOT mount (it fell back to the ramdisk), those defaulted to / and
  # tipped the 9M-free ramdisk over ("/: out of inodes / no space"). By build
  # time the target pool IS mounted at $ALTROOT (928G), so point HOME + the nix
  # caches THERE unconditionally -- independent of whether the earlier scratch
  # pool mounted. This is the robust fix: the pool, not a maybe-mounted scratch.
  mkdir -p "$ALTROOT/var/tmp" "$ALTROOT/root/.cache" 2>/dev/null || true
  HOME="$ALTROOT/root"; export HOME
  XDG_CACHE_HOME="$ALTROOT/root/.cache"; export XDG_CACHE_HOME
  # ⚠️ BELT-AND-BRACES, AT THE ACTUAL BUILD SITE. Even though the caller verified
  # the mount before calling us, re-assert here that $ALTROOT is a REAL ZFS mount
  # with real free space -- this is the last gate before `--store $ALTROOT` writes
  # gigabytes. The X1 5/9 failure was writing the store into the ~9M RAM ramdisk
  # because $ALTROOT looked like a directory but was not the mounted pool; catch
  # that here with the mount property AND a hard free-space floor, and fail LOUD
  # rather than let nix build fill the ramdisk and die with a cryptic ENOSPC.
  _bt_mounted=$(run_to 15 zfs get -H -o value mounted "$BEDS" 2>/dev/null || echo unknown)
  _bt_availk=$(df -k "$ALTROOT" 2>/dev/null | awk 'NR==2{print $4}')
  _bt_fs=$(df -n "$ALTROOT" 2>/dev/null | sed -n 's/.*: *//p')
  case "$_bt_fs" in *zfs*) : ;; *)
    echo "" >&2
    echo "FATAL: build store $ALTROOT is on fstype '${_bt_fs:-unknown}', not zfs" >&2
    echo "  (zfs mounted=$_bt_mounted). The target pool is not mounted at $ALTROOT, so" >&2
    echo "  \`nix build --store $ALTROOT\` would write into the RAM ramdisk and overflow it." >&2
    echo "  Nothing outside the target disk has been touched. Re-run; if it persists," >&2
    echo "  check \`zfs get mounted $BEDS\` and \`zpool status $POOL\`." >&2
    die "refusing to build the toplevel into the ramdisk (store $ALTROOT is not the zfs pool)" ;;
  esac
  # Free-space floor: a full solnix toplevel closure is many GB; a store with only
  # a few MB free is the ramdisk, not the 928G pool. 2 GiB is a conservative floor
  # that a real pool clears trivially and the 9M ramdisk cannot.
  case "$_bt_availk" in
    ''|*[!0-9]*) log "note: could not read df -k avail for $ALTROOT; trusting zfs mounted=$_bt_mounted" ;;
    *) if [ "$_bt_availk" -lt 2097152 ]; then
         echo "" >&2
         echo "FATAL: only ${_bt_availk}KB free at the build store $ALTROOT -- far too little" >&2
         echo "  for the toplevel closure. That is the RAM ramdisk, not the target pool." >&2
         echo "  The pool did not mount at $ALTROOT (zfs mounted=$_bt_mounted). Re-run." >&2
         die "insufficient free space at $ALTROOT -- the target pool is not mounted there"
       fi ;;
  esac
  log "build store OK: $ALTROOT is zfs (mounted=$_bt_mounted, ${_bt_availk:-?}KB free) -- building into the pool"
  # LONG STEP: spinner + elapsed while nix build runs (minutes to ~1h). The build
  # log grows in $_buildlog; a background tail feeds the spinner's last-line so
  # the operator sees forward motion, not a frozen console. nix's own
  # --log-format is deliberately NOT used for the display (bar/bar-with-logs
  # assume a smart terminal that the framebuffer console is not); we show our
  # own dumb spinner + the last log line instead.
  spin_start "nix build system toplevel (this can take many minutes)"
  ( while [ -f "$_buildlog" ]; do
      _ll=$(tail -1 "$_buildlog" 2>/dev/null | cut -c1-70)
      [ -n "$_ll" ] && printf '\r      %-72s' "$_ll" >&2
      sleep 5
    done ) &
  _blt=$!
  # ⚠️ NO --eval-store. A separate --eval-store makes nix treat it as a DIVERTED
  # store, and illumos single-user nix REFUSES to realise a derivation in a diverted
  # store ("building using a diverted store is not supported on this platform"). The
  # flake's `lib = import "${nixpkgs}/lib"` (nixpkgs = solnix-pkgs.lib.nixpkgsSrc, an
  # applyPatches DERIVATION) forces exactly that realisation at eval time -> fatal on
  # the X1. A plain --store $ALTROOT is a CHROOT store (not diverted): it
  # substitutes/realises normally AND still lands the eval source copy on the pool,
  # so the ramdisk-inode reason --eval-store was added for is already covered. The
  # name gate (step 2, --store $SCRATCH_STORE) already proved --store works on illumos.
  # Resolve the patched-nixpkgs store path directly from the config flake's
  # solnix-pkgs input via getFlake (see _solnix_nixpkgs_src). Pre-copy it so eval
  # substitutes it instead of building it in the diverted store.
  # Resolve WITH stderr captured to the build log -- the eval overflowing the
  # ramdisk cache used to be invisible (paste.rs/P46jo: empty result -> pre-copy
  # skipped -> the build hit "diverted store" and died). Pool-backed cache/tmp now.
  log "resolving the patched-nixpkgs source path (getFlake, pool-backed cache)"
  _pn=$(_solnix_nixpkgs_src "${_fl%#*}" 2>>"$_buildlog")
  if [ -z "$_pn" ]; then
    echo "" >&2
    echo "FATAL: could not resolve the patched-nixpkgs source path via getFlake." >&2
    echo "  This path MUST be pre-copied: the flake's \`import \"\${nixpkgs}/lib\"\`" >&2
    echo "  forces realising an applyPatches derivation, and illumos single-user nix" >&2
    echo "  REFUSES to build one in the target store (\"diverted store\"). Without the" >&2
    echo "  pre-copy the toplevel build cannot succeed, so failing now rather than" >&2
    echo "  letting the build die later with a misleading error." >&2
    echo "  The eval's own error is in $_buildlog (tail below):" >&2
    tail -20 "$_buildlog" 2>/dev/null | sed 's/^/    /' >&2 || true
    die "patched-nixpkgs resolve failed -- see $_buildlog"
  fi
  log "pre-copying the patched nixpkgs source into the target store so eval need not build it: $_pn"
  run_to 900 nix copy --to "$ALTROOT" $_extrasub \
    --option substituters "https://cache.solnix.io https://s3.solnix.io/solnix-cache" \
    "$_pn" >> "$_buildlog" 2>&1 \
    || die "pre-copy of $_pn failed -- the build would hit the diverted-store error; see $_buildlog"
  [ -e "$ALTROOT$_pn" ] || die "pre-copy claimed success but $ALTROOT$_pn is absent -- see $_buildlog"
  if run_to "${SOLNIX_BUILD_TIMEOUT:-14400}" env \
       HOME="$ALTROOT/var/tmp" XDG_CACHE_HOME="$ALTROOT/var/tmp/solnix-nixcache" \
       TMPDIR="$ALTROOT/var/tmp" nix build \
       --store "$ALTROOT" \
       $_extrasub \
       "${_fl}#${_set}.\"${_at}\".config.system.build.toplevel" \
       --out-link "$_outlink" > "$_buildlog" 2>&1; then
    kill "$_blt" 2>/dev/null; wait "$_blt" 2>/dev/null; spin_stop
    tail -40 "$_buildlog"
    TOPLEVEL=$(_readlink "$_outlink" 2>/dev/null || true)
    # --store $ALTROOT prints a bare /nix/store/... path (the store's own view).
    # KEEP it bare: the closure-verify and activation below all address paths as
    # $ALTROOT$TOPLEVEL, matching the copy-based flow. Mark that the closure is
    # already on the pool so the copy step is skipped.
    TOPLEVEL_ON_POOL=1
  else
    kill "$_blt" 2>/dev/null; wait "$_blt" 2>/dev/null; spin_stop
    tail -40 "$_buildlog"   # show the failure tail before build_toplevel die()s below
  fi
  # Validate against the on-pool location ($ALTROOT + the bare store path).
  if [ -z "$TOPLEVEL" ] || { [ ! -d "$TOPLEVEL" ] && [ ! -d "$ALTROOT$TOPLEVEL" ]; }; then
    echo "" >&2
    echo "The attr ${_set}.\"$_at\" EXISTS (the name gate proved that) but its" >&2
    echo "toplevel FAILED TO BUILD. Those are different claims; only the build" >&2
    echo "failed. The target pool may be partly populated, but nothing outside" >&2
    echo "the disk you chose to install to has been touched." >&2
    echo "" >&2
    echo "Re-run the build by hand to see the full log:" >&2
    echo "  TMPDIR=$ALTROOT/var/tmp nix build --store $ALTROOT ${_fl}#${_set}.\\\"${_at}\\\".config.system.build.toplevel -L" >&2
    die "toplevel build failed"
  fi
  log "toplevel built: $TOPLEVEL"
  # Where the toplevel actually lives on disk: bare path if copy-flow, $ALTROOT+bare if on-pool.
  _tlreal="$TOPLEVEL"; [ "${TOPLEVEL_ON_POOL:-0}" = 1 ] && _tlreal="$ALTROOT$TOPLEVEL"

  # Assert it LOOKS like a system before we rely on it. Each of
  # these has been absent in a real toplevel at some point in this repo's history,
  # and every one of them is load-bearing at boot or at switch time.
  _tl_missing=""
  for _need in activate systemPath bin/switch-to-configuration; do
    [ -e "$_tlreal/$_need" ] || _tl_missing="$_tl_missing $_need"
  done
  if [ -n "$_tl_missing" ]; then
    echo "toplevel $_tlreal is missing:$_tl_missing" >&2
    echo "It built, but it is not a bootable system -- refusing to install it." >&2
    die "incomplete toplevel"
  fi
  # The kernel specifically: a toplevel with no unix/genunix cannot boot, and the
  # failure would appear only as the loader saying "Failed to find bootable
  # partition" long after the disk was erased.
  for _need in systemPath/platform/i86pc/kernel/amd64/unix systemPath/kernel/amd64/genunix; do
    [ -s "$_tlreal/$_need" ] || die "toplevel has no $_need -- it cannot boot; refusing to install"
  done
  log "toplevel gate OK: activate + switch-to-configuration + unix + genunix all present"
}

# ⚠️ With no argument this used to print only a usage string, which reads on a
# console as "no disks listed" -- the operator cannot act on it. List what is
# actually enumerated, and name the boot medium so it is obvious which NOT to pick.
# detect_target here too (idempotent) so the offline/positional path -- which
# skips the network-gate block above where detect_target first runs -- still
# auto-selects a target rather than dying on an empty TARGET.
detect_target
[ -e "/dev/rdsk/${TARGET}s0" ] || [ -e "/dev/rdsk/${TARGET}p0" ] \
  || die "target disk $TARGET not present (attach + reboot so illumos enumerates it). NVMe blkdev disks expose p0, not s0, until labeled -- both are accepted here."

# guards derived from the RUNNING root pool: never touch it or its disk.
ROOTDISK=$(zpool status "$ROOTPOOL" 2>/dev/null | awk '/[0-9]d[0-9]/{gsub(/s[0-9]+$/,"",$1); print $1; exit}')
[ -n "$ROOTDISK" ] && [ "$TARGET" = "$ROOTDISK" ] && die "refusing to install onto the running root disk $TARGET (pool $ROOTPOOL)"
[ "$POOL" = "$ROOTPOOL" ] && die "target pool '$POOL' == the RUNNING root pool; choose a different SOLNIX_POOL (the installed disk gets its own pool)"
# rpool is the CORRECT name for a fresh illumos root install (this is a laptop
# getting its OS), so do NOT blanket-refuse it. Only refuse when an rpool ALREADY
# EXISTS somewhere we would clobber -- imported, or a label on a disk that is NOT
# our target -- which is the fat-finger this guards (a host whose real root pool
# is not named rpool, but a stale rpool label sits on another disk). A fresh
# target with no existing rpool proceeds. SOLNIX_ALLOW_RPOOL=1 forces past even an
# existing one; SOLNIX_POOL=<name> picks a different name (the gate uses spool).
if [ "$POOL" = "rpool" ] && [ -z "${SOLNIX_ALLOW_RPOOL:-}" ]; then
  # Detect an existing rpool: imported now, OR offered by `zpool import` as a pool
  # literally named rpool. `zpool import` prints a "  pool: rpool" line only when
  # one is actually importable (the earlier awk/grep heuristic misfired).
  _rpool_exists=0
  _rpool_where=""
  if zpool list -H -o name rpool >/dev/null 2>&1; then
    _rpool_exists=1; _rpool_where="imported"
  elif zpool import 2>/dev/null | grep -qE '^[[:space:]]*pool:[[:space:]]+rpool[[:space:]]*$'; then
    _rpool_exists=1; _rpool_where="importable (on-disk label)"
  fi
  if [ "$_rpool_exists" = 1 ]; then
    # An rpool exists. Do NOT silently clobber, and do NOT demand an env var --
    # ASK. Most often it is this operator's OWN prior-attempt leftover on the disk
    # they are installing to; destroying + recreating it is exactly right. Show
    # what it is and where, so the operator can refuse if it is a pool they need.
    echo "" >&2
    echo "=== An rpool ALREADY EXISTS ($_rpool_where) ===============================" >&2
    echo "  This installer creates a pool named 'rpool' on the target disk:" >&2
    echo "    target: $TARGET" >&2
    echo "  and an rpool already exists. Its vdev(s):" >&2
    { zpool status rpool 2>/dev/null || zpool import rpool 2>/dev/null || zpool import 2>/dev/null; } \
      | sed 's/^/      /' >&2
    echo "" >&2
    echo "  If this is a PRIOR solnix install attempt on $TARGET, destroying it is" >&2
    echo "  the right thing -- the disk is about to be erased for the install anyway." >&2
    echo "  If it is a pool you NEED (a real root on another disk), answer no." >&2
    if [ -t 0 ] && [ -t 1 ]; then
      printf '  Destroy the existing rpool and recreate it for this install? [y/N]: ' >&2
      read -r _dr || _dr=n
    else
      _dr="${SOLNIX_DESTROY_RPOOL:-n}"   # non-interactive: SOLNIX_DESTROY_RPOOL=y to allow
      echo "  (non-interactive; SOLNIX_DESTROY_RPOOL=${_dr})" >&2
    fi
    case "$_dr" in
      y|Y|yes|YES)
        log "rpool: operator confirmed destroy+recreate -- tearing down the existing rpool."
        # ⚠️ A SUSPENDED / FAULTED / UNAVAIL pool cannot be torn down from userland AT
        # ALL. destroy, export AND labelclear all block in an uninterruptible kernel
        # I/O wait (D-state) on the dead pool/its disks; run_to's timeout sends a
        # signal a D-state process CANNOT receive, so every one of them hangs forever
        # (measured on the X1: destroy hung, then export hung the same way). The
        # suspension lives ONLY in live-kernel memory -- a REBOOT is the sole escape,
        # after which the pool is not imported and labelclear on the raw disk works.
        # So: if the pool is unhealthy, attempt NOTHING on it -- print the reboot
        # recovery and exit cleanly, rather than wedge on a hang no timeout can kill.
        _rpool_health=$(run_to 10 zpool list -H -o health rpool 2>/dev/null || echo UNKNOWN)
        _rpool_suspended=0
        case "$_rpool_health" in
          ONLINE|DEGRADED) ;;   # healthy enough to destroy normally
          *) _rpool_suspended=1 ;;   # SUSPENDED/FAULTED/UNAVAIL/UNKNOWN/cannot-open
        esac
        run_to 10 zpool status rpool 2>/dev/null | grep -qiE 'suspended|UNAVAIL|FAULTED|cannot open' && _rpool_suspended=1
        if [ "$_rpool_suspended" = 1 ]; then
          echo "" >&2
          echo "=== rpool is SUSPENDED (health=$_rpool_health) -- REBOOT REQUIRED ============" >&2
          echo "  The existing rpool has faulted I/O and is SUSPENDED in the live kernel." >&2
          echo "  It CANNOT be destroyed, exported, or label-cleared from here -- every" >&2
          echo "  such command blocks forever on the dead pool (no timeout can kill it)." >&2
          echo "  The suspension lives only in kernel memory, so:" >&2
          echo "" >&2
          echo "    1. Reboot the live media:   reboot     (or: uadmin 2 1, or power-cycle)" >&2
          echo "    2. After it comes back, the pool will NOT be imported. Clear the disk:" >&2
          echo "         zpool labelclear -f /dev/dsk/${TARGET}p0" >&2
          echo "         zpool labelclear -f /dev/dsk/${TARGET}s0" >&2
          echo "    3. Bring up the network, re-fetch the installer, and re-run." >&2
          echo "" >&2
          echo "  Nothing outside the target disk has been touched." >&2
          die "rpool: suspended pool needs a reboot to clear (see the steps above)."
        fi
        run_to 30 zfs unmount -a 2>/dev/null || true
        run_to 60 zpool destroy -f rpool 2>/dev/null \
          || { run_to 60 zpool import -f rpool 2>/dev/null && run_to 60 zpool destroy -f rpool 2>/dev/null; } \
          || true
        # clear any surviving labels on the target so the fresh whole-disk create is
        # not refused (belt-and-braces; pool create also relabels). Reached only for
        # a HEALTHY pool that was destroyed above, so these do not block on dead I/O.
        for _tn in "${TARGET}s0" "${TARGET}s1" "${TARGET}p0" "${TARGET}"; do
          [ -e "/dev/dsk/$_tn" ] && run_to 30 zpool labelclear -f "/dev/dsk/$_tn" 2>/dev/null || true
        done
        # verify it is gone before proceeding.
        if run_to 10 zpool list -H -o name rpool >/dev/null 2>&1; then
          die "rpool: could not destroy the existing rpool (still imported) -- resolve it by hand, then re-run."
        fi
        log "rpool: existing pool destroyed; proceeding with a fresh rpool on $TARGET."
        ;;
      *)
        die "rpool: operator declined to destroy the existing rpool. Choose a different SOLNIX_POOL=<name>, or install to a different target."
        ;;
    esac
  else
    log "POOL=rpool: no existing rpool -- fresh root install, proceeding (the standard illumos root pool name)."
  fi
fi

# default toplevel: the running system. If neither a toplevel arg nor a
# /run-current-system link exists (the LIVE-INSTALLER case, where the ramdisk
# root IS the complete bootable illumos world), fall back to SELF-INSTALL: copy
# the running root as the installed system, skipping the nix-closure steps.
# This is the offline-bakeable path — the baked "system" is the live root.
#
# DECLARATIVE toplevel detection: a full toplevel has activate/; the REDUCED
# current-system (overlay path, scratch/current-system.nix) has NO activate but
# IS declarative — it carries sw/ (userland+nix) + etc/nix/nix.conf. Treat a
# toplevel with sw/bin/nix-store as declarative even without activate, so the
# installer copies its closure into the target /nix/store + wires the Stage-A
# userland (the activate-dependent steps self-guard on file presence below).
SELF_INSTALL=0
if [ -z "$TOPLEVEL" ] && [ -z "$FLAKE_REF" ]; then
  TOPLEVEL=$(_readlink /run-current-system 2>/dev/null || true)
fi
if [ -n "$FLAKE_REF" ]; then
  # A --flake was given: the toplevel is BUILT from it by build_toplevel LATER,
  # after the target pool is mounted at $ALTROOT (the flake build + eval-store
  # need real disk). Do NOT decide SELF-INSTALL here on an empty $TOPLEVEL -- that
  # is the ordering bug that made a --flake install silently fall into SELF-INSTALL
  # (copy the live root) instead of building dixi. Defer: build_toplevel runs after
  # the pool exists and sets $TOPLEVEL; the SELF-INSTALL/declarative branches below
  # are re-evaluated against that real toplevel.
  log "flake install: toplevel will be BUILT from $FLAKE_REF after the pool is ready (not SELF-INSTALL)"
elif [ -z "$TOPLEVEL" ]; then
  SELF_INSTALL=1
  log "no nix toplevel present and no --flake -> SELF-INSTALL: install the running live root as the system"
elif [ -e "$TOPLEVEL/activate" ] || [ -e "$TOPLEVEL/sw/bin/nix-store" ] || [ -e "$TOPLEVEL/sw" ]; then
  # A solnix current-system carries sw/ (the composed userland profile). The
  # 2.24 release toplevel ships nix as the store package on sw/bin/nix-store (systemPackages), so
  # accept a bare sw/ as a declarative(-overlay) toplevel -> copy its closure.
  [ -d "$TOPLEVEL" ] || die "toplevel $TOPLEVEL not found"
  [ -e "$TOPLEVEL/activate" ] || log "declarative overlay toplevel (sw/ present, no activate) -> installing declarative userland layer"
else
  SELF_INSTALL=1
  log "toplevel $TOPLEVEL has neither activate/ nor sw/bin/nix-store -> SELF-INSTALL"
fi
# OVERLAY: a declarative toplevel with NO systemPath (the reduced overlay
# current-system). Kernel/libc/SMF come from the copied illumos root; we only
# add the nix userland layer. Repo-handling matches SELF-INSTALL (keep the
# copied, working repository.db — do NOT reseed from the minimal global.db).
OVERLAY=0
if [ -z "$FLAKE_REF" ] && [ "$SELF_INSTALL" = 0 ] && [ ! -e "$TOPLEVEL/systemPath" ]; then
  OVERLAY=1
  log "declarative OVERLAY install (no systemPath): base OS from copied root + nix userland layer"
fi
# For a --flake install the OVERLAY decision is DEFERRED: $TOPLEVEL is empty until
# build_toplevel runs (after the pool), so testing $TOPLEVEL/systemPath now would
# wrongly force OVERLAY=1. build_toplevel + the post-build closure copy below key
# off TOPLEVEL_ON_POOL and the real toplevel's systemPath instead.

log "installing toplevel $TOPLEVEL onto $TARGET (pool $POOL, BE $BEDS)"
log "base world = the running root ($SRCROOT); running root pool=$ROOTPOOL disk=${ROOTDISK:-unknown}"

# ---------------------------------------------------------------------------
# 0. tear down any prior attempt on the target (idempotent; the hang fix).
#    A prior run may have left a pool IMPORTED + mounted on the target disk
#    (that wedged the re-run). Find and destroy/export ANY pool sitting on the
#    target disk's slices, not just one named $POOL, then unmount /a.
# ---------------------------------------------------------------------------
log "cleaning prior attempt on $TARGET (any pool, imported or not)"
run_to 30 umount "$ALTROOT/esp" 2>/dev/null || true
# 0-scratch. If setup_scratch built solnixscratch ON THIS TARGET disk (the
#     NVMe-scratch fallback, when no USB scratch attached), tear it down NOW,
#     explicitly and verifiably, BEFORE the fresh EFI label below. A leftover
#     scratch pool would make `zpool create solnixtmp <wholedisk>` fail ("device
#     is part of a pool") and strand the install. The generic 0a loop below also
#     catches it, but this is the guaranteed, logged teardown the install pool
#     create depends on -- and it unmounts the scratch mount + frees HOME/TMPDIR
#     that were pointed at it.
if zpool list solnixscratch >/dev/null 2>&1 \
   && { [ "${SCRATCH_ON_TARGET:-0}" = 1 ] || zpool status solnixscratch 2>/dev/null | grep -q "$TARGET"; }; then
  log "NVMe-scratch: destroying solnixscratch on $TARGET before the install pool create"
  # move HOME/TMPDIR off the pool first so nothing holds it busy.
  HOME=/root; TMPDIR=/tmp; XDG_CACHE_HOME=/root/.cache; SCRATCH_STORE=""
  export HOME TMPDIR XDG_CACHE_HOME
  run_to 30 zfs unmount solnixscratch 2>/dev/null || true
  run_to 30 zpool destroy -f solnixscratch 2>/dev/null || run_to 30 zpool export -f solnixscratch 2>/dev/null || true
  # VERIFY it is gone -- a silent failure here breaks the real create below.
  if zpool list solnixscratch >/dev/null 2>&1; then
    die "NVMe-scratch: could not destroy solnixscratch on $TARGET -- refusing to relabel a disk that still holds a pool"
  fi
  # DESTROY leaves the whole-disk pool's EFI label + ZFS vdev labels on the disk.
  # A leftover label makes the install's `zpool create -f <wholedisk>` at step 1
  # hit the documented "cannot label 'cNtNdN': try using fdisk(8)" refusal, or
  # import the ghost pool. Clear ALL vdev labels (front + back copies) so the
  # real create sees a clean disk, then zero the GPT header sectors as
  # belt-and-braces (step 1's own fdisk -B then rewrites the table).
  run_to 30 zpool labelclear -f "/dev/dsk/${TARGET}" 2>/dev/null || true
  run_to 30 zpool labelclear -f "/dev/dsk/${TARGET}s0" 2>/dev/null || true
  run_to 30 zpool labelclear -f "/dev/dsk/${TARGET}p0" 2>/dev/null || true
  # front GPT (LBA 0-33) + a chunk; the backup GPT is rewritten by the fresh
  # zpool create's EFI label. dd is bounded (count) so it cannot hang.
  run_to 30 dd if=/dev/zero of="/dev/rdsk/${TARGET}p0" bs=512 count=64 conv=notrunc 2>/dev/null || true
  log "NVMe-scratch: solnixscratch destroyed; target $TARGET is free for the install pool"
  # scratch is now GONE and the target is about to hold the REAL rpool. Reset the
  # flag so cleanup() on EXIT does NOT destroy/labelclear $TARGET (that would wreck
  # a SUCCESSFUL install). cleanup's scratch-teardown is only for the FAILURE path,
  # where we die BEFORE reaching here and the whole-disk scratch is still stranded.
  SCRATCH_ON_TARGET=0; export SCRATCH_ON_TARGET
fi
# 0a. any IMPORTED pool whose vdev is on the target disk -> destroy it (frees
#     the slice so the GPT relabel below can create the throwaway EFI pool).
for _p in $(zpool list -H -o name 2>/dev/null); do
  case "$_p" in "$ROOTPOOL"|rpool) continue;; esac
  if zpool status "$_p" 2>/dev/null | grep -q "$TARGET"; then
    log "target disk holds imported pool $_p -> destroy"
    run_to 30 zpool destroy -f "$_p" 2>/dev/null || run_to 30 zpool export -f "$_p" 2>/dev/null || true
  fi
done
# 0b. by our own names (belt-and-braces) + any EXPORTABLE pool on the disk.
run_to 30 zfs unmount "$BEDS" 2>/dev/null || true
run_to 30 zpool destroy -f "$POOL" 2>/dev/null || true
run_to 30 zpool export -f "$POOL" 2>/dev/null || true
# an exported (not-imported) pool on the disk still owns the slice label; import
# it read-only-less then destroy so the slice is truly free for a fresh label.
_stale=$(run_to 30 zpool import -d "/dev/dsk" 2>/dev/null | awk '/pool:/{print $2}')
for _p in $_stale; do
  case "$_p" in "$ROOTPOOL"|rpool) continue;; esac
  if run_to 30 zpool import -N -f "$_p" 2>/dev/null; then
    if zpool status "$_p" 2>/dev/null | grep -q "$TARGET"; then
      log "destroying stale exported pool $_p on $TARGET"
      run_to 30 zpool destroy -f "$_p" 2>/dev/null || run_to 30 zpool export -f "$_p" 2>/dev/null || true
    else
      run_to 30 zpool export -f "$_p" 2>/dev/null || true
    fi
  fi
done
rm -rf "$ALTROOT" 2>/dev/null || true
mkdir -p "$ALTROOT"

# ---------------------------------------------------------------------------
# 1. GPT label: clean EFI label via a throwaway pool, then fmthard 3-part spec.
#    (make-be gotcha: fmthard on a fdisk label complains cylinder alignment; a
#    zpool-created EFI label is sector-addressed and takes fmthard.)
# ---------------------------------------------------------------------------
log "GPT-labelling $TARGET"
step "partitioning target $TARGET (GPT label + ESP + pool slice)"
# Clean EFI label via a throwaway pool. This intermittently fails when the target
# device node isn't fully settled yet (fresh disk / just-attached), so retry a
# few times with a devfsadm + settle between attempts rather than dying on the
# first transient miss.
#
# On SOME illumos builds / virtual controllers (QEMU nvme/virtio, and various
# cloud volumes) `zpool create -f <wholedisk>` REFUSES to write the EFI label on
# a disk that has no fdisk partition table at all -> `cannot label 'cNtNdN': try
# using fdisk(8) and then provide a specific slice`. That is not a settle race,
# it is deterministic. So on each attempt FIRST lay a whole-disk Solaris2 fdisk
# partition (`fdisk -B <rdsk>p0`) so the subsequent whole-disk `zpool create`
# has a partition to EFI-label. Harmless where the disk was already labellable.
_label_ok=0
for _try in 1 2 3 4 5; do
  # whole-disk Solaris2 fdisk table (idempotent); satisfies the "try fdisk" case.
  run_to 30 fdisk -B "/dev/rdsk/${TARGET}p0" >/dev/null 2>&1 || true
  devfsadm >/dev/null 2>&1 || true; sync; sleep 1
  # capture the zpool error (was silenced) so a persistent failure is diagnosable
  # from the serial log instead of only 'not settling'.
  _zerr=$(run_to 60 zpool create -f solnixtmp "/dev/dsk/${TARGET}" 2>&1) && { _label_ok=1; break; }
  echo "clean EFI label attempt $_try failed; settling device + retrying" >&2
  echo "  zpool create said: ${_zerr:-<no output>}" >&2
  zpool destroy solnixtmp 2>/dev/null || true
  devfsadm >/dev/null 2>&1 || true
  sync; sleep 3
done
[ "$_label_ok" = 1 ] || die "clean EFI label failed after 5 attempts (device $TARGET not settling)"
run_to 30 zpool destroy solnixtmp 2>/dev/null || true
RESV_START=$(prtvtoc -h "/dev/rdsk/${TARGET}" 2>/dev/null | awk '$1==8{print $4}')
RESV_SIZE=$(prtvtoc -h "/dev/rdsk/${TARGET}" 2>/dev/null | awk '$1==8{print $5}')
[ -n "$RESV_START" ] || die "could not read EFI label reserved slice"
ESP_START=256; ESP_SIZE=524288                 # 256 MiB ESP
POOL_START=$((ESP_START + ESP_SIZE)); POOL_SIZE=$((RESV_START - POOL_START))
[ "$POOL_SIZE" -gt 0 ] || die "computed pool size <= 0 (RESV_START=$RESV_START)"
log "fmthard: s0 ESP @${ESP_START}+${ESP_SIZE}, s1 pool @${POOL_START}+${POOL_SIZE}, s8 resv @${RESV_START}+${RESV_SIZE}"
cat > /tmp/solnix-install.vtoc <<EOF
0 12 00 ${ESP_START} ${ESP_SIZE}
1 4 00 ${POOL_START} ${POOL_SIZE}
8 11 00 ${RESV_START} ${RESV_SIZE}
EOF
fmthard -s /tmp/solnix-install.vtoc "/dev/rdsk/${TARGET}" 2>&1 || die "fmthard failed"
prtvtoc -h "/dev/rdsk/${TARGET}"

# ---------------------------------------------------------------------------
# 2. ESP FAT32 + the pool + BE dataset
# ---------------------------------------------------------------------------
log "mkfs pcfs ESP on ${TARGET}s0"
step "formatting ESP + creating pool $POOL + datasets"
# fresh slice nodes after fmthard: re-run devfsadm so /dev/rdsk/${TARGET}s0
# reflects the new vtoc before mkfs_pcfs opens it (stale node = silent no-op).
devfsadm >/dev/null 2>&1 || true
# NOTE: pcfs `b=<file>` installs a boot file, NOT a volume label — `b=ESP` was
# misread as boot-file `/boot/ESP` -> `/boot/pmbr: No such file`. Drop it; the ESP
# just needs a FAT32 filesystem (the loader.efi is copied in later at mount time).
mkfs_esp() { yes | run_to 60 mkfs -F pcfs -o fat=32 "/dev/rdsk/${TARGET}s0" 2>&1; }
mkfs_esp
if ! fstyp "/dev/rdsk/${TARGET}s0" 2>/dev/null | grep -q pcfs; then
  log "ESP mkfs did not yield pcfs; devfsadm + retry"
  devfsadm >/dev/null 2>&1 || true
  mkfs_esp
  fstyp "/dev/rdsk/${TARGET}s0" 2>/dev/null | grep -q pcfs || die "ESP mkfs failed (fstyp=$(fstyp "/dev/rdsk/${TARGET}s0" 2>&1))"
fi
log "ESP fstyp: $(fstyp "/dev/rdsk/${TARGET}s0" 2>&1)"

log "creating pool $POOL on ${TARGET}s1 + BE dataset $BEDS"
# CRITICAL for bootability: create the ROOT pool with -d (disable ALL feature
# flags) so the illumos boot loader (loader64.efi / gptzfsboot) can READ the
# pool. A default `zpool create` enables modern features (com.delphix:*,
# org.openzfs:*, ...) the loader's ZFS reader doesn't understand -> the loader
# mounts the BE then reports "Failed to find bootable partition" (it can't read
# the dataset to find /platform/.../unix). -d gives a legacy-readable pool; the
# OS enables any extra features itself post-boot as needed. This is the standard
# illumos root-pool requirement (beadm/installers do the same).
# NOTE(2026-07-30): verified on the OI host that a -d pool activates ONLY
# lz4_compress + embedded_data, both in loader64.efi's features_for_read set, so
# feature-compat is NOT the disk-boot blocker. The remaining "Failed to find
# bootable partition" (loader gets the right bootfs but can't read the kernel/
# boot_archive from the BE) is under investigation -- likely the SELF-INSTALL BE
# /platform layout. TODO: inspect installed BE via `zpool import -R /mnt` on illumos.
# WARNING: feature@encryption must be enabled AT CREATE TIME if any dataset will
# be encrypted. On a `-d` pool it is NOT on by default and a later
# `zfs create -o encryption=...` fails with "Encryption feature not enabled"
# (measured, and used as this feature's negative control). Enabling the feature
# does NOT encrypt anything by itself and does NOT affect bootability: the loader
# only rejects features it cannot READ, and it lists com.datto:encryption in
# features_for_read[]. The root/BE datasets stay plaintext regardless -- see the
# encryption block above for why that is not negotiable.
_encfeat=""
# ENCRYPT_MODE is DETERMINED later (the prompt at the encryption block below runs
# after this pool create), but this line needs it. Under set -u an unset ref
# aborts ("ENCRYPT_MODE parameter not set"). The pool FEATURE flag is harmless to
# enable regardless -- it only lets the pool HOLD encrypted datasets; it encrypts
# nothing itself, and the loader reads com.datto:encryption in features_for_read[]
# so it never blocks boot. So: enable the feature whenever the platform CAN
# encrypt (measured), independent of the not-yet-chosen mode. The actual encrypted
# /home,/nix datasets are created later, after the mode prompt.
if zpool upgrade -v 2>/dev/null | grep -q '^encryption'; then _encfeat="-o feature@encryption=enabled"; fi
run_to 60 zpool create -f -d $_encfeat -o altroot="$ALTROOT" -o cachefile=none \
  -O compression=on -O atime=off -m none "$POOL" "/dev/dsk/${TARGET}s1" || die "zpool create failed"
# WHY the explicit feature list (not just -d): on modern illumos `zpool create`
# AUTO-ACTIVATES com.delphix:log_spacemap (needed for the log spacemap) even under
# -d, and the bundled loader64.efi's ZFS reader does NOT support log_spacemap ->
# check_mos_features() rejects the pool -> the loader gets the right bootfs
# (zfs:rpool/ROOT/solnix-1) but then "Failed to find bootable partition" (it
# can't read the MOS). loader64.efi's features_for_read set is: device_removal,
# obsolete_counts, zpool_checkpoint, spacemap_v2/histogram, embedded_data,
# lz4_compress, extensible_dataset, hole_birth, bookmark_v2, large_dnode,
# allocation_classes, edonr/sha512/skein/checksum_salt. We enable ONLY those the
# loader reads + explicitly DISABLE log_spacemap (the boot-blocker). This is the
# real root cause of the un-bootable installed disk (ESP+bootfs were always fine).
zfs create -o canmount=off -o mountpoint=legacy "$POOL/ROOT"
zfs create -o canmount=noauto -o mountpoint=/ "$BEDS"
# Capture the mount stderr so a failure surfaces WHY (busy mountpoint, a keyed
# dataset needing load-key, an EBUSY race) instead of a bare "not mounted". 30s
# is ample for a local ZFS mount of an empty BE; if it ever times out the retry
# hint plus the captured error tell the operator what to look at.
run_to 30 zfs mount "$BEDS" 2>/tmp/solnix-be-mount.err || true
# PROVE the pool is actually mounted at $ALTROOT -- not merely that the directory
# exists (it does: $ALTROOT was mkdir'd up front). A silent `zfs mount` failure
# here is the X1 5/9 root cause: the build's `--store $ALTROOT` would land on the
# 9M RAM ramdisk instead of the 928G pool. assert_mounted_on_pool fails LOUD.
assert_mounted_on_pool "$BEDS" "$ALTROOT" /tmp/solnix-be-mount.err

# ⚠️ /nix AND /export/home LIVE OUTSIDE THE BOOT ENVIRONMENT, deliberately.
# Everything above this point is inside $BEDS, so a dataset created there would be
# cloned by every `beadm create` and rolled back by every BE rollback. For a Nix
# system that is actively wrong: the store would be duplicated per BE (gigabytes),
# a rollback would silently revert the store and orphan user profiles, and nothing
# would be shared between BEs so each switch re-downloads. NixOS and nixbsd both
# put /nix on its own dataset for exactly this reason.
#
# The point of a shared store is that a BE rollback changes which SYSTEM you boot
# without destroying the store that every generation references.
# HOME LAYOUT: /home by default, the Solaris /export/home only on request.
#
# FreeBSD's bsdinstall creates a plain `/home mountpoint=/home` dataset
# (usr.sbin/bsdinstall/scripts/zfsboot:154) with the comment "Home directories
# separated so they are common to all BEs" -- the same BE-sharing reason we want,
# without the /export indirection. Solaris uses /export/home because
# /etc/auto_master:31 maps `/home auto_home -nobrowse`, so autofs OWNS /home and
# any local directory there is shadowed at boot.
#
# Measured on the maintainer's existing host `sun`, which already runs /home/gburd:
# the autofs SERVICE is disabled (svc:/system/filesystem/autofs:default), a real
# tank/home + tank/home/gburd dataset is mounted, and passwd points at /home/gburd.
# The auto_master line is still present there and harmless ONLY because the service
# is off -- so we do BOTH below: disable the service and comment the line, because
# a future `svcadm enable autofs` would otherwise silently shadow every home dir.
# CONSOLE TEXT SIZE. The console font is a FIXED 8x16 with no larger built-in, so
# rows/cols come from dividing screen size by glyph size (common/font/font.c) and
# RESOLUTION is the only lever. Measured on the maintainer's X1: EDID 3840x2160,
# where the loader picked 480 columns x 113 rows -- unreadable. Default to 800x600
# (~99x37): comfortably readable rather than maximising text on screen.
TARGET_RESOLUTION="${SOLNIX_TARGET_RESOLUTION:-}"
if [ -z "$TARGET_RESOLUTION" ] && [ -t 0 ] && [ -t 1 ]; then
  echo ""
  echo "=== Console text size ======================================================="
  echo "  Larger text = lower framebuffer resolution (the font is a fixed 8x16)."
  echo "  1) 640x480    ~79x29   largest text"
  echo "  2) 800x600    ~99x37   readable        (default)"
  echo "  3) 1024x768   ~127x47  medium"
  echo "  4) 1280x1024  ~159x63  small"
  echo "  5) native     tiny on a HiDPI panel -- 480x113 on a 4K screen"
  printf 'Choice [1-5] (default 2): '
  read -r _cr || _cr=2
  case "$_cr" in
    1) TARGET_RESOLUTION=640x480 ;;
    3) TARGET_RESOLUTION=1024x768 ;;
    4) TARGET_RESOLUTION=1280x1024 ;;
    5) TARGET_RESOLUTION=native ;;
    *) TARGET_RESOLUTION=800x600 ;;
  esac
fi
[ -n "$TARGET_RESOLUTION" ] || TARGET_RESOLUTION=800x600
log "console text size: $TARGET_RESOLUTION"

# ---------------------------------------------------------------------------
# ENCRYPTION. MEASURED ON THIS PLATFORM BEFORE BEING OFFERED, and the measurement
# is why the root pool is NOT an option.
#
# WHAT WORKS (measured on ami-0cb14e40f9355bd0c, illumos ZFS):
#   zpool create -O encryption=aes-256-gcm -O keyformat=passphrase  SUCCEEDS.
#   keystatus becomes available, data reads back, children inherit, and
#   load-key/unload-key round-trip. Algorithms: aes-{128,192,256}-{ccm,gcm}.
#   Negative control: encryption=aes-999-bogus is REJECTED, so the capability
#   test can fail and is therefore worth something.
#   On a `-d` (loader-compatible) pool it additionally needs
#   `-o feature@encryption=enabled`; negative control without it:
#   "cannot create: Encryption feature not enabled".
#
# WHY THE ROOT/BE IS REFUSED ANYWAY -- THE LOADER CANNOT DECRYPT:
#   usr/src/boot/.../zfsimpl.c lists "com.datto:encryption" in features_for_read[]
#   (line ~125), so the loader ACCEPTS an encrypted pool as readable. But that file
#   contains NO decryption code whatsoever: grep -E 'aes|gcm|pbkdf|hkdf|zio_crypt|
#   decrypt' over all 3805 lines matches nothing, and the only crypt-ish token is
#   the substring inside that allowlist string. loader64.efi and gptzfsboot carry
#   SHA256/SHA512 for CHECKSUMS only -- no AES, no GCM, no key derivation.
#
#   WORSE, AND THIS IS THE POINT: there is no error path either. The loader has no
#   ENCRYPT/encrypted/crypt_keydata handling at all, so it does not detect and
#   refuse an encrypted BE -- it reads ciphertext as though it were data. And
#   `zpool set bootfs=<encrypted dataset>` is ACCEPTED by ZFS (control: a plaintext
#   BE on the same pool is also accepted, so that is not a quirk of the test).
#
#   So EVERY layer says yes -- zfs(8) says encryption is supported, zpool(8)
#   accepts the bootfs, the loader accepts the pool -- and the machine simply does
#   not boot, with no diagnostic anywhere. That is the worst failure shape there
#   is, and it is why this installer will not build it even on request. An
#   operator who read "illumos ZFS supports native encryption" is not wrong; the
#   loader just silently disagrees.
#
# WHAT IS OFFERED: encryption of the datasets OUTSIDE the boot environment --
# /home (where the operator's data actually is) and optionally /nix. The loader
# never reads either one; only the kernel does, after it is already running.
#
# WARNING: /home ENCRYPTION AND BOOT. A passphrase-encrypted dataset needs its key
# loaded before it can mount, and nothing in the boot path can prompt for it. So
# the honest behaviour, stated to the operator at install time rather than
# discovered later: the pool imports, the system boots to a login, and /home is
# NOT mounted until someone runs `zfs load-key -a && zfs mount -a`. This installer
# does NOT pretend to solve that with an SMF service -- an SMF method has no
# controlling terminal to read a passphrase from.
ENCRYPT_MODE="${SOLNIX_ENCRYPT:-}"

# Capability probe. Ask the PLATFORM, do not assume from a version number: the
# question is whether this ZFS accepts the property at all.
zfs_can_encrypt() {
  # `zpool upgrade -v` lists supported features by name; encryption is one row.
  zpool upgrade -v 2>/dev/null | grep -q '^encryption' && return 0
  # Fallback: does the zfs(8) property parser know the value? A bad value is
  # rejected with a message that ENUMERATES the valid ones.
  zfs create -o encryption=aes-256-gcm -n nonexistent/probe 2>&1 | grep -q 'aes-256-gcm' && return 0
  return 1
}

if [ -z "$ENCRYPT_MODE" ] && [ -t 0 ] && [ -t 1 ]; then
  if zfs_can_encrypt; then
    echo ""
    echo "=== Encryption =============================================================="
    echo "  ZFS native encryption (aes-256-gcm, passphrase) is available on this"
    echo "  platform -- MEASURED, not assumed."
    echo ""
    echo "  It is offered for /home and /nix ONLY. The root filesystem CANNOT be"
    echo "  encrypted, and the reason is worth reading:"
    echo ""
    echo "    The boot loader accepts an encrypted pool but has NO decryption code"
    echo "    at all, and no error path either -- it reads ciphertext as data. ZFS"
    echo "    will happily let you set bootfs to an encrypted dataset. Every layer"
    echo "    says yes and the machine then does not boot, with no message anywhere."
    echo ""
    echo "  Note: an encrypted /home does NOT auto-mount at boot -- nothing in the"
    echo "  boot path can ask for a passphrase. You will run, after logging in:"
    echo "      pfexec zfs load-key -a && pfexec zfs mount -a"
    echo ""
    echo "  1) no encryption                 (default)"
    echo "  2) encrypt /home"
    echo "  3) encrypt /home and /nix        (/nix is public store data; slower,"
    echo "                                    and it must be unlocked before nix works)"
    printf 'Choice [1-3] (default 1): '
    read -r _ec || _ec=1
    case "$_ec" in
      2) ENCRYPT_MODE=home ;;
      3) ENCRYPT_MODE=home+nix ;;
      *) ENCRYPT_MODE=none ;;
    esac
  else
    log "ZFS native encryption is NOT available on this platform -- offering nothing rather than a flag that silently does nothing"
    ENCRYPT_MODE=none
  fi
fi
[ -n "$ENCRYPT_MODE" ] || ENCRYPT_MODE=none

# Refuse the root-pool case LOUDLY, including via the env var, quoting the
# mechanism. Someone will try it; they deserve the reason, not a shrug.
case "$ENCRYPT_MODE" in
  root|rpool|all|everything)
    echo "" >&2
    echo "REFUSING to encrypt the root pool / boot environment." >&2
    echo "" >&2
    echo "  This is not caution -- it is measured. The illumos boot loader" >&2
    echo "  (usr/src/boot/.../zfsimpl.c) lists com.datto:encryption in" >&2
    echo "  features_for_read[] so it ACCEPTS the pool, but the file contains NO" >&2
    echo "  decryption code and NO error path for encrypted datasets: it reads" >&2
    echo "  ciphertext as though it were data. loader64.efi carries SHA256/SHA512" >&2
    echo "  for checksums only -- no AES, no GCM, no key derivation." >&2
    echo "" >&2
    echo "  And 'zpool set bootfs=<encrypted dataset>' is ACCEPTED by ZFS, so" >&2
    echo "  nothing stops you building this by hand. The result is an unbootable" >&2
    echo "  disk with no diagnostic at any layer." >&2
    echo "" >&2
    die "use SOLNIX_ENCRYPT=home (or home+nix) to encrypt data datasets instead"
    ;;
  none|home|home+nix) : ;;
  *) die "SOLNIX_ENCRYPT must be none|home|home+nix (got '$ENCRYPT_MODE')" ;;
esac

# Collect the passphrase now, once, before any destructive step -- so a mismatch
# or a change of mind costs nothing. ZFS wants >= 8 characters.
ENC_KEYFILE=""
if [ "$ENCRYPT_MODE" != none ]; then
  if [ -n "${SOLNIX_ENCRYPT_PASSPHRASE:-}" ]; then
    _enc_pw="$SOLNIX_ENCRYPT_PASSPHRASE"
  elif [ -t 0 ] && [ -t 1 ]; then
    while : ; do
      _oldstty=$(stty -g 2>/dev/null || true)
      trap '[ -n "$_oldstty" ] && stty "$_oldstty" 2>/dev/null; echo ""' INT
      printf 'Encryption passphrase: '; stty -echo 2>/dev/null; read -r _enc_pw || _enc_pw=""; stty echo 2>/dev/null; echo ""
      printf 'Confirm:               '; stty -echo 2>/dev/null; read -r _enc_pw2 || _enc_pw2=""; stty echo 2>/dev/null; echo ""
      [ -n "$_oldstty" ] && stty "$_oldstty" 2>/dev/null
      trap - INT
      [ "$_enc_pw" = "$_enc_pw2" ] || { echo "  passphrases do not match"; continue; }
      [ ${#_enc_pw} -ge 8 ] || { echo "  too short (ZFS requires >= 8 characters)"; continue; }
      break
    done
  else
    die "SOLNIX_ENCRYPT=$ENCRYPT_MODE but no SOLNIX_ENCRYPT_PASSPHRASE and no tty to prompt on"
  fi
  # A key FILE, not a pipe: `zfs create -o keyformat=passphrase` reads from the
  # terminal, and driving that from a script is fragile. keylocation is rewritten
  # to prompt immediately afterwards so the passphrase is never persisted on disk.
  ENC_KEYFILE="/tmp/solnix-enc.$$"
  ( umask 077; printf '%s' "$_enc_pw" > "$ENC_KEYFILE" )
  log "encryption: $ENCRYPT_MODE (aes-256-gcm, passphrase)"
fi

HOME_STYLE="${SOLNIX_HOME_STYLE:-}"
if [ -z "$HOME_STYLE" ] && [ -t 0 ] && [ -t 1 ]; then
  echo ""
  echo "=== Home directory layout ==================================================="
  echo "  1) /home            (default) a real dataset, autofs disabled -- the"
  echo "                      FreeBSD/Linux layout. Simple, nothing exported."
  echo "  2) /export/home     traditional Solaris: autofs maps /home -> auto_home,"
  echo "                      real homes live under /export/home and can be shared."
  printf 'Choice [1/2] (default 1): '
  read -r _hs || _hs=1
  case "$_hs" in 2) HOME_STYLE=export ;; *) HOME_STYLE=home ;; esac
fi
[ -n "$HOME_STYLE" ] || HOME_STYLE=home
case "$HOME_STYLE" in
  home)   HOME_BASE=/home ;;
  export) HOME_BASE=/export/home ;;
  *) die "SOLNIX_HOME_STYLE must be 'home' or 'export' (got '$HOME_STYLE')" ;;
esac
log "home layout: $HOME_STYLE (homes under $HOME_BASE)"

# Datasets outside the BE. /nix always; the home tree follows the chosen layout.
_dslist="nix"
case "$HOME_STYLE" in
  home)   _dslist="$_dslist home" ;;
  export) _dslist="$_dslist export export/home" ;;
esac
for _ds in $_dslist; do
  zfs list -H "$POOL/$_ds" >/dev/null 2>&1 && continue
  case "$_ds" in
    nix)         _mp=/nix ;;
    home)        _mp=/home ;;
    export)      _mp=/export ;;
    export/home) _mp=/export/home ;;
  esac
  # Encrypt this dataset? Only the data datasets are ever candidates; the BE was
  # created above and is deliberately plaintext.
  _encargs=""
  case "$ENCRYPT_MODE:$_ds" in
    home:home|home:export|home:export/home|home+nix:home|home+nix:export|home+nix:export/home|home+nix:nix)
      _encargs="-o encryption=aes-256-gcm -o keyformat=passphrase -o keylocation=file://$ENC_KEYFILE" ;;
  esac
  zfs create $_encargs -o canmount=on -o mountpoint="$_mp" "$POOL/$_ds" \
    || die "failed to create $POOL/$_ds (needed for the nix store / home dirs)"
  # VERIFY the encryption actually landed rather than trusting the flag. A silently
  # unencrypted /home after the operator typed a passphrase is the worst outcome
  # here -- they would believe their data is protected when it is not.
  if [ -n "$_encargs" ]; then
    _got=$(zfs get -H -o value encryption "$POOL/$_ds" 2>/dev/null)
    [ "$_got" = "aes-256-gcm" ] \
      || die "$POOL/$_ds was asked to be encrypted but reports encryption=$_got"
    log "encrypted: $POOL/$_ds ($_got)"
  fi
done

# Move every encrypted dataset off the install-time key FILE and onto an
# interactive prompt. The file lives in the installer's /tmp (a ramdisk) and is
# removed on exit, so a dataset left pointing at it would be unloadable after
# reboot -- keylocation=prompt is what makes the passphrase the actual key.
if [ "$ENCRYPT_MODE" != none ]; then
  for _ds in $_dslist; do
    _full="$POOL/$_ds"
    [ "$(zfs get -H -o value encryption "$_full" 2>/dev/null)" = "aes-256-gcm" ] || continue
    zfs set keylocation=prompt "$_full" 2>/dev/null \
      || log "WARNING: could not set keylocation=prompt on $_full -- check it before rebooting"
    _kl=$(zfs get -H -o value keylocation "$_full" 2>/dev/null)
    case "$_kl" in
      prompt) log "$_full keylocation=prompt (passphrase asked for at load-key time)" ;;
      *) die "$_full still has keylocation=$_kl -- it points at the installer's temp keyfile and would be UNLOADABLE after reboot" ;;
    esac
  done
fi
# Mount them under the alt-root so the copy below populates the right datasets.
for _ds in nix export/home; do
  _t="$ALTROOT/${_ds#export/}"
  case "$_ds" in export/home) _t="$ALTROOT/export/home" ;; nix) _t="$ALTROOT/nix" ;; esac
  mkdir -p "$_t"
done
# Verify the store dataset is real and OUTSIDE the BE -- a silent fallback to a
# plain directory inside the BE is the failure this block exists to prevent.
zfs list -H -o name,mountpoint "$POOL/nix" >/dev/null 2>&1 \
  || die "$POOL/nix missing after create"
case "$(zfs list -H -o name "$POOL/nix" 2>/dev/null)" in
  "$POOL/ROOT/"*) die "$POOL/nix was created INSIDE the boot environment" ;;
esac
# And PROVE $POOL/nix is mounted at $ALTROOT/nix -- the build's `--store $ALTROOT`
# writes the store under $ALTROOT/nix, so if that dataset is unmounted the store
# lands in the BE (or, worse, a ramdisk dir). Same ramdisk-overflow risk as the
# BE mount above; fail LOUD before the long build rather than after it fills.
assert_mounted_on_pool "$POOL/nix" "$ALTROOT/nix"

# NOW build the flake toplevel -- $ALTROOT/nix is a real-disk ZFS store, so the
# fetchClosure realisation + build land on the target disk, not the ~620MB RAM
# ramdisk that a build up front would overflow. The store IS the installed
# system's store, so no cross-store copy is needed afterward. The ramdisk-safe
# name gate near the top already proved the attr exists; this is the heavy half.
build_toplevel
# Flake install: NOW that build_toplevel has set $TOPLEVEL from the flake, make the
# SELF_INSTALL/OVERLAY decision that was DEFERRED earlier (it could not run before
# the pool existed). A full flake toplevel (dixi) carries systemPath -> a real
# system install, NOT overlay.
if [ -n "$FLAKE_REF" ] && [ -n "$TOPLEVEL" ]; then
  _tlreal="$TOPLEVEL"; [ "${TOPLEVEL_ON_POOL:-0}" = 1 ] && _tlreal="$ALTROOT$TOPLEVEL"
  if [ -e "$_tlreal/systemPath" ]; then
    OVERLAY=0; log "flake toplevel has systemPath -> full declarative system install (not overlay)"
  elif [ -e "$_tlreal/sw" ] || [ -e "$_tlreal/activate" ]; then
    OVERLAY=1; log "flake toplevel has sw/ but no systemPath -> declarative overlay install"
  fi
fi
# ⚠️ THE STEP THAT ACTUALLY MAKES /home WORK. Creating the dataset is not enough:
# autofs owns /home via auto_master, so without this the mount is shadowed at boot
# and every home directory silently vanishes. Verified on `sun`, which runs
# /home/gburd today: the autofs service is DISABLED there. Belt and braces --
# disable the service in the target repo AND comment the auto_master line, because
# either alone is undone by a future svcadm enable or a package refresh of
# auto_master.
if [ "$HOME_STYLE" = home ]; then
  if [ -f "$ALTROOT/etc/auto_master" ]; then
    sed 's,^/home[[:space:]],#/home\t,' "$ALTROOT/etc/auto_master" > "$ALTROOT/etc/auto_master.new" \
      && mv "$ALTROOT/etc/auto_master.new" "$ALTROOT/etc/auto_master"
    grep -qE '^/home[[:space:]]' "$ALTROOT/etc/auto_master" \
      && die "auto_master still maps /home -- the dataset would be shadowed at boot"
  fi
  # Disable the service in the TARGET repository, not the live one.
  if [ -x /usr/sbin/svccfg ] && [ -f "$ALTROOT/etc/svc/repository.db" ]; then
    SVCCFG_REPOSITORY="$ALTROOT/etc/svc/repository.db" \
      /usr/sbin/svccfg -s system/filesystem/autofs setprop general/enabled = boolean: false \
      2>/dev/null || log "note: could not preset autofs disabled; run 'svcadm disable autofs' after first boot"
  fi
  log "autofs: /home mapping commented out + service preset disabled"
fi
log "datasets: $POOL/nix + $POOL${HOME_BASE} created outside $BEDS"

# ---------------------------------------------------------------------------
# 3. copy the running root FS onto the target BE (the base world).
#    The running root is a proven-booting proto-derived world (all 16 gotchas
#    already applied: driver files, /dev symlinks, dir perms, external libs,
#    OpenSSH, cryptosvc race fix, ttya console, DHCP netcfg, non-DEBUG kernel).
#    Copying it is the install analog of `beadm create` cloning the running BE,
#    but onto a fresh pool. Exclude pseudo filesystems + /nix (closure below) +
#    the altroot itself + the target's own mount.
# ---------------------------------------------------------------------------
log "copying running root -> target BE (tar | tar, minus pseudo fs + /nix)"
step "copying the base world onto $TARGET"
# tar from / with X exclude-list. Excludes are path prefixes relative to /.
cat > /tmp/solnix-install.exclude <<EOF
./nix
./proc
./dev/fd
./devices
./system/contract
./system/object
./system/volatile
./etc/svc/volatile
./tmp
./var/run
./var/tmp
./a
./mnt
.$ALTROOT
EOF
# SOLNIX_EXTRA_EXCLUDE: space-separated extra top-level paths to omit from the
# base-root copy (build hosts accumulate huge non-OS trees like /aarch64,
# /scratch, /code that must NOT ship in a clean image). Each is written as a
# ./<path> exclude prefix. Also drop known build-junk parents unconditionally
# (harmless if absent) so an image never carries the build environment.
for _x in ${SOLNIX_EXTRA_EXCLUDE:-} aarch64 scratch code build; do
  _x=${_x#/}; [ -n "$_x" ] || continue
  echo "./$_x" >> /tmp/solnix-install.exclude
done
# illumos tar pairs key-letters to positional args IN ORDER: `tar cEfX -
# <excludefile> .` means c(reate) E(xt-hdr) f(ile)=- X(exclude)=<file> then the
# paths. The GNU `-cEf - -X file` form is NOT parsed correctly by illumos tar.
( cd "$SRCROOT" && tar cEfX - /tmp/solnix-install.exclude . ) | ( cd "$ALTROOT" && tar xf - ) \
  || die "root copy failed"
# recreate the pseudo-fs mountpoints + writable dirs the exclude skipped.
for d in proc dev devices system/contract system/object system/volatile \
         etc/svc/volatile var/run var/tmp tmp mnt export export/home root nix \
         var/adm var/adm/sa var/log var/spool var/saf; do
  mkdir -p "$ALTROOT/$d"
done
chmod 1777 "$ALTROOT/tmp" "$ALTROOT/var/tmp" "$ALTROOT/system/volatile" 2>/dev/null || true
# /var/adm must exist (mode 775 root:sys) so ttymon/SAC's `makeutx` can create
# /var/adm/utmpx at first boot -- without it the console-login getty spins on
# "makeutx failed: No such file or directory" and never presents a login prompt
# (the curated live-ramdisk root that SELF-INSTALL copies may lack a proper
# /var/adm). Pre-create the login-accounting files too (empty is correct; the
# system rewrites them at boot).
chmod 0775 "$ALTROOT/var/adm" 2>/dev/null || true
chown 0:3 "$ALTROOT/var/adm" 2>/dev/null || true   # root:sys
for f in utmpx wtmpx; do : > "$ALTROOT/var/adm/$f" 2>/dev/null || true; done
chmod 0644 "$ALTROOT/var/adm/utmpx" "$ALTROOT/var/adm/wtmpx" 2>/dev/null || true

# essential /dev symlinks (gotcha #6): tar may not carry them from a live /dev.
log "seeding essential /dev symlinks"
for n in console msglog null zero tty syscon systty sysmsg random urandom poll; do
  [ -L "/dev/$n" ] && relink "$(_readlink /dev/$n)" "$ALTROOT/dev/$n" 2>/dev/null || true
done

# ---------------------------------------------------------------------------
# 4. copy the toplevel closure into the target's /nix/store (self-contained).
#    Walk the toplevel's closure. If nix-store IS present (build host), use it.
#    Else (the minimal proto installer env has no nix) compute the closure by a
#    fixpoint scan: for each store path found, grep its symlink targets AND file
#    contents for /nix/store/<hash>-... references, add any new ones, repeat.
#    (A shallow one-level symlink walk MISSES transitive deps like illumos-sys
#    that are referenced only through illumos-system-path.)
# ---------------------------------------------------------------------------
log "copying toplevel closure into target /nix/store"
step "placing the toplevel closure in $TARGET /nix/store"
if [ "$SELF_INSTALL" = 1 ]; then
  log "SELF-INSTALL: skipping nix-closure copy (the copied live root IS the system)"
elif [ "${TOPLEVEL_ON_POOL:-0}" = 1 ]; then
  # The flake build ran with --store $ALTROOT, so its whole closure is ALREADY in
  # $ALTROOT/nix/store -- there is nothing to copy across a store boundary. Copying
  # would also double-prefix ($ALTROOT$ALTROOT/nix/...). Just compute CLOSURE (bare
  # /nix/store paths) so the verify + DB-registration below still run.
  log "FLAKE BUILD ON POOL: closure already in $ALTROOT/nix/store, skipping copy"
  if command -v nix-store >/dev/null 2>&1; then
    CLOSURE=$(nix-store --store "$ALTROOT" -qR "$TOPLEVEL" 2>/dev/null)
  fi
  # Fallback: content-scan the on-pool toplevel for bare /nix/store refs.
  if [ -z "$CLOSURE" ]; then
    CLOSURE=$(find "$ALTROOT$TOPLEVEL" 2>/dev/null | while read f; do
        if [ -h "$f" ]; then ls -ld "$f" 2>/dev/null | sed -n 's/.* -> //p'
        elif [ -f "$f" ]; then strings "$f" 2>/dev/null || cat "$f" 2>/dev/null; fi
      done | grep -o '/nix/store/[a-z0-9]\{32\}-[^/" ]*' \
        | sed 's,\(/nix/store/[^/]*\).*,\1,' | sort -u)
  fi
else
mkdir -p "$ALTROOT/nix/store"
CLOSURE=""
# Prefer a real nix-store for the closure (fast, exact). SOLNIX_NIXSTORE lets a
# build host point at its nix-store even though this script resets PATH; else
# use nix-store if it is on PATH; else fall back to the fixpoint content scan
# (the minimal proto installer env has no nix — slow but self-contained).
_NIXSTORE=""
if [ -n "${SOLNIX_NIXSTORE:-}" ] && [ -x "${SOLNIX_NIXSTORE}" ]; then _NIXSTORE="$SOLNIX_NIXSTORE"
elif command -v nix-store >/dev/null 2>&1; then _NIXSTORE=nix-store; fi
if [ -n "$_NIXSTORE" ]; then
  log "closure via $_NIXSTORE -qR (fast path)"
  CLOSURE=$("$_NIXSTORE" -qR "$TOPLEVEL")
  for p in $CLOSURE; do copy_path "$p"; done
else
  # closure_refs <store-path>: emit every /nix/store/<hash>-name referenced by
  # that path (symlink targets via ls -l, plus any string in regular files).
  closure_refs() {
    find "$1" 2>/dev/null | while read f; do
      if [ -h "$f" ]; then ls -ld "$f" 2>/dev/null | sed -n 's/.* -> //p'
      elif [ -f "$f" ]; then strings "$f" 2>/dev/null || cat "$f" 2>/dev/null
      fi
    done | grep -o '/nix/store/[a-z0-9]\{32\}-[^/" ]*' | sed 's,\(/nix/store/[^/]*\).*,\1,' | sort -u
  }
  # BFS fixpoint: seed with the toplevel, expand until no new paths appear.
  seen=" "; queue="$TOPLEVEL"
  while [ -n "$queue" ]; do
    p=$(echo "$queue" | awk '{print $1}')
    queue=$(echo "$queue" | cut -d' ' -f2-)
    [ -n "$p" ] || continue
    case "$seen" in *" $p "*) continue;; esac
    seen="$seen$p "
    copy_path "$p"
    for r in $(closure_refs "$p"); do
      case "$seen $queue" in *"$r"*) : ;; *) queue="$queue $r";; esac
    done
  done
  CLOSURE=$(echo "$seen" | tr ' ' '\n' | grep '^/nix/store/')
fi
# _TLD: the toplevel's path ON DISK for READS. For an on-pool flake build the
# store is $ALTROOT/nix, so the real files are at $ALTROOT$TOPLEVEL; for the
# copy-based flow the closure was copied under $ALTROOT too, so $ALTROOT$TOPLEVEL
# is correct there as well. Symlink TARGETS below keep the bare $TOPLEVEL (a
# /nix/store/... target is what the booted system resolves), but every `cp` or
# `[ -e ]` that READS toplevel content must use $_TLD.
_TLD="$ALTROOT$TOPLEVEL"; [ -e "$_TLD" ] || _TLD="$TOPLEVEL"
relink "$TOPLEVEL" "$ALTROOT/run-current-system"
# also the slash form /run/current-system (NixOS convention; the login env.sh +
# switch-to-configuration look there). /run is a boot-time tmpfs on some setups,
# so ALSO drop it under /etc so it persists; the belt-and-suspenders symlink at
# the real path is what env.sh resolves.
mkdir -p "$ALTROOT/run"
relink "$TOPLEVEL" "$ALTROOT/run/current-system"

# 4v. VERIFY every closure path landed on the target (the T2.7 gate: prove all
#     ~17-20 store paths are self-contained on the installed disk). Fail loudly
#     rather than boot a system missing a slice (kernel/libc/rtld/system-path).
log "verifying closure on target /nix/store"
_missing=0; _count=0
for p in $CLOSURE; do
  _count=$((_count + 1))
  if [ ! -e "$ALTROOT$p" ]; then echo "MISSING on target: $p" >&2; _missing=$((_missing + 1)); fi
done
echo "closure: $_count paths, $_missing missing" >&2
[ "$_missing" = 0 ] || die "closure incomplete: $_missing/$_count store paths did not land on target"
# the load-bearing slices must specifically be present + non-empty. This only
# applies to a FULL toplevel that carries systemPath (kernel/libc/rtld baked into
# /nix). The REDUCED overlay current-system has NO systemPath — its kernel/libc
# come from the copied illumos root, not the closure — so skip the slice check
# when the toplevel has no systemPath (declarative-userland overlay install).
if [ -e "$TOPLEVEL/systemPath" ] || [ -e "$ALTROOT$TOPLEVEL/systemPath" ]; then
for must in systemPath/platform/i86pc/kernel/amd64/unix \
            systemPath/kernel/amd64/genunix \
            systemPath/lib/svc/bin/svc.startd \
            systemPath/lib/amd64/libc.so.1; do
  t="$ALTROOT$TOPLEVEL/$must"
  [ -s "$t" ] || [ -e "$t" ] || die "toplevel slice missing on target: $must"
done
else
  echo "declarative overlay toplevel (no systemPath) — kernel/libc from the copied illumos root; skipping slice check" >&2
fi
echo "closure OK: $_count store paths self-contained on $TARGET" >&2
fi   # end SELF_INSTALL=0 nix-closure block

# ---------------------------------------------------------------------------
# 5. seed the SMF repository fresh from the seed (so the target boots the stock
#    milestone set + manifest-import ADDS all /lib/svc/manifest/** on first boot,
#    incl. our solnix manifests). Do NOT copy the running repository.db — a fresh
#    seed avoids carrying the installer env's live service state onto the target.
# ---------------------------------------------------------------------------
log "seeding SMF repository from seed/global.db"
mkdir -p "$ALTROOT/etc/svc"
if [ "$SELF_INSTALL" = 1 ] || [ "$OVERLAY" = 1 ]; then
  # SELF-INSTALL / OVERLAY: the root copy already carried the LIVE root's
  # /etc/svc/repository.db, which is FULLY PRE-IMPORTED (oi-make-livecd 4f) and
  # proven to boot to multi-user (the live installer itself runs off it). Do NOT
  # overwrite it with the minimal lib/svc/seed/global.db -- that minimal seed
  # lacks the imported milestone instances, so first-boot manifest-import
  # DELETES the orphaned svc:/milestone/{multi-user,single-user,devices,...}
  # default instances -> "Console login service(s) cannot run" -> the system
  # drops to maintenance mode instead of multi-user. Keep the good copied repo.
  if [ -s "$ALTROOT/etc/svc/repository.db" ]; then
    log "keeping the copied pre-imported repository.db (NOT reseeding from global.db)"
  elif [ -e "$ALTROOT/lib/svc/seed/global.db" ]; then
    log "no copied repo -> falling back to global.db seed"
    cp "$ALTROOT/lib/svc/seed/global.db" "$ALTROOT/etc/svc/repository.db"
    chmod 0600 "$ALTROOT/etc/svc/repository.db"
  fi
elif [ -e "$ALTROOT/lib/svc/seed/global.db" ]; then
  cp "$ALTROOT/lib/svc/seed/global.db" "$ALTROOT/etc/svc/repository.db"
  chmod 0600 "$ALTROOT/etc/svc/repository.db"
fi

# ---------------------------------------------------------------------------
# 6. stage the toplevel's SMF manifests + site profile + activate (add-not-
#    replace; design-smf-init §5). The boot-plumbing hello/netcfg + cryptosvc
#    race fix already came from the copied root; here we install THIS toplevel's
#    config-generated manifests so first boot imports them.
# ---------------------------------------------------------------------------
log "staging toplevel SMF manifests + site profile + activate"
step "staging userland + SMF + boot loader"
if [ "$SELF_INSTALL" = 1 ]; then
  log "SELF-INSTALL: skipping toplevel manifest/etc staging (base root already carries the solnix SMF plumbing)"
else
mkdir -p "$ALTROOT/lib/svc/manifest/solnix" "$ALTROOT/lib/svc/method" "$ALTROOT/etc/svc/profile/site"
if [ -d "$_TLD/manifest/solnix" ]; then
  cp "$_TLD/manifest/solnix/"*.xml "$ALTROOT/lib/svc/manifest/solnix/" 2>/dev/null || true
fi
[ -e "$_TLD/site-profile.xml" ] && cp "$_TLD/site-profile.xml" "$ALTROOT/etc/svc/profile/site/solnix.xml"
[ -e "$_TLD/activate" ] && { cp "$_TLD/activate" "$ALTROOT/lib/svc/method/solnix-activate"; chmod 0555 "$ALTROOT/lib/svc/method/solnix-activate"; }

# 6b. stage the toplevel's config-generated /etc overlay (T2.9: networking +
#     users -> nodename/resolv.conf/defaultrouter/passwd/shadow/group) OVER the
#     copied base /etc, so the installed system reflects THIS toplevel's config,
#     not merely the installer env's. Merge declared users/groups (append any
#     the base lacks); overwrite the pure-config files.
if [ -d "$_TLD/etc" ]; then
  for f in nodename resolv.conf defaultrouter solnix-release; do
    [ -f "$_TLD/etc/$f" ] && cp "$_TLD/etc/$f" "$ALTROOT/etc/$f" 2>/dev/null || true
  done
  for f in passwd shadow group; do
    [ -f "$_TLD/etc/$f" ] || continue
    while IFS=: read -r nm rest; do
      [ -n "$nm" ] || continue
      grep -q "^$nm:" "$ALTROOT/etc/$f" 2>/dev/null || echo "$nm:$rest" >> "$ALTROOT/etc/$f"
    done < "$_TLD/etc/$f"
  done
  [ -f "$ALTROOT/etc/shadow" ] && chmod 0400 "$ALTROOT/etc/shadow"
fi
# 6c. seed each declared user's authorized_keys from the users module (T2.9),
#     against the target BE root, so SSH login works on the installed disk.
if [ -e "$_TLD/seed-authorized-keys" ] && [ -x /usr/bin/bash ]; then
  ROOT="$ALTROOT" /usr/bin/bash "$_TLD/seed-authorized-keys" 2>/dev/null \
    || echo "NOTE: authorized_keys seed had non-fatal errors" >&2
fi

# 6d. STAGE-A DECLARATIVE USERLAND (design §B/§C): the login env + nix.conf +
#     default profile + store-DB dump + first-boot register oneshot — same as
#     make-be, but staged onto the target BE root.
log "staging Stage-A userland (profile.d/solnix-env.sh, nix.conf, default profile, store-db dump)"
if [ -f "$_TLD/etc/profile.d/solnix-env.sh" ]; then
  mkdir -p "$ALTROOT/etc/profile.d"
  cp "$_TLD/etc/profile.d/solnix-env.sh" "$ALTROOT/etc/profile.d/solnix-env.sh"; chmod 0644 "$ALTROOT/etc/profile.d/solnix-env.sh"
fi
if [ -f "$_TLD/etc/nix/nix.conf" ]; then
  mkdir -p "$ALTROOT/etc/nix"
  cp "$_TLD/etc/nix/nix.conf" "$ALTROOT/etc/nix/nix.conf"; chmod 0644 "$ALTROOT/etc/nix/nix.conf"
fi
mkdir -p "$ALTROOT/nix/var/nix/profiles"
relink "$TOPLEVEL/sw" "$ALTROOT/nix/var/nix/profiles/default"
if [ "${TOPLEVEL_ON_POOL:-0}" = 1 ] && command -v nix-store >/dev/null 2>&1; then
  # On-pool build: the store DB is the $ALTROOT store's OWN db, already populated
  # by the build. Dump it via --store so first boot has every path registered.
  nix-store --store "$ALTROOT" --dump-db > "$ALTROOT/nix/.solnix-registration" 2>/dev/null \
    || echo "NOTE: nix-store --store $ALTROOT --dump-db failed; store DB not pre-dumped" >&2
elif [ -n "${_NIXSTORE:-}" ]; then
  # dump the FULL CLOSURE DB, not just the toplevel: --load-db needs every
  # referenced path registered, else first boot fails 'path <dep> is not valid'
  # (the toplevel-only dump left nix-2.3.16 etc. unregistered -> nix unusable).
  "$_NIXSTORE" --dump-db $CLOSURE > "$ALTROOT/nix/.solnix-registration" 2>/dev/null \
    || "$_NIXSTORE" --dump-db "$TOPLEVEL" > "$ALTROOT/nix/.solnix-registration" 2>/dev/null \
    || echo "NOTE: nix-store --dump-db failed; store DB not pre-dumped" >&2
fi
# first-boot store-registration oneshot (fixed manifest + method; self-disables).
mkdir -p "$ALTROOT/lib/svc/manifest/solnix" "$ALTROOT/lib/svc/method"
cat > "$ALTROOT/lib/svc/manifest/solnix/solnix-nix-register.xml" <<'EOF'
<?xml version="1.0"?>
<!DOCTYPE service_bundle SYSTEM "/usr/share/lib/xml/dtd/service_bundle.dtd.1">
<service_bundle type="manifest" name="solnix:nix-register">
  <service name="site/solnix-nix-register" type="service" version="1">
    <single_instance/>
    <dependency name="fs" grouping="require_all" restart_on="none" type="service">
      <service_fmri value="svc:/system/filesystem/local:default"/>
    </dependency>
    <exec_method type="method" name="start" exec="/lib/svc/method/solnix-nix-register" timeout_seconds="600">
      <method_context><method_credential user="root"/></method_context>
    </exec_method>
    <exec_method type="method" name="stop" exec=":true" timeout_seconds="60">
      <method_context><method_credential user="root"/></method_context>
    </exec_method>
    <property_group name="startd" type="framework">
      <propval name="duration" type="astring" value="transient"/>
    </property_group>
    <instance name="default" enabled="true"/>
    <template><common_name><loctext xml:lang="C">solnix nix store DB registration (first boot)</loctext></common_name></template>
  </service>
</service_bundle>
EOF
cat > "$ALTROOT/lib/svc/method/solnix-nix-register" <<'EOF'
#!/sbin/sh
. /lib/svc/share/smf_include.sh
SENTINEL=/nix/.solnix-registered
REG=/nix/.solnix-registration
if [ -e "$SENTINEL" ]; then exit $SMF_EXIT_OK; fi
NIXSTORE=""
for d in /run/current-system/sw/bin /nix/var/nix/profiles/default/bin /usr/bin; do
  [ -x "$d/nix-store" ] && { NIXSTORE="$d/nix-store"; break; }
done
# store nix is RUNPATH-correct: no LD_LIBRARY_PATH needed.
if [ -z "$NIXSTORE" ]; then
  echo "solnix-nix-register: nix-store not found; skipping" > /dev/console 2>&1
  exit $SMF_EXIT_OK
fi
if [ -s "$REG" ]; then
  "$NIXSTORE" --load-db < "$REG" > /dev/console 2>&1 \
    && echo "solnix-nix-register: store DB loaded" > /dev/console 2>&1 \
    || echo "solnix-nix-register: load-db failed" > /dev/console 2>&1
else
  "$NIXSTORE" --register-validity /run-current-system > /dev/console 2>&1 || true
fi
: > "$SENTINEL"
exit $SMF_EXIT_OK
EOF
chmod 0555 "$ALTROOT/lib/svc/method/solnix-nix-register"
fi   # end SELF_INSTALL=0 toplevel-staging block

# ---------------------------------------------------------------------------
# 7. register generation 1 + switch tools on the target's PATH (T2.5 layout).
# ---------------------------------------------------------------------------
if [ "$SELF_INSTALL" = 1 ]; then
  log "SELF-INSTALL: skipping generation/switch-tool registration (no nix toplevel)"
  # ...but DO make the store usable, so the operator can run a real nix-config
  # switch on the installed system. Without this the machine has a nix BINARY and
  # no store to use it on, which is what the maintainer hit: nix ran, and there
  # was nothing it could do. Single-user mode (no daemon) is deliberate -- it is
  # far less to go wrong on a fresh install, and SMF service plumbing for
  # nix-daemon is a separate piece of work.
  mkdir -p "$ALTROOT/nix/var/nix/profiles/per-user/root" \
           "$ALTROOT/nix/var/nix/gcroots" \
           "$ALTROOT/nix/var/nix/temproots" \
           "$ALTROOT/nix/var/nix/db" \
           "$ALTROOT/nix/store"
  # Root owns the store in single-user mode; 1775 with the sticky bit matches a
  # stock Nix install so the daemon can be adopted later without a re-chmod.
  chown -R 0:0 "$ALTROOT/nix" 2>/dev/null || true
  chmod 1775 "$ALTROOT/nix/store" 2>/dev/null || true
  # nix.conf for the INSTALLED system. The live-media copy under /nix-tools224
  # is not on the path a normal `nix` invocation reads.
  mkdir -p "$ALTROOT/etc/nix"
  if [ ! -s "$ALTROOT/etc/nix/nix.conf" ]; then
    cat > "$ALTROOT/etc/nix/nix.conf" <<'NIXCONF'
experimental-features = nix-command flakes
substituters = https://cache.solnix.io https://s3.solnix.io/solnix-cache https://cache.nixos.org
trusted-public-keys = cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY=
# Single-user: no daemon, root owns /nix. build-users-group must be EMPTY or nix
# refuses to build, looking for a nixbld group that does not exist here.
build-users-group =
NIXCONF
  fi
  # Gate: a store directory that is not on its own dataset would be cloned by
  # every `beadm create` and rolled back with the BE, orphaning every profile.
  case "$(zfs list -H -o name "$POOL/nix" 2>/dev/null)" in
    "$POOL/nix") log "nix store: $POOL/nix dataset present, single-user store initialised" ;;
    *) die "$POOL/nix dataset missing -- the store would live inside the BE" ;;
  esac
else
log "registering generation 1 + installing switch tools"
mkdir -p "$ALTROOT/nix/var/nix/profiles"
relink "$TOPLEVEL" "$ALTROOT/nix/var/nix/profiles/system-1-link"
relink "system-1-link" "$ALTROOT/nix/var/nix/profiles/system"
printf '1\n' > "$ALTROOT/nix/var/nix/profiles/system.gen"
if [ -e "$_TLD/bin/switch-to-configuration" ]; then
  relink "$TOPLEVEL/bin/switch-to-configuration" "$ALTROOT/usr/bin/switch-to-configuration"
  relink "$TOPLEVEL/bin/solnix-rebuild"          "$ALTROOT/usr/bin/solnix-rebuild"
  [ -e "$_TLD/bin/solnix-install" ] && relink "$TOPLEVEL/bin/solnix-install" "$ALTROOT/usr/bin/solnix-install"
fi
fi   # end SELF_INSTALL=0 generation-registration block

# ---------------------------------------------------------------------------
# 8. installed-system console + release stamp (make-be gotcha #1/#4). The copied
#    root already has bootenv.rc/loader.conf, but re-assert (idempotent, cheap).
#    The console value is SOLNIX_TARGET_CONSOLE (default ttya; "text" for the
#    keyboard-free install onto a machine with no serial port).
# ---------------------------------------------------------------------------
log "installed-system console=$TARGET_CONSOLE + release stamp"
mkdir -p "$ALTROOT/boot/solaris"
# Build the console-geometry lines BEFORE the heredocs that interpolate them.
# (_bootenv_geom / _efires were previously assigned AFTER the bootenv.rc heredoc
# that uses ${_bootenv_geom}, so under set -u the install died with
# "_bootenv_geom: parameter not set" at the console step -- measured on the X1.)
# "native" means omit the knob entirely and let the loader pick the panel's own
# mode; any other value pins it. The font is a fixed 8x16 with no larger built-in,
# so cell counts ARE the font size: 800x600 => 99x37. Set cell counts, not a
# resolution string. os/console.c:226-229 reads screen-#columns / screen-#rows.
case "$TARGET_RESOLUTION" in
  native) _cols=""; _rows="" ;;
  *) _cols=$(( ${TARGET_RESOLUTION%x*} / 8 )); _rows=$(( ${TARGET_RESOLUTION#*x} / 16 )) ;;
esac
if [ -n "$_cols" ]; then
  _efires="# console geometry: ${TARGET_RESOLUTION} with the fixed 8x16 font.
# screen-#columns / screen-#rows are read by os/console.c:226-229. These are the
# properties that actually work; efi-max-resolution does not exist in the loader.
screen-#columns=\"$_cols\"
screen-#rows=\"$_rows\""
  _bootenv_geom="setprop screen-#columns $_cols
setprop screen-#rows $_rows"
else
  _efires="# native panel geometry requested: no screen-#columns / screen-#rows set,
# so the console uses the full EDID mode (tiny on a HiDPI panel)."
  _bootenv_geom="# native geometry: no screen-#columns/#rows setprop"
fi
# the ttya-* props are kept unconditionally: they are inert when no serial port
# exists and are needed whenever TARGET_CONSOLE is ttya.
cat > "$ALTROOT/boot/solaris/bootenv.rc" <<EOF
setprop console $TARGET_CONSOLE
setprop os_console $TARGET_CONSOLE
setprop ttya-mode 115200,8,n,1,-
setprop ttya-ignore-cd true
setprop ttya-rts-dtr-off false
${_bootenv_geom}
EOF
cat > "$ALTROOT/boot/loader.conf" <<EOF
console="$TARGET_CONSOLE"
os_console="$TARGET_CONSOLE"
# Readable console on a HiDPI panel. MEASURED on the X1: EDID 3840x2160 and the
# loader chose text mode 2 = 480 columns x 113 rows, which is unreadable. The
# console font is a fixed 8x16 with no larger built-in, so rows/cols come from
# screen size (common/font/font.c) and RESOLUTION is the only lever. The live
# media already sets this; the installed system did not, so text was tiny again
# after the first reboot.
${_efires}
boot-args="-v"
loader_logo="illumos"
autoboot_delay="3"
kernel="/platform/i86pc/kernel/amd64/unix"
bootfile="/platform/i86pc/kernel/amd64/unix"
boot_archive_load="YES"
boot_archive_name="/platform/i86pc/amd64/boot_archive"
boot_archive.hash_load="NO"
EOF
# LOUD-FAIL GATE: the installed console is unrecoverable-if-wrong on a machine
# with no keyboard, and both files are written by heredoc (a quoting slip would
# ship the literal text). Assert what actually landed on the target.
for _cf in "$ALTROOT/boot/loader.conf" "$ALTROOT/boot/solaris/bootenv.rc"; do
  grep -q "$TARGET_CONSOLE" "$_cf" || die "installed console: $_cf does not mention $TARGET_CONSOLE"
  grep -q '\$TARGET_CONSOLE' "$_cf" && die "installed console: $_cf contains an UNEXPANDED variable"
done
grep -q "^console=\"$TARGET_CONSOLE\"\$" "$ALTROOT/boot/loader.conf" || \
  die "installed console: loader.conf lacks console=\"$TARGET_CONSOLE\""
# Gate the console GEOMETRY too. The maintainer's installed system reverted to the
# smallest font after reboot while the media was fine, because the only knob being
# written (efi-max-resolution) does not exist in the loader at all. A gate on the
# real property means that cannot recur silently.
if [ "$TARGET_RESOLUTION" != native ]; then
  grep -q "^setprop screen-#columns $_cols\$" "$ALTROOT/boot/solaris/bootenv.rc" \
    || die "bootenv.rc lacks setprop screen-#columns $_cols -- the installed console would use the tiny native mode"
  grep -q "^setprop screen-#rows $_rows\$" "$ALTROOT/boot/solaris/bootenv.rc" \
    || die "bootenv.rc lacks setprop screen-#rows $_rows"
  log "console geometry gate OK: ${_cols}x${_rows} cells written to bootenv.rc"
fi
grep -q "^setprop console $TARGET_CONSOLE\$" "$ALTROOT/boot/solaris/bootenv.rc" || \
  die "installed console: bootenv.rc lacks setprop console $TARGET_CONSOLE"
echo "installed-console gate OK: console=$TARGET_CONSOLE in loader.conf + bootenv.rc" >&2
# The illumos EFI loader's sanity_check_currdev() accepts a ZFS BE as bootable
# ONLY if it can stat /boot/defaults/loader.conf OR /boot/loader.rc on that
# dataset (verified in loader64.efi strings). The SELF-INSTALL live ramdisk root
# does not carry those (they live in the ISO staging tree, not the ramdisk), so
# the loader REJECTS zfs:rpool/ROOT/solnix-1 in sanity_check_currdev and cycles
# to "Failed to find bootable partition" -- even though unix + boot_archive are
# present + fine. Guarantee both sanity files exist on the BE (idempotent), and
# stage /boot/forth/ (loader.rc includes /boot/forth/loader.4th at runtime for
# the menu; without it the loader errors on the include). Root-caused via ZFS
# import of an installed pool on the illumos host (2026-07-30).
mkdir -p "$ALTROOT/boot/defaults"
[ -s "$ALTROOT/boot/defaults/loader.conf" ] || cat > "$ALTROOT/boot/defaults/loader.conf" <<'EOF'
kernel="/platform/i86pc/kernel/amd64/unix"
bootfile="/platform/i86pc/kernel/amd64/unix"
boot_archive_load="YES"
boot_archive_name="/platform/i86pc/amd64/boot_archive"
boot_archive.hash_load="NO"
EOF
# stage /boot/forth/ + the canonical /boot/loader.rc from the running root (/).
# The illumos loader needs a PROPER loader.rc: `include loader.4th; initialize
# drop; check-password; include beastie.4th; beastie-start` (autoboots via
# autoboot_delay). A naive `include loader.4th\nstart` fails with "start not
# found" (start isn't defined until the full include chain runs) -> the loader
# drops to the OK prompt instead of booting. So COPY the host's real loader.rc
# + the whole /boot/forth/ menu tree verbatim (they exist on the live root).
if [ -d "/boot/forth" ] && [ ! -d "$ALTROOT/boot/forth" ]; then
  ( cd / && tar -cf - boot/forth ) | ( cd "$ALTROOT" && tar -xf - ) 2>/dev/null || true
fi
if [ -s /boot/loader.rc ]; then
  cp /boot/loader.rc "$ALTROOT/boot/loader.rc" 2>/dev/null || true
fi
# A USABLE loader.rc is one that `include`s the forth chain -- the STOCK illumos
# loader.rc is `include /boot/forth/loader.4th` then `start` (or beastie-start),
# and does NOT contain the literal word `initialize` (start runs it internally).
# The old guard grepped for `initialize` and therefore REJECTED the good stock
# loader.rc we just copied, overwriting it with a hand-written
# `include loader.4th; initialize drop; boot` -- which, processed from the
# installed pool, EXHAUSTS the forth dictionary ("Error: dictionary full" on every
# word, before autoboot) and drops to the OK prompt. MEASURED on the dixi X1.
# Correct test: a usable rc contains an `include` of the forth chain. Only if it
# does NOT (or the file is empty/missing) do we synthesize one -- and we match the
# STOCK pattern (`start`), never the dictionary-blowing `initialize drop; boot`.
if [ ! -s "$ALTROOT/boot/loader.rc" ] || ! grep -q 'include' "$ALTROOT/boot/loader.rc" 2>/dev/null; then
  [ -f "$ALTROOT/boot/forth/loader.4th" ] || \
    echo "WARN: BE lacks /boot/forth/loader.4th; the installed loader may not autoboot" >&2
  # Stock illumos loader.rc: include the chain, then `start` (which runs
  # initialize + the menu + autoboots via autoboot_delay). This is exactly what a
  # working illumos install ships; do NOT add a second `initialize`/`boot`.
  printf 'include /boot/forth/loader.4th\nstart\n' > "$ALTROOT/boot/loader.rc"
fi
# ensure autoboot actually fires even if the menu is absent: defaults/loader.conf
# already sets kernel/bootfile; make sure autoboot_delay is a real number (set
# above in loader.conf) so `initialize`/menu autoboots the default BE.
cat > "$ALTROOT/etc/solnix-release" <<EOF
NAME="The Solnix Operating System"
EDITION=${SOLNIX_EDITION:-unstable}
ARCH=x86_64
solnix system (installed by solnix-install)
installed: $(date -u +%FT%TZ 2>/dev/null || date)
toplevel:  ${TOPLEVEL:-<self-install: live root>}
installer: $(uname -a)
target:    $TARGET pool $POOL BE $BEDS
EOF
[ -f "$ALTROOT/etc/hostid" ] || printf '0x1b0b57ec\n' > "$ALTROOT/etc/hostid"

# ---------------------------------------------------------------------------
# 9. boot_archive (the ramdisk that mounts ZFS root) for the target BE.
# ---------------------------------------------------------------------------
log "building boot_archive on the target BE"
step "building the boot archive (bootadm update-archive)"
# WIDEST-HARDWARE FIRST BOOT: unconditionally EMPTY the target's path_to_inst so
# the installed kernel REBUILDS device-instance assignments for whatever hardware
# it actually boots on (the SELF-INSTALL source root may carry stale instance
# bindings; a physical box or a different hypervisor has a different device tree).
# Also drop a /reconfigure sentinel so the first boot runs a reconfiguration
# (re-enumerate + attach all present devices) -- the standard illumos mechanism
# for booting installed media on unknown hardware.
: > "$ALTROOT/etc/path_to_inst"
: > "$ALTROOT/reconfigure"
# Remove the COPIED build-host zpool.cache: it names the HOST's rpool, so the
# installed system tries to import a non-existent rpool at boot -> ZFS-8000-D3/CS
# fmd faults + "pool: rpool UNAVAIL" noise. The target must only know its own
# (exported-with-cachefile=none) pool, which the loader's bootfs selects; drop
# the stale cache so no phantom rpool import is attempted.
rm -f "$ALTROOT/etc/zfs/zpool.cache" 2>/dev/null || true
# bootadm mkdirs <root>/platform/i86pc/amd64/archive_cache but does NOT create
# the parent dir; the SELF-INSTALL live root has no platform/i86pc/amd64 (the
# ramdisk installer env curates it out), so pre-create it or bootadm fails
# "mkdir of .../archive_cache failed: No such file or directory".
mkdir -p "$ALTROOT/platform/i86pc/amd64"
# NOTE: create_hash (bootadm's sha1 step) is memory-hungry and gets OOM-killed on
# small install VMs, leaving a TRUNCATED/empty boot_archive that [ -f ] passes but
# the loader rejects ("Failed to find bootable partition"). So: build, then VERIFY
# the archive is non-empty + a real archive; if it looks truncated, free memory
# (sync) and rebuild ONCE. A boot_archive under ~8MB is not a valid solnix ramdisk.
BA="$ALTROOT/platform/i86pc/amd64/boot_archive"
# TRUE ROOT CAUSE of the truncated-archive FAIL: bootadm's create_hash runs
# `digest -a sha1`, and the live PKCS#11 config enables the pkcs11_tpm.so
# provider whose libtspi.so.1 dep is missing from the media -> ld.so fatal
# relocation error -> `digest` dies with SIGKILL ("create_hash line 377
# Killed") -> no hash -> truncated boot_archive. Misreads as OOM but is a
# missing-lib abort (hence RAM-immune). Disable the TPM provider so digest
# falls back to SW SHA1. Covers ISOs predating the oi-make-livecd.sh fix.
for pk in /etc/crypto/pkcs11.conf "$ALTROOT/etc/crypto/pkcs11.conf"; do
  [ -f "$pk" ] && grep -q '^/usr/lib/security/\$ISA/pkcs11_tpm.so' "$pk" 2>/dev/null \
    && sed -i 's,^\(/usr/lib/security/\$ISA/pkcs11_tpm.so.*\)$,# solnix: disabled (libtspi.so.1 absent) \1,' "$pk" 2>/dev/null || true
done
# Belt-and-suspenders for the create_hash OOM: cap the live ZFS ARC at runtime
# right before the archive build so `digest` has RAM even if this ISO predates
# the /etc/system ARC cap. Harmless if already capped; mdb -kw is on the media.
if command -v mdb >/dev/null 2>&1; then
  echo 'zfs_arc_max/Z 0x20000000' | mdb -kw >/dev/null 2>&1 || true
fi
sync
# DEFINITIVE root-agnostic fix for the truncated-boot_archive FAIL. bootadm's
# create_ramdisk runs the hash via an ABSOLUTE path (`/usr/bin/digest -a sha1
# $CPIO`), so a PATH-shadow can't intercept it. The real digest either OOMs on
# the ~450MB CPIO, aborts on the missing libtspi/pkcs11_tpm provider, or (after
# we disable that provider) reports "failed to find any cryptographic provider"
# -- ALL leave a hashless -> truncated boot_archive -> FAIL rc=1. The loader does
# NOT use this hash (loader.conf boot_archive.hash_load="NO"). So REPLACE the
# digest BINARY itself (live + target) with an instant stub that emits a constant;
# create_ramdisk's absolute-path call then succeeds immediately. Back up + restore.
install_digest_stub() {
  for _d in /usr/bin/digest "$ALTROOT/usr/bin/digest"; do
    [ -e "$_d" ] || continue
    [ -e "$_d.solnix-orig" ] || cp -p "$_d" "$_d.solnix-orig" 2>/dev/null || true
    cat > "$_d" <<'DIGSTUB'
#!/sbin/sh
# solnix install-time stub for /usr/bin/digest: the real digest OOMs/aborts on the
# 450MB boot_archive CPIO and the hash is unused at boot (hash_load=NO). Emit a
# constant so create_ramdisk's `digest -a sha1 ... > $tarchive.hash` succeeds now.
printf '0000000000000000000000000000000000000000\n'
exit 0
DIGSTUB
    chmod 0755 "$_d" 2>/dev/null || true
  done
}
install_digest_stub
build_ba() { run_to 300 sh -c 'bootadm update-archive -f -R "$1" 2>&1 | grep -vE "^gzip:|cannot find" | tail -6' _ "$ALTROOT" || true; }
# The target boot_archive is a GZIP of a curated CPIO (create_ramdisk's x86
# path: cpio -H odc | gzip). A minimal target is legitimately much smaller
# (~27MB) than the full live-ISO ramdisk (~117MB), so size is NOT a validity
# signal -- `file` even reports it as "gzip compressed data" (which is why the
# old archive|cpio|ufs|boot regex wrongly rejected VALID archives). The real
# integrity test is `gzip -t`: it inflates the entire deflate stream and fails
# iff the archive was truncated mid-write. That catches the true failure
# (partial gzip) and passes any complete archive regardless of size. The
# unused-at-boot sha1 hash (hash_load=NO) is irrelevant to validity.
ba_ok() {
  [ -s "$BA" ] || return 1
  # NOTE: illumos has NO stat(1) -- not /usr/bin/stat, not gstat (verified on a
  # live node: only wc and ls are present). Every `stat -c %s` below therefore
  # expanded to the fallback 0, which made the non-gzip branch's size gate
  # ALWAYS FALSE: the `-ge 8388608` test failed, so the `&& file ...` check after
  # it never ran and that branch validated NOTHING. It also made the success log
  # read "boot_archive OK:  bytes" with an empty number -- the visible symptom of
  # a check that was silently dead. `wc -c` is POSIX and present, so use it.
  _fsize() {
    # An absent file makes `wc -c` fail and print nothing, and an EMPTY string
    # would make the caller's `[ "$(...)" -ge N ]` a syntax error rather than a
    # false -- so normalise to 0. (The `|| echo 0` on the pipeline does NOT cover
    # this: the pipeline's exit status is wc's, but its stdout is already empty.)
    _n=$(wc -c < "$1" 2>/dev/null | tr -d ' ')
    echo "${_n:-0}"
  }

  # gzip magic 1f 8b -> validate the whole stream; else accept a bare CPIO/UFS.
  if [ "$(od -An -N2 -tx1 "$BA" 2>/dev/null | tr -d ' ')" = "1f8b" ]; then
    gzip -t "$BA" 2>/dev/null
  else
    [ "$(_fsize "$BA")" -ge 8388608 ] && \
      file "$BA" 2>/dev/null | grep -qiE 'archive|cpio|ufs|boot'
  fi
}
spin_start "bootadm update-archive (builds the boot_archive cpio)"
build_ba
spin_stop
if ! ba_ok; then
  log "boot_archive incomplete ($(_fsize "$BA") bytes, gzip -t failed) — syncing + rebuilding once"
  sync; sleep 2
  spin_start "bootadm update-archive (retry)"
  build_ba
  spin_stop
fi
ba_ok || die "boot_archive invalid/truncated after rebuild ($(_fsize "$BA") bytes) — gzip stream incomplete"
log "boot_archive OK: $(_fsize "$BA") bytes, $(file "$BA" 2>/dev/null)"

# ---------------------------------------------------------------------------
# 10. loader: UEFI path (ESP) + BIOS/CSM path (pool boot area) + bootfs + menu.
# ---------------------------------------------------------------------------
# Two independent boot paths, because EC2 boots solnix two different ways:
#   * Nitro VMs (m5/m6i/c5 non-metal) boot via UEFI 2.70 -> the firmware reads
#     the ESP and runs EFI/Boot/bootx64.efi (= loader64.efi).
#   * EC2 bare-metal instances (m6i.metal, c5n.metal, ...) are Legacy-BIOS ONLY
#     (AWS: "All Nitro instances support UEFI and Legacy BIOS EXCEPT bare metal
#     instances"). Metal's SeaBIOS/CSM ignores the ESP and runs the MBR/PMBR
#     stage1 -> gptzfsboot (stage2, in the ZFS POOL boot area) -> loader.
# stage2 (gptzfsboot) MUST be installed on the ZFS POOL slice (s1), NOT the ESP
# (s0): installboot records stage2's location into stage1, and on x86 GPT+ZFS
# stage2 lives in the pool boot area of the pool vdev slice. Targeting the pcfs
# ESP leaves stage1 pointing at LBA 256 with no gptzfsboot there -> a real
# BIOS/CSM (EC2 metal) reads 1 sector of pcfs garbage and hangs at POST. On
# Nitro VMs this never surfaced because they UEFI-boot and skip the BIOS chain.
log "installing UEFI loader on ESP"
mkdir -p "$ALTROOT/esp"
devfsadm >/dev/null 2>&1 || true
mount -F pcfs "/dev/dsk/${TARGET}s0" "$ALTROOT/esp" || die "ESP mount failed (fstyp=$(fstyp "/dev/rdsk/${TARGET}s0" 2>&1))"
mkdir -p "$ALTROOT/esp/EFI/Boot"
cp "$ALTROOT/boot/loader64.efi" "$ALTROOT/esp/EFI/Boot/bootx64.efi" || die "loader copy failed"
umount "$ALTROOT/esp"
log "installing BIOS/CSM stage1+stage2 (pmbr + gptzfsboot) on the ZFS pool slice ${TARGET}s1"
installboot -fm "$ALTROOT/boot/pmbr" "$ALTROOT/boot/gptzfsboot" "/dev/rdsk/${TARGET}s1" 2>&1 || \
  die "installboot (BIOS stage1/stage2) failed on ${TARGET}s1"
zpool set bootfs="$BEDS" "$POOL"
# beadm needs the pool mounted + a menu.lst under the pool root (libbe "Invalid
# path for menu.lst" otherwise); give the pool a mountpoint + seed menu.lst.
zfs set mountpoint="/$POOL" "$POOL" 2>/dev/null || true
mkdir -p "$ALTROOT/$POOL/boot" 2>/dev/null || true
printf 'title %s\nbootfs %s\n' "$BE" "$BEDS" > "$ALTROOT/$POOL/boot/menu.lst"
cat > "$ALTROOT/boot/menu.lst" <<EOF
title $BE
bootfs $BEDS
EOF

# ---------------------------------------------------------------------------
# 11. finalize: export the pool so it's importable on the target machine.
# ---------------------------------------------------------------------------
# Remove the live-media auto-install marker from the INSTALLED BE so the
# installed system does NOT re-run the live-installer (site/solnix-live) and
# try to reinstall itself on every boot. The marker is a live-media test
# scaffold only; it must never ship on the installed root/AMI. Also disable
# the live-installer service in the target repo as belt-and-suspenders.
rm -f "$ALTROOT/etc/solnix-autoinstall" 2>/dev/null || true
# ---------------------------------------------------------------------------
# 10b. INTERACTIVE ADMIN ACCOUNT.
#
# illumos has no `wheel`. The native equivalents are the `sysadmin` group (gid 14)
# and RBAC's "Primary Administrator" profile, which prof_attr defines as
# uid=0;gid=0 -- i.e. genuinely root-equivalent, unlike a bare group membership.
# We grant BOTH plus `staff` (gid 10, the normal primary group), and add sudo's
# wheel only if that group happens to exist, since sudo is not in illumos-gate
# (OpenIndiana packages it separately) while pfexec is native.
#
# Skipped entirely when non-interactive: an auto-install has no operator to ask,
# and silently inventing an account with a guessed password would be worse than
# none. SOLNIX_ADMIN_USER/SOLNIX_ADMIN_PW allow unattended use explicitly.
# ---------------------------------------------------------------------------
# 10a. ROOT PASSWORD + login hardening.
#
# ⚠️ THE LIVE MEDIA DELIBERATELY BLANKS root's PASSWORD so the operator can log in
# to run this installer (oi-make-livecd.sh:1611 empties the shadow field, and :1614
# sets PASSREQ=NO and comments out CONSOLE=). Correct for live media, and a real
# hole once copied: step 3 copies /etc/{passwd,shadow,group} verbatim, so WITHOUT
# THIS BLOCK the installed system ships with a passwordless root, empty passwords
# permitted at login, and root allowed on any terminal.
#
# Hash helper shared with the admin-user block below.
_hash_pw() {  # $1 = plaintext -> stdout = crypt string, empty on failure
  for _o in openssl /usr/openssl/1.0/bin/openssl /usr/openssl/3/bin/openssl \
            "$ALTROOT/usr/openssl/1.0/bin/openssl"; do
    { command -v "$_o" >/dev/null 2>&1 || [ -x "$_o" ]; } || continue
    _h=$(printf '%s' "$1" | "$_o" passwd -6 -stdin 2>/dev/null || true)
    [ -n "$_h" ] && { printf '%s' "$_h"; return 0; }
  done
  return 1
}

_rootpw=""
if [ -n "${SOLNIX_ROOT_PW:-}" ]; then
  _rootpw="$SOLNIX_ROOT_PW"
elif [ -n "${SOLNIX_ROOT_NO_PASSWORD:-}" ]; then
  # Explicit unattended "lock root". Handled before the prompt so an automated
  # install can select it without a tty.
  _rootpw=""; _rootlock=1
  log "SOLNIX_ROOT_NO_PASSWORD set -> root will be LOCKED (*LK*)"
elif [ -t 0 ] && [ -t 1 ]; then
  echo ""
  echo "=== Root password =========================================================="
  echo "The install media runs root PASSWORDLESS so you can reach this installer."
  echo "The installed system must not inherit that -- copying it to disk was a real"
  echo "defect, not a hypothetical one."
  echo ""
  echo "  1) set a root password        (default)"
  echo "  2) NO root password -- lock the root account entirely"
  echo ""
  echo "  Option 2 writes *LK* to root's shadow field, which is NOT the same as"
  echo "  blank: a locked account cannot be logged into at all, whereas a blank one"
  echo "  lets anyone in. If you pick 2, make sure you create the admin user below"
  echo "  -- it gets the RBAC Primary Administrator profile, so 'pfexec <cmd>' is"
  echo "  your route to root, and 'su -' will not work."
  printf 'Choice [1/2] (default 1): '
  read -r _rpchoice || _rpchoice=1
  case "$_rpchoice" in
    2)
      _rootpw=""; _rootlock=1
      echo "  root will be LOCKED (*LK*). Use pfexec from the admin account."
      ;;
  esac
  while [ "${_rootlock:-0}" != 1 ]; do
    _oldstty=$(stty -g 2>/dev/null || true)
    trap '[ -n "$_oldstty" ] && stty "$_oldstty" 2>/dev/null; echo ""' INT
    printf 'Root password: '; stty -echo 2>/dev/null; read -r _rootpw || _rootpw=""; stty echo 2>/dev/null; echo ""
    printf 'Confirm:       '; stty -echo 2>/dev/null; read -r _rp2 || _rp2=""; stty echo 2>/dev/null; echo ""
    [ -n "$_oldstty" ] && stty "$_oldstty" 2>/dev/null
    trap - INT
    [ "$_rootpw" = "$_rp2" ] || { echo "  passwords do not match"; continue; }
    [ -n "$_rootpw" ] || { echo "  empty root password refused -- that is the hole this step closes"; continue; }
    [ ${#_rootpw} -ge 6 ] || { echo "  too short (illumos passwd requires >= 6)"; continue; }
    break
  done
fi

if [ "${_rootlock:-0}" = 1 ]; then
  # DELIBERATE no-password install: lock root. *LK*, never blank -- the live media
  # ships root with an EMPTY shadow field so the operator can run this installer,
  # and step 3 copies /etc/shadow verbatim, so "no password" must mean LOCKED or it
  # means "anyone can log in as root", which is the defect this whole block exists
  # to close.
  awk -F: 'BEGIN{OFS=":"} $1=="root"{$2="*LK*"} {print}' \
    "$ALTROOT/etc/shadow" > "$ALTROOT/etc/shadow.new" \
    && mv "$ALTROOT/etc/shadow.new" "$ALTROOT/etc/shadow"
  chmod 0400 "$ALTROOT/etc/shadow"
  # Verify: an EMPTY field here would be exactly the hole we think we just closed.
  _rf=$(awk -F: '$1=="root"{print $2}' "$ALTROOT/etc/shadow" 2>/dev/null)
  [ "$_rf" = "*LK*" ] || die "root lock did not land in the target /etc/shadow (field='$_rf', expected *LK*)"
  log "root account LOCKED (*LK*) on the target -- not blank, not passwordless"
elif [ -n "$_rootpw" ]; then
  _rh=$(_hash_pw "$_rootpw" || true)
  if [ -n "$_rh" ]; then
    awk -F: -v h="$_rh" 'BEGIN{OFS=":"} $1=="root"{$2=h} {print}' \
      "$ALTROOT/etc/shadow" > "$ALTROOT/etc/shadow.new" \
      && mv "$ALTROOT/etc/shadow.new" "$ALTROOT/etc/shadow"
    chmod 0400 "$ALTROOT/etc/shadow"
    # Verify the hash actually landed: an empty field here is the whole defect.
    _rf=$(awk -F: '$1=="root"{print $2}' "$ALTROOT/etc/shadow" 2>/dev/null)
    case "$_rf" in
      ''|'*'|'*LK*'|NP) die "root password did not land in the target /etc/shadow (field='$_rf')" ;;
    esac
    log "root password set on the target"
  else
    die "could not hash the root password -- refusing to install a passwordless root"
  fi
else
  # No password supplied and non-interactive: LOCK root rather than leave it open.
  # A locked root with an admin user able to pfexec is safe; a blank root is not.
  awk -F: 'BEGIN{OFS=":"} $1=="root"{$2="*LK*"} {print}' \
    "$ALTROOT/etc/shadow" > "$ALTROOT/etc/shadow.new" \
    && mv "$ALTROOT/etc/shadow.new" "$ALTROOT/etc/shadow"
  chmod 0400 "$ALTROOT/etc/shadow"
  log "no root password given -> root LOCKED (*LK*) on the target, not left blank"
fi

# Undo the live media's login relaxations on the INSTALLED system.
if [ -f "$ALTROOT/etc/default/login" ]; then
  sed -e 's/^#*PASSREQ=.*/PASSREQ=YES/' \
      -e 's,^#*CONSOLE=.*,CONSOLE=/dev/console,' \
      "$ALTROOT/etc/default/login" > "$ALTROOT/etc/default/login.new" \
    && mv "$ALTROOT/etc/default/login.new" "$ALTROOT/etc/default/login"
  grep -q '^PASSREQ=YES' "$ALTROOT/etc/default/login" \
    || die "PASSREQ=YES not set on the target -- empty passwords would be accepted"
  grep -q '^CONSOLE=/dev/console' "$ALTROOT/etc/default/login" \
    || die "CONSOLE= not restored -- root could log in on any terminal"
  log "login hardened: PASSREQ=YES, root console-only"
fi
# sshd must not accept root with a password even so; only touch an existing file.
if [ -f "$ALTROOT/etc/ssh/sshd_config" ]; then
  sed -e 's/^#*PermitRootLogin.*/PermitRootLogin no/' \
      -e 's/^#*PermitEmptyPasswords.*/PermitEmptyPasswords no/' \
      "$ALTROOT/etc/ssh/sshd_config" > "$ALTROOT/etc/ssh/sshd_config.new" \
    && mv "$ALTROOT/etc/ssh/sshd_config.new" "$ALTROOT/etc/ssh/sshd_config"
  log "sshd: PermitRootLogin no, PermitEmptyPasswords no"
fi
# Ensure network/ssh is ENABLED in the target's SMF repository, so the installed
# system comes up with sshd listening on first boot (needed for remote login).
# The target repository.db is the copied live one; network/ssh is normally enabled
# there, but assert it explicitly against the target repo (SVCCFG_REPOSITORY), same
# pattern as the autofs preset. A machine the operator installed to log into
# remotely must not come up with sshd disabled.
if [ -x /usr/sbin/svccfg ] && [ -f "$ALTROOT/etc/svc/repository.db" ]; then
  SVCCFG_REPOSITORY="$ALTROOT/etc/svc/repository.db" \
    /usr/sbin/svccfg -s network/ssh setprop general/enabled = boolean: true 2>/dev/null \
    && log "target network/ssh preset ENABLED (sshd listens on first boot)" \
    || log "note: could not preset network/ssh enabled; run 'svcadm enable network/ssh' after first boot"
fi

_mkadmin=0
if [ -n "${SOLNIX_ADMIN_USER:-}" ]; then
  _au="$SOLNIX_ADMIN_USER"; _apw="${SOLNIX_ADMIN_PW:-}"; _mkadmin=1
elif [ -t 0 ] && [ -t 1 ]; then
  echo ""
  echo "=== Create an administrative user ==========================================="
  echo "This account gets: primary group staff, secondary sysadmin, and the RBAC"
  echo "\"Primary Administrator\" profile (root-equivalent via pfexec)."
  echo "Press Enter with an empty name to skip."
  while : ; do
    printf 'Username: '; read -r _au || _au=""
    [ -z "$_au" ] && break
    # POSIX-portable name check: illumos useradd rejects names it dislikes only
    # AFTER doing work, so validate first and re-ask rather than failing late.
    case "$_au" in
      [a-z_]*) : ;;
      *) echo "  must start with a lowercase letter or underscore"; continue ;;
    esac
    case "$_au" in
      *[!a-z0-9_-]*) echo "  only lowercase letters, digits, - and _"; continue ;;
    esac
    if [ ${#_au} -gt 32 ]; then echo "  too long (max 32)"; continue; fi
    if grep -q "^$_au:" "$ALTROOT/etc/passwd" 2>/dev/null; then
      echo "  $_au already exists on the target"; continue
    fi
    # Password twice, never echoed. stty -echo is the portable way here; the trap
    # restores it even if the operator interrupts, so a Ctrl-C cannot leave the
    # terminal silently echo-less.
    _oldstty=$(stty -g 2>/dev/null || true)
    trap '[ -n "$_oldstty" ] && stty "$_oldstty" 2>/dev/null; echo ""' INT
    printf 'Password: '; stty -echo 2>/dev/null; read -r _apw || _apw=""; stty echo 2>/dev/null; echo ""
    printf 'Confirm:  '; stty -echo 2>/dev/null; read -r _apw2 || _apw2=""; stty echo 2>/dev/null; echo ""
    [ -n "$_oldstty" ] && stty "$_oldstty" 2>/dev/null
    trap - INT
    if [ "$_apw" != "$_apw2" ]; then echo "  passwords do not match -- try again"; continue; fi
    if [ -z "$_apw" ]; then echo "  empty password refused (the account would be unusable over ssh)"; continue; fi
    if [ ${#_apw} -lt 6 ]; then echo "  too short (illumos passwd requires >= 6)"; continue; fi
    _mkadmin=1; break
  done
fi

if [ "$_mkadmin" = 1 ]; then
  # SHOW THE PLAN BEFORE DOING IT. An installer that silently creates accounts is
  # the same class of surprise as one that silently picks a disk.
  echo ""
  echo "  About to create on $TARGET:"
  echo "    username    : $_au"
  echo "    home        : ${HOME_BASE}/$_au  (on $POOL/export/home, outside the BE)"
  echo "    shell       : /bin/bash"
  echo "    primary grp : staff (10)"
  echo "    secondary   : sysadmin (14)"
  echo "    RBAC profile: Primary Administrator  (root-equivalent via pfexec)"
  echo "    password    : set (not shown)"
  if [ -t 0 ]; then
    printf '  Proceed? [y/N] '; read -r _yn || _yn=n
    case "$_yn" in y|Y|yes|YES) : ;; *) echo "  skipped."; _mkadmin=0 ;; esac
  fi
fi

if [ "$_mkadmin" = 1 ]; then
  log "creating admin user $_au"
  # The home lives on the SEPARATE home dataset ($POOL/home or $POOL/export/home),
  # which mounts at $HOME_BASE on the running system. During install that dataset is
  # NOT mounted under $ALTROOT, so writing to $ALTROOT$HOME_BASE lands in the BE's
  # own $HOME_BASE directory -- which is SHADOWED by the dataset at boot, so the
  # home + authorized_keys silently vanish on first boot (measured on the X1: gburd
  # had no ~/.ssh after reboot). Mount the home dataset under $ALTROOT first so the
  # home + key land on the dataset that actually mounts at boot.
  _homeds="$POOL/home"
  case "$HOME_BASE" in */export/home) _homeds="$POOL/export/home" ;; esac
  if zfs list -H "$_homeds" >/dev/null 2>&1; then
    zfs set mountpoint="$ALTROOT$HOME_BASE" "$_homeds" 2>/dev/null || true
    zfs mount "$_homeds" 2>/dev/null || true
    log "mounted $_homeds at $ALTROOT$HOME_BASE so the admin home lands on the dataset (not the shadowed BE dir)"
  fi
  mkdir -p "$ALTROOT${HOME_BASE}"
  # Run useradd/passwd AGAINST THE TARGET ROOT (-R), not the live system, so the
  # account lands on the installed disk. Fall back to direct file edits if -R is
  # unsupported -- illumos useradd has carried -R for a long time, but a silent
  # no-op here would produce a machine with no way in.
  _ua_ok=0
  if "$ALTROOT/usr/sbin/useradd" -R "$ALTROOT" -m -d "${HOME_BASE}/$_au" \
       -s /bin/bash -g staff -G sysadmin "$_au" 2>/dev/null; then
    _ua_ok=1
  elif chroot "$ALTROOT" /usr/sbin/useradd -m -d "${HOME_BASE}/$_au" \
       -s /bin/bash -g staff -G sysadmin "$_au" 2>/dev/null; then
    _ua_ok=1
  fi
  if [ "$_ua_ok" != 1 ]; then
    # Documented fallback: append the entries by hand. Verified below either way.
    _uid=$(awk -F: '$3>=100 && $3<60000 {if ($3>m) m=$3} END {print (m<100?100:m+1)}' \
           "$ALTROOT/etc/passwd" 2>/dev/null)
    printf '%s:x:%s:10:%s:%s/%s:/bin/bash\n' "$_au" "$_uid" "$_au" "$HOME_BASE" "$_au" \
      >> "$ALTROOT/etc/passwd"
    printf '%s:*LK*:::::::\n' "$_au" >> "$ALTROOT/etc/shadow"
    mkdir -p "$ALTROOT${HOME_BASE}/$_au"
    chown "$_uid":10 "$ALTROOT${HOME_BASE}/$_au" 2>/dev/null || true
    log "useradd -R unavailable; created $_au via direct /etc edits (uid $_uid)"
  fi
  # Password: chroot passwd needs a tty, so set the hash directly. openssl is
  # staged and gives a portable SHA-512 crypt that illumos accepts.
  # ⚠️ openssl is a DANGLING SYMLINK on this AMI (usr/bin/openssl ->
  # ../openssl/1.0/bin/openssl, a versioned tree that is not staged), so it may not
  # run in the image. A locked admin account on a laptop the operator just installed
  # is a bad failure, so try openssl, then the versioned path directly, then let
  # passwd(1) do it under chroot with a tty. Each is verified by the assertion below.
  _hash=$(_hash_pw "$_apw" || true)
  if [ -z "$_hash" ]; then
    # Last resort: passwd inside the target. Needs a tty, which we have when
    # interactive; it prompts the operator a second time and that is acceptable
    # because the alternative is an account with no password at all.
    if [ -t 0 ] && chroot "$ALTROOT" /usr/bin/passwd "$_au" </dev/tty >/dev/tty 2>&1; then
      _hash="set-by-passwd"
      log "password set via chroot passwd (openssl unavailable in the image)"
    fi
  fi
  if [ -n "$_hash" ] && [ "$_hash" != set-by-passwd ]; then
    awk -F: -v u="$_au" -v h="$_hash" 'BEGIN{OFS=":"} \
      $1==u {$2=h} {print}' "$ALTROOT/etc/shadow" > "$ALTROOT/etc/shadow.new" \
      && mv "$ALTROOT/etc/shadow.new" "$ALTROOT/etc/shadow"
    chmod 400 "$ALTROOT/etc/shadow"
  else
    log "WARNING: could not hash the password; $_au is locked -- set it from a root login"
  fi
  # RBAC: Primary Administrator is prof_attr's uid=0;gid=0 entry, so this is real
  # root-equivalence rather than a group that merely looks privileged.
  printf '%s::::type=normal;profiles=Primary Administrator\n' "$_au" \
    >> "$ALTROOT/etc/user_attr"
  # sudo's wheel only if the group exists (sudo is not in illumos-gate).
  if grep -q '^wheel:' "$ALTROOT/etc/group" 2>/dev/null; then
    awk -F: -v u="$_au" 'BEGIN{OFS=":"} $1=="wheel" {$4=($4==""?u:$4","u)} {print}' \
      "$ALTROOT/etc/group" > "$ALTROOT/etc/group.new" && mv "$ALTROOT/etc/group.new" "$ALTROOT/etc/group"
  fi
  # VERIFY, rather than trusting the tools. Each of these has silently no-opped in
  # this project's history, so the account is checked in the target files.
  grep -q "^$_au:" "$ALTROOT/etc/passwd" || die "user $_au missing from target /etc/passwd"
  grep -q "^$_au:" "$ALTROOT/etc/shadow" || die "user $_au missing from target /etc/shadow"
  grep -q "^$_au:" "$ALTROOT/etc/user_attr" || die "user $_au has no RBAC entry"
  [ -d "$ALTROOT${HOME_BASE}/$_au" ] || die "home ${HOME_BASE}/$_au was not created"
  if [ -n "$_hash" ]; then
    grep -q "^$_au:\$" "$ALTROOT/etc/shadow" || grep -q "^$_au:[^*!]" "$ALTROOT/etc/shadow" \
      || die "password hash for $_au did not land in target /etc/shadow"
  fi
  log "admin user OK: $_au (staff+sysadmin, Primary Administrator, home on $POOL$HOME_BASE)"
  echo "  Created $_au. Log in and use: pfexec <command>   (or su - root)"
  # Seed the admin user's SSH authorized_keys so key login works on first boot.
  # Config-declared users get keys via seed-authorized-keys (step 6c); this
  # runtime-created admin user does NOT, so without this it would have NO key and
  # (with PermitRootLogin no) the machine could be unreachable by key.
  # SOLNIX_ADMIN_SSHKEY may hold one or more keys (newline-separated).
  if [ -n "${SOLNIX_ADMIN_SSHKEY:-}" ]; then
    _assh="$ALTROOT${HOME_BASE}/$_au/.ssh"
    mkdir -p "$_assh" 2>/dev/null
    printf '%s\n' "$SOLNIX_ADMIN_SSHKEY" >> "$_assh/authorized_keys"
    chmod 700 "$_assh" 2>/dev/null; chmod 600 "$_assh/authorized_keys" 2>/dev/null
    _auid=$(awk -F: -v u="$_au" '$1==u{print $3}' "$ALTROOT/etc/passwd" 2>/dev/null)
    [ -n "$_auid" ] && chown -R "$_auid":10 "$_assh" 2>/dev/null || true
    grep -qF "$SOLNIX_ADMIN_SSHKEY" "$_assh/authorized_keys" 2>/dev/null \
      && log "seeded $_au authorized_keys (SSH key login enabled)" \
      || log "WARNING: $_au authorized_keys seed did not verify"
  fi
fi

log "finalizing (export pool)"
sync
zfs set canmount=noauto "$BEDS"
# Reset the home dataset mountpoint to its boot-time path ($HOME_BASE), undoing the
# temporary $ALTROOT$HOME_BASE mount used to land the admin home on the dataset.
# Without this it would try to mount at /a/home at boot and the home would be lost.
if [ "${_mkadmin:-0}" = 1 ] && [ -n "${_homeds:-}" ] && zfs list -H "$_homeds" >/dev/null 2>&1; then
  run_to 20 zfs unmount "$_homeds" 2>/dev/null || true
  zfs set mountpoint="$HOME_BASE" "$_homeds" 2>/dev/null || true
fi
run_to 30 umount "$ALTROOT/esp" 2>/dev/null || true
# unmount the pool's own mountpoint (/a/$POOL from the menu.lst step) + the BE.
run_to 30 zfs unmount "$POOL" 2>/dev/null || true
run_to 30 zfs unmount "$BEDS" 2>/dev/null || run_to 30 zfs unmount -f "$BEDS" 2>/dev/null || true
run_to 60 zpool export "$POOL" || run_to 60 zpool export -f "$POOL" || die "zpool export failed"
trap - EXIT INT TERM   # clean exit: pool exported, nothing to clean up

log "DONE: solnix installed on $TARGET (pool $POOL, BE $BEDS, generation 1 = $TOPLEVEL)"
echo "Detach $TARGET, snapshot it, register an AMI (boot-mode uefi, ena) and boot it,"
echo "or attach it as the root disk of a new instance. It should boot to"
echo "multi-user-server with /run-current-system -> $TOPLEVEL."

# ---------------------------------------------------------------------------
# 13. HOME-MANAGER (step 8). Runs LAST, deliberately: it needs the system's users
#     and datasets to exist, and a home-manager failure must not be able to leave
#     the SYSTEM install half-done.
#
# WARNING: THIS ACTIVATES AGAINST THE TARGET, NOT THE LIVE MEDIA, and that is the
# whole difficulty. home-manager's `switch` wants to write into the user's home and
# register a profile generation, which on a fresh install means writing under the
# target's dataset while the target is what we just exported. So the honest
# behaviour is: BUILD the activation package now (it is the part that needs the
# network and the flake, and the part that can fail for interesting reasons), copy
# its closure onto the target, and leave a first-boot note telling the operator the
# one command to run. Do NOT chroot and run the activation script -- it expects a
# live session bus, a real $HOME on a mounted dataset and a working `nix` profile,
# none of which are true in an exported-pool chroot.
#
# Building it here is still worth doing: it proves the attr resolves and that the
# closure is fetchable BEFORE the operator reboots into a machine where fixing it
# means having a working network on the new install.
if [ "$DO_HOME" = 1 ] && [ -n "$HOME_FLAKE" ]; then
  log "home-manager: $HOME_FLAKE"
  _hfl="${HOME_FLAKE%%#*}"; _hat="${HOME_FLAKE#*#}"
  if ! command -v nix >/dev/null 2>&1; then
    log "no nix on this media -- skipping home-manager (run it after first boot)"
  else
    # Prove the attr exists first, and list what DOES exist if it does not. Same
    # discipline as the system attr gate: a typo must not look like a build failure.
    if ! nix eval --store "$ALTROOT" --raw "${_hfl}#homeConfigurations.\"${_hat}\".activationPackage.drvPath" >/dev/null 2>&1; then
      echo "" >&2
      echo "No homeConfigurations.\"$_hat\" in $_hfl. Available:" >&2
      nix eval --store "$ALTROOT" --raw "${_hfl}#homeConfigurations" --apply \
        'x: builtins.concatStringsSep "\n" (builtins.attrNames x)' 2>/dev/null \
        | sed 's/^/    /' >&2 || echo "    (none)" >&2
      log "WARNING: home-manager attr not found -- the SYSTEM install is complete and unaffected"
    else
      _hmlink="/var/tmp/solnix-hm-$$"
      # log to a file + test nix build's own exit (not tail's) -- same pipe-hides-
      # exit fix as the system build above. This HM build is non-fatal, but a
      # masked failure would still mislead.
      _hmlog="$ALTROOT/var/tmp/solnix-hm-$$.log"
      # --store $ALTROOT (a CHROOT store, NOT --eval-store which nix treats as a
      # DIVERTED store that illumos single-user nix refuses to realise into) +
      # TMPDIR on the pool: the HM flake eval also copies ~100k input source files
      # into a store; --store $ALTROOT lands them on the pool, not the RAM ramdisk
      # /nix (same inode bug as the system build).
      if run_to "${SOLNIX_HM_BUILD_TIMEOUT:-7200}" env TMPDIR="$ALTROOT/var/tmp" nix build \
           --store "$ALTROOT" \
           "${_hfl}#homeConfigurations.\"${_hat}\".activationPackage" \
           --out-link "$_hmlink" > "$_hmlog" 2>&1; then
        tail -20 "$_hmlog"
        _hmout=$(_readlink "$_hmlink" 2>/dev/null || true)
      else
        tail -20 "$_hmlog"
      fi
      if [ -z "${_hmout:-}" ] || [ ! -d "$_hmout" ]; then
        log "WARNING: home-manager activation package FAILED TO BUILD -- system install is complete and unaffected"
        log "         re-run after first boot: home-manager switch --flake $HOME_FLAKE"
      else
        log "home-manager activation package built: $_hmout"
        # The pool is exported by now, so the closure cannot be copied in. Record
        # exactly what to run instead -- and record it where the operator will
        # actually see it rather than only in this scrollback.
        echo "$_hmout" > /var/tmp/solnix-hm-activation-path
        log "NOTE: the target pool is already exported, so the home-manager closure was"
        log "      NOT copied onto it. After first boot, on the installed system, run:"
        log "        home-manager switch --flake $HOME_FLAKE"
        log "      (its store paths will be fetched from the substituters then.)"
      fi
    fi
  fi
elif [ "$DO_HOME" = 1 ] && [ -n "$FLAKE_REF" ]; then
  # No explicit --home: look for a matching homeConfigurations attr in the same
  # flake, which is the maintainer's layout (.#dixi + .#gburd@dixi).
  if command -v nix >/dev/null 2>&1; then
    _fl="${FLAKE_REF%%#*}"; _at="${FLAKE_REF#*#}"
    _cands=$(nix eval --raw "${_fl}#homeConfigurations" --apply \
      'x: builtins.concatStringsSep "\n" (builtins.attrNames x)' 2>/dev/null | grep "@${_at}\$" || true)
    if [ -n "$_cands" ]; then
      echo ""
      echo "This flake also has home-manager configurations for $_at:"
      echo "$_cands" | sed 's/^/    /'
      echo "  After first boot: home-manager switch --flake ${_fl}#<one-of-those>"
    fi
  fi
fi

# ---------------------------------------------------------------------------
# 12. Offer to reboot or power off.
#
# The pool is already exported at this point, so both are safe: there is nothing
# left to flush and no dataset still mounted. Only offered on a tty -- an
# auto-install must never reboot a machine out from under whatever drove it, and
# an EC2/AMI build would lose its own session.
# ---------------------------------------------------------------------------
if [ -t 0 ] && [ -t 1 ]; then
  echo ""
  echo "=== Installation complete =================================================="
  echo "Remove the install media before booting from the new system."
  echo ""
  echo "  r) reboot now"
  echo "  h) halt / power off now"
  echo "  q) quit to the shell (do nothing)"
  printf 'Choice [r/h/q]: '
  read -r _fin || _fin=q
  case "$_fin" in
    r|R|reboot)
      echo "Rebooting -- REMOVE THE USB MEDIA NOW or it will boot the installer again."
      sync
      # reboot(1m) and poweroff(1m) are argv[0] links to halt (halt.c dispatches on
      # argv[0]); fall back through the family in case only one name is staged.
      for _c in /usr/sbin/reboot /sbin/reboot /usr/sbin/shutdown; do
        [ -x "$_c" ] || continue
        case "$_c" in *shutdown) exec "$_c" -y -i 6 -g 0 ;; *) exec "$_c" ;; esac
      done
      echo "no reboot command found -- use: halt, then power-cycle" >&2 ;;
    h|H|halt|poweroff)
      echo "Powering off."
      sync
      for _c in /usr/sbin/poweroff /sbin/poweroff /usr/sbin/halt /sbin/halt; do
        [ -x "$_c" ] && exec "$_c"
      done
      echo "no poweroff command found -- power-cycle the machine" >&2 ;;
    *)
      echo "Left running. Reboot with: reboot   (or power off with: poweroff)" ;;
  esac
fi
