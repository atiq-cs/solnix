@@ -725,6 +754,44 @@
 
 
 /*
+ * tzmon_report
+ * One console line per over-limit reading: the zone, the reading, the trip
+ * points and, on a ThinkPad, the EC's sensor temperatures (TMP0-7, C; 0 and
+ * +/-128 mean no sensor, as FreeBSD acpi_ibm.c reads them) and its per-level
+ * alarm bitmaps (TSL0-3), so the console names the sensor behind the alarm.
+ */
+static void
+tzmon_report(thermal_zone_t *tzp, int tmp)
+{
+	char tname[] = "TMP0";
+	static char *lname[] = { "TSL0", "TSL1", "TSL2", "TSL3" };
+	int t[8], l[4], i;
+	ACPI_HANDLE ec;
+
+	for (i = 0; i < 8; i++)
+		t[i] = -1;
+	for (i = 0; i < 4; i++)
+		l[i] = -1;
+	if (tzmon_hkey != NULL && AcpiGetParent(tzmon_hkey, &ec) == AE_OK) {
+		for (i = 0; i < 8; i++) {
+			tname[3] = '0' + i;
+			(void) acpica_eval_int(ec, tname, &t[i]);
+		}
+		for (i = 0; i < 4; i++)
+			(void) acpica_eval_int(ec, lname[i], &l[i]);
+	}
+	cmn_err(CE_WARN, "tzmon: Thermal zone (%s) reads %d C (_HOT %d, _CRT %d); "
+	    "over-limit reading %d of %d; EC TMP0-7: %d %d %d %d %d %d %d %d; "
+	    "TSL0-3: %x %x %x %x", (char *)tzp->zone_name, K_TO_C(tmp),
+	    tzp->hot > 0 ? K_TO_C(tzp->hot) : -1,
+	    tzp->crt > 0 ? K_TO_C(tzp->crt) : -1,
+	    tzp->validchecks, TZ_VALIDCHECKS,
+	    t[0], t[1], t[2], t[3], t[4], t[5], t[6], t[7],
+	    l[0], l[1], l[2], l[3]);
+}
