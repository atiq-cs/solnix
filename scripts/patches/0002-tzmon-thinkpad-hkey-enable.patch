+	/*
+	 * _HOT and _CRT. On ThinkPads _TMP returns _CRT (128 C) exactly when the
+	 * EC raises a critical-temperature level (TSL3, or TSL2 before
+	 * MHKC(1)); an unreadable sensor reads 48 C, not _CRT (the X1 Extreme /
+	 * P1 and X1 Carbon DSDTs). So _CRT is a real alarm and must be acted on.
+	 * Some ECs return a bogus high value for a single poll, so act only
+	 * after TZ_VALIDCHECKS consecutive over-limit polls, re-polling every
+	 * TZ_CONFIRM_PERIOD seconds meanwhile (FreeBSD acpi_thermal.c). Both
+	 * limits power the machine off through init, so filesystems sync and the
+	 * reason stays on the console; neither halts and waits for a key.
+	 */
+	if ((tzp->hot > 0 && tmp >= tzp->hot) ||
+	    (tzp->crt > 0 && tmp >= tzp->crt)) {
+		tzp->validchecks++;
+		tzmon_report(tzp, tmp);
+		if (tzp->validchecks >= TZ_VALIDCHECKS) {
+			cmn_err(CE_WARN, "tzmon: Thermal zone (%s) is %s (%d C) "
+			    "for %d consecutive readings; powering off",
+			    (char *)tzp->zone_name,
+			    (tzp->crt > 0 && tmp >= tzp->crt) ?
+			    "critically hot" : "too hot",
+			    K_TO_C(tmp), tzp->validchecks);
+			tzmon_do_shutdown();
+		}
+	} else {
+		if (tzp->validchecks > 0)
+			cmn_err(CE_NOTE, "tzmon: Thermal zone (%s) back to %d C "
+			    "after %d over-limit reading(s)",
+			    (char *)tzp->zone_name, K_TO_C(tmp),
+			    tzp->validchecks);
+		tzp->validchecks = 0;
 	}
 
