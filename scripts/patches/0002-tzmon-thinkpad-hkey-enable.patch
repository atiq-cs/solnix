+
+
+/*
+ * ThinkPad firmware turns an EC "sensor critically hot" level into the
+ * thermal zone's critical temperature, but only while no OS driver has
+ * enabled its hotkey/event interface. In the DSDTs of the X1 Extreme / P1
+ * and X1 Carbon lines, \_TZ.THM0._TMP returns _CRT (TCRT, 128 C) when the
+ * EC's TSL2 level is set and HKEY.DHKC is 0, so tzmon halts the machine at
+ * that level. HKEY.MHKC(1) sets DHKC, which the Linux thinkpad_acpi driver
+ * and Lenovo's Windows driver both do at load. The firmware then reports the
+ * TSL2 level as HKEY event 0x6022, and _TMP returns _CRT only for the EC's own
+ * shutdown level (TSL3), which still halts here. The HKEY notify handler logs
+ * the thermal alarm events, the same events Linux logs, so the warning stays
+ * visible.
+ */
+#define	TZ_HKEY_MAX_EVENTS	16
+
+/*ARGSUSED*/
+static ACPI_STATUS
+tzmon_hkey_cb(ACPI_HANDLE obj, UINT32 nest, void *ctx, void **rv)
+{
+	*(ACPI_HANDLE *)ctx = obj;
+	return (AE_CTRL_TERMINATE);
+}
+
+static ACPI_STATUS
+tzmon_hkey_mhkc(ACPI_HANDLE obj, int on)
+{
+	ACPI_OBJECT arg;
+	ACPI_OBJECT_LIST args;
+
+	arg.Type = ACPI_TYPE_INTEGER;
+	arg.Integer.Value = on;
+	args.Count = 1;
+	args.Pointer = &arg;
+	return (AcpiEvaluateObject(obj, "MHKC", &args, NULL));
+}
+
+/*
+ * Log a thermal alarm with the EC's per-level sensor bitmaps (TSL0..TSL3 in
+ * the EC device, HKEY's parent), so the log names which sensor tripped which
+ * level. An unreadable bitmap prints as ffffffff.
+ */
+static void
+tzmon_hkey_alarm(ACPI_HANDLE hkey, char *what)
+{
+	static char *names[] = { "TSL0", "TSL1", "TSL2", "TSL3" };
+	int lvl[4] = { -1, -1, -1, -1 };
+	ACPI_HANDLE ec;
+	int i;
+
+	if (AcpiGetParent(hkey, &ec) == AE_OK) {
+		for (i = 0; i < 4; i++)
+			(void) acpica_eval_int(ec, names[i], &lvl[i]);
+	}
+	cmn_err(CE_WARN, "tzmon: ThinkPad thermal alarm: %s "
+	    "(EC sensor levels TSL0-3: %x %x %x %x)", what,
+	    lvl[0], lvl[1], lvl[2], lvl[3]);
+}
+
+/*ARGSUSED*/
+static void
+tzmon_hkey_notify(ACPI_HANDLE obj, UINT32 val, void *ctx)
+{
+	int i, ev;
+
+	if (val != 0x80)
+		return;
+
+	/* MHKP returns the next queued event, 0 when the queue is empty */
+	for (i = 0; i < TZ_HKEY_MAX_EVENTS; i++) {
+		if (acpica_eval_int(obj, "MHKP", &ev) != AE_OK || ev == 0)
+			break;
+		switch (ev) {
+		case 0x6011:
+			tzmon_hkey_alarm(obj, "battery is too hot");
+			break;
+		case 0x6012:
+			tzmon_hkey_alarm(obj, "battery is critically hot");
+			break;
+		case 0x6021:
+			tzmon_hkey_alarm(obj, "a sensor is too hot");
+			break;
+		case 0x6022:
+			tzmon_hkey_alarm(obj, "a sensor is critically hot");
+			break;
+		default:
+			DTRACE_PROBE1(hkey__event, int, ev);
+			break;
+		}
+	}
+}
+
+static void
+tzmon_hkey_enable(void)
+{
+	static char *hids[] = { "LEN0268", "LEN0068", "IBM0068", NULL };
+	ACPI_HANDLE obj = NULL;
+	int i;
+
+	for (i = 0; hids[i] != NULL && obj == NULL; i++)
+		(void) AcpiGetDevices(hids[i], tzmon_hkey_cb, &obj, NULL);
+	if (obj == NULL)
+		return;
+
+	if (ACPI_FAILURE(AcpiInstallNotifyHandler(obj, ACPI_DEVICE_NOTIFY,
+	    tzmon_hkey_notify, NULL)))
+		return;
+	if (ACPI_FAILURE(tzmon_hkey_mhkc(obj, 1))) {
+		(void) AcpiRemoveNotifyHandler(obj, ACPI_DEVICE_NOTIFY,
+		    tzmon_hkey_notify);
+		return;
+	}
+	tzmon_hkey = obj;
+	cmn_err(CE_NOTE, "!tzmon: ThinkPad HKEY event interface enabled");
+}
+
+static void
+tzmon_hkey_disable(void)
+{
+	if (tzmon_hkey == NULL)
+		return;
+	(void) tzmon_hkey_mhkc(tzmon_hkey, 0);
+	(void) AcpiRemoveNotifyHandler(tzmon_hkey, ACPI_DEVICE_NOTIFY,
+	    tzmon_hkey_notify);
+	tzmon_hkey = NULL;
+}
