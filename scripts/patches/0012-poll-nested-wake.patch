 /*
+ * Wake every thread sleeping on pcp->pc_cv and record the wakeup in
+ * pc_wakepend, both under pc_wake_lock.
+ *
+ * poll(2) and ksocket sleep on pc_cv with pc_lock as the interlock, and their
+ * wakers hold pc_lock, so pc_wake_lock adds nothing for them. DP_POLL sleeps
+ * with pc_wake_lock as the interlock instead, because a recursive (epoll in
+ * epoll) wakeup comes from pcache_wake_parents(), which holds the CHILD's
+ * pc_lock and cannot take the parent's: the parent holds its own pc_lock
+ * while it locks the child in dppoll(), so the reverse order deadlocks. Before
+ * this, that wakeup was a bare cv_broadcast() with no lock and no flag the
+ * parent could test, so an event that reached the child after the parent had
+ * scanned it, but before the parent slept, was lost and the parent slept
+ * until its timeout (forever for epoll_wait(-1)).
+ */
+void
+pcache_wake(pollcache_t *pcp)
+{
+	mutex_enter(&pcp->pc_wake_lock);
+	pcp->pc_wakepend = 1;
+	cv_broadcast(&pcp->pc_cv);
+	mutex_exit(&pcp->pc_wake_lock);
+}
+
