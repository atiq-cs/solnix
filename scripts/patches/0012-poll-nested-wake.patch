+			 * parent takes it in pcachelink_purge_all() before
+			 * pcache_destroy(). Order: pcl_lock, then the parent's
+			 * pc_wake_lock (a leaf).
+			 */
+			pcache_wake(pl->pcl_parent_pc);
 		}
