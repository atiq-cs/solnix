+/*
+ * The EC's sensor temperatures TMP0-7 (C; 0 and +/-128 mean no sensor, as
+ * FreeBSD acpi_ibm.c reads them) and its per-level alarm bitmaps TSL0-3, from
+ * the EC device that is HKEY's parent. -1 where unreadable or not a ThinkPad.
+ * On the X1 Extreme Gen5 (BIOS N3JET48W) these are fields of the EC's
+ * operation region: TMP0 at 0x78, TSL0-3 at 0x88-0x8B (dsdt.dsl lines
+ * 27633-27656), and THM0._TMP reads TMP0, TSL2 and TSL3 (lines 67457-67490).
+ * That EC names only TMP0; bytes 0x79-0x7E are GPUT, TTS1-TTS4, so TMP1-7
+ * read -1 there and the kstat carries GPUT (the dGPU's temperature) itself.
+ */
+static void
+tzmon_ec_temps(int *t, int *l)
+{
+	char tname[] = "TMP0";
+	static char *lname[] = { "TSL0", "TSL1", "TSL2", "TSL3" };
+	ACPI_HANDLE ec;
+	int i;
+
+	for (i = 0; i < 8; i++)
+		t[i] = -1;
+	for (i = 0; i < 4; i++)
+		l[i] = -1;
+	if (tzmon_hkey == NULL || AcpiGetParent(tzmon_hkey, &ec) != AE_OK)
+		return;
+	for (i = 0; i < 8; i++) {
+		tname[3] = '0' + i;
+		(void) acpica_eval_int(ec, tname, &t[i]);
+	}
+	for (i = 0; i < 4; i++)
+		(void) acpica_eval_int(ec, lname[i], &l[i]);
+}
+
+
+/*
+ * kstat tzmon:<instance>:<zone>, <zone> being the zone's ACPI name (THM0),
+ * read by solnix-diag's temperature line: kstat -p tzmon:::temp_C. temp_C is the last poll (no ACPI work on
+ * read); the EC sensors are read on demand, so an unread kstat costs nothing.
+ */
+static char *tzmon_ks_ec[8] = { "ec_tmp0", "ec_tmp1", "ec_tmp2", "ec_tmp3",
+	"ec_tmp4", "ec_tmp5", "ec_tmp6", "ec_tmp7" };
+#define	TZ_KS_FIXED	5	/* temp_C, hot_C, crt_C, overlimit, ec_gput */
+
+static int
+tzmon_kstat_update(kstat_t *ksp, int rw)
+{
+	thermal_zone_t *tzp = ksp->ks_private;
+	kstat_named_t *kn = ksp->ks_data;
+	ACPI_HANDLE ec;
+	int t[8], l[4], i;
+
+	if (rw == KSTAT_WRITE)
+		return (EACCES);
+	/* ks_lock is tzp->lock, held by the framework here */
+	kn[0].value.i32 = tzp->last_tmp > 0 ? K_TO_C(tzp->last_tmp) : -1;
+	kn[1].value.i32 = tzp->hot > 0 ? K_TO_C(tzp->hot) : -1;
+	kn[2].value.i32 = tzp->crt > 0 ? K_TO_C(tzp->crt) : -1;
+	kn[3].value.i32 = tzp->validchecks;
+	kn[4].value.i32 = -1;
+	if (tzmon_hkey != NULL && AcpiGetParent(tzmon_hkey, &ec) == AE_OK)
+		(void) acpica_eval_int(ec, "GPUT", &kn[4].value.i32);
+	tzmon_ec_temps(t, l);
+	for (i = 0; i < 8; i++)
+		kn[TZ_KS_FIXED + i].value.i32 = t[i];
+	return (0);
+}
+
+static void
+tzmon_kstat_create(thermal_zone_t *tzp, int instance)
+{
+	char *zn = (char *)tzp->zone_name;
+	char name[KSTAT_STRLEN];
+	kstat_named_t *kn;
+	size_t len;
+	int i;
+
+	/* the last path segment: \_TZ_.THM0 -> THM0 */
+	len = (zn != NULL) ? strlen(zn) : 0;
+	(void) snprintf(name, sizeof (name), "%s",
+	    len >= 4 ? zn + len - 4 : "zone");
+	tzp->ksp = kstat_create("tzmon", instance, name, "misc",
+	    KSTAT_TYPE_NAMED, TZ_KS_FIXED + 8, 0);
+	if (tzp->ksp == NULL)
+		return;
+	kn = tzp->ksp->ks_data;
+	kstat_named_init(&kn[0], "temp_C", KSTAT_DATA_INT32);
+	kstat_named_init(&kn[1], "hot_C", KSTAT_DATA_INT32);
+	kstat_named_init(&kn[2], "crt_C", KSTAT_DATA_INT32);
+	kstat_named_init(&kn[3], "overlimit", KSTAT_DATA_INT32);
+	kstat_named_init(&kn[4], "ec_gput", KSTAT_DATA_INT32);
+	for (i = 0; i < 8; i++)
+		kstat_named_init(&kn[TZ_KS_FIXED + i], tzmon_ks_ec[i],
+		    KSTAT_DATA_INT32);
+	tzp->ksp->ks_update = tzmon_kstat_update;
+	tzp->ksp->ks_private = tzp;
+	tzp->ksp->ks_lock = &tzp->lock;
+	kstat_install(tzp->ksp);
+}
