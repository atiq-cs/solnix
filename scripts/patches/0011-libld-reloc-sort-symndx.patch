diff --git a/usr/src/test/elf-tests/tests/relocs/order/order.sh b/usr/src/test/elf-tests/tests/relocs/order/order.sh
new file mode 100644
index 0000000000..9ef75ae4eb
--- /dev/null
+++ b/usr/src/test/elf-tests/tests/relocs/order/order.sh
@@ -0,0 +1,108 @@
+#!/bin/ksh
+#
+# This file and its contents are supplied under the terms of the
+# Common Development and Distribution License ("CDDL"), version 1.0.
+# You may only use this file in accordance with the terms of version
+# 1.0 of the CDDL.
+#
+# A full copy of the text of the CDDL should have accompanied this
+# source.  A copy of the CDDL is also available via the Internet at
+# http://www.illumos.org/license/CDDL.
+#
+
+#
+# Copyright 2026 Greg Burd
+#
+
+#
+# The output relocations of a dynamic object must not depend on the order
+# in which ld(1) first meets each symbol.  undefs.s carries no content, only
+# references to the symbols refs1.s and refs2.s relocate against, so moving
+# it on the link line changes nothing but that order: both links must produce
+# the same bytes.  The relocations against each symbol must also stay grouped
+# together (one ld.so.1 lookup per symbol), each group in offset order.
+#
+
+TESTDIR=$(dirname $0)
+
+tmpdir=/tmp/test.$$
+mkdir $tmpdir
+cd $tmpdir
+
+cleanup() {
+	cd /
+	rm -fr $tmpdir
+}
+
+trap 'cleanup' EXIT
+
+if [[ $PWD != $tmpdir ]]; then
+	print -u2 "Failed to create temporary directory: $tmpdir"
+	exit 1
+fi
+
+assemble() {
+	gcc -m64 -c -o $2 $1
+	if (( $? != 0 )); then
+		print -u2 "assembly of ${1} failed"
+		exit 1
+	fi
+}
+
+# We expect any alternate linker to be in LD_ALTEXEC for us already
+assemble ${TESTDIR}/refs1.s refs1.o
+assemble ${TESTDIR}/refs2.s refs2.o
+assemble ${TESTDIR}/undefs.s undefs.o
+
+# Same output name for both links: ld records it in a FILE symbol
+for order in "refs1.o refs2.o undefs.o" "undefs.o refs1.o refs2.o"; do
+	gcc -m64 -shared -o order.so $order
+	if (( $? != 0 )); then
+		print -u2 "link of $order failed"
+		exit 1
+	fi
+	mv order.so "order.${order%% *}.so"
+done
+
+if ! cmp -s order.refs1.o.so order.undefs.o.so; then
+	print -u2 "FAIL: output depends on the order ld first meets each symbol"
+	elfdump -r order.refs1.o.so >&2
+	elfdump -r order.undefs.o.so >&2
+	exit 1
+fi
+
+#
+# Each symbol's relocations form one contiguous run, in increasing offset.
+#
+elfdump -r order.refs1.o.so | awk '
+	function hex(s,   i, n) {
+		n = 0
+		for (i = 3; i <= length(s); i++)
+			n = n * 16 + index("0123456789abcdef", substr(s, i, 1)) - 1
+		return (n)
+	}
+	$1 ~ /^R_AMD64_64$|^R_386_32$/ {
+		n++
+		if ($NF != last) {
+			if ($NF in seen) {
+				printf("%s is not grouped\n", $NF); bad = 1
+			}
+			seen[$NF] = 1; last = $NF
+		} else if (hex($2) <= off) {
+			printf("%s is not in offset order\n", $NF); bad = 1
+		}
+		off = hex($2)
+	}
+	END {
+		if (n != 8) {
+			printf("expected 8 relocations, found %d\n", n); bad = 1
+		}
+		exit bad
+	}' >&2
+if (( $? != 0 )); then
+	print -u2 "FAIL: relocations against one symbol are not grouped"
+	elfdump -r order.refs1.o.so >&2
+	exit 1
+fi
+
+exit 0
