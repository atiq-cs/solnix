#!/sbin/sh
# solnix-x1ewatch -- name whoever asks the kernel to power off, halt, suspend or
# reboot, on the console, before anything is torn down.
#
# Why: on the X1 Extreme Gen5 the machine stops at a bare "Press any key to
# reboot." a few minutes after boot, with no panic line. On x86 that bare prompt
# is mdboot -> halt(NULL) after an AD_POWEROFF / CPR (suspend) request whose
# firmware S5/S3 entry did not take (machdep.c, apic_common.c, cpr_mod.c). The
# requester printed nothing. dtrace probes fire in the requester's context:
#   syscall::uadmin:entry    userland callers (powerd, poweroff, sys-suspend...)
#   fbt::kadmin:entry        every admin request, kernel callers included
#   fbt::mdboot:entry        the last stop before power-off/halt/reboot
#   fbt::cpr:entry           the suspend (CPR) entry point
#
# kadmin(A_SHUTDOWN) calls killall() microseconds after entry, and killall
# SIGKILLs this dtrace before it copies anything out (measured under KVM: a
# watcher without the chill left only "syncing file systems... done"). So the
# killall probe chill()s the requester for 350 ms while the consumer, on another
# CPU, prints the uadmin + kadmin records; the consumer then dies, so mdboot
# prints only when a kernel caller reaches it without killall.
#
# libctf reads the kernel's compressed CTF through /usr/lib/64/libz.so.1, which
# this world lacks: without LIBCTF_DECOMPRESSOR every dtrace that names a kernel
# type fails ("Decompression package SUNWzlib not installed").
# Records also go to /var/tmp/x1ewatch.log (ramdisk; the screen is the record
# that survives). A_CONFIG and the other boot-time admin calls get one line.
PATH=/usr/sbin:/usr/bin:/sbin; export PATH
LIBCTF_DECOMPRESSOR=/run/current-system/world/lib-64/libz.so.1; export LIBCTF_DECOMPRESSOR
exec >/dev/console 2>&1
D=/var/tmp/x1ewatch.d
cat > $D <<'DSCRIPT'
syscall::uadmin:entry
/arg0 == 1 || arg0 == 2 || arg0 == 3 || arg0 == 5/
{
	printf("\n######## X1E WATCH: uadmin(cmd=%d fcn=%d) by %s pid=%d ppid=%d\n", arg0, arg1, execname, pid, ppid);
	printf("######## args: %s\n", curpsinfo->pr_psargs);
	printf("######## (cmd 1=REBOOT 2=SHUTDOWN 3=FREEZE 5=DUMP; fcn 6=POWEROFF 20=S3)\n");
}

syscall::uadmin:entry
/!(arg0 == 1 || arg0 == 2 || arg0 == 3 || arg0 == 5)/
{
	printf("X1E WATCH: uadmin(cmd=%d fcn=%d) by %s pid=%d\n", arg0, arg1, execname, pid);
}

fbt::kadmin:entry, fbt::mdboot:entry, fbt::cpr:entry
/probefunc != "kadmin" || arg0 == 1 || arg0 == 2 || arg0 == 3 || arg0 == 5/
{
	printf("######## X1E WATCH: %s(%d,%d) by %s pid=%d -- photograph this screen. kernel stack:", probefunc, arg0, arg1, execname, pid);
	stack(12);
	chill(100000000);
}

fbt::killall:entry, fbt::stop_other_cpus:entry
{
	chill(350000000);
}
DSCRIPT
# NOTE: the first start after boot was seen to die at once (svc log "all processes
# in service exited", then a restart that held); restart here and keep the error.
n=0
while [ $n -lt 30 ]; do
	dtrace -q -w -Z -x bufsize=1m -x switchrate=50hz -s $D 2>&1 | tee -a /var/tmp/x1ewatch.log
	n=$((n + 1))
	echo "X1E WATCH: dtrace exited; restart $n" | tee -a /var/tmp/x1ewatch.log
	sleep 1
done
