#!/sbin/sh
# solnix-templine -- one console line every SOLNIX_TEMP_PERIOD (30) seconds on the
# live media: the CPU (coretemp ksensors), each ACPI thermal zone (tzmon's kstat)
# and, on a ThinkPad, the EC's own readings (the dGPU among them). It reads only:
# one ioctl per CPU sensor and one kstat read per zone each period; idle cost is the
# sleep. A machine that powers off by itself then leaves its last readings on screen.
# Fields: cpu pkg / cores-max (C, "-" = no coretemp), then per zone
# <ZONE> <C> [hot/crt <C>] [over <n>], and ec tmp0/gpu (C, -1 = no such EC field).
PATH=/usr/bin:/usr/sbin:/sbin; export PATH
P=${SOLNIX_TEMP_PERIOD:-30}
CPUTEMP=@cputemp@
_line() {
  _cpu=$($CPUTEMP 2>/dev/null)
  # tzmon:<inst>:<zone>:<stat>\t<value>
  _tz=$(kstat -p tzmon 2>/dev/null | awk -F'\t' '
    { split($1, k, ":"); z = k[3]; s = k[4]; v[z, s] = $2; zs[z] = 1 }
    END {
      for (z in zs) {
        o = o sprintf(" %s %s", z, v[z, "temp_C"])
        if (v[z, "crt_C"] > 0) o = o sprintf(" crt %s", v[z, "crt_C"])
        if (v[z, "overlimit"] > 0) o = o sprintf(" OVER %s", v[z, "overlimit"])
        if (v[z, "ec_tmp0"] != "" && v[z, "ec_tmp0"] != -1) o = o sprintf(" ec tmp0 %s gpu %s", v[z, "ec_tmp0"], v[z, "ec_gput"])
      }
      print o
    }')
  echo "[temp] $(date +%H:%M:%S) cpu ${_cpu:-pkg - cores-max -} |${_tz:- no thermal zone}"
}
if [ "${1:-}" = once ]; then _line; exit 0; fi
while :; do
  _line > /dev/msglog 2>&1
  sleep "$P"
done
