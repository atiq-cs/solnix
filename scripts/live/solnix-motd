#!/sbin/sh
# solnix-motd -- the next-steps message shown on login on the installer media.
STATUS=/var/run/solnix-net-status
_net=$(cat "$STATUS" 2>/dev/null)
case "$_net" in
  up:*)   _netline="  network: ${_net#up: }" ;;
  down:*) _netline="  network: NOT up (${_net#down: })" ;;
  *)      _netline="  network: bringing up in the background... (run: solnix-net to retry)" ;;
esac
cat <<BANNER

  ############################################################
  #        The Solnix Operating System - Live Installer      #
  #                  (x86_64 / illumos)                      #
  ############################################################

  Root has an empty password on this media (as on NixOS's). Read /root/README
  for what Solnix is, the install steps, and the tools here (lsblk, lspci,
  nano, rsync ...):   less /root/README

$_netline

  ── STEPS ──────────────────────────────────────────────────────────────────

  1) Bring up networking (skip if the line above already says the network is up):
       solnix-install --net           # plumb the NIC + DHCP, then report
     No wired link? plug a USB-ethernet dongle (ASIX AX88772) and re-run it.
     To also pull the latest installer once online:
       solnix-install --self-update   # network up + re-fetch this installer
     To install REMOTELY (ssh in from another host):
       solnix-install --ssh           # network up + start sshd; prints a root
                                      # password to ssh with (or set SOLNIX_SSH_PUBKEY)

  2) Install to a disk (the target is AUTO-DETECTED; scratch is set up for you):
       solnix-install --flake 'github:USER/REPO#HOST'   # e.g. github:jdoe/myrepo#myhost
       solnix-install                                    # base system (no flake)
     No configuration yet? Generate one from this machine's hardware and edit it
     (nixos-generate-config's analog):
       solnix-generate-config --dir /var/tmp/cfg --host myhost
       nano /var/tmp/cfg/configuration.nix
       solnix-install --flake /var/tmp/cfg#myhost

  3) Reboot and remove the media:
       init 6

  ── IF A DISK WILL NOT INSTALL (leftover/faulted pool from a prior attempt) ──
       solnix-zap                     # export + clear the target disk (asks first)
       solnix-zap <disk>              # name it; solnix-zap --list shows disks+pools
     then go back to step 2. (If solnix-zap says to reboot, do so and retry.)

  Nothing is written until step 2; the installer never touches the media you
  booted from. Send a diagnostics bundle to the maintainer:
       solnix-diag                    # writes a bundle + prints how to upload it
       solnix-diag fetch <url>        # run a maintainer-authored fix script

BANNER
