 #include <cstring>
 #include <termios.h>
 
+#ifdef __sun
+#include <stropts.h>
+/* illumos libc lacks cfmakeraw(); provide the standard BSD/glibc body. */
+static void cfmakeraw(struct termios *t)
+{
+    t->c_iflag &= ~(IMAXBEL|IGNBRK|BRKINT|PARMRK|ISTRIP|INLCR|IGNCR|ICRNL|IXON);
+    t->c_oflag &= ~OPOST;
+    t->c_lflag &= ~(ECHO|ECHONL|ICANON|ISIG|IEXTEN);
+    t->c_cflag &= ~(CSIZE|PARENB);
+    t->c_cflag |= CS8;
+    t->c_cc[VMIN] = 1;
+    t->c_cc[VTIME] = 0;
+}
+#endif
