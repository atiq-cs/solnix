#!/usr/bin/env python3
# glslc-compatible wrapper over glslangValidator for GGML's vulkan-shaders-gen on illumos.
# GGML invokes: glslc -fshader-stage=compute --target-env=vulkan1.2 IN -o OUT [-O] [-MD -MF x.d] [-g] [-Dk=v ...]
# glslangValidator equivalents: -V --target-env vulkan1.2 / -S comp / -Os / --depfile x.d / -g / -Dk=v / -I<dir>
# GGML shaders use "#include" relying on glslc's implicit GL_GOOGLE_include_directive; glslangValidator
# requires the pragma in-source, so we inject it after the #version line into a temp copy.
import sys, subprocess, os, re, tempfile

GLSLANG = os.environ.get("GLSLANG_VALIDATOR", "glslangValidator")

def main(argv):
    out = None
    in_file = None
    stage = "comp"
    target_env = None
    defines = []
    depfile = None
    debug = False
    optimize = False
    incdirs = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("-fshader-stage="):
            s = a.split("=", 1)[1]
            stage = {"compute": "comp", "vertex": "vert", "fragment": "frag",
                     "geometry": "geom", "tesscontrol": "tesc", "tesseval": "tese"}.get(s, s)
        elif a.startswith("--target-env="):
            target_env = a.split("=", 1)[1]
        elif a == "-o":
            i += 1; out = argv[i]
        elif a == "-O":
            optimize = True
        elif a == "-MD":
            pass
        elif a == "-MF":
            i += 1; depfile = argv[i]
        elif a == "-g":
            debug = True
        elif a.startswith("-D"):
            defines.append(a)
        elif a.startswith("-I"):
            incdirs.append(a)
        elif a.startswith("-"):
            pass
        else:
            in_file = a
        i += 1

    if in_file is None or out is None:
        sys.stderr.write("glslc-wrap: need input and -o output\n")
        return 2

    srcdir = os.path.dirname(os.path.abspath(in_file)) or "."

    # inject include-directive extension into a temp copy so #include resolves under glslang
    src = open(in_file).read()
    if "GL_GOOGLE_include_directive" not in src:
        src = re.sub(r"(#version[^\n]*\n)",
                     r"\1#extension GL_GOOGLE_include_directive : require\n",
                     src, count=1)
    tf = tempfile.NamedTemporaryFile("w", suffix="." + stage, delete=False,
                                     dir=srcdir, prefix=".glslcwrap_")
    tf.write(src); tf.close()

    cmd = [GLSLANG, "-V"]
    if target_env:
        cmd += ["--target-env", target_env]
    cmd += ["-S", stage, "-I" + srcdir]
    cmd += incdirs
    if optimize:
        cmd.append("-Os")
    if debug:
        cmd.append("-g")
    if depfile:
        cmd += ["--depfile", depfile]
    cmd += defines
    cmd += [tf.name, "-o", out]
    try:
        rc = subprocess.call(cmd)
    finally:
        try:
            os.unlink(tf.name)
        except OSError:
            pass
    return rc

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
