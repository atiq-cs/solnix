 size_t Os::getPhysicalMemSize() {
+#ifdef __sun
+  /* illumos: glibc's struct sysinfo/sysinfo() collide with the unrelated
+     illumos <sys/sysinfo.h> struct; use the portable sysconf query (the same
+     substitution ROCr's os_linux.cpp uses). Returns the same physical fact. */
+  long pages = ::sysconf(_SC_PHYS_PAGES);
+  long psz = ::sysconf(_SC_PAGESIZE);
+  return (pages > 0 && psz > 0) ? (size_t)pages * (size_t)psz : 0;
+#else
   struct ::sysinfo si;
 
   if (::sysinfo(&si) != 0) {
@@ -697,12 +705,21 @@ size_t Os::getPhysicalMemSize() {
   }
 
   return (size_t)si.totalram * si.mem_unit;
+#endif
 }
 
 void Os::getAppPathAndFileName(std::string& appName, std::string& appPathAndName) {
   std::unique_ptr<char[]> buff(new char[FILE_PATH_MAX_LENGTH]());
 
+#ifdef __sun
+  /* illumos has no /proc/self/exe symlink; getexecname() returns the path
+     of the executable of the calling process. */
+  const char* xn = getexecname();
+  if (xn != nullptr) {
+    strncpy(buff.get(), xn, FILE_PATH_MAX_LENGTH - 1);
+#else
   if (readlink("/proc/self/exe", buff.get(), FILE_PATH_MAX_LENGTH) > 0) {
+#endif
     // Get filename without path and extension.
     appName = std::string(basename(buff.get()));
     appPathAndName = std::string(buff.get());
