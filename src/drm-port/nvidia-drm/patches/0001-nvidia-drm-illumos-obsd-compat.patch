+ * all copies or substantial portions of the Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL
+ * THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+ * DEALINGS IN THE SOFTWARE.
+ */
+
+/*
+ * nvidia-drm on illumos (solnix): quirks of the OpenBSD drm Linux-compat
+ * layer it is built against (OpenBSD sys/dev/pci/drm 37a498de plus
+ * src/drm-port/obsd-compat, the layer i915 runs on), in the role the NV_BSD
+ * block of nvidia-drm-conftest.h plays for FreeBSD's linuxkpi.
+ *
+ * In that layer a Linux "struct mutex" is OpenBSD's struct rwlock
+ * (linux/mutex.h) and a Linux spinlock_t is OpenBSD's struct mutex, which is
+ * an illumos kmutex_t (obsd_kern.h).  nvidia-drm's struct mutex members are
+ * declared struct rwlock under NV_SUNOS and initialised with rw_init().
+ */
+#ifndef __NVIDIA_DRM_SUNOS_H__
+#define __NVIDIA_DRM_SUNOS_H__
+
+#if !defined(NV_DRM_OBSD)
+#error "nvidia-drm on illumos is built with -DNV_DRM_OBSD (the common/inc arms)"
+#endif
+#if defined(NV_DRM_FBDEV_AVAILABLE)
+#error "nvidia-drm fbdev emulation is not ported to illumos"
+#endif
+
+#include <linux/iosys-map.h>
+
+/* Not in OpenBSD's linux/spinlock.h; the drm sources there call mtx_init. */
+#define spin_lock_init(lock)    mtx_init((lock), IPL_TTY)
+/* Asserts the caller holds the lock, as FreeBSD's mtx_owned does. */
+#define spin_is_locked(lock)    mtx_owned(lock)
+
+/* Linux struct mutex is struct rwlock in OpenBSD's linux/mutex.h. */
+#define NV_DRM_MUTEX struct rwlock
+#define nv_drm_mutex_init(m) rw_init((m), "nvidia-drm")
+
+/* OpenBSD's drm has no drm_atomic_state_free; drm_atomic_state_put frees. */
+#define drm_atomic_state_free drm_atomic_state_put
+
+/*
+ * Write-combined kernel mapping of a GPU aperture (the BAR1 address NVKMS
+ * mapMemory(NVKMS_KAPI_MAPPING_TYPE_KERNEL) returns), for dumb buffers.
+ * In the illumos module shell.
+ */
+void *nv_drm_sunos_ioremap_wc(uint64_t pa, size_t size);
+void nv_drm_sunos_iounmap(void *va);
+#define ioremap_wc(pa, size)    nv_drm_sunos_ioremap_wc((pa), (size))
+#define iounmap(va)             nv_drm_sunos_iounmap(va)
+
+struct drm_device;
+struct NvKmsKapiGpuInfo;
+struct drm_driver;
+
+/*
+ * OpenBSD's drm core makes a drm_device in drm_attach() (autoconf) and has no
+ * drm_dev_alloc() (it is "#ifdef notyet" in drm_drv.c).  The illumos module
+ * shell (nvidia-drm-illumos.c) creates it for an NVKMS GPU: the
+ * struct device, the PCI identity (pdev) of the GPU behind os_device_ptr
+ * (the nvidia dev_info_t) and the minors.  Returns NULL on failure.
+ */
+struct drm_device *nv_drm_sunos_dev_alloc(const struct drm_driver *driver,
+                                          const struct NvKmsKapiGpuInfo *gpu_info);
+
+#endif /* __NVIDIA_DRM_SUNOS_H__ */
diff -ruN a/kernel-open/nvidia-drm/nv-kthread-q.c b/kernel-open/nvidia-drm/nv-kthread-q.c
--- a/kernel-open/nvidia-drm/nv-kthread-q.c
+++ b/kernel-open/nvidia-drm/nv-kthread-q.c
@@ -23,6 +23,198 @@
 
 #include "nv-kthread-q.h"
 
+#if defined(NV_DRM_OBSD)
+/*
+ * illumos (solnix): the queue of kernel-illumos/nvidia-modeset/nvkms_q.c.
+ * Each queue is served by one long-running task on a single-threaded
+ * ddi_taskq, which gives it a dedicated kernel thread like the Linux kthread.
+ * nv_kthread_q_schedule_q_item() takes only an adaptive kmutex, so it may be
+ * called from timeout(9F) callbacks and low-level interrupt threads.
+ */
+#include <sys/types.h>
+#include <sys/systm.h>
+#include <sys/cmn_err.h>
+#include <sys/ksynch.h>
+#include <sys/list.h>
+#include <sys/sunddi.h>
+
+static void _main_loop(void *args)
+{
+    nv_kthread_q_t *q = args;
+    nv_kthread_q_item_t *q_item;
+
+    mutex_enter(&q->q_lock);
+
+    for (;;) {
+        while (list_is_empty(&q->q_list) && !q->main_loop_should_exit)
+            cv_wait(&q->q_cv, &q->q_lock);
+
+        q_item = list_remove_head(&q->q_list);
+        if (q_item == NULL)
+            break;
+
+        mutex_exit(&q->q_lock);
+
+        q_item->function_to_run(q_item->function_args);
+
+        mutex_enter(&q->q_lock);
+    }
+
+    mutex_exit(&q->q_lock);
+}
+
+int nv_kthread_q_init_on_node(nv_kthread_q_t *q, const char *q_name, int preferred_node)
+{
+    (void)preferred_node;
+
+    bzero(q, sizeof(*q));
+
+    mutex_init(&q->q_lock, NULL, MUTEX_DRIVER, NULL);
+    cv_init(&q->q_cv, NULL, CV_DRIVER, NULL);
+    list_create(&q->q_list, sizeof(nv_kthread_q_item_t),
+                offsetof(nv_kthread_q_item_t, q_list_node));
+
+    q->q_taskq = ddi_taskq_create(NULL, q_name, 1, TASKQ_DEFAULTPRI, 0);
+    if (q->q_taskq == NULL)
+        goto fail;
+
+    if (ddi_taskq_dispatch(q->q_taskq, _main_loop, q, DDI_SLEEP) != DDI_SUCCESS) {
+        ddi_taskq_destroy(q->q_taskq);
+        q->q_taskq = NULL;
+        goto fail;
+    }
+
+    return 0;
+
+fail:
+    list_destroy(&q->q_list);
+    cv_destroy(&q->q_cv);
+    mutex_destroy(&q->q_lock);
+    return -ENOMEM;
+}
+
+int nv_kthread_q_init(nv_kthread_q_t *q, const char *qname)
+{
+    return nv_kthread_q_init_on_node(q, qname, NV_KTHREAD_NO_NODE);
+}
+
+/* Returns non-zero if the item was queued, zero if it was already pending. */
+static int _raw_q_schedule(nv_kthread_q_t *q, nv_kthread_q_item_t *q_item)
+{
+    int ret = 1;
+
+    mutex_enter(&q->q_lock);
+
+    if (!list_link_active(&q_item->q_list_node)) {
+        list_insert_tail(&q->q_list, q_item);
+        cv_signal(&q->q_cv);
+    } else {
+        ret = 0;
+    }
+
+    mutex_exit(&q->q_lock);
+
+    return ret;
+}
+
+void nv_kthread_q_item_init(nv_kthread_q_item_t *q_item,
+                            nv_q_func_t function_to_run,
+                            void *function_args)
+{
+    list_link_init(&q_item->q_list_node);
+    q_item->function_to_run = function_to_run;
+    q_item->function_args = function_args;
+}
+
+int nv_kthread_q_schedule_q_item(nv_kthread_q_t *q,
+                                 nv_kthread_q_item_t *q_item)
+{
+    if (q->main_loop_should_exit) {
+        cmn_err(CE_WARN, "nvidia-drm: nv_kthread_q: item scheduled on a "
+                "stopped queue %p", (void *)q);
+        return 0;
+    }
+
+    return _raw_q_schedule(q, q_item);
+}
+
+typedef struct {
+    kmutex_t lock;
+    kcondvar_t cv;
+    int done;
+} nv_kthread_q_completion_t;
+
+static void _q_flush_function(void *args)
+{
+    nv_kthread_q_completion_t *c = args;
+
+    mutex_enter(&c->lock);
+    c->done = 1;
+    cv_broadcast(&c->cv);
+    mutex_exit(&c->lock);
+}
+
+static void _raw_q_flush(nv_kthread_q_t *q)
+{
+    nv_kthread_q_item_t q_item;
+    nv_kthread_q_completion_t c;
+
+    mutex_init(&c.lock, NULL, MUTEX_DRIVER, NULL);
+    cv_init(&c.cv, NULL, CV_DRIVER, NULL);
+    c.done = 0;
+
+    nv_kthread_q_item_init(&q_item, _q_flush_function, &c);
+    (void)_raw_q_schedule(q, &q_item);
+
+    /* Once the flush item has run, everything queued before it has run. */
+    mutex_enter(&c.lock);
+    while (!c.done)
+        cv_wait(&c.cv, &c.lock);
+    mutex_exit(&c.lock);
+
+    cv_destroy(&c.cv);
+    mutex_destroy(&c.lock);
+}
+
+void nv_kthread_q_flush(nv_kthread_q_t *q)
+{
+    if (q->main_loop_should_exit) {
+        cmn_err(CE_WARN, "nvidia-drm: nv_kthread_q: flush of a stopped "
+                "queue %p", (void *)q);
+        return;
+    }
+
+    /* Twice, to cover a q_item that reschedules itself. */
+    _raw_q_flush(q);
+    _raw_q_flush(q);
+}
+
+void nv_kthread_q_stop(nv_kthread_q_t *q)
+{
+    if (q->q_taskq == NULL)
+        return;
+
+    nv_kthread_q_flush(q);
+
+    mutex_enter(&q->q_lock);
+    if (!list_is_empty(&q->q_list))
+        cmn_err(CE_WARN, "nvidia-drm: nv_kthread_q: queue %p not empty "
+                "after flushing", (void *)q);
+    q->main_loop_should_exit = 1;
+    cv_broadcast(&q->q_cv);
+    mutex_exit(&q->q_lock);
+
+    /* Waits for the main loop, which drains anything still queued. */
+    ddi_taskq_destroy(q->q_taskq);
+    q->q_taskq = NULL;
+
+    list_destroy(&q->q_list);
+    cv_destroy(&q->q_cv);
+    mutex_destroy(&q->q_lock);
+}
+
+#else /* !NV_DRM_OBSD */
+
 #include <linux/kthread.h>
 #include <linux/interrupt.h>
 #include <linux/completion.h>
@@ -315,3 +507,5 @@
     _raw_q_flush(q);
     _raw_q_flush(q);
 }
+
+#endif /* NV_DRM_OBSD */
