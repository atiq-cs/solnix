diff -ruN a/kernel-open/nvidia-drm/nvidia-drm-sunos.h b/kernel-open/nvidia-drm/nvidia-drm-sunos.h
--- a/kernel-open/nvidia-drm/nvidia-drm-sunos.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-sunos.h
@@ -0,0 +1,83 @@
+/*
