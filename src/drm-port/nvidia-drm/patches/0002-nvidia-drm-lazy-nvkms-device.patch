+#if defined(NV_DRM_LAZY_NVKMS)
+static void nv_drm_nvkms_release(struct nv_drm_device *nv_dev);
+static void nv_drm_reprobe_connectors(struct nv_drm_device *nv_dev);
+
+/*
+ * Allocate the NVKMS device for the device's first user, or take another
+ * reference. 0 or a negative errno. The DRM objects (crtcs, planes,
+ * encoders, connectors) were made once at load, from a device that load
+ * released again; the NVKMS display handles they hold (hDisplay, dpy ids)
+ * name hardware, not the device instance.
+ */
+int nv_drm_nvkms_get(struct nv_drm_device *nv_dev)
+{
+    struct NvKmsKapiAllocateDeviceParams params;
+    struct NvKmsKapiDevice *pDevice;
+    int ret = 0;
+
+    /* without modeset upstream never has a device (nv_drm_dev_load) */
+    if (!drm_core_check_feature(nv_dev->dev, DRIVER_MODESET)) {
+        return 0;
+    }
+
+    mutex_lock(&nv_dev->nvkms_lock);
+    if (nv_dev->pDevice != NULL) {
+        atomic_inc(&nv_dev->nvkms_refs);
+        goto done;
+    }
+
+    memset(&params, 0, sizeof(params));
+    params.gpuId = nv_dev->gpu_info.gpu_id;
+    params.migDevice = nv_dev->gpu_mig_device;
+    params.privateData = nv_dev;
+    params.eventCallback = nv_drm_event_callback;
+
+    pDevice = nvKms->allocateDevice(&params);
+    if (pDevice == NULL) {
+        NV_DRM_DEV_LOG_ERR(nv_dev, "Failed to allocate NvKmsKapiDevice");
+        ret = -ENODEV;
+        goto done;
+    }
+    if (!nvKms->declareEventInterest(
+            pDevice,
+            ((1 << NVKMS_EVENT_TYPE_DPY_CHANGED) |
+             (1 << NVKMS_EVENT_TYPE_DYNAMIC_DPY_CONNECTED) |
+             (1 << NVKMS_EVENT_TYPE_DPY_CONTENT_PROTECTION_CHANGED) |
+             (1 << NVKMS_EVENT_TYPE_DPY_CP_TOPOLOGY_CHANGED) |
+             (1 << NVKMS_EVENT_TYPE_FLIP_OCCURRED)))) {
+        NV_DRM_DEV_LOG_ERR(nv_dev, "Failed to register event mask");
+    }
+
+    mutex_lock(&nv_dev->lock);
+    nv_dev->pDevice = pDevice;
+    atomic_set(&nv_dev->nvkms_refs, 1);
+    atomic_set(&nv_dev->enable_event_handling, true);
+    mutex_unlock(&nv_dev->lock);
+
+    /* connectors: what the hardware has now, read with this device
+     * (the hotplug event is sent 2 s later, as on resume) */
+    nv_drm_reprobe_connectors(nv_dev);
+    NV_DRM_DEV_LOG_INFO(nv_dev, "NVKMS device allocated (first user)");
+
+done:
+    mutex_unlock(&nv_dev->nvkms_lock);
+    return ret;
+}
+
+/*
+ * Drop a reference. The last one schedules the release: a DRM file's last
+ * reference goes from drmclose, under DRM locks the release must take too.
+ */
+void nv_drm_nvkms_hold(struct nv_drm_device *nv_dev)
+{
+    if (!drm_core_check_feature(nv_dev->dev, DRIVER_MODESET)) {
+        return;
+    }
+    WARN_ON(nv_dev->pDevice == NULL || atomic_read(&nv_dev->nvkms_refs) == 0);
+    atomic_inc(&nv_dev->nvkms_refs);
+}
+
+void nv_drm_nvkms_put(struct nv_drm_device *nv_dev)
+{
+    if (!drm_core_check_feature(nv_dev->dev, DRIVER_MODESET)) {
+        return;
+    }
+    if (atomic_dec_and_test(&nv_dev->nvkms_refs)) {
+        schedule_work(&nv_dev->nvkms_release_work);
+    }
+}
+
+static void nv_drm_nvkms_release_work(struct work_struct *work)
+{
+    struct nv_drm_device *nv_dev =
+        container_of(work, struct nv_drm_device, nvkms_release_work);
+
+    mutex_lock(&nv_dev->nvkms_lock);
+    /* a new user may have come and taken pDevice back up meanwhile */
+    if (atomic_read(&nv_dev->nvkms_refs) == 0 && nv_dev->pDevice != NULL) {
+        nv_drm_nvkms_release(nv_dev);
+    }
+    mutex_unlock(&nv_dev->nvkms_lock);
+}
+
+/*
+ * Free the NVKMS device; nvkms_lock held, no file or GEM object left. What
+ * still names NVKMS objects is DRM state: the atomic states (LUT surfaces,
+ * framebuffer surfaces through plane state), reset here as the suspend path
+ * resets them, and the LUT surface pool. After this the GPU has no NVKMS
+ * user and RM may power it down.
+ */
+static void nv_drm_nvkms_release(struct nv_drm_device *nv_dev)
+{
+    struct drm_device *dev = nv_dev->dev;
+    struct NvKmsKapiDevice *pDevice;
+
+    mutex_lock(&nv_dev->lock);
+    atomic_set(&nv_dev->enable_event_handling, false);
+    mutex_unlock(&nv_dev->lock);
+    cancel_delayed_work_sync(&nv_dev->hotplug_event_work);
+
+    drm_modeset_lock_all(dev);
+    {
+        /*
+         * drm_atomic_helper_plane_reset frees a plane state without the
+         * driver's atomic_destroy_state, which drops the plane's LUT surface
+         * references: destroy the plane states first.
+         */
+        struct drm_plane *plane;
+
+        nv_drm_for_each_plane(plane, dev) {
+            if (plane->state != NULL) {
+                plane->funcs->atomic_destroy_state(plane, plane->state);
+                plane->state = NULL;
+            }
+        }
+    }
+    drm_mode_config_reset(dev);
+    drm_modeset_unlock_all(dev);
+    nv_free_drm_lut_surface_pool(nv_dev);
+
+    if (!nvKms->declareEventInterest(nv_dev->pDevice, 0x0)) {
+        NV_DRM_DEV_LOG_ERR(nv_dev, "Failed to stop event listening");
+    }
+
+    mutex_lock(&nv_dev->lock);
+    pDevice = nv_dev->pDevice;
+    nv_dev->pDevice = NULL;
+    mutex_unlock(&nv_dev->lock);
+
+    nvKms->freeDevice(pDevice);
+    NV_DRM_DEV_LOG_INFO(nv_dev, "NVKMS device freed (no user)");
+}
+#endif /* NV_DRM_LAZY_NVKMS */
