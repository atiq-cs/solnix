@@ -113,6 +113,12 @@
                         uint32_t handle);
 #endif /* NV_DRM_DRIVER_HAS_DUMB_DESTROY */
 
+#if defined(NV_SUNOS)
+/* the illumos devmap path (D2.3): 0, or -EOPNOTSUPP/-ENOMEM/... */
+int nv_drm_sunos_gem_mmap_pa(struct nv_drm_gem_object *nv_gem,
+                             uint64_t *pa, uint64_t *size);
+#endif
+
 struct drm_gem_object *nv_drm_gem_nvkms_prime_import(
     struct drm_device *dev,
     struct drm_gem_object *gem);
