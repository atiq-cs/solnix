+/*
+ * solnix: KERNEL_LOCK is a no-op in the port and drm ioctls run in
+ * parallel, so this lock stands in for it here. It covers every SPLAY_*
+ * call on an idr or xarray tree (SPLAY_FIND rotates the tree: lookups
+ * write too) and idr_entry_cache. A leaf lock: nothing allocates, frees,
+ * sleeps or calls out while holding it.
+ */
+struct mutex obsd_idr_mtx = MUTEX_INITIALIZER(IPL_NONE);
+
+/* solnix: the entry with the least id >= key, or NULL; holds obsd_idr_mtx */
+static struct idr_entry *
+idr_lower_bound(struct idr *idr, unsigned long key)
+{
+	struct idr_entry find, *res;
+
+	if (SPLAY_EMPTY(&idr->tree))
+		return NULL;
+	find.id = key;
+	idr_tree_SPLAY(&idr->tree, &find);	/* root: key or a neighbour */
+	res = SPLAY_ROOT(&idr->tree);
+	if (res->id < key)
+		res = SPLAY_NEXT(idr_tree, &idr->tree, res);
+	return res;
+}
