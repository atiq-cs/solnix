 typedef atomic_t refcount_t;
 
+/*
+ * solnix: Linux refcount_t semantics (lib/refcount.c). An increment from 0
+ * or a decrement below 0 means someone dropped a reference they did not
+ * own: obsd_refcount_warn (obsd_kern.c) logs the caller's stack and
+ * saturates the count, so the object leaks instead of being released (and
+ * freed) a second time.
+ */
+static inline bool
+obsd_refcount_dec_and_test(volatile uint32_t *p)
+{
+	uint32_t o = atomic_dec_int_nv(p) + 1;
+
+	if (o == 1)
+		return true;
+	if (__predict_false(o == 0 || (int32_t)o < 0))
+		obsd_refcount_warn(p, "underflow; use-after-free");
+	return false;
+}
+
+/* atomic_add_unless(p, -1, 1), refusing to go below 0 */
+static inline bool
+obsd_refcount_dec_not_one(volatile uint32_t *p)
+{
+	uint32_t o;
+
+	do {
+		o = *p;
+		if (o == 1)
+			return false;
+		if (__predict_false(o == 0 || (int32_t)o < 0)) {
+			obsd_refcount_warn(p, "underflow; use-after-free");
+			return true;
+		}
+	} while (__sync_val_compare_and_swap(p, o, o - 1) != o);
+	return true;
+}
+
 static inline bool
 refcount_dec_and_test(uint32_t *p)
 {
-	return atomic_dec_and_test(p);
+	return obsd_refcount_dec_and_test(p);
 }
 
