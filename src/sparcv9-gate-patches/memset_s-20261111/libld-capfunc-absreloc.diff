diff --git a/usr/src/cmd/sgs/libld/common/relocate.c b/usr/src/cmd/sgs/libld/common/relocate.c
index d2aab26b42..e8c4ef6745 100644
--- a/usr/src/cmd/sgs/libld/common/relocate.c
