diff --git a/usr/src/lib/libc/port/mapfile-vers.gnu b/usr/src/lib/libc/port/mapfile-vers.gnu
index 70c81d3f..ff060e63 100644
--- a/usr/src/lib/libc/port/mapfile-vers.gnu
+++ b/usr/src/lib/libc/port/mapfile-vers.gnu
@@ -2522,6 +2522,13 @@ $mapfile_version 2
 	putw;
 	_putw;
 	qsort;
+# ILLUMOS_0.32-0.37 symbols (port/mapfile-vers) that this GNU list lacked: compiled into libc, declared in the headers, never exported.
+	__stack_chk_fail;
+	futimes;
+	getgrouplist;
+	lutimes;
+	qsort_r;
+	upanic;
