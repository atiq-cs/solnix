diff --git a/usr/src/lib/nsswitch/dns/Makefile.com b/usr/src/lib/nsswitch/dns/Makefile.com
index 73779135..f83b95a9 100644
--- a/usr/src/lib/nsswitch/dns/Makefile.com
+++ b/usr/src/lib/nsswitch/dns/Makefile.com
@@ -52,5 +52,7 @@ $(ROOT)/usr/lib/$(MACH64)/$(DYNLIB1):  \
 CPPFLAGS +=	-DNSS_DNS_LIBRESOLV=\"libresolv.so.2\"
 
 
-LDLIBS +=	-lnsl -lsocket
+# riscv64 gcc calls a #pragma weak undefined function through a GOT slot that ld.so.1 fills at load time (R_RISCV_64), before
+# _nss_dns_init dlopens libresolv, so every res_* call jumped to 0 (SIGSEGV in getent/login). Bind libresolv as a dependency.
+LDLIBS +=	-lnsl -lsocket -lresolv
 
diff --git a/usr/src/oss/openssh/Makefile b/usr/src/oss/openssh/Makefile
index 4adaafce..2cb3e6fc 100644
--- a/usr/src/oss/openssh/Makefile
+++ b/usr/src/oss/openssh/Makefile
@@ -35,6 +35,8 @@ SOURCE_DIR=$(SOURCE:%.tar.gz=%)
 
 CONFIG_ADDITIONAL_ARGS+= --sysconfdir=/etc/ssh --libexecdir=/usr/lib/ssh --sbindir=/usr/lib/ssh
 CONFIG_ADDITIONAL_ARGS+= --with-privsep-user=nobody --with-privsep-path=/var/empty
+# cross configure cannot run the select/RLIMIT_NOFILE probes and assumes yes, picking the rlimit sandbox; illumos poll() then fails EINVAL (poll.c nfds > p_fno_ctl). Use the privileges sandbox, as a native illumos configure does.
+CONFIG_ADDITIONAL_ARGS+= --with-solaris-privs --with-sandbox=solaris
 CONFIG_ADDITIONAL_CFLAGS= -std=gnu90
 INSTALL_TARGET= install-nosysconf
 #CONFIG_ENV = ac_cv_func_arc4random=no ac_cv_func_arc4random_buf=no ac_cv_func_arc4random_uniform=no
