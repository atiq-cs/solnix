diff -ruN a/emu/lib.js b/emu/lib.js
--- a/emu/lib.js
+++ b/emu/lib.js
@@ -0,0 +1,153 @@
+/*
+ * solnix WASM demo -- Emscripten JS library glue for TinyEMU (qemu-virt build).
+ *
+ * Bridges the emulated ns16550 UART to an xterm.js terminal and fetches the
+ * bios / split-disk blocks over HTTP.  Written for a modern emscripten
+ * (>= 3.x): UTF8ToString, getWasmTableEntry, no Pointer_stringify/Runtime.
+ *
+ * C entry points (see jsemu.c): vm_start(url, ram, cmdline, pwd, w, h, net)
+ * and console_queue_char(c).  The page defines a global `SolnixTerm` object
+ * with .write(str) and .getSize() -> [cols, rows].
+ */
+mergeInto(LibraryManager.library, {
+    /* guest UART TX -> xterm.js */
+    console_write: function(opaque, buf, len) {
+        var s = "";
+        for (var i = 0; i < len; i++)
+            s += String.fromCharCode(HEAPU8[buf + i]);
+        SolnixTerm.write(s);
+    },
+
+    /* terminal geometry for the (unused) resize event */
+    console_get_size: function(pw, ph) {
+        var r = SolnixTerm.getSize();
+        HEAPU32[pw >> 2] = r[0];
+        HEAPU32[ph >> 2] = r[1];
+    },
+
+    /* file-download hook (unused by this demo, kept for link compat) */
+    fs_export_file: function(filename, buf, buf_len) {},
+
+    /*
+     * HTTP fetch used by fs_wget (bios) and the split-disk block device.
+     * Signature matches TinyEMU's emscripten_async_wget3_data.
+     */
+    emscripten_async_wget3_data__deps: ['$getWasmTableEntry'],
+    emscripten_async_wget3_data: function(url, request, user, password,
+                                          post_data, post_data_len, arg,
+                                          free, onload, onerror, onprogress) {
+        var _url = UTF8ToString(url);
+        var _request = UTF8ToString(request);
+        var http = new XMLHttpRequest();
+        http.open(_request, _url, true);
+        http.responseType = "arraybuffer";
+        var handle = 1;
+        http.onload = function() {
+            /* status is 0 for non-http schemes (e.g. file:), 200 for http(s);
+             * a relative URL fetched over http still reports the real status,
+             * so a 404 must be treated as an error, not fed to the guest. */
+            if (http.status === 200 || http.status === 0) {
+                var bytes = new Uint8Array(http.response);
+                var buffer = _malloc(bytes.length);
+                HEAPU8.set(bytes, buffer);
+                if (onload)
+                    getWasmTableEntry(onload)(handle, arg, buffer, bytes.length);
+                if (free) _free(buffer);
+            } else if (onerror) {
+                getWasmTableEntry(onerror)(handle, arg, http.status, 0);
+            }
+        };
+        http.onerror = function() {
+            if (onerror) getWasmTableEntry(onerror)(handle, arg, http.status, 0);
+        };
+        http.onprogress = function(e) {
+            if (onprogress)
+                getWasmTableEntry(onprogress)(handle, arg, e.loaded,
+                    e.lengthComputable ? e.total : 0);
+        };
+        http.send(_request === "POST"
+            ? HEAPU8.subarray(post_data, post_data + post_data_len) : null);
+        return handle;
+    },
+
+    fs_wget_update_downloading: function(flag) {
+        if (typeof SolnixTerm.setDownloading === "function")
+            SolnixTerm.setDownloading(Boolean(flag));
+    },
+
+    /* framebuffer + network are unused in this console-only demo (extern-only) */
+    fb_refresh: function(opaque, data, x, y, w, h, stride) {},
+    net_recv_packet: function(bs, buf, buf_len) {},
+
+    /*
+     * file-buffer API used by the split-disk block device (block_net.c).
+     * A FileBuffer is two 32-bit words: {handle, allocated_size}.  The bytes
+     * live JS-side in a handle table (fbuf.h maps FileBuffer to a JS handle
+     * under EMSCRIPTEN).  Self-contained table (no dependency on Browser).
+     */
+    $SolnixFbuf: { table: {}, next: 1 },
+    file_buffer_get_new_handle__deps: ['$SolnixFbuf'],
+    file_buffer_get_new_handle: function() {
+        var h;
+        for (;;) {
+            h = SolnixFbuf.next++;
+            if (SolnixFbuf.next === 0x80000000) SolnixFbuf.next = 1;
+            if (typeof SolnixFbuf.table[h] === "undefined") return h;
+        }
+    },
+    file_buffer_init__deps: ['$SolnixFbuf'],
+    file_buffer_init: function(bs) {
+        HEAPU32[bs >> 2] = 0;
+        HEAPU32[(bs + 4) >> 2] = 0;
+    },
+    file_buffer_resize__deps: ['file_buffer_get_new_handle', '$SolnixFbuf'],
+    file_buffer_resize: function(bs, new_size) {
+        var h, size, new_data, i, data;
+        h = HEAPU32[bs >> 2];
+        size = HEAPU32[(bs + 4) >> 2];
+        if (new_size == 0) {
+            if (h != 0) { delete SolnixFbuf.table[h]; h = 0; }
+        } else if (size == 0) {
+            h = _file_buffer_get_new_handle();
+            SolnixFbuf.table[h] = new Uint8Array(new_size);
+        } else if (size != new_size) {
+            data = SolnixFbuf.table[h];
+            new_data = new Uint8Array(new_size);
+            if (new_size > size) new_data.set(data, 0);
+            else for (i = 0; i < new_size; i = (i + 1) | 0) new_data[i] = data[i];
+            SolnixFbuf.table[h] = new_data;
+        }
+        HEAPU32[bs >> 2] = h;
+        HEAPU32[(bs + 4) >> 2] = new_size;
+        return 0;
+    },
+    file_buffer_reset__deps: ['file_buffer_resize', 'file_buffer_init'],
+    file_buffer_reset: function(bs) {
+        _file_buffer_resize(bs, 0);
+        _file_buffer_init(bs);
+    },
+    file_buffer_write__deps: ['$SolnixFbuf'],
+    file_buffer_write: function(bs, offset, buf, size) {
+        var h = HEAPU32[bs >> 2], data, i;
+        if (h) {
+            data = SolnixFbuf.table[h];
+            for (i = 0; i < size; i = (i + 1) | 0) data[offset + i] = HEAPU8[buf + i];
+        }
+    },
+    file_buffer_read__deps: ['$SolnixFbuf'],
+    file_buffer_read: function(bs, offset, buf, size) {
+        var h = HEAPU32[bs >> 2], data, i;
+        if (h) {
+            data = SolnixFbuf.table[h];
+            for (i = 0; i < size; i = (i + 1) | 0) HEAPU8[buf + i] = data[offset + i];
+        }
+    },
+    file_buffer_set__deps: ['$SolnixFbuf'],
+    file_buffer_set: function(bs, offset, val, size) {
+        var h = HEAPU32[bs >> 2], data, i;
+        if (h) {
+            data = SolnixFbuf.table[h];
+            for (i = 0; i < size; i = (i + 1) | 0) data[offset + i] = val;
+        }
+    }
+});
