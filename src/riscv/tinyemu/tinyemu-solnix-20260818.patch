diff -ruN a/build-wasm.sh b/build-wasm.sh
--- a/build-wasm.sh
+++ b/build-wasm.sh
@@ -0,0 +1,55 @@
+#!/bin/sh
+# Build the solnix WASM emulator (TinyEMU, qemu-virt map) with Emscripten.
+#
+# RUN THIS ON A LINUX BOX WITH EMSCRIPTEN INSTALLED (emsdk).  The solnix build
+# node is illumos and cannot run emcc, so this step is done off-node; the
+# emulator sources here are already patched + native-validated (see
+# build-wasm-demo.sh / SITE-TEAM-WASM-DEMO.md).
+#
+#   1. git clone / unpack this tinyemu-solnix source tree
+#   2. . /path/to/emsdk/emsdk_env.sh      # puts emcc on PATH
+#   3. sh build-wasm.sh
+#   4. copy js/riscvemu64-wasm.js + js/riscvemu64-wasm.wasm into <bundle>/emu/
+#
+# Produces: js/riscvemu64-wasm.js and js/riscvemu64-wasm.wasm
+set -e
+
+EMCC=${EMCC:-emcc}
+command -v "$EMCC" >/dev/null 2>&1 || { echo "emcc not found; source emsdk_env.sh"; exit 1; }
+
+CFLAGS="-O2 -Wall -DEMSCRIPTEN -Wno-deprecated-pragma -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -fno-strict-aliasing -DCONFIG_FS_NET"
+
+# The emscripten JS entry point is jsemu.c (not temu.c).
+OBJS="jsemu softfp virtio fs simplefb pci json iomem cutils aes sha256 \
+      riscv_machine machine fs_net fs_wget fs_utils block_net"
+
+mkdir -p js
+for o in $OBJS; do
+    echo "  CC   $o.c"
+    "$EMCC" $CFLAGS -c -o "$o.js.o" "$o.c"
+done
+echo "  CC   riscv_cpu.c (MAX_XLEN=64)"
+"$EMCC" $CFLAGS -DMAX_XLEN=64 -DCONFIG_RISCV_MAX_XLEN=64 -c -o riscv_cpu64.js.o riscv_cpu.c
+
+OBJ_FILES="$(for o in $OBJS; do echo $o.js.o; done) riscv_cpu64.js.o"
+
+# Modern-emscripten link flags.  console_queue_char + vm_start are the JS entry
+# points; the demo page (index.html) calls them via cwrap.  emu/lib.js provides
+# console_write / console_get_size / the HTTP fetch used by fs_wget + block_net.
+LDFLAGS="-O3 \
+  -s WASM=1 \
+  -s ALLOW_MEMORY_GROWTH=1 \
+  -s INITIAL_MEMORY=134217728 \
+  -s EXPORTED_FUNCTIONS=['_vm_start','_console_queue_char','_malloc','_free'] \
+  -s EXPORTED_RUNTIME_METHODS=['ccall','cwrap'] \
+  -s ALLOW_TABLE_GROWTH=1 \
+  -s NO_EXIT_RUNTIME=1 \
+  -s MODULARIZE=0 \
+  --js-library emu/lib.js"
+
+echo "  LD   js/riscvemu64-wasm.js"
+"$EMCC" $LDFLAGS -o js/riscvemu64-wasm.js $OBJ_FILES
+
+echo
+echo "Done. Copy into the bundle:"
+echo "  cp js/riscvemu64-wasm.js js/riscvemu64-wasm.wasm <bundle>/emu/"
