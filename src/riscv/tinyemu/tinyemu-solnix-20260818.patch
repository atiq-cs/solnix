+/* ns16550 UART @ 0x10000000 (qemu-virt).  OpenSBI drives this as its console;
+   the guest reads input via SBI getchar, which reads the RBR below.  Polled I/O
+   only (no TX/RX interrupts needed for the SBI console). */
+#define UART_LSR_DR   0x01   /* receive data ready */
+#define UART_LSR_THRE 0x20   /* TX holding empty */
+#define UART_LSR_TEMT 0x40   /* TX shift empty */
+#define UART_LCR_DLAB 0x80
+
+static BOOL uart_rx_empty(RISCVMachine *s)
+{
+    return s->uart_rx_r == s->uart_rx_w;
+}
+
+/* push one host byte into the UART RX ring (called from the emulator poll) */
+static void uart_rx_put(RISCVMachine *s, uint8_t ch)
+{
+    unsigned int next = (s->uart_rx_w + 1) & 255;
+    if (next != s->uart_rx_r) {   /* drop on overflow */
+        s->uart_rx_buf[s->uart_rx_w] = ch;
+        s->uart_rx_w = next;
+    }
+}
+
+static uint32_t uart_read(void *opaque, uint32_t offset, int size_log2)
+{
+    RISCVMachine *s = opaque;
+    uint8_t v = 0;
+    switch(offset) {
+    case 0: /* RBR (or DLL when DLAB) */
+        if (s->uart_lcr & UART_LCR_DLAB) {
+            v = 1; /* DLL */
+        } else if (!uart_rx_empty(s)) {
+            v = s->uart_rx_buf[s->uart_rx_r];
+            s->uart_rx_r = (s->uart_rx_r + 1) & 255;
+        }
+        break;
+    case 1: /* IER (or DLM when DLAB) */
+        v = (s->uart_lcr & UART_LCR_DLAB) ? 0 : s->uart_ier;
+        break;
+    case 2: /* IIR: no interrupt pending */
+        v = 0x01;
+        break;
+    case 3: /* LCR */
+        v = s->uart_lcr;
+        break;
+    case 4: /* MCR */
+        v = s->uart_mcr;
+        break;
+    case 5: /* LSR: TX always ready; DR when a byte is buffered */
+        v = UART_LSR_THRE | UART_LSR_TEMT;
+        if (!uart_rx_empty(s))
+            v |= UART_LSR_DR;
+        break;
+    case 6: /* MSR */
+        v = 0xb0; /* DCD|DSR|CTS asserted */
+        break;
+    case 7: /* SCR */
+        v = s->uart_scr;
+        break;
+    default:
+        break;
+    }
+    return v;
+}
+
+static void uart_write(void *opaque, uint32_t offset, uint32_t val,
+                       int size_log2)
+{
+    RISCVMachine *s = opaque;
+    uint8_t ch;
+    switch(offset) {
+    case 0: /* THR (or DLL when DLAB) */
+        if (!(s->uart_lcr & UART_LCR_DLAB)) {
+            ch = val & 0xff;
+            if (s->common.console)
+                s->common.console->write_data(s->common.console->opaque, &ch, 1);
+        }
+        break;
+    case 1: s->uart_ier = val & 0xff; break; /* IER (or DLM) */
+    case 2: s->uart_fcr = val & 0xff; break; /* FCR */
+    case 3: s->uart_lcr = val & 0xff; break; /* LCR */
+    case 4: s->uart_mcr = val & 0xff; break; /* MCR */
+    case 7: s->uart_scr = val & 0xff; break; /* SCR */
+    default: break;
+    }
+}
+
+/* feed host console bytes into the UART RX ring (called from the run loop) */
+void riscv_machine_console_rx(VirtMachine *m1, const uint8_t *buf, int len)
+{
+    RISCVMachine *s = (RISCVMachine *)m1;
+    int i;
+    for(i = 0; i < len; i++)
+        uart_rx_put(s, buf[i]);
+}
