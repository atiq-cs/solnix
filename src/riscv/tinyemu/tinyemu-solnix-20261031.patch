@@ -349,16 +351,31 @@
     }
 }
 
+/* Deliver only sources the context enabled with priority > its threshold (as
+   qemu-virt does): a guest that polls a virtio queue and never enables its
+   source must not get an interrupt storm. */
+static uint32_t plic_ctx_mask(RISCVMachine *s, int ctx)
+{
+    uint32_t mask = s->plic_pending_irq & ~s->plic_served_irq & s->plic_enable[ctx];
+    uint32_t m = 0;
+    int i;
+    for (i = 0; i < 32; i++)
+        if ((mask >> i & 1) && s->plic_priority[i] > s->plic_threshold[ctx])
+            m |= 1u << i;
+    return m;
+}
+
 static void plic_update_mip(RISCVMachine *s)
 {
     RISCVCPUState *cpu = s->cpu_state;
-    uint32_t mask;
-    mask = s->plic_pending_irq & ~s->plic_served_irq;
-    if (mask) {
-        riscv_cpu_set_mip(cpu, MIP_MEIP | MIP_SEIP);
-    } else {
-        riscv_cpu_reset_mip(cpu, MIP_MEIP | MIP_SEIP);
-    }
+    if (plic_ctx_mask(s, 0))
+        riscv_cpu_set_mip(cpu, MIP_MEIP);
+    else
+        riscv_cpu_reset_mip(cpu, MIP_MEIP);
+    if (plic_ctx_mask(s, 1))
+        riscv_cpu_set_mip(cpu, MIP_SEIP);
+    else
+        riscv_cpu_reset_mip(cpu, MIP_SEIP);
 }
 
 #define PLIC_HART_BASE 0x200000
