         break;
     case PLIC_HART_BASE + 4:          /* hart0 M claim */
     case PLIC_HART_BASE + 0x1000 + 4: /* hart0 S claim */
-        mask = s->plic_pending_irq & ~s->plic_served_irq;
+        mask = plic_ctx_mask(s, (offset - PLIC_HART_BASE) / 0x1000);
         if (mask != 0) {
             i = ctz32(mask);
             s->plic_served_irq |= 1 << i;
@@ -400,7 +424,22 @@
     RISCVMachine *s = opaque;
     
     assert(size_log2 == 2);
+    if (offset >= 4 && offset < 4 * 33) {
+        s->plic_priority[offset / 4 - 1] = val & 7;
+        plic_update_mip(s);
+        return;
+    }
+    if (offset == 0x2000 || offset == 0x2080) {
+        s->plic_enable[(offset - 0x2000) / 0x80] = val >> 1;
+        plic_update_mip(s);
+        return;
+    }
     switch(offset) {
+    case PLIC_HART_BASE:              /* hart0 M threshold */
+    case PLIC_HART_BASE + 0x1000:     /* hart0 S threshold */
+        s->plic_threshold[(offset - PLIC_HART_BASE) / 0x1000] = val & 7;
