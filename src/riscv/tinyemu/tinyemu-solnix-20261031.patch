diff -ruN tinyemu-solnix/build-wasm.sh tinyemu-solnix/build-wasm.sh
--- tinyemu-solnix/build-wasm.sh
+++ tinyemu-solnix/build-wasm.sh
@@ -11,8 +11,10 @@
 #   3. sh build-wasm.sh
 #   4. copy js/riscvemu64-wasm.js + js/riscvemu64-wasm.wasm into <bundle>/emu/
 #
-# Produces: js/riscvemu64-wasm.js and js/riscvemu64-wasm.wasm
+# Produces: js/$OUT.js and js/$OUT.wasm (OUT defaults to riscvemu64-wasm; give each
+# published bundle a new OUT, because solnix.io caches /tryit/emu/ for a week)
 set -e
+OUT=${OUT:-riscvemu64-wasm}
 
 EMCC=${EMCC:-emcc}
 command -v "$EMCC" >/dev/null 2>&1 || { echo "emcc not found; source emsdk_env.sh"; exit 1; }
@@ -47,9 +49,9 @@
   -s MODULARIZE=0 \
   --js-library emu/lib.js"
 
-echo "  LD   js/riscvemu64-wasm.js"
-"$EMCC" $LDFLAGS -o js/riscvemu64-wasm.js $OBJ_FILES
+echo "  LD   js/$OUT.js"
+"$EMCC" $LDFLAGS -o js/$OUT.js $OBJ_FILES
 
 echo
 echo "Done. Copy into the bundle:"
-echo "  cp js/riscvemu64-wasm.js js/riscvemu64-wasm.wasm <bundle>/emu/"
+echo "  cp js/$OUT.js js/$OUT.wasm <bundle>/emu/"
