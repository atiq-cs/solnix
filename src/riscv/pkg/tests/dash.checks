# dash checks. % oracle: the HOST's dash (Bianbu, dash 0.5.12-x) running the same input.
dash-script|0|/bin/dash|dash|/etc/dash-test.sh
%dash-script|dash etc/dash-test.sh
dash-c-exit|7|/bin/dash|dash|-c|echo before; exit 7
@dash-c-exit|^before$
dash-exec-external|0|/bin/dash|dash|-c|/bin/sbase-box wc -l /etc/words; echo "rc=$?"
@dash-exec-external|^9 /etc/words$
@dash-exec-external|^rc=0$
dash-exec-notfound|127|/bin/dash|dash|-c|nosuchcmd
@dash-exec-notfound|nosuchcmd: not found
# reads its commands from the CONSOLE (STDIN_FILE line 1-3): the interactive path
dash-interactive|5|/bin/dash|dash|-i
@dash-interactive|interactive-2
# ed: commands from the console (STDIN_FILE), file + scratch file in the ramfs
ed-edit|0|/bin/sbase-box|ed|/etc/words
@ed-edit|^cherry$
@ed-edit|^bandana$
@ed-edit|^FIG$
ed-readback|0|/bin/sbase-box|cat|/tmp/ed.out
@ed-readback|^FIG$
@ed-readback|^apple$
!ed-readback|^fig$
# Pipes/redirection between BUILTINS (one process) work through the glue's fd table.
# (%7C is a literal '|': pkginit splits on '|'.)
dash-pipe-builtin|0|/bin/dash|dash|-c|echo piped %7C { read x; echo "got:$x"; }
@dash-pipe-builtin|^got:piped$
dash-pipe-3|0|/bin/dash|dash|-c|echo a b c %7C { read x y z; echo "$z$y$x"; } %7C { read w; echo "w=$w"; }
@dash-pipe-3|^w=cba$
dash-redirect-builtin|0|/bin/dash|dash|-c|echo redir-text > /tmp/r; /bin/sbase-box wc -c /tmp/r
@dash-redirect-builtin|^11 /tmp/r$
!dash-redirect-builtin|^redir-text$
dash-redirect-in-builtin|0|/bin/dash|dash|-c|read l < /etc/words; echo "first=$l"
@dash-redirect-in-builtin|^first=cherry$
# EXEC'D PROGRAMS SEE THE SHELL'S PIPES AND REDIRECTS. rvsh fixed kernel defects 1-3 and builds
# the packages with the glue -DSOLNIX_NO_VFD (build-sysroot.sh GLUE_DEFS): no userland fd table,
# the kernel's is the only one. On rvpkg's kernel + glue these were kernel-limit-* (console).
dash-exec-subst|0|/bin/dash|dash|-c|n=$(/bin/sbase-box echo inner); echo "n=[$n]"
@dash-exec-subst|^n=\[inner\]$
!dash-exec-subst|^inner$
dash-exec-stdin|0|/bin/dash|dash|-c|/bin/sbase-box head -n 1 < /etc/words
@dash-exec-stdin|^cherry$
!dash-exec-stdin|^FROM-CONSOLE$
dash-exec-pipe|0|/bin/dash|dash|-c|echo a %7C /bin/sbase-box tr a b
@dash-exec-pipe|^b$
dash-exec-pipe3|0|/bin/dash|dash|-c|/bin/sbase-box sort /etc/words %7C /bin/sbase-box uniq %7C /bin/sbase-box wc -l
@dash-exec-pipe3|^8$
dash-exec-redirect|0|/bin/dash|dash|-c|/bin/sbase-box grep an /etc/words > /tmp/g; /bin/sbase-box wc -l < /tmp/g
@dash-exec-redirect|^3$
!dash-exec-redirect|^banana$
