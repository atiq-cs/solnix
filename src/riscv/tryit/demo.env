# demo.env -- tryit1: the demo's text, sourced before mk-images.sh.
MOTD1="Solnix riscv64: the illumos RISC-V port's kernel, running in TinyEMU compiled to WebAssembly, in your browser."
MOTD2="Userland: dash, sbase, less. The root fs lives in RAM: no network, nothing is saved. Try: ls /bin, uname -a, cat /etc/release"
RELEASE="Solnix riscv64 browser demo (tryit): kernel uts/unix-demo; dash 0.5.12, sbase c546c3a, less 668, newlib 4.5.0"
