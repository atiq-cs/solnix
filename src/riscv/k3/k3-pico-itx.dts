			reset-names = "stmmaceth";
			interrupt-parent = <0x83>;
			interrupts = <0x83 0x04 0x114 0x04>;
			interrupt-names = "macirq", "eth_wake_irq";
			mac-address = [00 00 00 00 00 00];
			tx-fifo-depth = <0x2000>;
			rx-fifo-depth = <0x2000>;
			snps,tso;
			snps,force_sf_dma_mode;
