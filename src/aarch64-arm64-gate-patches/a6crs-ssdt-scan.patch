+/*
+ * synth_scan_crs -- find the PCIe host-bridge _CRS windows, wherever they live.
+ *
+ * The DSDT is reachable only via the FADT (it is not listed in the XSDT); SSDTs
+ * are listed in the XSDT and there may be several. Scan the DSDT first (that is
+ * where QEMU-EDK2 puts PCI0, and it preserves the previously-validated
+ * behaviour), then each SSDT in turn, stopping at the first table that yields
+ * windows.
+ *
+ * MEASURED ON REAL c6g.metal: the DSDT (23805 bytes) contains no PCI0 at all,
+ * while SSDT1 (1498 bytes) carries PCI0 and a _CRS whose windows match the
+ * hardware's MCFG/firmware tables exactly -- MEM32 0x80000000 size 0x20000000,
+ * MEM64 0x18000000000 size 0x2000000000, bus 0x00-0xff, and NO IO window. The
+ * old DSDT-only scan therefore always came back empty on metal and the caller
+ * silently substituted QEMU-virt constants (MEM32 0x10000000, MEM64
+ * 0x8000000000, IO 0x3eff0000), i.e. it mapped MMIO real Graviton does not
+ * decode. The descriptor parser itself was never wrong -- it decodes these very
+ * descriptors correctly; the table SELECTION was.
+ */
+static void
+synth_scan_crs(synth_crs_t *c)
+{
+	const ACPI_TABLE_FADT *fadt;
+	const ACPI_TABLE_HEADER *tab;
+	uint64_t dsdt_pa;
+	uint32_t dsdt32;
+	UINT32 n;
+
+	memset(c, 0, sizeof (*c));
+
+	/* 1. the DSDT, via the FADT. */
+	fadt = (const ACPI_TABLE_FADT *)synth_find_table(ACPI_SIG_FADT);
+	if (fadt != NULL) {
+		memcpy(&dsdt_pa, &fadt->XDsdt, sizeof (dsdt_pa));
+		if (dsdt_pa == 0) {
+			memcpy(&dsdt32, &fadt->Dsdt, sizeof (dsdt32));
+			dsdt_pa = dsdt32;
+		}
+		if (dsdt_pa != 0) {
+			tab = (const ACPI_TABLE_HEADER *)(uintptr_t)dsdt_pa;
+			if (strncmp(tab->Signature, ACPI_SIG_DSDT,
+			    strlen(ACPI_SIG_DSDT)) == 0) {
+				synth_scan_crs_table(c, tab);
+				if (c->nwin > 0) {
+					c->have = true;
+					return;
+				}
+			}
+		}
+	}
+
+	/*
+	 * 2. every SSDT. Bounded by SYNTH_MAX_SSDT rather than trusting the
+	 * table count, since this runs with the MMU off and a corrupt XSDT
+	 * length must not become an unbounded walk.
+	 */
+	for (n = 0; n < SYNTH_MAX_SSDT; n++) {
+		tab = synth_find_table_nth(ACPI_SIG_SSDT, n);
+		if (tab == NULL)
+			break;
+		synth_scan_crs_table(c, tab);
+		if (c->nwin > 0) {
+			c->have = true;
+			return;
+		}
+	}
+}
