+/*
+ * synth_find_table_nth -- the `n`th XSDT entry whose signature matches `sig`
+ * (n == 0 is the first), or NULL.
+ *
+ * WHY THIS EXISTS: synth_find_table() returns only the FIRST match, which is
+ * correct for singleton tables (FADT/MADT/MCFG/SPCR) but wrong for SSDTs -- a
+ * platform may publish several, and real c6g.metal publishes SSDT1 and SSDT2.
+ * PCI0 and its PCIe host-bridge _CRS live in SSDT1 on that hardware (measured:
+ * DSDT 23805 bytes with no PCI0; SSDT1 1498 bytes with PCI0 + the _CRS carrying
+ * MEM32 0x80000000/0x20000000 and MEM64 0x18000000000/0x2000000000, no IO
+ * window), so a scan that cannot enumerate past the first SSDT cannot find the
+ * PCIe windows at all -- and then silently substitutes QEMU-virt constants the
+ * hardware does not decode.
+ */
+static const ACPI_TABLE_HEADER *
+synth_find_table_nth(const char *sig, UINT32 n)
+{
+	const ACPI_TABLE_XSDT *xsdt;
+	const ACPI_TABLE_HEADER *tab;
+	const UINT64 *entries;
+	UINT64 entry;
+	UINT32 nentries, i, seen = 0;
+	size_t slen;
+
+	if ((xsdt = synth_get_xsdt()) == NULL)
+		return (NULL);
+
+	slen = strlen(sig);
+	nentries = (xsdt->Header.Length -
+	    sizeof (xsdt->Header)) / ACPI_XSDT_ENTRY_SIZE;
+	entries = &xsdt->TableOffsetEntry[0];
+
+	for (i = 0; i < nentries; ++i) {
+		/* Unaligned: the MMU is off, SCTLR.A is ignored. */
+		memcpy(&entry, &entries[i], sizeof (entry));
+		if (entry == 0)
+			continue;
+		tab = (const ACPI_TABLE_HEADER *)entry;
+		if (strncmp(tab->Signature, sig, slen) != 0)
+			continue;
+		if (seen++ == n)
+			return (tab);
+	}
+
+	return (NULL);
+}
