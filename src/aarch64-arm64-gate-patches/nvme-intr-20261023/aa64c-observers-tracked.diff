 	dev_err(dip, CE_CONT,
-	    "!GICv3 ITS: Devbits=%u IDbits=%u ITT_entry=%u HCC=%u "
+	    "?GICv3 ITS: Devbits=%u IDbits=%u ITT_entry=%u HCC=%u "
 	    "max_colls=%u PTA=%s doorbell PA 0x%" PRIx64 "\n",
