 	    sc->its_hcc, sc->its_max_colls,
 	    sc->its_pta ? "yes" : "no",
 	    sc->its_doorbell_pa);
 
+	{
+		/* NOTE: diagnostic.  Print the IORT that dboot copied. */
+		uchar_t *iort;
+		uint_t niort, o, i;
+		char line[3 * 32 + 1];
+
+		if (ddi_prop_lookup_byte_array(DDI_DEV_T_ANY, dip,
+		    DDI_PROP_DONTPASS, "solnix,acpi-iort", &iort, &niort) ==
+		    DDI_PROP_SUCCESS) {
+			for (o = 0; o < niort; o += 32) {
+				char *p = line;
+				line[0] = '\0';
+				for (i = o; i < niort && i < o + 32; i++) {
+					(void) snprintf(p, 4, " %02x", iort[i]);
+					p += 3;
+				}
+				cmn_err(CE_CONT, "?[IORT] %04x:%s\n", o, line);
+			}
+			ddi_prop_free(iort);
+		} else {
+			cmn_err(CE_CONT, "?[IORT] none\n");
+		}
+	}
 	ddi_report_dev(dip);
 	return (DDI_SUCCESS);
 
