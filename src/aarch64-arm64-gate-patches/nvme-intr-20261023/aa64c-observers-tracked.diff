 	 */
 	priv->ip_msi_addr = sc->its_doorbell_pa;
 	priv->ip_msi_data = eventid;
+	if (strcmp(ddi_driver_name(rdip), "pcieb") != 0)
+		dev_err(sc->its_dip, CE_CONT, "?MAPTI %s%d devid 0x%x "
+		    "event %u lpi %u cpu %d doorbell 0x%" PRIx64 "\n",
+		    ddi_driver_name(rdip), ddi_get_instance(rdip), devid,
