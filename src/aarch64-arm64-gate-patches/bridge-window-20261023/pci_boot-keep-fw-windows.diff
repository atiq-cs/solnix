+	 * 15:00.0 at 0x83e00000 behind root port 00:02.0), and disabling the
+	 * window cuts the kernel off from its own console.  Only a window that
+	 * firmware left unconfigured is disabled here, for fix_ppb_res().
+	 */
+	cmd_reg = pci_cfgacc_get16(rcdip, PCI_GETBDF(bus, dev, func),
