+++ b/usr/src/uts/armv8/dboot/dboot_conf_acpi.c
@@ -36,6 +36,7 @@
 
 extern void boot_smccc_init(struct xboot_info *);
 extern void boot_psci_init(struct xboot_info *);
+extern uint64_t dboot_synth_fdt(struct xboot_info *);
 
 static const ACPI_TABLE_XSDT *
 get_acpi_xsdt(void)
@@ -305,5 +306,16 @@ dboot_configure_acpi(void)
 	boot_smccc_init(bi);
 	boot_psci_init(bi);
 	dboot_count_pcierc(bi);
-	return (dboot_configure_acpi_cpuinfo(bi));
+	if (dboot_configure_acpi_cpuinfo(bi) != 0)
+		return (-1);
+
+	/*
+	 * Synthesise a minimal FDT from the static ACPI tables so that
+	 * the kernel's FDT-fed prom_emul and device enumeration work
+	 * unchanged. On failure bi_fdt stays 0 (no devicetree); the
+	 * kernel would then come up without enumerated devices.
+	 */
+	bi->bi_fdt = dboot_synth_fdt(bi);
+
+	return (0);
 }
