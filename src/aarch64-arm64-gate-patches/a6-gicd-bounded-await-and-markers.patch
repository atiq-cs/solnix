+/*
+ * Bound for the register-flag polls below.
+ *
+ * WHAT: an iteration cap on every "wait for this GIC status flag to clear"
+ * spin, plus a one-line report naming the site that gave up.
+ *
+ * WHY: these polls were unbounded (`while (ddi_get32(...) & mask);`).  On real
+ * AWS Graviton the PL011 was already observed not to drive its TX flags the
+ * way SBSA implies (see the bounded FR poll in armv8/boot/boot_uart.c), so a
+ * status flag that never clears is a demonstrated property of this hardware,
+ * not a theoretical one.  An unbounded spin turns that into a silent hang with
+ * no panic and no console output -- which is exactly the observed failure mode
+ * after `scsi_vhci0 is /scsi_vhci`.  Bounding it converts an undiagnosable
+ * hang into a named, printed symptom and lets the boot continue far enough to
+ * report it.
+ *
+ * The cap is deliberately generous: RWP/ChildrenAsleep settle in well under a
+ * microsecond on conforming hardware, so a healthy machine never approaches
+ * this and prints nothing.
+ */
+#define	GICV3_AWAIT_MAX	10000000u
+
+/*
+ * Cap on how many await-timeout reports we will print.
+ *
+ * WHY: the redistributor polls run once per CPU, so a flag that is stuck on
+ * every one of Graviton's 64 redistributors would otherwise emit 64 near
+ * identical lines.  The first few carry all the diagnostic value (which site,
+ * which register, which redistributor); the rest are noise on a slow console.
+ */
+#define	GICV3_AWAIT_REPORT_MAX	8
+
+static uint32_t gicv3_await_timeouts = 0;
+
+/*
+ * Poll until `mask` reads back clear in `reg`, giving up after
+ * GICV3_AWAIT_MAX iterations.
+ *
+ * On giving up, report the site and the last value read and return, letting
+ * the caller proceed.  Continuing is the point: a silent bound would only move
+ * the mystery, whereas a bound that announces itself tells us which flag the
+ * hardware never cleared.
+ */
