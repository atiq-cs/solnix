diff --git a/usr/src/uts/armv8/boot/boot_uart.c b/usr/src/uts/armv8/boot/boot_uart.c
index d1c77ebf09..b866e45343 100644
--- a/usr/src/uts/armv8/boot/boot_uart.c
+++ b/usr/src/uts/armv8/boot/boot_uart.c
@@ -92,18 +92,33 @@ boot_uart_getchar(void)
 void
 boot_uart_putchar(int c)
 {
+	/*
+	 * FR-poll handling for a misbehaving SBBR/PL011.  On AWS Graviton the
+	 * PL011 flag register (UARTFR) reads 0x00000000 forever: TXFF (bit 5)
+	 * never sets (so the pre-write FIFO-full guard is a no-op) and TXFE
+	 * (bit 7) never sets either -- so the old post-write "wait for TX
+	 * empty" spun to its cap on every character, making the console
+	 * unusably slow (and, unbounded, hung the boot outright).  A UART
+	 * whose FR is stuck at zero gives us no useful flow-control signal, so
+	 * bound the pre-write TXFF guard to a small cap (it still throttles a
+	 * *working* PL011 that briefly reports FIFO-full) and drop the
+	 * post-write TXFE wait entirely.  Blind UARTDR writes are proven to
+	 * reach the console on this part (the raw BOP/BCONS/FR-diag markers),
+	 * so no post-write handshake is required.
+	 */
+	uint32_t cap;
+
 	if (boot_uart_mmio_base == NULL)
 		return;
 
-	while (boot_uart_readreg32(SBSA_UARTFR) & SBSA_UARTFR_TXFF)
+	for (cap = 0; (boot_uart_readreg32(SBSA_UARTFR) & SBSA_UARTFR_TXFF) &&
+	    cap < 65536u; cap++)
 		boot_uart_yield();
 
 	if ((c & 0xff) == '\n')
 		boot_uart_putchar('\r');
 
 	boot_uart_writereg32(SBSA_UARTDR, c & 0xff);
-	while (!(boot_uart_readreg32(SBSA_UARTFR) & SBSA_UARTFR_TXFE))
-		boot_uart_yield();
 }
 
