;; solnix package metadata — Mentat/Datomic-style EDN datoms.
;;
;; One file per built package (docs/registry/edn/<pname>-<version>-<compiler>.edn),
;; emitted by the fleet-publish step. Shape is transaction-ready: when a writable
;; pg_mentat / Mentat endpoint for solnix exists, `(transact conn (read-edn f))`
;; loads it directly. Until then the EDN files ARE the index (grep/query locally).
;;
;; The pg_mentat MCP server currently exposed is the PostgreSQL research corpus
;; (read-only). These datoms target the solnix package Mentat store (to stand up).

;; ---- schema (transact once, before any package datoms) ----
[
 {:db/ident :pkg/name         :db/valueType :db.type/string   :db/cardinality :db.cardinality/one  :db/doc "pname"}
 {:db/ident :pkg/version      :db/valueType :db.type/string   :db/cardinality :db.cardinality/one}
 {:db/ident :pkg/store-path   :db/valueType :db.type/string   :db/cardinality :db.cardinality/one  :db/unique :db.unique/identity :db/doc "/nix/store/<hash>-<pname>-<version>"}
 {:db/ident :pkg/narinfo-hash :db/valueType :db.type/string   :db/cardinality :db.cardinality/one  :db/doc "store hash (the <hash> part)"}
 {:db/ident :pkg/system       :db/valueType :db.type/string   :db/cardinality :db.cardinality/one  :db/doc "x86_64-solaris | aarch64-solaris | sparcv9-solaris | ..."}
 {:db/ident :pkg/compiler     :db/valueType :db.type/string   :db/cardinality :db.cardinality/one  :db/doc "gcc | clang"}
 {:db/ident :pkg/compiler-ver :db/valueType :db.type/string   :db/cardinality :db.cardinality/one  :db/doc "e.g. 14.3.0 / 21.1.0"}
 {:db/ident :pkg/libc-store   :db/valueType :db.type/string   :db/cardinality :db.cardinality/one  :db/doc "libc slice store path used at build"}
 {:db/ident :pkg/libc-ver     :db/valueType :db.type/string   :db/cardinality :db.cardinality/one  :db/doc "illumos-gate rev the libc slice came from"}
 {:db/ident :pkg/debug-path   :db/valueType :db.type/string   :db/cardinality :db.cardinality/one  :db/doc "separate `debug` output store path (split DWARF), if any"}
 {:db/ident :pkg/dep          :db/valueType :db.type/string   :db/cardinality :db.cardinality/many :db/doc "store paths this pkg links/needs"}
 {:db/ident :pkg/cached-at    :db/valueType :db.type/string   :db/cardinality :db.cardinality/one  :db/doc "ISO8601 publish time to solnix.io"}
 {:db/ident :pkg/cache-sig    :db/valueType :db.type/string   :db/cardinality :db.cardinality/one  :db/doc "signing key id, e.g. cache.solnix.io-1"}
]
