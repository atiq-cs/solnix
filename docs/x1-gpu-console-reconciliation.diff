+	if (i915 == NULL)
+		return (ENXIO);
+	ri = &i915->ro;
+	if (ri->ri_bits == NULL)
+		return (ENXIO);
+	d->fb_bits = ri->ri_bits;
+	d->fb_paddr = 0;
+	d->fb_width = ri->ri_width;
+	d->fb_height = ri->ri_height;
+	d->fb_stride = ri->ri_stride;
+	d->fb_depth = ri->ri_depth;
+	d->fb_rnum = ri->ri_rnum;
+	d->fb_gnum = ri->ri_gnum;
+	d->fb_bnum = ri->ri_bnum;
+	d->fb_rpos = ri->ri_rpos;
+	d->fb_gpos = ri->ri_gpos;
+	d->fb_bpos = ri->ri_bpos;
