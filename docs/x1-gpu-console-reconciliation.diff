+/*
+ * The text-0 console. Before the first modeset the console is gfxp_fb (the
+ * firmware GOP framebuffer, exactly vgatext's console), so a boot that never
+ * modesets shows the boot image on gfxp. When the OpenBSD modeset finishes
+ * (i915_il_drm_attach, drm_i915_private->ro.ri_bits != NULL) the console is
+ * handed over to i915's own fbdev framebuffer with tem's own mechanism: the
+ * vis_devinit modechg_cb tem passed at VIS_DEVINIT is called with a new
+ * vis_devinit describing i915's buffer and polled-I/O routines, and tem
+ * re-reads the geometry and repaints onto the i915 plane
+ * (tems_modechange_callback). This is the illumos-native equivalent of
+ * OpenBSD's wsdisplay_cnattach: gfxp owns the GOP console, i915 owns the
+ * fbdev console, and modechg_cb moves tem from one to the other at modeset.
+ *
+ * ic_switched gates every per-op path: 0 => the GOP phase, forward VIS_* to
+ * gfxp_fb; 1 => the fbdev phase, serve VIS_* from i915's own routines against
+ * ic_fb. The polled-I/O routines (display/copy/cursor) must run from panic
+ * and kmdb context, so they take no locks and only touch ic_fb and the
+ * framebuffer bytes.
+ */
+struct i915_console {
+	kmutex_t		ic_lock;	/* ioctl path; polled path lock-free */
+	int			ic_switched;	/* 0 GOP (gfxp), 1 fbdev (i915) */
+	int			ic_mode;	/* KD_TEXT / KD_GRAPHICS */
+	/* tem's handover callback, captured from the vis_devinit it sent. */
+	vis_modechg_cb_t	ic_modechg_cb;
+	struct vis_modechg_arg	*ic_modechg_arg;
+	struct vis_polledio	ic_polledio;	/* handed to tem after switch */
+	struct i915_fb_desc	ic_fb;		/* the fbdev buffer + geometry */
+};
 
