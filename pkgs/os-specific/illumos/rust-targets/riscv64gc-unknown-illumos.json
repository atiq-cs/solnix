{
  "arch": "riscv64",
  "code-model": "medium",
  "cpu": "generic-rv64",
  "crt-objects-fallback": "false",
  "data-layout": "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128",
  "dynamic-linking": true,
  "eh-frame-header": false,
  "features": "+m,+a,+f,+d,+c,+zicsr,+zifencei",
  "frame-pointer": "always",
  "has-rpath": true,
  "has-thread-local": true,
  "is-like-solaris": true,
  "late-link-args": {
    "unix-cc": ["-lc", "-lssp"]
  },
  "limit-rdylib-exports": false,
  "linker": "riscv64-unknown-illumos-gcc",
  "linker-flavor": "unix-cc",
  "linker-is-gnu": false,
  "llvm-abiname": "lp64d",
  "llvm-target": "riscv64-unknown-solaris2.11",
  "max-atomic-width": 64,
  "metadata": {
    "description": "RISC-V 64 illumos",
    "host_tools": false,
    "std": true,
    "tier": 3
  },
  "os": "illumos",
  "position-independent-executables": true,
  "pre-link-args": {
    "unix-cc": ["-std=c99"]
  },
  "relro-level": "full",
  "target-family": ["unix"],
  "target-pointer-width": 64
}
