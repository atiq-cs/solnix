diff --git a/smallvil/src/handlers/mod.rs b/smallvil/src/handlers/mod.rs
index fafba61..ca3958b 100644
--- a/smallvil/src/handlers/mod.rs
+++ b/smallvil/src/handlers/mod.rs
@@ -87,4 +87,77 @@ impl WaylandDndGrabHandler for Smallvil {
 
 impl OutputHandler for Smallvil {}
 
+//
+// Session-shell protocols (for cosmic-panel): wlr-layer-shell, fractional-scale, security-context
+//
+
+use smithay::desktop::{LayerSurface as DesktopLayerSurface, layer_map_for_output};
+use smithay::wayland::fractional_scale::FractionalScaleHandler;
+use smithay::wayland::security_context::{
+    SecurityContext, SecurityContextHandler, SecurityContextListenerSource,
+};
+use smithay::wayland::shell::wlr_layer::{
+    Layer, LayerSurface as WlrLayerSurfaceHandle, WlrLayerShellHandler, WlrLayerShellState,
+};
+use smithay::reexports::wayland_server::protocol::wl_output::WlOutput;
+
+impl WlrLayerShellHandler for Smallvil {
+    fn shell_state(&mut self) -> &mut WlrLayerShellState {
+        &mut self.layer_shell_state
+    }
+
+    fn new_layer_surface(
+        &mut self,
+        surface: WlrLayerSurfaceHandle,
+        wl_output: Option<WlOutput>,
+        _layer: Layer,
+        namespace: String,
+    ) {
+        // Map the layer surface onto an output. smallvil maps a single "winit"
+        // output at (0,0); fall back to it when the client did not pin one.
+        let output = wl_output
+            .as_ref()
+            .and_then(smithay::output::Output::from_resource)
+            .or_else(|| self.space.outputs().next().cloned());
+        if let Some(output) = output {
+            let mut map = layer_map_for_output(&output);
+            let _ = map.map_layer(&DesktopLayerSurface::new(surface, namespace));
+        }
+    }
+
+    fn layer_destroyed(&mut self, surface: WlrLayerSurfaceHandle) {
+        if let Some((mut map, layer)) = self.space.outputs().find_map(|o| {
+            let map = layer_map_for_output(o);
+            let layer = map
+                .layers()
+                .find(|&l| l.layer_surface() == &surface)
+                .cloned();
+            layer.map(|layer| (map, layer))
+        }) {
+            map.unmap_layer(&layer);
+        }
+    }
+}
+
+impl FractionalScaleHandler for Smallvil {}
+
+impl SecurityContextHandler for Smallvil {
+    fn context_created(&mut self, source: SecurityContextListenerSource, _context: SecurityContext) {
+        // A privileged client (e.g. a cosmic-panel applet given
+        // X_PRIVILEGED_WAYLAND_SOCKET) connects on this listener. Insert the
+        // listener into the event loop and register each incoming stream as a
+        // client on the display; otherwise the socket is never accepted and the
+        // applet's registry roundtrip fails with ECONNREFUSED (which made
+        // cosmic-applet-time panic, so the panel never learned its thickness and
+        // stayed collapsed). smallvil applies no extra sandboxing here.
+        self.loop_handle
+            .insert_source(source, move |client_stream, _, state| {
+                let _ = state
+                    .display_handle
+                    .insert_client(client_stream, std::sync::Arc::new(crate::state::ClientState::default()));
+            })
+            .expect("Failed to insert security context listener source");
+    }
+}
+
 smithay::delegate_dispatch2!(Smallvil);
