WHAT: add a riscv64 arch module to the libc crate's solarish (illumos/Solaris) tree.

WHY: libc's `src/unix/solarish/mod.rs` selects an arch submodule with a cfg_if
that knows only `x86_64` and `x86`. On a riscv64 illumos target the whole
arch-specific surface is therefore ABSENT, and any crate that names it fails to
compile. Measured on a `riscv64gc-unknown-illumos` custom target with
-Zbuild-std=std,panic_abort: `std` itself builds fine (it does not reference
these), but a downstream probe naming them yields exactly five E0425s:

    cannot find type `ucontext_t`   in crate `libc`
    cannot find type `mcontext_t`   in crate `libc`
    cannot find type `fpregset_t`   in crate `libc`
    cannot find type `Elf64_Phdr`   in crate `libc`
    cannot find type `dl_phdr_info` in crate `libc`

(The same probe on `x86_64-unknown-illumos` compiles clean.) So this file is the
entire riscv64 gap in libc for illumos -- the machine-dependent
signal/ucontext/ELF-phdr surface, nothing else.

REGISTER MODEL: RV64 has 32 integer registers x0..x31 and 32 FP registers
f0..f31 (D extension, 64-bit each) plus fcsr. The gregset holds x1..x31 in
slots 0..30 with the PC in the LAST slot (31) and no slot for x0 (hardwired
zero on RISC-V). That ordering is not a guess: it is what the solnix riscv64
kernel's own trap frame uses (src/riscv/uts/regs.h `struct regs`: r_ra(x1)
through r_t6(x31), then r_sepc) and it agrees with the NetBSD riscv
`_NGREG`/`__gregset_t` layout cribbed into
src/riscv/bsd-ref/netbsd/nb_mcontext.h (_REG_X1==0 .. _REG_X31==30,
_REG_PC==31). NGREG==32, NFPREG==33 (f0..f31 + fcsr, NetBSD _NFREG).

This is the ONE thing in this patch a real illumos riscv64 <sys/regset.h>
could order differently; re-verify NGREG and the index order when the solnix
riscv64 <sys/regset.h> lands, and adjust here.

FP UNION SIZING: the union's flat-u32 view is [[u32; 33]; 2] == 264 bytes, the
same size as the fpchip_state view (32*u64 + fcsr + pad). It is deliberately
NOT the x86_64 module's [[u32; 13]; 10]: that is the 520-byte FXSAVE area, and
copying it here silently inflates mcontext_t from 520 to 1088 bytes -- an ABI
break against the kernel's ucontext. A libc-side ucontext_t larger than the
kernel's is how a signal handler smashes the stack, so this is load-bearing.

Elf64_* / dl_phdr_info are arch-independent for any LP64 ELF target and are
copied verbatim from solarish/x86_64.rs.

VERIFIED: applies to libc 0.2.189; with it applied the five-type probe compiles
for riscv64gc-unknown-illumos to EM_RISCV rlibs, and a 24-assertion
compile-time layout check passes (fpchip_state 264, fp_reg_set 264, fpregset_t
264, mcontext_t 520/align 8, Elf64_Phdr 56, greg_t 8, REG_X1 0, REG_X31 30,
REG_PC 31, NGREG 32, NFPREG 33, every index in range, psABI aliases, hwcap
bits). The layout assertions were negative-controlled: substituting the x86
FXSAVE union view makes them fail, so they are not vacuous.

Apply against libc 0.2.189 (also applies cleanly to 0.2.184-0.2.186; the
solarish tree has not changed shape in that range).

--- a/src/unix/solarish/mod.rs
+++ b/src/unix/solarish/mod.rs
@@ -3049,6 +3049,9 @@
         mod x86_common;
         pub use self::x86_64::*;
         pub use self::x86_common::*;
+    } else if #[cfg(target_arch = "riscv64")] {
+        mod riscv64;
+        pub use self::riscv64::*;
     } else if #[cfg(target_arch = "x86")] {
         mod x86;
         mod x86_common;
--- /dev/null
+++ b/src/unix/solarish/riscv64.rs
@@ -0,0 +1,221 @@
+//! riscv64 illumos/Solaris machine-dependent definitions.
+//!
+//! Mirrors solarish/x86_64.rs for RV64GC: 32 integer gregs + 33 D-extension
+//! fpregs (f0..f31 + fcsr). The Elf64_*/dl_phdr_info block is arch-independent
+//! LP64 ELF and is identical to the x86_64 module's.
+use crate::prelude::*;
+
+cfg_if! {
+    if #[cfg(target_os = "solaris")] {
+        use crate::unix::solarish::solaris;
+    }
+}
+
+pub type greg_t = c_long;
+
+pub type Elf64_Addr = c_ulong;
+pub type Elf64_Half = c_ushort;
+pub type Elf64_Off = c_ulong;
+pub type Elf64_Sword = c_int;
+pub type Elf64_Sxword = c_long;
+pub type Elf64_Word = c_uint;
+pub type Elf64_Xword = c_ulong;
+pub type Elf64_Lword = c_ulong;
+pub type Elf64_Phdr = __c_anonymous_Elf64_Phdr;
+
+s! {
+    pub struct __c_anonymous_Elf64_Phdr {
+        pub p_type: crate::Elf64_Word,
+        pub p_flags: crate::Elf64_Word,
+        pub p_offset: crate::Elf64_Off,
+        pub p_vaddr: crate::Elf64_Addr,
+        pub p_paddr: crate::Elf64_Addr,
+        pub p_filesz: crate::Elf64_Xword,
+        pub p_memsz: crate::Elf64_Xword,
+        pub p_align: crate::Elf64_Xword,
+    }
+
+    pub struct dl_phdr_info {
+        pub dlpi_addr: crate::Elf64_Addr,
+        pub dlpi_name: *const c_char,
+        pub dlpi_phdr: *const crate::Elf64_Phdr,
+        pub dlpi_phnum: crate::Elf64_Half,
+        pub dlpi_adds: c_ulonglong,
+        pub dlpi_subs: c_ulonglong,
+        pub dlpi_tls_modid: size_t,
+        pub dlpi_tls_data: *mut c_void,
+    }
+
+    // sys/regset.h -- RV64 D-extension FP state: f0..f31 (64-bit each) then
+    // fcsr, i.e. NFPREG == 33 slots. Matches the NetBSD riscv __fregset_t
+    // (_NFREG 33: "F0-31, FCSR") cribbed into
+    // src/riscv/bsd-ref/netbsd/nb_mcontext.h.
+    pub struct __c_anonymous_fpchip_state {
+        pub fpu_regs: [u64; 32],
+        pub fpu_fcsr: u32,
+        // Explicit tail pad: keeps the union's two views the same size and the
+        // struct 8-byte aligned, so ucontext_t's size does not depend on
+        // implicit trailing padding.
+        pub fpu_pad: u32,
+    }
+
+    pub struct fpregset_t {
+        pub fp_reg_set: __c_anonymous_fp_reg_set,
+    }
+
+    // NGREG for riscv64 == 32. Index order follows the solnix kernel's
+    // riscv64 trap frame (src/riscv/uts/regs.h `struct regs`: x1..x31 then
+    // sepc) and the NetBSD riscv gregset: slots 0..30 are x1..x31 and the
+    // LAST slot (31) is the PC. There is deliberately no slot for x0, which
+    // is hardwired zero on RISC-V.
+    //
+    // This is the ONE thing in this module a real illumos riscv64
+    // <sys/regset.h> could order differently; re-verify NGREG and the index
+    // order when that header lands.
+    pub struct mcontext_t {
+        pub gregs: [crate::greg_t; 32],
+        pub fpregs: fpregset_t,
+    }
+
+    pub struct ucontext_t {
+        pub uc_flags: c_ulong,
+        pub uc_link: *mut ucontext_t,
+        pub uc_sigmask: crate::sigset_t,
+        pub uc_stack: crate::stack_t,
+        pub uc_mcontext: mcontext_t,
+        #[cfg(target_os = "illumos")]
+        pub uc_brand_data: [*mut c_void; 3],
+        #[cfg(target_os = "illumos")]
+        pub uc_filler: [c_long; 2],
+        #[cfg(target_os = "solaris")]
+        pub uc_xrs: solaris::xrs_t,
+        #[cfg(target_os = "solaris")]
+        pub uc_lwpid: c_uint,
+        #[cfg(target_os = "solaris")]
+        pub uc_filler: [c_long; 2],
+    }
+}
+
+s_no_extra_traits! {
+    // The second view is the flat u32 array illumos exposes for the same
+    // bytes. 33 u64 slots == 66 u32, expressed as [[u32; 33]; 2] so both
+    // union members are exactly 264 bytes. (The x86_64 module's
+    // [[u32; 13]; 10] is the 520-byte FXSAVE view and does NOT carry over.)
+    pub union __c_anonymous_fp_reg_set {
+        pub fpchip_state: __c_anonymous_fpchip_state,
+        pub f_fpregs: [[u32; 33]; 2],
+    }
+}
+
+cfg_if! {
+    if #[cfg(feature = "extra_traits")] {
+        impl PartialEq for __c_anonymous_fp_reg_set {
+            fn eq(&self, other: &__c_anonymous_fp_reg_set) -> bool {
+                unsafe {
+                    self.fpchip_state == other.fpchip_state
+                        || self
+                            .f_fpregs
+                            .iter()
+                            .zip(other.f_fpregs.iter())
+                            .all(|(a, b)| a == b)
+                }
+            }
+        }
+        impl Eq for __c_anonymous_fp_reg_set {}
+        impl hash::Hash for __c_anonymous_fp_reg_set {
+            fn hash<H: hash::Hasher>(&self, state: &mut H) {
+                unsafe {
+                    self.f_fpregs.hash(state);
+                }
+            }
+        }
+    }
+}
+
