# config.site for solnix's store-only builds (mk-src-pkg nativeTools): the configure answers that depend on the HOST, not on the source,
# pinned so two hosts give one answer (NixOS gets this from its sandbox: one /build, a C-only locale set, one uid). Measured differences,
# chef (OpenIndiana) vs dixi (solnix): wave4 cfg/*.diff. Each line names what it pins and why.
# gnulib locale probes: chef has 23 en_* locales, dixi 229 (fr_FR, zh_CN, ...). With a French/Chinese locale gnulib runs the real mbrtowc
# tests and swaps in replacements; without one it "guesses". The NixOS sandbox has no such locales: pin "none".
gt_cv_locale_fr=none
gt_cv_locale_fr_utf8=none
gt_cv_locale_zh_CN=none
gt_cv_locale_ja=none
gt_cv_locale_tr_utf8=none
# iconv: chef has 1395 /usr/lib/iconv modules, dixi 201; the probe converts through modules the host may lack. The gate libc's iconv is the
# same on both; pin the answer chef (the served builds) gave.
am_cv_func_iconv_works=yes
# O_NOATIME: the probe opens a file in the build dir; the answer follows that file system's atime setting (chef /var/tmp atime=on: "bad",
# dixi off: "yes"). illumos has no O_NOATIME semantics either way; pin "yes" (dixi, the NixOS-like answer).
gl_cv_header_working_fcntl_h=yes
# (ustar uid/gid: automake asks `id -u`, no cache variable; it only picks the `make dist` tar format, never shipped: both hosts say yes.)
# Fixed host paths, read outside PATH (wave4 T2a cross-host diff, chef vs dixi, both as nixbld):
# lynx: "ipv6 stack type" tests for /usr/include/netinet/ip6.h on the HOST. The headers it compiles against are the gate proto's, which
# has ip6.h. A solnix host has no /usr/include, so it gave "unknown". Pin it to "solaris": what the proto's headers are, and what chef found.
cf_cv_ipv6type=solaris
# GNU tar: the remote-shell probe walks /usr/ucb/rsh, /usr/bin/rsh, ... (chef /usr/bin/rsh, dixi /usr/ucb/rsh) and bakes the path in for
# `tar -f host:file`. "no", as on NixOS (no rsh in the closure): remote archives then need --rsh-command.
tar_cv_path_RSH=no
# AC_C_BIGENDIAN (autoconf <= 2.59, and 2.69's sub-configures in gcc/binutils): the gate defines BYTE_ORDER only in <endian.h>, not
# <sys/param.h>, so the probe falls back to compiling or running a test program; where that fails (gcc >= 14: exit() without <stdlib.h>,
# a sub-configure that thinks it cross-compiles) it concludes "yes" on a little-endian host (served tcl 8.6.16 got WORDS_BIGENDIAN=1;
# chef W1g logs: 1 of gcc 15.3.0's 10 configures, 1 of binutils 2.47's 4). Every solnix target this file serves is little-endian
# (x86_64, aarch64). shortcut: one value for all arches, as config.site loads before configure knows $host; a big-endian target
# (sparcv9) needs its own config.site with ac_cv_c_bigendian=yes, passed by mk-src-pkg for that arch.
ac_cv_c_bigendian=no
# gnupg 2.4.8's GNUPG_CHECK_ENDIAN (its acinclude.m4; cache variable gnupg_cv_c_endian): its runtime probe fails to link under gcc >= 14, so it answers
# "big" on x86 ("checking endianness... big" in every wave6 build, 4 hosts) and defines BIG_ENDIAN_HOST: g10/rmd160.c then computes a
# wrong uid namehash (endian1, measured: rmd160 of a test string 2F8259F4.. = served gpg vs 3F943865.. correct). Little, as above.
gnupg_cv_c_endian=little
# (config-x86.site = config.site + this pin, for x86 store-only builds: the seed instance and aarch64 read config.site, and editing
# it moved 22 seed rows and 169 aarch64 drvs (wave7, measured). Fold back with the next aarch64 / bootstrap-tools wave.)
# X.Org XORG_MANPAGE_SECTIONS: tests the BUILD HOST for /usr/share/man/man7/attributes.7 (lixi has it via illumos-world-man, woof does not), so
# man sections followed the host (recipes4 R8: libX11/mkfontscale/bdftopcf differed woof vs lixi, man pages only). illumos uses traditional ones.
ac_cv_file__usr_share_man_man7_attributes_7=yes
# python3's AC_CACHE_CHECK([for broken nice()]): nice(1) then nice(2), "broken" when both return the same, which a build already at nice
# >= 18 always gets (both hit 19): pyconfig.h/_sysconfigdata then said HAVE_BROKEN_NICE 1 and the NarHash followed the builder's nice level
# (wave8-p1: nice 0/10/17 "ok", 18/19 "broken"; aarch64 a64rows2, main 871b296). illumos nice() returns the new priority: "no", as at nice 0
# and as the served python3 (axizzwb4: #undef HAVE_BROKEN_NICE).
ac_cv_broken_nice=no
