+//===----------------------------------------------------------------------===//
+
+#include "PlatformSolaris.h"
+
+#include "lldb/Core/PluginManager.h"
+#include "lldb/Host/HostInfo.h"
+#include "lldb/Utility/LLDBLog.h"
+#include "lldb/Utility/Log.h"
+
+// illumos <sys/mman.h> values, for a remote illumos target from any host.
+#define SOLARIS_MAP_PRIVATE 0x0002
+#define SOLARIS_MAP_ANON 0x0100
+
+using namespace lldb;
+using namespace lldb_private;
+using namespace lldb_private::platform_solaris;
+
+LLDB_PLUGIN_DEFINE(PlatformSolaris)
+
+static uint32_t g_initialize_count = 0;
+
+PlatformSP PlatformSolaris::CreateInstance(bool force, const ArchSpec *arch) {
+  bool create = force;
+  if (!create && arch && arch->IsValid()) {
+    const llvm::Triple &triple = arch->GetTriple();
+    create = triple.getOS() == llvm::Triple::Solaris;
+#if defined(__sun)
+    // An illumos core file has ELFOSABI_NONE and no OS note: take it here.
+    if (triple.getOS() == llvm::Triple::UnknownOS)
+      create = !arch->TripleOSWasSpecified();
+#endif
+  }
+  if (create)
+    return PlatformSP(new PlatformSolaris(false));
+  return PlatformSP();
+}
+
+void PlatformSolaris::Initialize() {
+  Platform::Initialize();
+  if (g_initialize_count++ == 0) {
+#if defined(__sun)
+    PlatformSP default_platform_sp(new PlatformSolaris(true));
+    default_platform_sp->SetSystemArchitecture(HostInfo::GetArchitecture());
+    Platform::SetHostPlatform(default_platform_sp);
+#endif
+    PluginManager::RegisterPlugin(
+        PlatformSolaris::GetPluginNameStatic(false),
+        PlatformSolaris::GetPluginDescriptionStatic(false),
+        PlatformSolaris::CreateInstance, nullptr);
+  }
+}
+
+void PlatformSolaris::Terminate() {
+  if (g_initialize_count > 0 && --g_initialize_count == 0)
+    PluginManager::UnregisterPlugin(PlatformSolaris::CreateInstance);
+  PlatformPOSIX::Terminate();
+}
+
+PlatformSolaris::PlatformSolaris(bool is_host) : PlatformPOSIX(is_host) {
+  if (is_host) {
+    m_supported_architectures.push_back(HostInfo::GetArchitecture());
+    ArchSpec arch32 = HostInfo::GetArchitecture(HostInfo::eArchKind32);
+    if (arch32.IsValid())
+      m_supported_architectures.push_back(arch32);
+  } else {
+    m_supported_architectures = CreateArchList(
+        {llvm::Triple::x86_64, llvm::Triple::x86, llvm::Triple::aarch64},
+        llvm::Triple::Solaris);
+  }
+}
+
+std::vector<ArchSpec>
+PlatformSolaris::GetSupportedArchitectures(const ArchSpec &process_host_arch) {
+  if (m_remote_platform_sp)
+    return m_remote_platform_sp->GetSupportedArchitectures(process_host_arch);
+  return m_supported_architectures;
+}
+
+void PlatformSolaris::CalculateTrapHandlerSymbolNames() {
+  // libc's signal path: the kernel enters sigacthandler, which calls the
+  // user handler through __sighndlr (both local symbols in libc.so.1).
+  m_trap_handlers.push_back(ConstString("sigacthandler"));
+  m_trap_handlers.push_back(ConstString("__sighndlr"));
+}
+
+MmapArgList PlatformSolaris::GetMmapArgumentList(const ArchSpec &arch,
+                                                 addr_t addr, addr_t length,
+                                                 unsigned prot, unsigned flags,
+                                                 addr_t fd, addr_t offset) {
+  uint64_t flags_platform = 0;
+  if (flags & eMmapFlagsPrivate)
+    flags_platform |= SOLARIS_MAP_PRIVATE;
+  if (flags & eMmapFlagsAnon)
+    flags_platform |= SOLARIS_MAP_ANON;
+  return MmapArgList({addr, length, prot, flags_platform, fd, offset});
+}
