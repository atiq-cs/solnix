+
+#include "lldb/Host/solaris/HostInfoSolaris.h"
+
+#include <climits>
+#include <unistd.h>
+
+using namespace lldb_private;
+
+// The running executable: /proc/self/path/a.out links to it (illumos procfs).
+FileSpec HostInfoSolaris::GetProgramFileSpec() {
+  static FileSpec g_program_filespec;
+  if (!g_program_filespec) {
+    char exe[PATH_MAX];
+    ssize_t n = ::readlink("/proc/self/path/a.out", exe, sizeof(exe) - 1);
+    if (n > 0) {
+      exe[n] = '\0';
+      g_program_filespec.SetFile(exe, FileSpec::Style::native);
+    }
+  }
+  return g_program_filespec;
+}
