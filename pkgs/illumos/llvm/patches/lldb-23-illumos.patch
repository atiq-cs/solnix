diff -ruN a/lldb/source/Host/solaris/Host.cpp b/lldb/source/Host/solaris/Host.cpp
--- a/lldb/source/Host/solaris/Host.cpp	1969-12-31 19:00:00.000000000 -0500
+++ b/lldb/source/Host/solaris/Host.cpp	2026-11-02 13:12:29.495120855 -0500
@@ -0,0 +1,99 @@
+//===-- source/Host/solaris/Host.cpp --------------------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+// illumos/Solaris host process queries over /proc/<pid>/{psinfo,path/a.out},
+// the same model as Host/aix/Host.cpp.
+
+#include "lldb/Host/Host.h"
+#include "lldb/Host/HostInfo.h"
+#include "lldb/Host/posix/Support.h"
+#include "lldb/Utility/ProcessInfo.h"
+#include "lldb/Utility/Status.h"
+#include "llvm/Support/MemoryBuffer.h"
+
+#include <dirent.h>
+#include <procfs.h>
+#include <unistd.h>
+
+#include <climits>
+#include <cstring>
+
+using namespace lldb;
+using namespace lldb_private;
+
+static bool GetProcessAndStatInfo(::pid_t pid, ProcessInstanceInfo &info,
+                                  bool &skip) {
+  info.Clear();
+  info.SetProcessID(pid);
+  skip = false;
+  auto buf = getProcFile(pid, "psinfo");
+  if (!buf || (*buf)->getBufferSize() < sizeof(psinfo_t))
+    return false;
+  psinfo_t ps;
+  std::memcpy(&ps, (*buf)->getBufferStart(), sizeof(ps));
+
+  // /proc/<pid>/path/a.out is a symlink to the executable (when it is known).
+  char exe[PATH_MAX];
+  std::string link = "/proc/" + std::to_string(pid) + "/path/a.out";
+  ssize_t n = ::readlink(link.c_str(), exe, sizeof(exe) - 1);
+  if (n > 0) {
+    exe[n] = '\0';
+    info.GetExecutableFile().SetFile(exe, FileSpec::Style::native);
+  } else {
+    info.GetExecutableFile().SetFile(
+        llvm::StringRef(ps.pr_fname, strnlen(ps.pr_fname, sizeof(ps.pr_fname))),
+        FileSpec::Style::native);
+  }
+  info.SetArchitecture(HostInfo::GetArchitecture(
+      ps.pr_dmodel == PR_MODEL_LP64 ? HostInfo::eArchKind64
+                                    : HostInfo::eArchKind32));
+  info.SetParentProcessID(ps.pr_ppid);
+  info.SetUserID(ps.pr_uid);
+  info.SetEffectiveUserID(ps.pr_euid);
+  info.SetGroupID(ps.pr_gid);
+  info.SetEffectiveGroupID(ps.pr_egid);
+  info.SetProcessGroupID(ps.pr_pgid);
+  info.SetProcessSessionID(ps.pr_sid);
+  info.SetIsZombie(ps.pr_nlwp == 0);
+  // pr_state 4 = SSTOP (<sys/proc.h>, not exported to user code)
+  skip = ps.pr_nlwp == 0 || ps.pr_lwp.pr_state == 4;
+  return true;
+}
+
+uint32_t Host::FindProcessesImpl(const ProcessInstanceInfoMatch &match_info,
+                                 ProcessInstanceInfoList &process_infos) {
+  DIR *d = opendir("/proc");
+  if (!d)
+    return 0;
+  const uid_t our_uid = getuid();
+  const lldb::pid_t our_pid = getpid();
+  while (struct dirent *e = readdir(d)) {
+    lldb::pid_t pid;
+    if (!llvm::to_integer(e->d_name, pid) || pid == our_pid)
+      continue;
+    ProcessInstanceInfo info;
+    bool skip;
+    if (!GetProcessAndStatInfo(pid, info, skip) || skip)
+      continue;
+    if (!match_info.GetMatchAllUsers() && our_uid != 0 &&
+        info.GetUserID() != our_uid)
+      continue;
+    if (match_info.Matches(info))
+      process_infos.push_back(info);
+  }
+  closedir(d);
+  return process_infos.size();
+}
+
+bool Host::GetProcessInfo(lldb::pid_t pid, ProcessInstanceInfo &process_info) {
+  bool skip;
+  return GetProcessAndStatInfo(pid, process_info, skip);
+}
+
+Status Host::ShellExpandArguments(ProcessLaunchInfo &launch_info) {
+  return Status::FromErrorString("unimplemented");
+}
