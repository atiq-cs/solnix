+/// illumos/Solaris (64-bit) core notes, named "CORE" (uts/common/exec/elf/
+/// elf_notes.c). Offsets are lwpstatus_t/psinfo_t from <sys/procfs.h> for an
+/// LP64 process, measured with offsetof() on illumos:
+///   lwpstatus_t: pr_lwpid@4, pr_cursig@12, pr_reg@544 (28 x u64 gregset_t),
+///                pr_fpreg@768 (fpregset_t, FXSAVE layout first 512 bytes)
+///   psinfo_t:    pr_pid@8, pr_fname@136 [16], pr_psargs@152 [80]
+llvm::Error ProcessElfCore::parseSolarisNotes(llvm::ArrayRef<CoreNote> notes) {
+  if (GetArchitecture().GetMachine() != llvm::Triple::x86_64)
+    return llvm::createStringError(
+        "illumos core files are supported for x86_64 only");
+  std::map<lldb::tid_t, std::string> lwp_names;
+  size_t nthreads = m_thread_data.size();
+  bool have_pstatus = false;
+  for (const auto &note : notes) {
+    if (note.info.n_name != "CORE")
+      continue;
+    const DataExtractor &d = note.data;
+    switch (note.info.n_type) {
+    case SOLARIS::NT_PSTATUS:
+      have_pstatus = true;
+      break;
+    case SOLARIS::NT_PSINFO: {
+      if (d.GetByteSize() < 232)
+        return llvm::createStringError("short illumos NT_PSINFO note");
+      lldb::offset_t o = 8;
+      SetID(d.GetU32(&o));
+      const char *fname = d.PeekCStr(136);
+      if (fname)
+        m_executable_name.assign(fname, strnlen(fname, 16));
+      const char *args = d.PeekCStr(152);
+      if (args) {
+        std::string a(args, strnlen(args, 80));
+        m_process_args = CoreArgs(a, /*might_be_truncated=*/a.size() == 79);
+      }
+      break;
+    }
+    case SOLARIS::NT_AUXV:
+      m_auxv = d;
+      break;
+    case SOLARIS::NT_LWPNAME: {
+      lldb::offset_t o = 0;
+      lldb::tid_t tid = d.GetU64(&o);
+      if (const char *n = d.PeekCStr(8))
+        lwp_names[tid] = std::string(n, strnlen(n, 32));
+      break;
+    }
+    case SOLARIS::NT_LWPSTATUS: {
+      if (d.GetByteSize() < 768 + 512)
+        return llvm::createStringError("short illumos NT_LWPSTATUS note");
+      ThreadData td;
+      lldb::offset_t o = 4;
+      td.tid = d.GetU32(&o);
+      o = 12;
+      td.prstatus_sig = d.GetU16(&o);
+      td.gpregset = DataExtractor(d, 544, 28 * 8);
+      CoreNote fp;
+      fp.info = note.info;
+      fp.info.n_type = SOLARIS::NT_PRFPREG;
+      fp.data = DataExtractor(d, 768, 512);
+      td.notes.push_back(fp);
+      m_thread_data.push_back(td);
+      break;
+    }
+    default:
+      break;
+    }
+  }
+  // The kernel writes each LWP's NT_LWPNAME after its NT_LWPSTATUS.
+  for (auto &td : m_thread_data) {
+    auto it = lwp_names.find(td.tid);
+    if (it != lwp_names.end())
+      td.name = it->second;
+  }
+  // A core can have two PT_NOTE segments (each is parsed on its own): the
+  // old-style one (NT_PRSTATUS, NT_PRPSINFO, ...) and the one with NT_PSTATUS
+  // and an NT_LWPSTATUS per LWP. Only the second must have threads.
+  if (have_pstatus && m_thread_data.size() == nthreads)
+    return llvm::createStringError(
+        "no NT_LWPSTATUS note in illumos core file");
+  return llvm::Error::success();
+}
