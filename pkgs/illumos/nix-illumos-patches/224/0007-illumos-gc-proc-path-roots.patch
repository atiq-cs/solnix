+                       /proc/<pid>/cwd and fd/N do not readlink to a path. The
+                       targets are under /proc/<pid>/path/: a.out, cwd, root,
+                       one entry per open fd and one per mapped object. */
+                    auto pathStr = fmt("/proc/%s/path", ent->d_name);
+                    auto pathDir = AutoCloseDir(opendir(pathStr.c_str()));
+                    if (!pathDir) {
