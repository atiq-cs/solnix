diff -ruN wa/wayland-1.23.1/src/wayland-os.c wb/wayland-1.23.1/src/wayland-os.c
--- a/src/wayland-os.c
+++ b/src/wayland-os.c
@@ -125,6 +125,24 @@
 	*pid = ucred.pid;
 	return 0;
 }
+#elif defined(__sun)
+/* illumos: no SO_PEERCRED/LOCAL_PEERCRED; getpeerucred(3C) gives the peer. */
+#include <ucred.h>
+int
+wl_os_socket_peercred(int sockfd, uid_t *uid, gid_t *gid, pid_t *pid)
+{
+	ucred_t *uc = NULL;
+
+	if (getpeerucred(sockfd, &uc) < 0)
+		return -1;
+	*uid = ucred_geteuid(uc);
+	*gid = ucred_getegid(uc);
+	*pid = ucred_getpid(uc);
+	ucred_free(uc);
+	if (*uid == (uid_t)-1 || *gid == (gid_t)-1)
+		return -1;
+	return 0;
+}
 #else
 #error "Don't know how to read ucred on this platform"
 #endif
