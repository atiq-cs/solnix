+#ifdef __sun
+/* solnix i915 minors (src/drm-port/i915/i915_drmioc.h): clone << 16 |
+ * instance << 8 | kind (0 card, 64 console text, 128 render). fstat of an
+ * open fd sees its clone minor; the /dev/dri nodes carry clone 0. Map to the
+ * Linux drm minor the /dev/dri names use (cardN, renderD128+N). */
+static unsigned int drm_minor(dev_t d)
+{
+    unsigned int m = minor(d), kind = m & 0xff, inst = (m >> 8) & 0xff;
+
+    if (kind == 0)
+        return inst;
+    return kind == 128 ? 128 + inst : 0xffff;
+}
+#else
+#define drm_minor(d) minor(d)
+#endif
