-// process.config is serialized config.gypi
+// process.config is serialized config.gypi. It is parsed on first access, not
+// here: config.gypi holds the install prefix, and an object made during
+// bootstrap is stored in the startup snapshot, under the snapshot's checksum.
 const binding = internalBinding('builtins');
 
-const processConfig = JSONParse(binding.config, (_key, value) => {
+let processConfig;
+function getProcessConfig() {
   // The `reviver` argument of the JSONParse method will visit all the values of
   // the parsed config, including the "root" object, so there is no need to
   // explicitly freeze the config outside of this method
-  return ObjectFreeze(value);
-});
+  processConfig ??= JSONParse(binding.config, (_key, value) => {
+    return ObjectFreeze(value);
+  });
+  return processConfig;
+}
 
+// Replaced by the same data property (read-only) on first access.
 ObjectDefineProperty(process, 'config', {
   __proto__: null,
   enumerable: true,
   configurable: true,
-  value: processConfig,
+  get() {
+    const value = getProcessConfig();
+    ObjectDefineProperty(process, 'config', {
+      __proto__: null,
+      enumerable: true,
+      configurable: true,
+      value,
+    });
+    return value;
+  },
 });
 
 require('internal/worker/js_transferable').setup();
