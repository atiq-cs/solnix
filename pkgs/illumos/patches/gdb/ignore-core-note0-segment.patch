Skip the legacy note0 segment of an illumos core (NT_PRPSINFO/NT_PRSTATUS/NT_FPREGSET). The core also carries the
current notes (NT_PSINFO/NT_PSTATUS/NT_LWPSTATUS) for the same LWP, so bfd made LWP 1 several times and gdb 18.1
aborted opening any core: regcache.c:432 get_thread_regcache: Assertion thread->state () != THREAD_EXITED
(measured on dixi, gdb1 2026-11-02). Upstream: https://sourceware.org/bugzilla/show_bug.cgi?id=33258 (unconfirmed).
Source: OpenIndiana oi-userland components/developer/gdb/patches/ignore-core-note0-segment.patch, identical in
omnios-extra build/gdb/patches. Applies to 18.1 unchanged.

diff --git a/bfd/elf.c b/bfd/elf.c
index affddf9..9c00a72 100644
--- a/bfd/elf.c
+++ b/bfd/elf.c
@@ -11991,6 +11991,9 @@ elfcore_grok_solaris_note_impl (bfd *abfd, Elf_Internal_Note *note)
 static bool
 elfcore_grok_solaris_note (bfd *abfd, Elf_Internal_Note *note)
 {
+  /* ignore the old note segment */
+  if (note->type == NT_PRPSINFO)
+    return true;
   if (!elfcore_grok_solaris_note_impl (abfd, note))
     return false;
 
diff --git a/bfd/elf.c b/bfd/elf.c
index b6edb86..38d1024 100644
--- a/bfd/elf.c
+++ b/bfd/elf.c
@@ -13290,6 +13290,9 @@ elf_parse_notes (bfd *abfd, char *buf, size_t size, file_ptr offset,
 		  {
 		    if (! grokers[i].func (abfd, & in))
 		      return false;
+		    /* ignore the old note segment */
+		    if ((grokers[i].func == elfcore_grok_solaris_note) && (in.type == NT_PRPSINFO))
+			p = buf + size;
 		    break;
 		  }
 	      }
