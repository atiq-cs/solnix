+/* Implement the "set_syscall_catchpoint" target_ops method: the traced
+   entry and exit sets are procfs_debug_inferior's own calls plus the
+   caught ones (all of them for a bare "catch syscall").  */
+
+int
+procfs_target::set_syscall_catchpoint (int pid, bool needed, int any_count,
+				       gdb::array_view<const int> counts)
+{
+  procinfo *pi = find_procinfo_or_die (pid, 0);
+  sysset_t sysentry, sysexit;
+
+  premptyset (&sysentry);
+  praddset (&sysentry, SYS_exit);
+  praddset (&sysentry, SYS_lwp_exit);
+  premptyset (&sysexit);
+  praddset (&sysexit, SYS_execve);
+  praddset (&sysexit, SYS_lwp_create);
+  praddset (&sysexit, SYS_lwp_exit);
+
+  if (needed && any_count > 0)
+    {
+      prfillset (&sysentry);
+      prfillset (&sysexit);
+    }
+  else if (needed)
+    for (size_t i = 0; i < counts.size (); i++)
+      if (counts[i] != 0)
+	{
+	  praddset (&sysentry, i);
+	  praddset (&sysexit, i);
+	}
+
+  if (!proc_set_traced_sysentry (pi, &sysentry)
+      || !proc_set_traced_sysexit (pi, &sysexit))
+    return 1;
+  return 0;
+}
