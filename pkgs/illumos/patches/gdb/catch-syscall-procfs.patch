+/* Implement the "get_syscall_number" gdbarch method.  */
+
+static LONGEST
+sol2_get_syscall_number (struct gdbarch *gdbarch, thread_info *thread)
+{
+  /* As FreeBSD and NetBSD: the procfs native target takes the system
+     call number from pr_what of the PR_SYSENTRY/PR_SYSEXIT stop, so this
+     is never called.  System call catching requires it to be set.  */
+
+  internal_error (_("sol2_get_syscall_number called"));
+}
+
 /* To be called from GDB_OSABI_SOLARIS handlers.  */
 
 void
@@ -108,4 +121,9 @@
 
   /* How to print LWP PTIDs from core files.  */
   set_gdbarch_core_pid_to_str (gdbarch, sol2_core_pid_to_str);
+
+  /* System call names for "catch syscall": one table for both ISAs,
+     generated from illumos <sys/syscall.h>.  */
+  set_xml_syscall_file_name (gdbarch, "syscalls/illumos.xml");
+  set_gdbarch_get_syscall_number (gdbarch, sol2_get_syscall_number);
 }
