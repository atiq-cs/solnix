+/*
+ * Change the interface MTU.
+ *
+ * The device is initialised with a boot-safe MTU (1500) at attach and the
+ * Rx/Tx buffer sizes are derived from it. Changing the MTU changes those
+ * buffer sizes, which are baked into the IO queue descriptors when the queues
+ * are allocated. The ENA IO queues are (re)allocated when the data path is
+ * (re)started, so a change is applied cleanly only while the interface is
+ * stopped: update ena_mtu and the derived buffer sizes here, and the new
+ * sizes take effect the next time MAC starts the rings.
+ *
+ * While the data path is running we do not attempt a live resize. The only
+ * in-driver primitive that reprograms the device and reallocates the rings is
+ * ena_reset(), which is an error-recovery path: driving it under an active
+ * data path races in-flight Tx/Rx against the ring teardown and makes the
+ * device latch its fatal-error bit. Rather than risk wedging the link we
+ * report EBUSY, matching other illumos NIC drivers (e.g. i40e); the standard
+ * way to change the MTU of an active link is to bring it down first, and the
+ * evidence-based first-boot service applies the per-instance MTU via the
+ * ena.conf "mtu" property so the raise happens at a clean attach.
+ */
 static int
+ena_set_mtu_prop(ena_t *ena, uint32_t new_mtu)
+{
+	int ret;
+
+	if (new_mtu < ETHERMIN || new_mtu > ena->ena_max_mtu)
+		return (EINVAL);
+
+	mutex_enter(&ena->ena_lock);
+	if (new_mtu == ena->ena_mtu) {
+		mutex_exit(&ena->ena_lock);
+		return (0);
+	}
+	if ((ena->ena_state & ENA_STATE_STARTED) != 0) {
+		mutex_exit(&ena->ena_lock);
+		return (EBUSY);
+	}
+
+	ret = mac_maxsdu_update(ena->ena_mh, new_mtu);
+	if (ret == 0) {
+		ena->ena_mtu = new_mtu;
+		ena_update_buf_sizes(ena);
+	}
+	mutex_exit(&ena->ena_lock);
+	return (ret);
+}
+
+static int
 ena_m_setprop(void *arg, const char *pr_name, mac_prop_id_t pr_num,
     uint_t pr_valsize, const void *pr_val)
 {
-	return (ENOTSUP);
+	ena_t *ena = arg;
+	uint32_t new_mtu;
+
+	switch (pr_num) {
+	case MAC_PROP_MTU:
+		if (pr_valsize < sizeof (uint32_t))
+			return (EOVERFLOW);
+		bcopy(pr_val, &new_mtu, sizeof (uint32_t));
+		return (ena_set_mtu_prop(ena, new_mtu));
+	default:
+		return (ENOTSUP);
+	}
 }
 
