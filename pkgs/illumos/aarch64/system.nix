# aarch64/system.nix -- a minimal solnix toplevel for the aarch64 EC2 image (aa64nix).
# It is a real derivation tree: /run/current-system -> this output, whose deriver resolves.
# NOT the full module-system toplevel (modules/system/activation hard-codes i86pc/amd64 and the
# x86 world slices); this is the shape the image's /run/current-system needs today:
#   sw/bin: nix + the store-built tools; etc/nix/{nix.conf,registry.json} as configuration does.
{ pkgs, extraPaths ? [ ], system ? "aarch64-solaris", rev ? "unknown" }:

let
  nix = pkgs.nix;
  cacert = pkgs.nixChain.cacert;
  # as modules/config/nix.nix (single-user here: no nixbld users on this image yet).
  nixConf = ''
    # /etc/nix/nix.conf -- generated by pkgs/illumos/aarch64/system.nix. Do not edit.
    substituters = https://cache.solnix.io
    trusted-public-keys = cache.solnix.io-1:8UNrVAOSOrI9PGHc8/pD2Yqp265ZeYb3OId+gv4+wm8=
    require-sigs = true
    ssl-cert-file = ${cacert}/etc/ssl/certs/ca-bundle.crt
    sandbox = false
    build-users-group =
    experimental-features = nix-command flakes
    max-jobs = auto
    cores = 0
    keep-outputs = true
    keep-derivations = true
    trusted-users = root
  '';
  # as modules/config/nix-channel.nix (the edition registry).
  registry = builtins.toJSON {
    version = 2;
    flakes = map (id: { from = { type = "indirect"; inherit id; };
                        to = { type = "git"; url = "https://git.solnix.io/solnix.git"; ref = "26.11"; }; })
               [ "nixpkgs" "solnix" ];
  };
in
derivation {
  name = "solnix-system-aarch64";
  inherit system nixConf registry rev cacert;
  paths = [ nix ] ++ extraPaths;
  builder = "/usr/bin/bash";
  PATH = "/usr/gnu/bin:/usr/bin:/usr/sbin";
  args = [ "-c" ''
    set -eu
    mkdir -p $out/sw/bin $out/etc/nix
    for p in $paths; do
      for b in "$p"/bin/*; do [ -e "$b" ] && ln -sf "$b" "$out/sw/bin/$(basename "$b")"; done
      # cp -rs copies the store dirs' r-x mode: without the chmod, the first package with man1 locks the rest out.
      [ -d "$p/share/man" ] && { mkdir -p $out/sw/share/man; cp -rs "$p/share/man/." $out/sw/share/man/; chmod -R u+w $out/sw/share/man; }
    done
    # as modules/system/activation: the system CA bundle is the store cacert (wget, git, fetch).
    mkdir -p $out/etc/ssl/certs
    ln -s $cacert/etc/ssl/certs/ca-bundle.crt $out/etc/ssl/certs/ca-certificates.crt
    ln -s $cacert/etc/ssl/certs/ca-bundle.crt $out/etc/ssl/certs/ca-bundle.crt
    printf '%s' "$nixConf" > $out/etc/nix/nix.conf
    printf '%s' "$registry" > $out/etc/nix/registry.json
    printf 'RELEASE=26.11\nARCH=aarch64\nREVISION=%s\n' "$rev" > $out/etc/solnix-release
    [ -x $out/sw/bin/nix ] || { echo "FATAL: no nix in sw/bin" >&2; exit 1; }
  '' ];
}
