# pkgs.solnix.nvidia-drm-driver -- nvidia-drm, NVIDIA's DRM driver (MIT), over
# the OpenBSD drm layer i915 runs on (src/drm-port/nvidia-drm/README.md). One
# module, kernel/drv/amd64/nvidia_drm, linked like i915: the OpenBSD drm core
# (i915's "drm" files and patches), obsd-compat, the 18 nvidia-drm sources of
# the pinned upstream tree with patches/0001 (the OpenBSD-layer arms) and
# patches/0002 (the NVKMS device only while a DRM file or GEM object uses it,
# so an idle dGPU can power off with nvidia_drm attached), patches/0003 (GEM
# mmap for the shell's devmap: nvkms video memory, dumb buffers included,
# through the FB BAR, write-combined) and the illumos shell
# (nvidia_drm_illumos.c, nvidia_drm_glue.c, nvidia_drm_bar1.h), ld -r -Breduce with
# nvidia-drm.mapfile. It NEEDs drv/nvidia_modeset (NVKMS) and
# misc/gfx_private. conftest/*.h are generated by NVIDIA's conftest.sh
# (conftest-run.sh) against the OpenBSD headers.
#
# GATE (fail closed):
#   * 0 compile errors; every nvidia-drm .c but nv-pci-table.c (data only)
#     and nvidia-drm-color-pipeline.c (needs drm_colorop) has a function;
#   * unresolved = 0 against kernelNd (unix, genunix, misc/gfx_private) and
#     nvidia-oss-modules (drv/nvidia_modeset, drv/nvidia);
#   * exported globals are exactly _init, _fini, _info, _depends_on;
#   * no module global collides with a kernelNd global (_init/_fini/_info aside);
#   * SIMD: i915's simd-gate.sh, with drm_cache.c as the only exempt object
#     (OpenBSD's movntdqa copy inside fpu_kernel_enter/exit);
#   * test/test_bar1.c: the GEM mmap arithmetic (FB BAR lookup, offset and
#     range checks) on the X1E's PCI properties.
# Negative controls, each must FAIL: one more unresolved symbol (named), the
# SIMD gate on the module with one nvidia-drm object rebuilt -msse, and
# test_bar1 built with each of its two sabotages.
#
# Not bound to anything: hardware.graphics.nvidia.drm lays it with
# nvidia_drm.conf.
{ gate, kernelNd, ld, kmodDev, kmodPath ? null, pathGate ? null
, nvidiaModules              # pkgs.solnix.nvidia-oss-modules (NVKMS)
, rmSrc                      # the pinned upstream tree (nvidia-oss-modules's)
, obsdDrm                    # OpenBSD drm 37a498de (i915-driver's)
, system ? "x86_64-solaris"
, portSrc ? builtins.path {
    path = ../../src/drm-port;
    name = "solnix-drm-port-nvidia-drm-src";
    filter = path: type:
      let
        base = toString ../../src/drm-port;
        rel = builtins.substring (builtins.stringLength base + 1) 1000 (toString path);
        top = builtins.head (builtins.split "/" rel);
      in (top == "nvidia-drm" || top == "obsd-compat" || top == "i915")
         && !(type == "regular" && builtins.match ".*\\.o" (baseNameOf path) != null);
  }
}:

derivation {
  name = "nvidia-drm-driver-615.71.09";
  inherit system gate kernelNd ld kmodDev nvidiaModules rmSrc obsdDrm portSrc;
  allowedReferences = [ ];
  builder = "/usr/bin/bash";
  PATH = if kmodPath == null then "/usr/bin:/usr/sbin:/usr/gnu/bin" else kmodPath;
  pathGate = if pathGate == null then "" else pathGate;
  args = [ "-c" ''
    set -eu
    export LC_ALL=C   # sort and comm below must collate alike
    export PATH="$kmodDev/bin:$ld/usr/bin:$ld/bin:$PATH"
    [ -z "$pathGate" ] || PATH_GATE_ALLOW="" /usr/bin/bash "$pathGate"
    for t in gcc gmake gnm gobjdump patch nm elfdump awk; do
      command -v $t >/dev/null || { echo "FATAL: no $t on PATH" >&2; exit 1; }
    done
    LDBIN="$ld/usr/bin/ld"; [ -x "$LDBIN" ] || LDBIN=/usr/bin/ld
    "$LDBIN" -V 2>&1 | grep -q 'Solaris Link Editors\|illumos' || { echo "FATAL: $LDBIN is not the illumos ld" >&2; exit 1; }
    NM=$(command -v nm)
    G="$gate/usr/include"
    [ -d "$G/sys" ] || { echo "FATAL: gate proto has no usr/include/sys" >&2; exit 1; }
    J=''${NIX_BUILD_CORES:-0}; [ "$J" -gt 0 ] 2>/dev/null || J=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)

    W=$(mktemp -d "''${TMPDIR:-/tmp}"/nvidia-drm.XXXXXX)
    cp -r "$portSrc" "$W/port"; chmod -R u+w "$W/port"
    cp -r "$obsdDrm" "$W/obsd"; chmod -R u+w "$W/obsd"
    P=$W/port; O=$W/obsd; C=$P/obsd-compat; S=$P/nvidia-drm
    # the OpenBSD tree exactly as i915-driver.nix patches it
    sed -i 's/^kmap_atomic_prot(struct vm_page \*pg, pgprot_t prot)$/obsd_orig_kmap_atomic_prot(struct vm_page *pg, pgprot_t prot)/; s/^kunmap_atomic(void \*addr)$/obsd_orig_kunmap_atomic(void *addr)/' "$O/drm_linux.c"
    [ "$(grep -c '^obsd_orig_k' "$O/drm_linux.c")" -eq 2 ] || { echo "FATAL: drm_linux.c kmap_atomic anchors not found" >&2; exit 1; }
    ( cd "$O" && patch -p1 --no-backup-if-mismatch -F0 < "$P/i915/obsd-norcu.patch" ) >&2
    ( cd "$O" && patch -p1 --no-backup-if-mismatch -F0 < "$P/i915/obsd-errno.patch" ) >&2

    # nvidia-drm: the pinned kernel-open/{nvidia-drm,common/inc} with patches/0001
    mkdir -p "$W/ko"
    cp -r "$rmSrc/kernel-open/nvidia-drm" "$rmSrc/kernel-open/common" "$W/ko/"; chmod -R u+w "$W/ko"
    ( cd "$W" && mkdir -p kernel-open && mv ko/nvidia-drm ko/common kernel-open/ \
      && for p in "$S"/patches/*.patch; do patch -p1 --fuzz=0 --no-backup-if-mismatch < "$p" >&2; done )
    K=$W/kernel-open
    grep -q 'defined(NV_SUNOS)' "$K/nvidia-drm/nvidia-drm-conftest.h" || { echo "FATAL: patches/0001 not applied" >&2; exit 1; }
    grep -q '^#define NV_DRM_LAZY_NVKMS 1' "$K/nvidia-drm/nvidia-drm-sunos.h" || { echo "FATAL: patches/0002 not applied" >&2; exit 1; }
    grep -q '^int nv_drm_sunos_gem_mmap_pa' "$K/nvidia-drm/nvidia-drm-gem-nvkms-memory.c" || { echo "FATAL: patches/0003 not applied" >&2; exit 1; }

    # the GEM mmap arithmetic (nvidia_drm_bar1.h), userland, and its negative controls
    mkdir -p "$W/t"
    gcc -m64 -O2 -Wall -Wextra -Werror -o "$W/t/test_bar1" "$S/test/test_bar1.c"
    "$W/t/test_bar1" > "$W/t/test_bar1.out" || { cat "$W/t/test_bar1.out" >&2; echo "FATAL: test_bar1" >&2; exit 1; }
    tail -1 "$W/t/test_bar1.out" >&2
    for neg in FB RANGE; do
      gcc -m64 -O2 -Wall -Wextra -Werror -DNVD_BAR1_SABOTAGE_$neg -o "$W/t/neg_$neg" "$S/test/test_bar1.c"
      if "$W/t/neg_$neg" > "$W/t/neg_$neg.out"; then echo "FATAL: NEGATIVE CONTROL test_bar1 $neg DID NOT FAIL" >&2; exit 1; fi
      echo "gate: negative control (test_bar1 $neg) FAILS as required: $(grep -c '^FAIL ' "$W/t/neg_$neg.out")" >&2
    done

    F="-m64 -mcmodel=kernel -mno-red-zone -mno-mmx -mno-sse -D_KERNEL -ffreestanding -nostdinc -std=gnu11 -O2"
    F="$F -fno-strict-aliasing -D__HAVE_ACPI -DNACPI=1 -include $C/obsd_prelude.h -I$C"
    F="$F -I$O/include -I$O/include/uapi -I$O -I$G -fmacro-prefix-map=$W/= -fmacro-prefix-map=$gate/=/"
    GI=$(gcc -print-file-name=include)

    # conftest/*.h from NVIDIA's conftest.sh against the OpenBSD headers
    RM=$rmSrc OBSD=$O COMPAT=$C GATEINC=$G CC=gcc GREP=grep sh "$S/conftest-run.sh" "$W" >&2
    grep -q '^#define NV_DMA_RESV_RESERVE_FENCES_PRESENT' "$W/cf/conftest/types.h" \
      || { echo "FATAL: conftest did not find OpenBSD's dma_resv_reserve_fences" >&2; exit 1; }

    # --- compile ---------------------------------------------------------------
    mkdir -p "$W/core" "$W/nvd"
    awk '$1=="file" && $3=="drm" {sub("dev/pci/drm/","",$2); print $2}' "$O/files.drm" > "$W/core.txt"
    echo drm_drv.c >> "$W/core.txt"
    n=0
    for f in $(cat "$W/core.txt"); do
      o="$W/core/$(echo "$f" | tr / _).o"
      { ( cd "$O" && gcc $F -c "$f" -o "$o" ) > "$o.log" 2>&1 || echo "$f" >> "$W/cc-fail"; } &
      n=$((n + 1)); [ $((n % J)) -eq 0 ] && wait
    done
    wait
    NF="$F -isystem $GI -Wall -Wno-unused-function -DNVRM -DNV_VERSION_STRING=\"615.71.09\" -UDEBUG -U_DEBUG -DNDEBUG"
    NF="$NF -DNV_BUILD_MODULE_INSTANCES=0 -DNVIDIA_UNDEF_LEGACY_BIT_MACROS -DNV_DRM_OBSD -I$W/cf -I$K/nvidia-drm -I$K/common/inc"
    NF="$NF -I$rmSrc/kernel-open/nvidia-modeset -I$rmSrc/src/nvidia-modeset/kapi/interface -I$rmSrc/src/nvidia-modeset/interface"
    NF="$NF -I$rmSrc/src/common/unix/common/inc -fmacro-prefix-map=$rmSrc/=/nvidia/"
    for f in $(cd "$K/nvidia-drm" && ls *.c | grep -v '^nvidia-drm-linux\.c$'); do
      gcc $NF -c "$K/nvidia-drm/$f" -o "$W/nvd/''${f%.c}.o" > "$W/nvd/''${f%.c}.log" 2>&1 || echo "nvidia-drm/$f" >> "$W/cc-fail"
    done
    gcc $NF -I$S -c "$S/nvidia_drm_glue.c" -o "$W/nvd/nvidia_drm_glue.o" > "$W/nvd/glue.log" 2>&1 || echo nvidia_drm_glue.c >> "$W/cc-fail"
    gcc $F -isystem $GI -I$S -I$P/i915 -Wall -Werror -c "$S/nvidia_drm_illumos.c" -o "$W/nvd/nvidia_drm_illumos.o" \
      > "$W/nvd/shell.log" 2>&1 || echo nvidia_drm_illumos.c >> "$W/cc-fail"
    if [ -s "$W/cc-fail" ]; then
      echo "FATAL: $(grep -c . "$W/cc-fail") files failed to compile:" >&2; cat "$W/cc-fail" >&2
      cat "$W"/nvd/*.log | grep error | head -20 >&2; exit 1
    fi
    # a .o with no function is code guarded out, not a port
    for o in "$W"/nvd/*.o; do
      b=$(basename "$o" .o)
      case $b in nv-pci-table|nvidia-drm-color-pipeline) continue ;; esac
      [ "$($NM -p "$o" | awk '$2 ~ /^[Tt]$/' | grep -c .)" -gt 0 ] || { echo "FATAL: $b.o has no function (guarded out)" >&2; exit 1; }
    done
    ( cd "$C" && gmake obj GATE_INC="$G" ) > "$W/compat.log" 2>&1 || { tail -20 "$W/compat.log" >&2; exit 1; }
    ls "$W"/core/*.o "$C"/obsd_*.o "$W"/nvd/*.o > "$W/objs.txt"
    nobj=$(grep -c . "$W/objs.txt")
    link() { ( cd "$W" && "$LDBIN" -r -Breduce -M "$S/nvidia-drm.mapfile" -o "$1" $(cat "$2") ) > "$W/$1.ld.log" 2>&1 \
      || { cat "$W/$1.ld.log" >&2; exit 1; }; }
    link nvidia_drm objs.txt
    echo "built: nvidia_drm ($(wc -c < "$W/nvidia_drm") bytes, $nobj objects)" >&2

    # --- GATE: symbols --------------------------------------------------------
    cd "$W"
    M=$nvidiaModules/kernel/drv/amd64
    for k in "$kernelNd/platform/i86pc/kernel/amd64/unix" "$kernelNd/kernel/amd64/genunix" \
             "$kernelNd/platform/i86pc/kernel/misc/amd64/gfx_private" "$M/nvidia_modeset" "$M/nvidia"; do
      [ -f "$k" ] || { echo "FATAL: reference $k missing" >&2; exit 1; }
      $NM -p "$k"
    done | awk '$2 ~ /^[TDBRCW]$/ {print $3}' | sort -u > ks.txt
    undef() { $NM -p "$1" | awk '$2=="U" {print $3}' | sort -u; }
    undef nvidia_drm > undef.txt
    $NM -p nvidia_drm | awk '$2 ~ /^[TDBRC]$/ {print $3}' | sort -u > defined.txt
    nund=$(grep -c . undef.txt || true)
    [ "$nund" -ge 100 ] || { echo "FATAL: only $nund undefined syms (nm printed too few)" >&2; exit 1; }
    printf 'extern int nvd_gate_negctl_nosuch(void);\nint nvd_gate_negctl(void) { return nvd_gate_negctl_nosuch(); }\n' > negctl.c
    gcc -m64 -mcmodel=kernel -mno-red-zone -mno-mmx -mno-sse -ffreestanding -nostdinc -c -o negctl.o negctl.c
    "$LDBIN" -r -o nvidia_drm-negctl nvidia_drm negctl.o
    undef nvidia_drm-negctl | comm -23 - ks.txt | grep -v '^__dtrace_probe_' > negctl-unres.txt || true
    comm -23 undef.txt ks.txt | grep -v '^__dtrace_probe_' > unres.txt || true
    nreal=$(grep -c . unres.txt || true); nneg=$(grep -c . negctl-unres.txt || true)
    [ "$nneg" -eq $((nreal + 1)) ] && grep -qx nvd_gate_negctl_nosuch negctl-unres.txt \
      || { echo "FATAL: negative control (unresolved): $nneg, want $((nreal + 1))" >&2; exit 1; }
    echo "gate: negative control (unresolved) FAILS as required: +1 (nvd_gate_negctl_nosuch)" >&2
    echo "gate: undefined=$nund unresolved=$nreal" >&2
    [ "$nreal" -eq 0 ] || { sed 's/^/  /' unres.txt >&2; echo "FATAL: unresolved symbols (must be 0)" >&2; exit 1; }
    grep -v -E '^(_init|_fini|_info|_depends_on)$' defined.txt > leaked.txt || true
    nleak=$(grep -c . leaked.txt || true)
    [ "$nleak" -eq 0 ] || { sed 's/^/  /' leaked.txt >&2; echo "FATAL: non-interface globals exported" >&2; exit 1; }
    for s in _init _fini _info _depends_on; do
      grep -qx "$s" defined.txt || { echo "FATAL: $s not exported" >&2; exit 1; }
    done
    find "$kernelNd/platform" "$kernelNd/kernel" "$kernelNd/usr/kernel" "$M" -type f 2>/dev/null \
      | while read -r f; do gnm -g --defined-only "$f" 2>/dev/null || true; done \
      | awk '{print $3}' | sort -u > ksyms-all.txt
    nall=$(grep -c . ksyms-all.txt || true)
    [ "$nall" -ge 10000 ] || { echo "FATAL: only $nall kernel globals: refusing a vacuous collision gate" >&2; exit 1; }
    comm -12 defined.txt ksyms-all.txt | grep -v -E '^(_init|_fini|_info)$' > collide.txt || true
    ncol=$(grep -c . collide.txt || true)
    echo "gate: collisions vs $nall kernel globals=$ncol" >&2
    [ "$ncol" -eq 0 ] || { sed 's/^/  /' collide.txt >&2; echo "FATAL: name collisions" >&2; exit 1; }

    # --- GATE: SIMD -------------------------------------------------------------
    SG="$P/i915/simd-gate.sh"
    grep -qx "$W/core/drm_cache.c.o" objs.txt || { echo "FATAL: exempt object drm_cache.c.o not linked" >&2; exit 1; }
    mkdir -p neg-sse/nvd
    printf 'double nvd_simd_neg(double a, double b) { return a * b; }\n' > neg-sse/f.c
    gcc -m64 -mcmodel=kernel -mno-red-zone -msse2 -ffreestanding -nostdinc -O2 -c neg-sse/f.c -o neg-sse/nvd/f.o
    "$LDBIN" -r -o neg-sse/nvd/nvidia-drm-format.o "$W/nvd/nvidia-drm-format.o" neg-sse/nvd/f.o
    sed "s#^$W/nvd/nvidia-drm-format.o\$#$W/neg-sse/nvd/nvidia-drm-format.o#" objs.txt > neg-sse/objs.txt
    cmp -s objs.txt neg-sse/objs.txt && { echo "FATAL: simd-sse control did not swap the object" >&2; exit 1; }
    link neg-sse/nvidia_drm neg-sse/objs.txt
    if OBJDUMP=gobjdump sh "$SG" neg-sse/nvidia_drm drm_cache.c.o $(cat neg-sse/objs.txt) > neg-sse/log 2>&1; then
      cat neg-sse/log >&2; echo "FATAL: NEGATIVE CONTROL (simd-sse) DID NOT FAIL" >&2; exit 1; fi
    grep -q 'FAIL (object): nvidia-drm-format.o' neg-sse/log \
      || { cat neg-sse/log >&2; echo "FATAL: negative control (simd-sse) failed for the wrong reason" >&2; exit 1; }
    echo "gate: negative control (simd-sse) FAILS as required" >&2
    OBJDUMP=gobjdump sh "$SG" nvidia_drm drm_cache.c.o $(cat objs.txt) > simd.log 2>&1 || { cat simd.log >&2; echo "FATAL: SIMD gate" >&2; exit 1; }
    grep -E '^(exempt|module|SIMD-GATE PASS)' simd.log >&2

    mkdir -p "$out/kernel/drv/amd64" "$out/share/nvidia-drm"
    cp nvidia_drm "$out/kernel/drv/amd64/nvidia_drm"
    chmod 0555 "$out/kernel/drv/amd64/nvidia_drm"
    cp "$S/nvidia_drm.conf" "$out/share/nvidia-drm/"
    cp "$W"/cf/conftest/*.h "$out/share/nvidia-drm/"
    {
      echo "objects=$nobj undefined=$nund unresolved=$nreal non-interface-globals=$nleak collisions=$ncol/$nall"
      echo "negctl-unresolved=$nneg negctl-simd-sse=FAIL"
      echo "test_bar1=$(tail -1 "$W/t/test_bar1.out") negctl-test_bar1=FB,RANGE:FAIL"
      grep -E '^(exempt|module|SIMD-GATE PASS)' simd.log
      echo "obsd-drm=$(cat "$O/OPENBSD_REV")"
    } > "$out/share/nvidia-drm/GATE-RESULT.txt"
    if grep -rl /nix/store/ "$out" > refs.txt 2>/dev/null; then
      echo "FATAL: store paths in the output:" >&2; cat refs.txt >&2; exit 1
    fi
    cd /; find "$W" -depth -delete 2>/dev/null || true
    echo "=== nvidia-drm-driver: module built, gate green ===" >&2
  '' ];
}
